// ─────────────────────────────────────────────────────────────────────
//  ASSURANCE INTEGRITY — auditor independence, competence, meetings, errata
//
//  Design: docs/cams/09-module-completion.md Part 2.
//
//  Premise: CAMS already modelled auditor and auditee correctly — both are
//  ENGAGEMENT-SCOPED (ComplianceAudit.leadAuditorUserId / coAuditors / auditees
//  plus the per-checkpoint assignedAuditorId / assignedOwnerId), and there is no
//  global AUDITOR role in RBAC. What was missing was every GUARD over that
//  model. These tables are those guards' records, not a new role model.
//
//  Schema is owned SQLAlchemy-side (app/models/assurance.py) and applied by
//  scripts/add_assurance_integrity.py — NOT `prisma db push`, which would drop
//  the Cams* tables due to known drift. This block exists so the two schemas do
//  not diverge; divergence between them is the mechanism behind F-29, the worst
//  defect in the module.
// ─────────────────────────────────────────────────────────────────────

/// Who is responsible for a discipline at a site (open question Q17).
/// plantId NULL = estate-wide ownership: a group lead who owns Fire Safety
/// across every factory should not audit Fire Safety anywhere.
model DisciplineOwner {
  id              String   @id @default(cuid())
  plantId         String?
  disciplineCode  String
  disciplineLabel String   @default("")
  ownerUserId     String
  ownershipType   String   @default("ACCOUNTABLE") // ACCOUNTABLE | RESPONSIBLE
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  createdBy       String?

  @@unique([plantId, disciplineCode, ownerUserId], name: "uq_DisciplineOwner_scope")
  @@index([plantId, disciplineCode, isActive])
  @@index([ownerUserId])
}

/// A governed, VISIBLE exception to an independence rule (§2.1.6).
/// ISO 19011 acknowledges proportionality — small sites cannot always staff full
/// independence. What matters is that the exception is visible, not impossible,
/// so a justification and a named approver are required and the waiver is
/// rendered in the engagement's report.
model IndependenceWaiver {
  id               String    @id @default(cuid())
  engagementKind   String // AUDIT | INSPECTION
  engagementId     String
  subjectUserId    String
  ruleViolated     String // OWN_WORK | SAME_ENGAGEMENT_DUAL_ROLE
  conflictDetail   Json? // frozen copy of what the guard said at waiver time
  justification    String
  approvedByUserId String // must NOT be subjectUserId — enforced via segregation_ok
  approvedAt       DateTime  @default(now())
  scope            String    @default("ENGAGEMENT") // ENGAGEMENT | CHECKPOINT_SET
  checkpointCodes  Json      @default("[]")
  revokedAt        DateTime?
  revokedByUserId  String?
  createdAt        DateTime  @default(now())

  @@index([engagementKind, engagementId])
  @@index([subjectUserId, revokedAt])
}

/// What the Skill Matrix said about this auditor AT ASSIGNMENT TIME (§2.2).
/// Same principle as the template snapshot: a live CompetencyRecord read cannot
/// answer "was this person qualified when the audit was conducted?" after a
/// revalidation, expiry or suspension.
model EngagementCompetenceSnapshot {
  id                           String    @id @default(cuid())
  engagementKind               String
  engagementId                 String
  userId                       String
  competencyId                 String
  competencyCode               String    @default("")
  competencyName               String    @default("")
  state                        String?
  validUntil                   DateTime?
  externalCertificateReference String?
  held                         Boolean   @default(false)
  waivedGap                    Boolean   @default(false)
  capturedAt                   DateTime  @default(now())
  capturedByUserId             String?

  @@index([engagementKind, engagementId, userId])
}

/// Opening / closing meeting record — ISO 19011 §6.4.2 and §6.4.9 (§2.3).
/// ComplianceAudit.openingRemarks/closingRemarks are free text with no
/// attendees, no time and no acknowledgement, so the report could only ever
/// assert a meeting the product had no evidence of. This is the evidence.
/// attendees is [{userId}] OR [{name, organisation, role}] — buyer auditors and
/// certification assessors attend these meetings and are not platform users.
model EngagementMeeting {
  id                          String    @id @default(cuid())
  engagementKind              String
  engagementId                String
  meetingType                 String // OPENING | CLOSING
  heldAt                      DateTime
  attendees                   Json      @default("[]")
  scopeConfirmed              Boolean   @default(false)
  findingsSummaryPresented    String?
  auditeeAcknowledgedByUserId String?
  auditeeAcknowledgedAt       DateTime?
  notes                       String?
  recordedByUserId            String
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@unique([engagementKind, engagementId, meetingType], name: "uq_EngagementMeeting_type")
  @@index([engagementKind, engagementId])
}

/// An append-only correction to an ISSUED report (§2.5).
/// Editing the snapshot would destroy the integrity hash's meaning; an erratum
/// leaves the original snapshot and its hash untouched and renders as a dated
/// block at the head of the report.
model ReportErratum {
  id               String   @id @default(cuid())
  reportId         String
  auditId          String
  sequence         Int      @default(1)
  text             String
  raisedByUserId   String
  approvedByUserId String
  createdAt        DateTime @default(now())

  @@unique([reportId, sequence], name: "uq_ReportErratum_seq")
  @@index([reportId])
  @@index([auditId])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
//  BRSR â€” Business Responsibility & Sustainability Reporting (SEBI)
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Standalone disclosure module. Aggregates FROM other modules (ERM controls +
// vendor risk, Manhours, Incident/NearMiss, Training, Safety Culture, EPC,
// Facilities, CAMS) but owns its own model, workflow and report generator â€”
// the Daily Brief pattern, not a sub-module of ERM.
//
// Mirrors app/models/brsr.py. Read that file first: it carries the rationale
// for the four places this shape departs from the original build spec.
//
// NOTE: FactoryEnvPeriod (above) is NOT extended by this module. It becomes a
// DERIVED rollup of BrsrEnvMetricLine â€” see services/brsr_env_rollup.py â€” so
// the Facilities ESG tab and the BRSR report can never disagree on Scope 1.

/// One BRSR filing cycle: one financial year, one listed entity.
/// No plantId â€” BRSR is filed by the listed entity, not the site. Sites enter
/// one level down at BrsrEnvironmentalMetric, which is genuinely per-facility.
model BrsrReportingCycle {
  id            String   @id @default(cuid())
  financialYear String // "FY2025-26" â€” as SEBI labels it
  periodStart   DateTime
  periodEnd     DateTime
  status        String   @default("DRAFT") // DRAFT | DATA_COLLECTION | REVIEW | APPROVED | FILED

  // Section A entity identity (asked once per cycle, not per principle)
  entityName              String?
  cin                     String?
  stockExchangeCodes      Json    @default("[]") // dual-listed entities exist
  registeredOfficeAddress String?
  contactName             String?
  contactEmail            String?
  contactPhone            String?
  assuranceProvider       String? // declaration only â€” the assurance workflow is out of scope
  assuranceType           String?

  // Rollup, recomputed by services/brsr_completion.py
  completionPct    Float     @default(0)
  autoPopulatedPct Float     @default(0)
  lastComputedAt   DateTime?

  // Sign-off + immutable snapshot (the CAMS audit-report pattern)
  approvedById    String?
  approvedAt      DateTime?
  filedById       String?
  filedAt         DateTime?
  filingReference String? // the entity files via its own SEBI process; SafeOps360 does not submit
  snapshotJson    Json?
  snapshotHash    String? // SHA-256 over the canonicalised snapshot
  notes           String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  principleResponses BrsrPrincipleResponse[]

  // The live-row uniqueness of financialYear is a PARTIAL unique index
  // (WHERE isDeleted = false) created in apply-brsr-ddl.ts â€” Prisma cannot
  // express a partial index, so it is deliberately absent here.
  @@index([financialYear])
  @@index([status])
  @@index([isDeleted])
}

/// One disclosure line item in the SEBI BRSR format. Seeded, not user-created.
/// Completion % is `answered / applicable` over these rows, and the P2/P4/P7/P8
/// manual forms render from them â€” which is what keeps the field names SEBI's.
model BrsrIndicator {
  id             String  @id @default(cuid())
  code           String  @unique // "C.P6.EI.1" = Section C, Principle 6, Essential Indicator 1
  section        String // A | B | C
  principle      String? // NULL outside Section C
  indicatorClass String? // ESSENTIAL | LEADERSHIP; NULL outside Section C

  label      String // SEBI's wording, verbatim
  groupLabel String? // e.g. "Water withdrawal by source"
  guidance   String?

  valueType       String  @default("TEXT") // NUMBER | TEXT | BOOLEAN | TABLE
  unit            String?
  tableSchemaJson Json? // for valueType=TABLE: column defs the form and report render

  isMandatory       Boolean @default(true) // leadership indicators are voluntary â€” a blank one must not drag completion % down
  displayOrder      Int     @default(0) // report order; SEBI numbering is not lexicographically sortable past 9
  isActive          Boolean @default(true)
  sebiFormatVersion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section, principle, displayOrder])
  @@index([principle])
  @@index([indicatorClass])
  @@index([isActive])
}

/// Which SafeOps360 module and field feeds which BRSR indicator â€” the
/// traceability record AND the mapping engine's configuration. `resolverKey`
/// names a function in services/brsr_mapping.RESOLVERS, so adding a source is a
/// seed row plus a resolver, never a change to the engine's control flow.
model BrsrDataSource {
  id            String @id @default(cuid())
  indicatorCode String

  sourceModule     String // ERM | MANHOURS | INCIDENT | TRAINING | EPC | FACILITIES | CAMS | SAFETY_CULTURE | BRSR_ENV
  sourceEntity     String // the table the figure is computed over
  sourceField      String?
  resolverKey      String
  resolverArgsJson Json? // static kwargs â€” lets one resolver serve several indicators

  derivationNote String? // rendered verbatim under the figure, so an auditor reads the derivation without opening the code
  isPrimary      Boolean @default(true) // SECONDARY sources contribute drill-through records only
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([indicatorCode, resolverKey], name: "uq_BrsrDataSource_ind_resolver")
  @@index([indicatorCode])
  @@index([sourceModule, isActive])
}

/// One principle (P1â€“P9) within one cycle. Owns the narrative, ownership and
/// sign-off; the figures live in BrsrIndicatorValue.
model BrsrPrincipleResponse {
  id      String             @id @default(cuid())
  cycleId String
  cycle   BrsrReportingCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  principle String // P1..P9
  status    String @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | READY_FOR_REVIEW | REVIEWED

  /// Denormalised from PLATFORM_SOURCED_PRINCIPLES at row creation, so the
  /// "not sourced from platform data" banner survives a change to the constant
  /// without restating history. P2/P4/P7/P8 are false.
  isPlatformSourced Boolean @default(false)

  ownerUserId String?
  dueDate     DateTime?

  totalIndicators         Int       @default(0)
  answeredIndicators      Int       @default(0)
  autoPopulatedIndicators Int       @default(0)
  completionPct           Float     @default(0)
  autoPopulatedPct        Float     @default(0)
  lastComputedAt          DateTime?

  narrative    String?
  reviewedById String?
  reviewedAt   DateTime?
  reviewNotes  String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  values BrsrIndicatorValue[]

  @@unique([cycleId, principle], name: "uq_BrsrPrincipleResponse_cycle_principle")
  @@index([cycleId])
  @@index([principle])
  @@index([status])
  @@index([ownerUserId])
}

/// One indicator's answer for one cycle, plus where it came from â€” the
/// audit-grade unit. Everything an assurance provider asks about a single
/// figure is on this row.
model BrsrIndicatorValue {
  id                  String                 @id @default(cuid())
  cycleId             String
  principleResponseId String? // NULL for Section A / B indicators, which belong to no principle
  principleResponse   BrsrPrincipleResponse? @relation(fields: [principleResponseId], references: [id], onDelete: Cascade)

  indicatorCode String

  // Separate typed columns rather than one text blob, so a numeric indicator
  // can be aggregated for the year-over-year trend without a cast.
  valueNumber  Float?
  valueText    String?
  valueBoolean Boolean?
  valueJson    Json?
  unit         String?

  provenance          String  @default("MANUAL") // AUTO | MANUAL | AUTO_OVERRIDDEN | NOT_APPLICABLE
  notApplicableReason String? // required by the API when provenance = NOT_APPLICABLE

  // Auto-population trace (null on a purely manual figure).
  // sourceRecordRefs holds [{module, entity, id, label}] rather than bare ids â€”
  // the drill-through must render a row for a record the user may not be
  // entitled to open, and a dangling cuid with no label is exactly the
  // "never render a raw id" failure the platform already has a rule about.
  // Deliberately NOT foreign-keyed: the refs span nine modules, several
  // soft-deleted, and a filed disclosure must keep rendering its provenance.
  sourceModule      String?
  resolverKey       String?
  sourceRecordRefs  Json?
  sourceRecordCount Int?
  derivationNote    String?
  computedAt        DateTime?

  // Override trace (populated only when provenance = AUTO_OVERRIDDEN). The
  // platform's number is frozen here rather than recomputed, because re-running
  // the resolver later answers a different question than "what did the reviewer
  // actually disagree with".
  autoValueNumber Float?
  autoValueText   String?
  overrideReason  String?
  overriddenById  String?
  overriddenAt    DateTime?

  isVerified   Boolean   @default(false)
  verifiedById String?
  verifiedAt   DateTime?
  evidenceNote String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique([cycleId, indicatorCode], name: "uq_BrsrIndicatorValue_cycle_indicator")
  @@index([cycleId, provenance])
  @@index([cycleId, isVerified])
  @@index([indicatorCode])
  @@index([principleResponseId])
  @@index([sourceModule])
}

/// Emission factor for one fuel or grid, with its published source. Versioned
/// by validity window rather than overwritten: a revision must never restate a
/// prior year's filed Scope 1. BrsrEnvMetricLine also freezes the factor it
/// used, so a revision cannot restate an unfiled draft either.
model BrsrEmissionFactor {
  id          String @id @default(cuid())
  code        String
  name        String
  factorType  String // ELECTRICITY_GRID | LIQUID_FUEL | GASEOUS_FUEL | SOLID_FUEL | REFRIGERANT
  scope       String // SCOPE_1 | SCOPE_2
  factorValue Float // tCO2e per perUnit
  perUnit     String // kWh | litre | kg | scm | tonne

  source     String // "CEA CO2 Baseline Database v20", "IPCC AR6" â€” a Scope 2 figure with no citation is not assurable
  sourceYear String?
  region     String? // NULL = all-India grid factor

  validFrom  DateTime?
  validUntil DateTime?
  isActive   Boolean   @default(true)
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([factorType, scope, isActive])
  @@index([code])
}

/// One facility's environmental submission for one period of one cycle.
/// The header carries the workflow and the intensity denominators; the
/// quantities are BrsrEnvMetricLine children.
model BrsrEnvironmentalMetric {
  id       String  @id @default(cuid())
  cycleId  String
  siteId   String // FK-by-value to Plant, per house convention
  siteName String? // denormalised â€” a register row must never render a raw Plant cuid

  periodLabel String // "FY2025-26" annual, or "2025-Q3" quarterly; the generator sums whatever exists
  periodStart DateTime?
  periodEnd   DateTime?
  status      String    @default("DRAFT") // DRAFT | SUBMITTED | VERIFIED

  // Intensity denominators. Per-facility because BRSR allows both a turnover
  // and a physical-output intensity, and a multi-site entity has both per site.
  // A site with no denominator reports absolutes and omits intensity rather
  // than dividing by a guess.
  turnoverInr      Float?
  productionVolume Float?
  productionUnit   String?

  // Scope 3 is captured, not computed â€” building a calculator is explicitly
  // out of scope for this build.
  scope3TCo2e       Float?
  scope3Methodology String?

  isWaterPositive        Boolean?
  hasZeroLiquidDischarge Boolean?
  consentStatus          String?

  submittedById String?
  submittedAt   DateTime?
  verifiedById  String?
  verifiedAt    DateTime?
  notes         String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  lines BrsrEnvMetricLine[]

  @@unique([cycleId, siteId, periodLabel], name: "uq_BrsrEnvironmentalMetric_cycle_site_period")
  @@index([cycleId, status])
  @@index([siteId])
  @@index([periodLabel])
  @@index([isDeleted])
}

/// One captured environmental quantity: a stream, a category, a number.
/// A line table rather than columns because BRSR's environmental section is a
/// set of grids whose categories SEBI revises. Adding a category is a seed row
/// here; as columns it would be a migration on an already-filed table.
model BrsrEnvMetricLine {
  id       String                  @id @default(cuid())
  metricId String
  metric   BrsrEnvironmentalMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)

  stream        String // ENERGY | WATER | EMISSIONS | WASTE
  categoryCode  String // ELECTRICITY_NON_RENEWABLE | GROUNDWATER | PLASTIC_WASTE ...
  categoryLabel String? // frozen so a filed snapshot survives a taxonomy rename

  // flowType / destination are part of the row's unique slot and are therefore
  // NOT NULL with the sentinel "NA" â€” Postgres treats NULLs as distinct, so
  // nullable slot columns would let the same category be inserted unlimited
  // times while the unique constraint silently passed.
  //   WATER: WITHDRAWAL | DISCHARGE | CONSUMPTION | RECYCLED
  //   WASTE: GENERATED | RECYCLED | REUSED | RECOVERED | INCINERATED |
  //          LANDFILLED | OTHER_DISPOSAL
  //   ENERGY / EMISSIONS: "NA" â€” the category alone is the full key
  flowType       String  @default("NA")
  destination    String  @default("NA") // WATER DISCHARGE only
  treatmentLevel String?

  quantity Float?
  unit     String?

  // Emissions derivation, frozen onto the line so revising BrsrEmissionFactor
  // next year cannot silently restate a number that has already been reviewed.
  // computedTCo2e is written by the service, never by the client.
  scope            String?
  emissionFactorId String?
  factorValue      Float?
  factorPerUnit    String?
  factorSource     String?
  computedTCo2e    Float?

  // METER | INVOICE | ESTIMATE | THIRD_PARTY. Defaults to nothing rather than
  // to METER, so an estimate is never mistaken for a reading.
  dataQuality  String?
  evidenceNote String?
  notes        String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique([metricId, stream, categoryCode, flowType, destination], name: "uq_BrsrEnvMetricLine_slot")
  @@index([metricId, stream])
  @@index([categoryCode])
  @@index([flowType])
  @@index([scope])
}

// ═══════════════════════════════════════════════════════════════════════════
//  LOTO — Lockout / Tagout
// ═══════════════════════════════════════════════════════════════════════════
//
//  Two halves that must never be confused:
//
//    LotoProcedure   — the reusable LIBRARY entry. Authored once for a piece of
//                      equipment, reviewed annually, referenced by many jobs.
//    LotoExecution   — one actual lockout EVENT. References a procedure, but
//                      carries a FROZEN SNAPSHOT of it (procedureVersionSnapshot)
//                      taken at start. An in-progress lockout is never re-read
//                      from the live procedure, so an authoring edit mid-job
//                      cannot retroactively change the steps a crew is standing
//                      at the equipment following. That property is the whole
//                      reason the snapshot column exists.
//
//  Versioning: the procedure's editable body lives in the four child tables
//  (energy sources, isolation points, hardware, verification steps). Every
//  material edit to that body writes an immutable LotoProcedureVersion holding
//  a JSON snapshot and bumps LotoProcedure.version. Old versions are RETAINED,
//  never overwritten. `publishedVersionId` points at the version the field is
//  allowed to see — an edit in flight does not reach a QR scanner until it has
//  been re-approved and published.
//
//  House convention followed throughout: references to pre-existing tables
//  (Plant, User, Equipment, Permit) are FK-by-value String columns with
//  denormalised display fields alongside, so a register row never has to
//  render a raw cuid and this module stays additive. Prisma relations are
//  declared only among the LOTO tables themselves.
//
//  Tables are created by prisma/apply-loto-ddl.ts (NEVER `prisma db push` —
//  that drops the hand-DDL tables other modules depend on).

/// A reusable, versioned energy-isolation procedure for one piece of equipment.
model LotoProcedure {
  id            String @id @default(cuid())
  procedureCode String // human-readable, e.g. LOTO-EQ-0142. Unique per site (partial unique index, live rows only)

  siteId   String // FK-by-value to Plant, per house convention
  siteName String? // denormalised — a register row must never render a raw Plant cuid
  area     String?
  areaId   String? // FK-by-value to Area when the caller picked one from the master

  // Equipment master EXISTS in this platform (model Equipment), so this is a
  // real reference to it. The two denormalised fields are NOT a fallback for a
  // missing master — they are how a procedure covers something the master does
  // not carry a row for (a valve station, a cable trench, a common header), and
  // how the register renders without a join.
  equipmentId   String? // FK-by-value to Equipment
  equipmentName String?
  equipmentTag  String?

  title       String
  description String? @db.Text

  // draft | active | under_review | retired
  //   draft        — being authored; never visible to a QR scan
  //   active       — published; publishedVersionId is what the field sees
  //   under_review — a material edit has withdrawn approval. The PREVIOUSLY
  //                  published version remains what a QR scan resolves to, so
  //                  the field is never handed an unapproved isolation sequence.
  //   retired      — withdrawn from use; QR resolves but is flagged
  status String @default("draft")

  version            Int     @default(1)
  publishedVersionId String? // → LotoProcedureVersion.id; null until first publish

  // Immutable once generated (enforced service-side). The public field-access
  // URL is /lockout/{qrCodeToken} — see spec §2.3. NOT /loto/… : that path is
  // the authenticated register, and a public [token] route under it collides
  // with [id] and 500s every page in the app.
  qrCodeToken String? @unique

  // ─── Scheduled evaluation cycle (OSHA 1910.147(c)(6) — annual) ───
  reviewFrequencyMonths Int       @default(12)
  lastReviewedAt        DateTime?
  lastReviewedById      String?
  nextReviewDueAt       DateTime?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Governed entity — soft-delete only (P1-3 platform rule).
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?

  energySources     LotoEnergySource[]
  isolationPoints   LotoIsolationPoint[]
  hardware          LotoHardwareRequirement[]
  verificationSteps LotoVerificationStep[]
  versions          LotoProcedureVersion[]
  executions        LotoExecution[]
  reviewLogs        LotoReviewLog[]

  @@index([siteId, status])
  @@index([equipmentId])
  @@index([nextReviewDueAt, status])
  @@index([isDeleted])
  @@index([createdAt])
}

/// One energy source that must be isolated. Order is presentational; the
/// SEQUENCE that matters for safety is on LotoIsolationPoint.
model LotoEnergySource {
  id          String        @id @default(cuid())
  procedureId String
  procedure   LotoProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  sequence Int @default(0)

  // electrical | mechanical | hydraulic | pneumatic | thermal | chemical | gravity | other
  energyType String

  // Free text so "415 V AC, 3-ph", "7 bar", "180 °C" all record faithfully.
  // A numeric column would force a unit column and still not cover "stored
  // rotational energy in the flywheel".
  magnitude           String?
  locationDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isolationPoints LotoIsolationPoint[]

  @@index([procedureId, sequence])
}

/// One physical isolation point, in the ORDER it must be actioned. Sequence is
/// safety-critical (isolate upstream before downstream), which is why the
/// builder UI treats these as a reorderable list rather than a flat form.
model LotoIsolationPoint {
  id          String        @id @default(cuid())
  procedureId String
  procedure   LotoProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  sequence Int

  energySourceId String?
  energySource   LotoEnergySource? @relation(fields: [energySourceId], references: [id], onDelete: SetNull)

  location           String
  // breaker | valve | blocking | blanking | disconnect | plug | chain | other
  isolationMethod    String
  lockType           String?
  // How zero-energy is proven at THIS point ("try-start from local panel",
  // "gauge reads 0 bar for 60 s"). Distinct from the procedure-level
  // verification steps, which are the ordered sign-off checklist.
  verificationMethod String? @db.Text
  notes              String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([procedureId, sequence])
  @@index([energySourceId])
}

/// Locks, tags, hasps, chains the job needs. A count, not an inventory link —
/// PPE/stores integration is deliberately out of scope for this pass.
model LotoHardwareRequirement {
  id          String        @id @default(cuid())
  procedureId String
  procedure   LotoProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  // lock | tag | hasp | chain | blind | lockbox | other
  itemType         String
  description      String?
  quantityRequired Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([procedureId])
}

/// Ordered zero-energy verification checklist. Each step can demand a photo
/// and/or an explicit sign-off; the execution refuses to reach `verified`
/// until every one has a matching LotoVerificationRecord.
model LotoVerificationStep {
  id          String        @id @default(cuid())
  procedureId String
  procedure   LotoProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  sequence        Int
  stepText        String  @db.Text
  requiresPhoto   Boolean @default(false)
  requiresSignoff Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([procedureId, sequence])
}

/// Immutable snapshot of a procedure body at one version. Written on publish
/// and on every material edit thereafter. This is the audit trail that proves
/// what the procedure said on the day a job was done.
model LotoProcedureVersion {
  id          String        @id @default(cuid())
  procedureId String
  procedure   LotoProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  version Int

  /// Full body: { header{}, energySources[], isolationPoints[], hardware[], verificationSteps[] }
  snapshotJson Json

  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  publishedById String?
  supersededAt  DateTime?

  changeSummary String? @db.Text
  // MATERIAL — isolation points / hardware / verification steps moved.
  // MINOR    — title, description, review cadence only.
  changeType    String  @default("MATERIAL")

  createdById String?
  createdAt   DateTime @default(now())

  executions LotoExecution[]

  @@unique([procedureId, version], name: "uq_LotoProcedureVersion_proc_version")
  @@index([procedureId, isPublished])
}

/// One actual lockout event.
model LotoExecution {
  id     String @id @default(cuid())
  number String @unique // LOTO-EX-{year}-{seq}; max+1, never count+1

  procedureId String
  procedure   LotoProcedure @relation(fields: [procedureId], references: [id])

  procedureVersionId String?
  procedureVersion   LotoProcedureVersion? @relation(fields: [procedureVersionId], references: [id])

  /// FROZEN copy of the procedure body taken at start(). The execution screen,
  /// the verification gate and the close-out report all read THIS, never the
  /// live procedure. See the module header.
  procedureVersionSnapshot Json
  /// The version number inside the snapshot, lifted out so a register row can
  /// show "running v3" without parsing JSON.
  snapshotVersion          Int  @default(1)

  // FK-by-value to Permit (§6). Nullable: most lockouts stand alone.
  ptwId     String?
  ptwNumber String? // denormalised so the register never renders a raw cuid

  siteId   String
  siteName String?

  initiatedById   String
  initiatedByName String?
  initiatedAt     DateTime @default(now())

  isGroupLockout Boolean @default(false)

  // locks_applied | verified | work_in_progress | locks_removed | closed | aborted
  // Deliberately a String, not a Postgres enum: a client-supplied value that is
  // not a member aborts the whole transaction on a native enum (see the
  // agent-platform enum-poisoning incident). Validated in the Pydantic layer,
  // so a bad value is a clean 422.
  status String @default("locks_applied")

  workStartedAt  DateTime?
  locksRemovedAt DateTime?

  closedById   String?
  closedAt     DateTime?
  closureNotes String?   @db.Text

  abortedById String?
  abortedAt   DateTime?
  abortReason String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?

  participants        LotoExecutionParticipant[]
  verificationRecords LotoVerificationRecord[]

  @@index([procedureId, status])
  @@index([siteId, status])
  @@index([ptwId])
  @@index([createdAt])
  @@index([isDeleted])
}

/// One person on a lockout. In a GROUP lockout every row must confirm lock
/// application AND lock removal individually — one person's confirmation never
/// applies to the group. Enforced at the API layer, not just the UI.
model LotoExecutionParticipant {
  id          String        @id @default(cuid())
  executionId String
  execution   LotoExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  userId   String // FK-by-value to User
  userName String? // denormalised — the roster must never render a raw cuid
  userRole String? // the person's platform role, for the roster line

  // primary_authorized | secondary | affected_employee
  //
  // affected_employee is NOT a lock holder — an affected employee is notified,
  // not locked on. Only primary_authorized/secondary rows gate the status
  // transitions; see app/services/loto.py::lock_holders.
  participantRole String @default("secondary")

  /// Which isolation points (by snapshot id) this person is responsible for.
  assignedIsolationPointIds String[]

  lockTagNumber String?

  lockAppliedAt        DateTime?
  lockAppliedConfirmed Boolean   @default(false)
  lockRemovedAt        DateTime?
  lockRemovedConfirmed Boolean   @default(false)

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([executionId, userId], name: "uq_LotoExecutionParticipant_exec_user")
  @@index([executionId])
  @@index([userId])
}

/// One completed zero-energy verification step on one execution.
model LotoVerificationRecord {
  id          String        @id @default(cuid())
  executionId String
  execution   LotoExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  /// Id of the step INSIDE procedureVersionSnapshot — not a live FK to
  /// LotoVerificationStep, which may have been edited or deleted since.
  stepId   String
  sequence Int     @default(0)
  /// Denormalised step text as it read at execution start, so the close-out
  /// report is legible without rehydrating the snapshot.
  stepText String? @db.Text

  completedById   String
  completedByName String?
  completedAt     DateTime @default(now())

  photoUrl String? // storage path (Supabase bucket), resolved to a signed URL on read
  signoff  Boolean @default(false)
  notes    String? @db.Text

  createdAt DateTime @default(now())

  @@unique([executionId, stepId], name: "uq_LotoVerificationRecord_exec_step")
  @@index([executionId])
}

/// Audit trail for the scheduled evaluation cycle. A row is created in `pending`
/// by the daily scheduler when a procedure falls due, and completed by a human.
/// An unattended review escalates into a visible overdue flag — it never lapses
/// silently.
model LotoReviewLog {
  id          String        @id @default(cuid())
  procedureId String
  procedure   LotoProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  // pending | completed
  status String   @default("pending")
  dueAt  DateTime

  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?

  // pass | fail | updated
  outcome String?
  notes   String? @db.Text

  /// Set when outcome = updated — points at the version the review produced.
  newVersionId String?

  notifiedAt DateTime? // owner notification fired (deduped by this column)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([procedureId, status])
  @@index([status, dueAt])
}

// ═══════════════════════════════════════════════════════════════════════════
//  Form & Workflow Engine (Part A) — the no-code form primitive.
//
//  Two tables only. Approvals, tasks, assignees, SLAs and transition history
//  are NOT modelled here: a FormRecord submits into the platform's existing
//  WorkflowDefinition / WorkflowInstance / WorkflowTask engine exactly the way
//  a Permit does, so a form's approvals land in the same inbox as every other
//  module. Attachments reuse the shared `Attachment` table via the evidence
//  registry ("form_record"), so there is no per-form attachment clone either.
//
//  Applied by prisma/apply-form-engine-ddl.ts — NOT by `prisma db push`, which
//  would drop the hand-DDL tables the other modules live in.
// ═══════════════════════════════════════════════════════════════════════════

/// One version of one form template. Versions are ROWS, not a child table:
/// editing a published definition inserts (key, version + 1), and
/// FormRecord.formVersion pins the version a record was created under — so
/// publishing v3 cannot retroactively invalidate a v2 record mid-approval.
model FormDefinition {
  id String @id @default(cuid())

  /// Stable slug shared across versions: 'kaizen', 'sustainability_energy'.
  key     String
  version Int    @default(1)
  /// DRAFT | PUBLISHED | ARCHIVED
  status  String @default("DRAFT")

  title       String
  description String?
  /// Grouping only — 'SUSTAINABILITY', 'BUSINESS_EXCELLENCE'. Not a licence code.
  module      String

  /// The ordered field list. Validated by the publish gate
  /// (services/form_engine/schema.py), not by Prisma.
  schemaJson   Json?
  /// Layout hints (sections, column spans). Never affects validation.
  uiSchemaJson Json?

  /// The value matched against WorkflowDefinition.module when a record submits.
  /// NULL = no approval. Two definitions naming the SAME workflowModule share
  /// one WorkflowDefinition — which is what the four Business Excellence
  /// registers require, at zero engine cost.
  workflowModule     String?
  workflowRecordType String?

  /// e.g. 'KAIZEN-{YYYY}-{####}'. See services/form_engine/numbering.py.
  numberPattern String?

  /// Where this form's data physically lives. {"kind":"NATIVE"} today; the
  /// ENTITY kind binds a definition to a pre-existing platform table (BRSR's
  /// environmental capture, ERM's RootCauseAnalysis) so the engine can sit in
  /// front of a data model it did not create instead of duplicating it.
  storageBinding Json?

  /// {"plantIds": [...]} — which sites may use this form. NULL = every site.
  orgScope Json?

  /// Permission codes are '<prefix>.READ' / '.CREATE' / '.UPDATE' / '.PUBLISH'
  /// / '.DELETE'. Per-definition, so a module gets its own codes without a line
  /// of engine code changing.
  permissionPrefix String @default("FORMS")

  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  publishedById String?
  publishedAt   DateTime?

  // Governed soft-delete: hard-deleting a definition would strand every record
  // that pinned it, leaving the renderer with no schema for the record it holds.
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?

  records FormRecord[]

  @@unique([key, version], name: "uq_FormDefinition_key_version")
  @@index([key, status])
  @@index([module, status])
  @@index([isDeleted])
}

/// One submitted instance of a FormDefinition version.
model FormRecord {
  id String @id @default(cuid())

  definitionId  String
  definition    FormDefinition @relation(fields: [definitionId], references: [id])
  /// Denormalised so a register can filter without a join, and so a record
  /// still identifies its form after the definition is archived.
  definitionKey String
  /// The PINNED version. Validation always runs against this, never the latest.
  formVersion   Int
  module        String

  /// House convention: never render a raw Plant cuid. siteName is frozen at
  /// write time so a closed record keeps the name it was filed under.
  siteId   String
  siteName String?
  areaId   String?

  /// Client-supplied field values, validated against the pinned version.
  dataJson     Json?
  /// Server-derived calculated fields. A separate column from dataJson so a
  /// client POSTing {"co2e_emissions": 0} cannot overwrite a computed
  /// disclosure figure — the merge is one-way by construction.
  computedJson Json?

  /// DRAFT | SUBMITTED | IN_REVIEW | APPROVED | REJECTED | CLOSED
  status      String  @default("DRAFT")
  /// 'KAIZEN-2026-0142'. Assigned on submit, not on draft creation — an
  /// abandoned draft must not burn a number out of the register's sequence.
  referenceNo String?

  /// The existing engine's WorkflowInstance. NULL until submit.
  workflowInstanceId String?

  createdById   String
  createdAt     DateTime  @default(now())
  updatedById   String?
  updatedAt     DateTime  @updatedAt
  submittedById String?
  submittedAt   DateTime?
  closedAt      DateTime?

  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?

  /// Two drafts may both hold a NULL referenceNo (Postgres treats NULLs as
  /// distinct), but two numbered records may never share one.
  @@unique([definitionKey, referenceNo], name: "uq_FormRecord_key_reference")
  @@index([definitionKey, createdAt])
  @@index([siteId, status])
  @@index([module, status])
  @@index([workflowInstanceId])
  @@index([isDeleted])
}

// ─────────────────────────────────────────────────────────────────────────
// Business Excellence — shop-floor improvement registers (Phase 1)
//
// Kaizen, One Point Lesson and Poka Yoke. The BE view of Root Cause Analysis
// reuses the existing RootCauseAnalysis model rather than adding a fourth
// table here — see prisma/apply-be-ddl.ts for the columns that extends.
//
// ⚠ NOT the same thing as the SCI "Kaizen Wall" (KaizenPost). That is the
// Safety Culture Index's anonymous posting board with a rotating committee
// and a points ledger. This is a shop-floor improvement register with a cost,
// a savings figure and an implementation owner. Two products, one Japanese
// word; they are deliberately separate and must not be merged.
//
// References to pre-existing tables (User, Plant, Area) are plain String
// columns rather than Prisma relations — the same additive-only convention
// LOTO and the Form Engine follow, so adding this module cannot change how any
// existing model loads. The one real relation is BeOpl → BeOplAcknowledgement,
// where both ends are new.
//
// Physical DDL is owned by prisma/apply-be-ddl.ts, NOT by `prisma db push`,
// which would drop the hand-DDL tables the other modules live in.
// ─────────────────────────────────────────────────────────────────────────

model BeKaizen {
  id       String  @id @default(cuid())
  /// 'KZN-2026-0001'. Assigned on SUBMIT, not on create — an abandoned draft
  /// must not burn a number out of the register's sequence.
  kaizenNo String?

  /// House rule: never render a raw Plant cuid. siteName/areaName are frozen at
  /// write time so a closed record keeps the labels it was filed under.
  plantId  String
  siteName String?
  areaId   String?
  areaName String?

  title    String
  /// SQCDM axis — SAFETY | QUALITY | COST | DELIVERY | MORALE | PRODUCTIVITY | ENVIRONMENT
  category String
  /// STANDARD (full screening) | FAST_TRACK (the Suggestion Scheme lane)
  lane     String @default("STANDARD")

  /// Free text, not an Equipment FK: a Kaizen is usually raised against a
  /// station or jig that has no master-data row, and demanding one first is how
  /// a suggestion scheme dies.
  lineOrMachine String?
  processStep   String?

  problemStatement    String  @db.Text
  currentState        String? @db.Text
  proposedImprovement String  @db.Text
  expectedBenefit     String? @db.Text

  ownerId            String?
  targetDate         DateTime?
  implementedAt      DateTime?
  implementationNote String?   @db.Text

  /// Cycle-time instrumentation. Stamped on their own transitions only — never
  /// backfilled from updatedAt, which moves on every edit and would turn the
  /// median into a measure of "last touched" rather than "how long screening
  /// took". Rows predating these columns contribute nothing to the median
  /// rather than contributing a fake zero.
  screenedAt DateTime?
  approvedAt DateTime?

  currency              String  @default("INR")
  investmentCost        Float?
  estimatedAnnualSaving Float?
  /// HARD (bookable against a cost centre) | SOFT (real but unbookable)
  savingType            String?

  /// Written by a DIFFERENT person at a different time from the estimate.
  /// Collapsing the two is how a Kaizen programme reports the number the
  /// submitter hoped for rather than the one the plant banked.
  verifiedAnnualSaving Float?
  verifiedById         String?
  verifiedAt           DateTime?
  verificationNote     String?   @db.Text

  /// Horizontal deployment INTENT. Records where this idea ought to go; the
  /// BeKaizenReplication rows record where it actually went.
  yokotenScope Json?

  /// Set on the copy raised at the target plant, pointing back at the original.
  originKaizenId String?

  /// The One Point Lesson generated from this Kaizen on closure — the closed
  /// loop into standard work. Nullable and one-way: an OPL outlives the idea
  /// that prompted it.
  generatedOplId String?

  rewardPoints Int?

  /// Reserved link into the Safety-Culture recognition ledger. NOTHING WRITES
  /// THIS: RecognitionEntry's award categories are observation- and walk-based
  /// and no job scores Kaizen contributions. The column exists so that link has
  /// one home if Recognition is extended, rather than a second recognition
  /// mechanism growing inside Business Excellence.
  recognitionEventId String?

  status             String    @default("DRAFT")
  workflowInstanceId String?
  rejectionReason    String?   @db.Text
  closedAt           DateTime?

  sourceModule    String?
  sourceRecordId  String?
  sourceRecordRef String?

  createdById String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?

  replications BeKaizenReplication[] @relation("KaizenReplications")

  /// kaizenNo is unique PER PLANT and only among LIVE rows — a soft-deleted
  /// record must keep owning its number. Prisma cannot express a partial
  /// unique index, so the constraint itself is created by apply-be-ddl.ts and
  /// only the lookup index is declared here.
  @@index([plantId, kaizenNo])
  @@index([plantId, status])
  @@index([plantId, createdAt])
  @@index([sourceModule, sourceRecordId])
  @@index([ownerId])
  @@index([isDeleted])
  @@index([originKaizenId])
  @@index([generatedOplId])
}

/// One horizontal-deployment event: this idea was taken up at that plant.
///
/// Append-only — no soft-delete columns, no update path. The register's claim
/// ("this idea spread to four plants") is only worth something if the rows
/// behind it cannot be quietly removed when the number looks bad.
model BeKaizenReplication {
  id String @id @default(cuid())

  sourceKaizenId String
  sourceKaizen   BeKaizen @relation("KaizenReplications", fields: [sourceKaizenId], references: [id])

  /// The record raised at the target plant, when one was. Nullable because two
  /// distinct facts are recorded here — "it was deployed there" and "a record
  /// was raised for it there" — and a later import of historical yokoten data
  /// would have the first without the second.
  replicaKaizenId String?

  replicatedAtPlantId   String
  /// Frozen label, same rule as everywhere: a plant renamed next year must not
  /// rewrite last year's history.
  replicatedAtPlantName String?

  replicatedById String
  replicatedAt   DateTime @default(now())
  notes          String?  @db.Text

  /// One idea deploys at one plant once. A second row is the same deployment
  /// recorded twice, and it inflates the one number this table exists to make
  /// trustworthy.
  @@unique([sourceKaizenId, replicatedAtPlantId])
  @@index([sourceKaizenId])
  @@index([replicatedAtPlantId])
  @@index([replicaKaizenId])
}

model BeOpl {
  id    String  @id @default(cuid())
  oplNo String?

  plantId  String
  siteName String?
  areaId   String?
  areaName String?

  title         String
  /// BASIC_KNOWLEDGE | IMPROVEMENT_CASE | TROUBLE_CASE | SAFETY | QUALITY
  category      String
  lineOrMachine String?

  /// The one page. Images live in the shared Attachment table via the evidence
  /// registry ("be_opl"), never inline as base64 — a 4 MB data URI in a TEXT
  /// column is a lesson nobody can load on plant wifi.
  contentHtml String? @db.Text
  /// At most 5 bullets. The cap is the format's whole value.
  keyPoints   Json?

  authorId   String
  approverId String?
  approvedAt DateTime?

  effectiveFrom DateTime?
  reviewDueAt   DateTime?

  /// Published content is immutable. Changing an OPL supersedes it with a new
  /// revision, because an acknowledgement is a claim about SPECIFIC content —
  /// editing the page under people who already signed it turns a training
  /// record into a fiction.
  revision          Int     @default(1)
  supersedesOplId   String?
  supersededByOplId String?

  /// {"roleCodes":[],"areaIds":[],"userIds":[],"allPlant":false} — resolved to
  /// concrete acknowledgement rows ONCE, at publish time, so the percentage is
  /// about the people who were actually asked rather than today's roster.
  audience               Json?
  acknowledgementDueDays Int   @default(14)

  /// Optional Skill Matrix link. Nullable by design — forcing a Competency row
  /// per OPL would make authoring a lesson a taxonomy exercise.
  competencyId String?

  status             String    @default("DRAFT")
  workflowInstanceId String?
  rejectionReason    String?   @db.Text
  publishedAt        DateTime?
  retiredAt          DateTime?

  sourceModule    String?
  sourceRecordId  String?
  sourceRecordRef String?

  createdById String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?

  acknowledgements BeOplAcknowledgement[]

  @@index([plantId, oplNo])
  @@index([plantId, status])
  @@index([plantId, createdAt])
  @@index([reviewDueAt])
  @@index([competencyId])
  @@index([isDeleted])
}

/// One person's obligation to read one revision of one OPL.
///
/// Deliberately NOT TrainingAssignment. That table is structurally close —
/// person, source record, due date, escalation, completion evidence — but its
/// competencyId is NOT NULL, so reusing it would mean inventing a Competency
/// for every OPL ever written. This takes its escalation shape and leaves the
/// table alone.
///
/// No soft-delete columns: an acknowledgement is an immutable claim about what
/// someone was asked to read and whether they did.
model BeOplAcknowledgement {
  id String @id @default(cuid())

  oplId String
  opl   BeOpl  @relation(fields: [oplId], references: [id], onDelete: Cascade)
  /// Pinned, so the row still says WHICH content was acknowledged after the OPL
  /// is superseded.
  oplRevision Int @default(1)

  personUserId String
  plantId      String

  assignedAt     DateTime  @default(now())
  dueAt          DateTime?
  readAt         DateTime?
  acknowledgedAt DateTime?

  /// ASSIGNED | READ | ACKNOWLEDGED | WAIVED. OVERDUE is DERIVED at read time,
  /// never stored — a stored flag needs a job and is wrong for as long as that
  /// job is broken.
  status              String  @default("ASSIGNED")
  acknowledgementNote String? @db.Text

  quizScore    Float?
  quizPassedAt DateTime?

  escalatedAt       DateTime?
  escalatedToUserId String?

  competencyRecordId String?

  waivedById   String?
  waivedReason String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One obligation per person per revision. Re-publishing as a NEW revision
  /// creates a new row rather than resetting this one, so the history of who
  /// read what stays intact.
  @@unique([oplId, personUserId, oplRevision], name: "uq_BeOplAck_opl_person_rev")
  @@index([personUserId, status])
  @@index([plantId, status])
  @@index([dueAt])
}

model BePokaYoke {
  id       String  @id @default(cuid())
  deviceNo String?

  plantId       String
  siteName      String?
  areaId        String?
  areaName      String?
  lineOrMachine String?
  processStep   String?

  title               String
  defectModePrevented String  @db.Text
  description         String? @db.Text

  /// CONTACT | FIXED_VALUE | MOTION_STEP (Shingo's classification)
  deviceType   String
  /// PREVENTION makes the defect impossible; DETECTION only catches it after.
  /// A register that does not separate them cannot say how mistake-proofed a
  /// line actually is.
  approach     String
  /// CONTROL stops the process; WARNING signals a human and relies on them.
  reactionMode String

  beforeCondition String? @db.Text
  afterCondition  String? @db.Text

  ownerId     String?
  currency    String    @default("INR")
  cost        Float?
  installedAt DateTime?

  /// SHIFT | DAILY | WEEKLY | MONTHLY | QUARTERLY | ANNUAL
  verificationFrequency  String    @default("MONTHLY")
  lastVerifiedAt         DateTime?
  lastVerificationResult String?
  nextVerificationDueAt  DateTime?

  /// A bypassed device is still FITTED, which is why this is a flag and not a
  /// status — a register that showed it as removed would understate how much
  /// mistake-proofing the line has lost.
  isBypassed         Boolean   @default(false)
  bypassReason       String?   @db.Text
  bypassedAt         DateTime?
  bypassedById       String?
  bypassApprovedById String?

  status             String    @default("PROPOSED")
  workflowInstanceId String?
  rejectionReason    String?   @db.Text
  retiredAt          DateTime?

  /// Where the device came from — an improvement idea, or the permanent
  /// countermeasure of an RCA (8D's D5/D6).
  sourceKaizenId String?
  sourceRcaId    String?

  createdById String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?

  verifications BePokaYokeVerification[]
  bypasses      BePokaYokeBypass[]

  @@index([plantId, deviceNo])
  @@index([plantId, status])
  @@index([plantId, createdAt])
  @@index([plantId, nextVerificationDueAt])
  @@index([isBypassed])
  @@index([sourceKaizenId])
  @@index([isDeleted])
}

/// One periodic check that a device still functions. Append-only: evidence that
/// can be edited after the fact is not evidence. A device that failed and was
/// fixed gets a second PASS row, never an edited FAIL.
model BePokaYokeVerification {
  id String @id @default(cuid())

  deviceId String
  device   BePokaYoke @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  plantId  String

  verifiedById String
  verifiedAt   DateTime @default(now())
  /// PASS | FAIL
  result       String
  note         String?  @db.Text

  /// The due date this check was answering, so a late verification is still
  /// attributable to the cycle it belonged to.
  dueAt DateTime?

  /// Set when a FAIL auto-raised a CAPA through services/capa_spawn.py.
  capaId String?

  createdAt DateTime @default(now())

  @@index([deviceId, verifiedAt])
  @@index([plantId, result])
  @@index([capaId])
}

/// One period during which a device was deliberately overridden.
///
/// Replaces the five flat bypass columns on BePokaYoke as the record of truth.
/// Those columns worked until somebody ENDED a bypass: `/restore` NULLed the
/// timestamp and both user references, so a device bypassed and restored ten
/// times kept one reason string, no dates and no names. How often a device is
/// switched off, and for how long, is the question an auditor actually asks —
/// and it was unanswerable by construction.
///
/// Append-only. A bypass is closed by stamping `restoredAt`, never deleted. The
/// device's `isBypassed` flag survives as a cache of the currently-open episode
/// so the register does not need a join per row to answer a boolean.
model BePokaYokeBypass {
  id String @id @default(cuid())

  deviceId String
  device   BePokaYoke @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  plantId  String

  bypassedById String
  bypassedAt   DateTime @default(now())
  /// NOT NULL by design — a bypass with no stated reason records that
  /// protection was removed and nobody has to own why.
  reason       String   @db.Text
  approvedById String?

  /// The device's lifecycle status at the moment it was bypassed, so a restore
  /// can put it back honestly rather than guessing.
  statusAtBypass String?

  restoredAt   DateTime?
  restoredById String?
  restoreNote  String?   @db.Text

  createdAt DateTime @default(now())

  @@index([deviceId, bypassedAt])
  @@index([plantId, restoredAt])
  /// ⚠ The real "one open bypass per device" guard is a PARTIAL unique index
  /// (WHERE "restoredAt" IS NULL) that Prisma cannot express — it is created in
  /// prisma/apply-poka-yoke-bypass-ddl.ts. This plain index is only the lookup.
  @@index([deviceId, restoredAt])
}

// ─────────────────────────────────────────────────────────────────────────
// BUSINESS EXCELLENCE — PHASE 2
// Suggestion Scheme (§3), Quality Circle (§6), Structured Improvement Project
// (§7) and the shared benefit-realisation layer (§2/§6/§7/§8) from
// docs/be/BE_Module_Functional_Scope.md.
//
// Same additive-only convention as Phase 1: references to pre-existing tables
// (User, Plant, Area) are plain String columns rather than Prisma relations, so
// adding this module cannot change how any existing model loads. Real relations
// only where both ends are new.
//
// Physical DDL is owned by prisma/apply-be-p2-ddl.ts, NOT by `prisma db push`,
// which would drop the hand-DDL tables the other modules live in. The partial
// unique indexes (WHERE isDeleted = false, WHERE leftAt IS NULL) cannot be
// expressed here at all and live only in that script.
// ─────────────────────────────────────────────────────────────────────────

model BeSuggestion {
  id           String  @id @default(cuid())
  /// 'SGN-2026-0001'. Assigned on SUBMIT, not on create.
  suggestionNo String?

  plantId  String
  siteName String?
  areaId   String?
  areaName String?

  /// §3 is broader than Kaizen — "not limited to process-floor issues" — so
  /// there is deliberately no lineOrMachine or processStep here.
  title           String
  category        String
  description     String  @db.Text
  expectedBenefit String? @db.Text

  /// ANONYMITY IS A RENDERING RULE, NOT A MISSING COLUMN. createdById is set
  /// even when this is true; the router suppresses it for every reader except
  /// the submitter. §8 requires an immutable audit trail and §3 requires the
  /// decision rationale to be "visible to the submitter" — neither is possible
  /// if the identity is discarded.
  isAnonymous Boolean @default(false)

  /// Stage one of §3's two-stage decision — RELEVANT | NOT_RELEVANT | DUPLICATE
  screeningOutcome        String?
  screeningNote           String?   @db.Text
  screenedById            String?
  screenedAt              DateTime?
  duplicateOfSuggestionId String?

  /// Stage two — ACCEPT | REJECT | DEFER
  decision          String?
  /// Required on EVERY outcome, including acceptances (§3).
  decisionRationale String?   @db.Text
  decidedById       String?
  decidedAt         DateTime?
  deferredUntil     DateTime?

  ownerId            String?
  targetDate         DateTime?
  implementedAt      DateTime?
  implementationNote String?   @db.Text

  /// Tracked only — payout/payroll integration is out of scope.
  incentiveStatus       String    @default("NOT_APPLICABLE")
  incentivePoints       Int?
  incentiveAmount       Float?
  currency              String    @default("INR")
  incentiveNote         String?   @db.Text
  incentiveApprovedById String?
  incentiveApprovedAt   DateTime?

  status             String    @default("DRAFT")
  workflowInstanceId String?
  rejectionReason    String?   @db.Text
  closedAt           DateTime?

  /// Set when an accepted suggestion was escalated into a full Kaizen. The link
  /// is what stops one idea being counted twice on the §8 dashboard.
  convertedToKaizenId String?

  sourceModule    String?
  sourceRecordId  String?
  sourceRecordRef String?

  createdById String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?

  @@index([plantId, status])
  @@index([plantId, createdAt])
  @@index([sourceModule, sourceRecordId])
  @@index([createdById])
  @@index([suggestionNo])
}

model BeQccTeam {
  id     String  @id @default(cuid())
  /// 'QCC-2026-0001'. Assigned on CREATE, unlike the registers — the number IS
  /// the circle's identity and appears on a certificate long before it has a
  /// project to show.
  teamNo String?

  plantId  String
  siteName String?
  areaId   String?
  areaName String?

  name       String
  department String?
  motto      String? @db.Text

  /// Also carried as membership rows, so "who was in this circle" has one
  /// answer. Pinned here because a circle without a leader is not a circle.
  leaderId      String?
  facilitatorId String?

  formedOn    DateTime?
  disbandedOn DateTime?

  status String @default("FORMING")

  createdById String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?

  members  BeQccTeamMember[]
  projects BeQccProject[]

  @@index([plantId, status])
  @@index([plantId, createdAt])
  @@index([teamNo])
}

model BeQccTeamMember {
  id String @id @default(cuid())

  teamId String
  team   BeQccTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  userId     String
  memberRole String @default("MEMBER")

  joinedAt DateTime  @default(now())
  /// Stood down, never deleted: the separation-of-duties check on benefit
  /// validation has to know who was EVER in the circle, not just who is today.
  leftAt   DateTime?

  createdAt DateTime @default(now())

  @@index([teamId, userId])
  @@index([userId])
}

model BeQccProject {
  id        String  @id @default(cuid())
  /// 'QCP-2026-0001'. Assigned at CHARTER.
  projectNo String?

  teamId String
  team   BeQccTeam @relation(fields: [teamId], references: [id], onDelete: Restrict)

  plantId  String
  siteName String?
  areaId   String?
  areaName String?

  title            String
  category         String
  problemStatement String @db.Text

  selectionRationale String?   @db.Text
  priorityScore      Float?
  scope              String?   @db.Text
  baselineMetric     String?
  baselineValue      Float?
  targetValue        Float?
  metricUnit         String?
  targetDate         DateTime?
  charteredAt        DateTime?

  /// DMAIC | PDCA. Stage rows are materialised from this at charter time, which
  /// is why it cannot be changed afterwards.
  methodology String @default("DMAIC")

  /// The SHARED RootCauseAnalysis. §6: "no separate RCA tool or duplicate
  /// record" — there is no cause, 5-why or fishbone column anywhere under QCC.
  rcaId String?

  /// §6 evaluation — a configurable rubric field. Convention and competition
  /// management is explicitly out of scope.
  evaluationRubric Json?
  evaluationScore  Float?
  evaluatedById    String?
  evaluatedAt      DateTime?
  presentedAt      DateTime?
  presentationRef  String?

  actualValue Float?
  completedAt DateTime?

  status             String    @default("DRAFT")
  workflowInstanceId String?
  rejectionReason    String?   @db.Text
  closedAt           DateTime?

  sourceModule    String?
  sourceRecordId  String?
  sourceRecordRef String?

  createdById String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?

  stages BeQccProjectStage[]

  @@index([plantId, status])
  @@index([plantId, createdAt])
  @@index([teamId, status])
  @@index([rcaId])
  @@index([projectNo])
}

model BeQccProjectStage {
  id String @id @default(cuid())

  projectId String
  project   BeQccProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plantId   String

  /// DEFINE|MEASURE|ANALYZE|IMPROVE|CONTROL, or PLAN|DO|CHECK|ACT.
  stage    String
  sequence Int    @default(0)

  status  String  @default("NOT_STARTED")
  summary String? @db.Text

  startedAt     DateTime?
  targetDate    DateTime?
  signedOffById String?
  signedOffAt   DateTime?
  signOffNote   String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, stage], name: "uq_BeQccStage_project_stage")
  @@index([projectId, sequence])
  @@index([status])
}

model BeSip {
  id    String  @id @default(cuid())
  /// 'SIP-2026-0001'. Assigned on SUBMIT.
  sipNo String?

  plantId    String
  siteName   String?
  areaId     String?
  areaName   String?
  department String?

  title            String
  category         String
  scope            String  @db.Text
  problemStatement String? @db.Text

  /// §7 names both roles separately and they do different jobs. The API refuses
  /// a SIP where they are the same person — it would remove the independent
  /// voice the benefit sign-off later depends on.
  sponsorId String?
  ownerId   String?

  metricName    String?
  metricUnit    String?
  baselineValue Float?
  targetValue   Float?
  /// Denormalised off BeBenefitReading so the portfolio list needs no
  /// correlated subquery. The readings table stays the source of truth;
  /// services/business_excellence_p2.record_reading() is the only writer.
  latestActualValue Float?
  latestReadingAt   DateTime?

  startDate   DateTime?
  targetDate  DateTime?
  completedAt DateTime?

  /// §7 "Feasibility and impact scoring used to prioritize competing SIPs".
  /// priorityScore is their product, computed once so the portfolio sorts on
  /// one comparable number.
  feasibilityScore Float?
  impactScore      Float?
  priorityScore    Float?

  lessonsLearned      String? @db.Text
  /// Set when the lessons-learned note was published to the floor as an OPL.
  lessonsLearnedOplId String?

  currency       String @default("INR")
  investmentCost Float?

  rcaId String?

  status             String    @default("DRAFT")
  workflowInstanceId String?
  rejectionReason    String?   @db.Text
  holdReason         String?   @db.Text
  closedAt           DateTime?

  sourceModule    String?
  sourceRecordId  String?
  sourceRecordRef String?

  createdById String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?

  milestones BeSipMilestone[]

  @@index([plantId, status])
  @@index([plantId, createdAt])
  @@index([ownerId, status])
  @@index([priorityScore])
  @@index([sipNo])
}

model BeSipMilestone {
  id String @id @default(cuid())

  sipId   String
  sip     BeSip  @relation(fields: [sipId], references: [id], onDelete: Cascade)
  plantId String

  name        String
  description String? @db.Text
  sequence    Int     @default(0)

  ownerId String?
  /// NEVER overwritten once the project is approved. Slippage is recorded on
  /// revisedDate — a tracker that lets the plan follow the actuals always
  /// reports green.
  plannedDate DateTime?
  revisedDate DateTime?
  actualDate  DateTime?

  status          String  @default("NOT_STARTED")
  progressPercent Int?
  note            String? @db.Text

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sipId, sequence])
  @@index([plantId, plannedDate])
  @@index([ownerId])
}

model BeBenefit {
  id String @id @default(cuid())

  plantId  String
  siteName String?

  /// KAIZEN | SUGGESTION | OPL | POKA_YOKE | QCC | SIP. One table for all six
  /// workflows, because §8 wants "cumulative benefit realised across all six" on
  /// one dashboard and five per-register savings columns cannot be summed
  /// without five UNIONs that drift.
  sourceType String
  sourceId   String
  sourceRef  String?

  benefitType String
  /// FINANCIAL carries a currency; NON_FINANCIAL carries a unit. Exactly one is
  /// meaningful, the schema validates which, and the rollup keeps them apart —
  /// adding rupees to parts-per-million produces a number that means nothing.
  valueKind String  @default("FINANCIAL")
  currency  String?
  unit      String?

  projectedValue Float?
  realizedValue  Float?
  /// Written by the caller, never inferred — guessing a periodicity is how a
  /// benefit total inflates twelvefold.
  annualisedValue Float?

  /// §6's configurable follow-up window (1/3/6/12 months).
  validationWindowMonths Int?
  validationDueAt        DateTime?
  validatedById          String?
  validatedAt            DateTime?
  validationNote         String?   @db.Text
  /// §6 "a designated validating authority (e.g. finance or plant operations)".
  validatingAuthorityId String?

  status String  @default("PROJECTED")
  note   String? @db.Text

  createdById String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?

  readings BeBenefitReading[]

  @@index([sourceType, sourceId])
  @@index([plantId, status])
  @@index([plantId, validationDueAt])
  @@index([validatingAuthorityId])
}

model BeBenefitReading {
  id String @id @default(cuid())

  benefitId String
  benefit   BeBenefit @relation(fields: [benefitId], references: [id], onDelete: Cascade)
  plantId   String

  readingAt DateTime @default(now())
  /// Free text ("2026-07", "FY26-Q2") because plants report on calendars this
  /// platform does not model.
  periodLabel String?

  actualValue Float
  targetValue Float?
  note        String? @db.Text

  recordedById String
  createdAt    DateTime @default(now())

  @@index([benefitId, readingAt])
  @@index([plantId])
}
