// SafeOps360 — EHS Management System for Star Cement India
// Prisma schema (PostgreSQL / Supabase)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_SYNC")
}

// ─────────────────────────────────────────────────────────────────────
//  CORE — Users, Plants, Departments, Employees
// ─────────────────────────────────────────────────────────────────────

// Role is now a master table (was a Prisma enum). User.role stores the role's
// `code` as a String — keeping every existing string comparison
// (`role === "ADMIN"`, `where: { role: "HSE_MANAGER" }`) working unchanged.
// The master table drives the Configuration → Roles UI and lets clients add
// custom roles without a code release.
model Role {
  id             String   @id @default(cuid())
  code           String   @unique // "WORKER" | "HSE_MANAGER" | "ENVIRONMENT_MANAGER" etc.
  name           String
  description    String?
  isSystem       Boolean  @default(false) // system roles cannot be deleted via UI
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  defaultLanding String? // optional landing path post-login
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

// User-Role-Scope assignment. Multi-row per user supports multi-role users
// (e.g., HSE Manager for Lumshnong plus Environment Manager for the same).
// scopeType + scopeValue narrow the role's effect to a plant or department.
model UserRole {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("UserRoleAssignments", fields: [userId], references: [id], onDelete: Cascade)
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  scopeType    String? // PLANT | DEPARTMENT | null (= global)
  scopeValue   String? // plantId / departmentName when scoped
  validFrom    DateTime?
  validTo      DateTime?
  assignedAt   DateTime  @default(now())
  assignedById String?
  assignedBy   User?     @relation("UserRoleAssignedBy", fields: [assignedById], references: [id])

  @@unique([userId, roleId, scopeType, scopeValue])
  @@index([userId])
  @@index([roleId])
}

// One-row-per-action permission codes. e.g. PTW.CREATE, OBSERVATION.APPROVE.
// module + action are denormalised from the code for efficient grouping in
// the admin matrix UI.
model Permission {
  id          String   @id @default(cuid())
  code        String   @unique // {MODULE}.{ACTION}
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

// Joins Role × Permission with a scope. scope answers the question
// "for which records does this role have this permission?":
//   ALL_PLANTS     — corporate-wide
//   OWN_PLANT      — only records at the user's plant
//   OWN_DEPARTMENT — only records at the user's department
//   OWN_RECORDS    — only records the user authored / is named on
// conditions JSON allows future record-attribute filters (e.g., severity).
model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  scope        String     @default("OWN_PLANT") // ALL_PLANTS | OWN_PLANT | OWN_DEPARTMENT | OWN_RECORDS
  conditions   Json?

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String
  passwordHash       String
  // Role code (FK by value to Role.code, not enforced in DB to keep migration simple)
  role               String   @default("WORKER")
  plantId            String?
  plant              Plant?   @relation(fields: [plantId], references: [id])
  designation        String?
  department         String?
  // ─── Safety-roster gate (Observation deroster workflow) ───
  // active | pending_safety_review | derostered. Anything other than `active`
  // excludes this person from NEW work assignment (PTW crew, EPC mobilisation,
  // gate clearance); it never affects login or existing records. Written only
  // by app/services/observation_deroster.py.
  rosterStatus       String   @default("active")
  currentDerosterRef String?
  createdAt          DateTime @default(now())

  observationsInvolved ObservationWorkerInvolved[] @relation("ObservationWorkerInvolvedUser")
  severityOverrides    SeverityOverrideLog[]

  observations             Observation[]
  observationsResponsible  Observation[]            @relation("ObservationResponsiblePerson")
  nearMisses               NearMiss[]
  nearMissesActionOwner    NearMiss[]               @relation("NearMissActionOwner")
  // Near Miss — refactor relations
  nearMissesSuggestedOwner NearMiss[]               @relation("NearMissSuggestedOwner")
  nearMissPersonInvolved   NearMissPersonInvolved[] @relation("NearMissPersonInvolved")
  nearMissPersonAffected   NearMissPersonAffected[] @relation("NearMissPersonAffected")
  nearMissWitness          NearMissWitness[]        @relation("NearMissWitness")
  nearMissCapas            NearMissCapa[]           @relation("NearMissCapaOwner")
  nearMissCapasVerified    NearMissCapa[]           @relation("NearMissCapaVerifier")
  nearMissAttachments      NearMissAttachment[]     @relation("NearMissAttachmentUploader")
  nearMissComments         NearMissComment[]        @relation("NearMissCommentAuthor")
  permits                  Permit[]                 @relation("PermitOriginator")
  permitsIssuer            Permit[]                 @relation("PermitIssuer")
  permitsReceiver          Permit[]                 @relation("PermitReceiver")
  flras                    FLRA[]
  flrasToolboxTalkBy       FLRA[]                   @relation("FLRAToolboxTalkBy")
  flraTeamMemberships      FLRATeamMember[]
  flraCrewSignatures       FLRACrewSignature[]
  permitCrewMemberships    PermitCrewMember[]

  // RBAC
  userRoles                UserRole[]                    @relation("UserRoleAssignments")
  userRolesAssignedByMe    UserRole[]                    @relation("UserRoleAssignedBy")
  incidents                Incident[]
  incidentInvestigations   IncidentInvestigationMember[]
  trainingRecords          TrainingRecord[]
  trainingRecordsAsTrainer TrainingRecord[]              @relation("TrainerRecords")

  // Training production-depth — inverse relations
  trainingProgramsApproved                  TrainingProgram[]         @relation("TrainingProgramApprover")
  trainingProgramsOwned                     TrainingProgram[]         @relation("TrainingProgramOwner")
  trainingSchedulesAsTrainer                TrainingSchedule[]        @relation("ScheduleTrainer")
  trainingSchedulesCreated                  TrainingSchedule[]        @relation("ScheduleCreator")
  trainingSchedulesApproved                 TrainingSchedule[]        @relation("ScheduleApprover")
  trainingSessionsAsTrainer                 TrainingSession[]         @relation("SessionTrainer")
  trainingRegistrations                     TrainingRegistration[]    @relation("RegistrationUser")
  trainingRegistrationsNominated            TrainingRegistration[]    @relation("RegistrationNominator")
  trainingRegistrationsApproved             TrainingRegistration[]    @relation("RegistrationApprover")
  trainingAttendancesCaptured               TrainingAttendance[]      @relation("AttendanceCapturer")
  trainingAssessmentsAssessed               TrainingAssessment[]      @relation("AssessmentAssessor")
  trainingCertificatesHeld                  TrainingCertificate[]     @relation("CertificateHolder")
  trainingCertificatesIssued                TrainingCertificate[]     @relation("CertificateIssuer")
  trainingCertificatesRevoked               TrainingCertificate[]     @relation("CertificateRevoker")
  trainingCertificatesEffectivenessReviewed TrainingCertificate[]     @relation("CertificateEffectivenessReviewer")
  inspections                               Inspection[]
  inspectionsAsReviewer                     Inspection[]              @relation("InspectionReviewer")
  inspectionsAsCloser                       Inspection[]              @relation("InspectionCloser")
  inspectionsDeferredByMe                   Inspection[]              @relation("InspectionDeferredBy")
  checklistTemplatesAuthored                ChecklistTemplate[]       @relation("ChecklistTemplateAuthor")
  checklistTemplatesApproved                ChecklistTemplate[]       @relation("ChecklistTemplateApprover")
  equipmentInspectionTypeAssignments        EquipmentInspectionType[] @relation("EqInspectionTypeInspector")
  inspectionItemResultsCaptured             InspectionItemResult[]    @relation("ItemResultCapturer")
  inspectionFindingsOwned                   InspectionFinding[]       @relation("FindingOwner")
  inspectionFindingsClosed                  InspectionFinding[]       @relation("FindingCloser")
  inspectionFindingsVerified                InspectionFinding[]       @relation("FindingVerifier")
  inspectionFindingsEffectivenessReviewed   InspectionFinding[]       @relation("FindingEffectivenessReviewer")
  inspectionFindingCapasOwned               InspectionFindingCapa[]   @relation("FindingCapaOwner")
  inspectionFindingCapasCompleted           InspectionFindingCapa[]   @relation("FindingCapaCompleter")
  inspectionFindingCapasVerified            InspectionFindingCapa[]   @relation("FindingCapaVerifier")
  incidentAttachments                       IncidentAttachment[]
  observationAttachments                    ObservationAttachment[]

  // Coaching / counselling tasks spawned by post-closure rules (Rule 6)
  coachingsAsPerson CoachingTask[] @relation("CoachingPerson")
  coachingsAssigned CoachingTask[] @relation("CoachingAssignee")

  // AnomalyDetectionAgent — person-of-concern subjects + anomaly reviewers
  anomaliesAsSubject Anomaly[] @relation("AnomalySubject")
  anomaliesReviewed  Anomaly[] @relation("AnomalyReviewer")

  // Workflow engine relations
  workflowsInitiated     WorkflowInstance[]          @relation("WorkflowInitiator")
  workflowHistory        WorkflowHistory[]           @relation("WorkflowActor")
  workflowTasks          WorkflowTask[]              @relation("WorkflowAssignee")
  workflowStepsApproving WorkflowStep[]              @relation("WorkflowStepSpecificApprover")
  workflowVersionsEdited WorkflowDefinitionVersion[] @relation("WorkflowVersionEditor")

  // Incident production-depth refactor — inverse relations for each role
  // a user can play across the new child models. Each relation has a
  // unique field name + matching @relation("...") tag so Prisma can
  // disambiguate the multiple FKs that point back to User.
  incidentPersonRecords      IncidentPerson[]           @relation("IncidentPersonUser")
  incidentClassifications    Incident[]                 @relation("IncidentClassifier")
  incidentInvestigationsLead Incident[]                 @relation("IncidentInvestigationLead")
  incidentReclassifications  IncidentReclassification[] @relation("IncidentReclassifier")
  incidentEvidenceCollected  IncidentEvidence[]         @relation("EvidenceCollector")
  incidentWitnessStatements  IncidentWitnessStatement[] @relation("WitnessUser")
  incidentStatementsTaken    IncidentWitnessStatement[] @relation("StatementTaker")
  incidentCapasOwned         IncidentCapa[]             @relation("IncidentCapaOwner")
  incidentCapasVerified      IncidentCapa[]             @relation("IncidentCapaVerifier")
  incidentComments           IncidentComment[]          @relation("IncidentCommentAuthor")

  // PTW + FLRA refactor — inverse relations for new role assignments
  permitsAsFireWatch        Permit[]                 @relation("PermitFireWatch")
  permitsAsStandby          Permit[]                 @relation("PermitStandby")
  permitGasReadings         PermitGasTestReading[]   @relation("PermitGasTestRecorder")
  permitApprovalsLogged     PermitApproval[]         @relation("PermitApprover")
  permitsSuspendedByMe      PermitSuspension[]       @relation("PermitSuspendedBy")
  permitsResumedByMe        PermitSuspension[]       @relation("PermitResumedBy")
  permitExtensionsRequested PermitExtension[]        @relation("PermitExtensionRequester")
  permitExtensionsApproved  PermitExtension[]        @relation("PermitExtensionApprover")
  permitAttachmentsUploaded PermitAttachment[]       @relation("PermitAttachmentUploader")
  permitComments            PermitComment[]          @relation("PermitCommentAuthor")
  permitActionEvidence      PermitActionEvidence[]   @relation("PermitEvidenceActor")
  flraFitnessDeclarations   FLRAFitnessDeclaration[] @relation("FlraFitnessDeclarant")
  flraAttachmentsUploaded   FLRAAttachment[]         @relation("FlraAttachmentUploader")

  // Manhours production-depth — Commit 1
  // Multiple FKs from ManhoursSubmission point back to User (submitter,
  // reviewer, locker) — each needs a unique relation tag. Same for the
  // two-FK ManhoursUnlockEvent (unlocker + reLocker).
  manhoursSubmissionsSubmitted  ManhoursSubmission[]  @relation("ManhoursSubmitter")
  manhoursSubmissionsReviewed   ManhoursSubmission[]  @relation("ManhoursReviewer")
  manhoursSubmissionsLocked     ManhoursSubmission[]  @relation("ManhoursLocker")
  manhoursUnlockEventsInitiated ManhoursUnlockEvent[] @relation("ManhoursUnlocker")
  manhoursUnlockEventsReLocked  ManhoursUnlockEvent[] @relation("ManhoursReLocker")
  manhoursAttachmentsUploaded   ManhoursAttachment[]  @relation("ManhoursAttachmentUploader")
  manhoursCommentsAuthored      ManhoursComment[]     @relation("ManhoursCommentAuthor")

  // Agent infrastructure — Commit 1 of the user-initiated agent platform
  // (separate from the workflow-rule-triggered TriageAgent / Lessons agent,
  // which write to Observation.closureTriggers JSON and do not invoke here).
  agentPromptsCreated       AgentPrompt[]     @relation("AgentPromptCreator")
  agentPromptsApproved      AgentPrompt[]     @relation("AgentPromptApprover")
  agentInvocationsTriggered AgentInvocation[] @relation("AgentInvocationUser")
  agentInvocationsDecided   AgentInvocation[] @relation("AgentInvocationDecider")

  // HIRA — Phase 1 of IMS expansion. The risk register module ties studies,
  // entries, review cycles, versions, and CAPA child rows back to the user
  // who created/edited/approved/owns each artefact.
  hiraStudiesCreated           HiraStudy[]                   @relation("HiraStudyCreator")
  hiraStudiesUpdated           HiraStudy[]                   @relation("HiraStudyUpdater")
  hiraStudiesApproved          HiraStudy[]                   @relation("HiraStudyApprover")
  hiraStudiesLed               HiraStudy[]                   @relation("HiraStudyTeamLeader")
  hiraStudyMemberships         HiraStudyTeamMember[]         @relation("HiraStudyTeamMemberUser")
  hiraStudyAttachments         HiraStudyAttachment[]         @relation("HiraStudyAttachmentUploader")
  hiraEntriesCreated           HiraEntry[]                   @relation("HiraEntryCreator")
  hiraEntriesUpdated           HiraEntry[]                   @relation("HiraEntryUpdater")
  hiraRecommendedControlsOwned HiraEntryRecommendedControl[] @relation("HiraRecommendedControlOwner")
  hiraReviewCyclesAssigned     HiraReviewCycle[]             @relation("HiraReviewAssignee")
  hiraReviewCyclesCompleted    HiraReviewCycle[]             @relation("HiraReviewCompleter")
  hiraVersionsCreated          HiraVersion[]                 @relation("HiraVersionCreator")
  hiraCapasOwned               HiraCapa[]                    @relation("HiraCapaOwner")
  hiraCapasVerified            HiraCapa[]                    @relation("HiraCapaVerifier")

  // CAPA generalization — unified Capa table replaces (eventually) the 4
  // existing CAPA child tables. User can be: raiser, primary owner,
  // contributor, action owner, RCA completer, verifier, closure approver.
  capasRaised             Capa[]            @relation("CapaRaisedBy")
  capasOwned              Capa[]            @relation("CapaPrimaryOwner")
  capasUpdated            Capa[]            @relation("CapaUpdatedBy")
  capasRcaCompleted       Capa[]            @relation("CapaRcaCompletedBy")
  capasVerified           Capa[]            @relation("CapaVerifiedBy")
  capasClosed             Capa[]            @relation("CapaClosedBy")
  capaActionsOwned        CapaAction[]      @relation("CapaActionOwner")
  capaActionsApproved     CapaAction[]      @relation("CapaActionApprover")
  capaContributorRoles    CapaContributor[] @relation("CapaContributorUser")
  capaAttachmentsUploaded CapaAttachment[]  @relation("CapaAttachmentUploader")
  capaCommentsAuthored    CapaComment[]     @relation("CapaCommentAuthor")

  // EAI — Phase 2 of IMS (Environmental Aspect & Impact register).
  // Mirrors HIRA back-relation layout; one row per EAI artefact a user
  // touches as creator/updater/approver/team-member/reviewer/owner.
  eaiStudiesCreated        EaiStudy[]           @relation("EaiStudyCreator")
  eaiStudiesUpdated        EaiStudy[]           @relation("EaiStudyUpdater")
  eaiStudiesApproved       EaiStudy[]           @relation("EaiStudyApprover")
  eaiStudiesLed            EaiStudy[]           @relation("EaiStudyTeamLeader")
  eaiStudyMemberships      EaiStudyTeamMember[] @relation("EaiStudyTeamMemberUser")
  eaiEntriesCreated        EaiEntry[]           @relation("EaiEntryCreator")
  eaiEntriesUpdated        EaiEntry[]           @relation("EaiEntryUpdater")
  eaiReviewCyclesAssigned  EaiReviewCycle[]     @relation("EaiReviewAssignee")
  eaiReviewCyclesCompleted EaiReviewCycle[]     @relation("EaiReviewCompleter")
  eaiVersionsCreated       EaiVersion[]         @relation("EaiVersionCreator")

  // EPC — Construction Site management
  sitesManaged          ConstructionSite[]   @relation("SiteManager")
  sitesHseManaged       ConstructionSite[]   @relation("SiteHseManager")
  sitesCorpHseOwned     ConstructionSite[]   @relation("SiteCorpHse")
  mobilizationsApproved MobilizationRecord[] @relation("MobApprover")
  inductionsConducted   SiteInduction[]      @relation("InductionConductor")
  gateOverrides         GateClearanceCheck[] @relation("GateOverrideUser")
}

model Plant {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  location  String
  state     String
  unitType  String // "Integrated", "Grinding", "Packing"
  createdAt DateTime @default(now())

  users               User[]
  areas               Area[]
  observations        Observation[]
  nearMisses          NearMiss[]
  permits             Permit[]
  flras               FLRA[]
  incidents           Incident[]
  inspections         Inspection[]
  manhours            Manhours[]
  manhoursSubmissions ManhoursSubmission[]
  equipment           Equipment[]
  departments         Department[]

  // Detected anomalies scoped to this plant
  anomalies Anomaly[]

  // Training production-depth — schedules + plant-scoped programs
  trainingPrograms  TrainingProgram[]
  trainingSchedules TrainingSchedule[]

  // HIRA — the risk register module is plant-scoped. Hazard library and
  // RiskMatrix masters are tenant-global; HiraStudy is the per-plant root.
  hiraStudies HiraStudy[]

  // CAPA — unified register, plant-scoped.
  capas Capa[] @relation("CapaPlant")

  // EAI — environmental register, plant-scoped (Phase 2).
  eaiStudies EaiStudy[]

  // Observation severity engine — per-area hazard tiers, plus the plant-wide
  // default row (areaId NULL) they fall back to.
  hazardTiers AreaHazardTier[]
}

model Area {
  id          String   @id @default(cuid())
  name        String
  plantId     String
  plant       Plant    @relation(fields: [plantId], references: [id])
  // Responsible owner for this area (docs/cams/09 §2.1.4, open question Q17).
  // The platform had no area-level ownership, which capped the audit own-work
  // independence guard at site/department granularity. Nullable: an absent owner
  // must degrade the guard to "no signal", never to "no conflict".
  ownerUserId String?
  createdAt   DateTime @default(now())

  observations Observation[]
  nearMisses   NearMiss[]
  permits      Permit[]
  incidents    Incident[]
  hiraStudies  HiraStudy[]      @relation("HiraStudyArea")
  hiraEntries  HiraEntry[]      @relation("HiraEntryArea")
  eaiStudies   EaiStudy[]       @relation("EaiStudyArea")
  eaiEntries   EaiEntry[]       @relation("EaiEntryArea")
  hazardTiers  AreaHazardTier[]

  @@index([ownerUserId])
}

// ─────────────────────────────────────────────────────────────────────
//  MASTER / LOOKUP TABLES — used by Near Miss, will be reused by other
//  modules as they're brought to production depth.
// ─────────────────────────────────────────────────────────────────────

model Department {
  id        String   @id @default(cuid())
  plantId   String
  plant     Plant    @relation(fields: [plantId], references: [id])
  name      String
  code      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  nearMisses         NearMiss[]
  incidents          Incident[]                 @relation("IncidentDepartment")
  permits            Permit[]                   @relation("PermitDepartment")
  manhoursCategories ManhoursEmployeeCategory[] @relation("ManhoursCategoryDepartment")
  hiraStudies        HiraStudy[]                @relation("HiraStudyDepartment")
  eaiStudies         EaiStudy[]                 @relation("EaiStudyDepartment")

  @@unique([plantId, name])
  @@index([plantId, active])
}

model ContractorCompany {
  id            String  @id @default(cuid())
  name          String  @unique
  code          String? @unique
  contactPerson String?
  contactEmail  String?
  contactPhone  String?
  // ACTIVE | SUSPENDED | TERMINATED (existing safety-score status)
  status        String  @default("ACTIVE")
  // Live safety score 0-100; decremented by post-closure rules
  score         Int     @default(100)

  // ── EPC fields (added for EPC module) ──────────────────────────
  tradeName                    String?
  registrationNumber           String?
  panNumber                    String?
  gstNumber                    String?
  tradeCategories              Json?     @default("[]")
  sizeCategory                 String?   @default("small")
  prequalificationStatus       String    @default("not_applied")
  prequalificationValidUntil   DateTime?
  prequalificationScore        Float?
  prequalificationReviewedById String?
  prequalificationReviewedAt   DateTime?
  complianceDocuments          Json?     @default("[]")
  representativeName           String?
  representativePhone          String?
  representativeEmail          String?
  safetyOfficerName            String?
  safetyOfficerPhone           String?
  suspensionHistory            Json?     @default("[]")
  // ───────────────────────────────────────────────────────────────

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nearMisses          NearMiss[]
  observations        Observation[]
  permits             Permit[]
  incidentPersons     IncidentPerson[]           @relation("IncidentPersonContractor")
  manhoursCategories  ManhoursEmployeeCategory[] @relation("ManhoursCategoryContractor")
  workers             ContractorWorker[]
  mobilizationRecords MobilizationRecord[]

  @@index([status])
  /// EPC tenant partition (app/services/tenant_partition.py); DDL: apply-epc-tenant-partition-ddl.ts
  tenantId                  String   @default("default")
  @@index([tenantId])
  @@index([prequalificationStatus])
}

// Generic key/value lookup — single table for ACTIVITY_TYPE, SHIFT,
// HAZARD_CATEGORY, ENERGY_SOURCE, ROOT_CAUSE_CATEGORY. Avoids one tiny
// table per master and lets the configuration UI use a single CRUD
// component for all of them.
model MasterItem {
  id        String   @id @default(cuid())
  // ACTIVITY_TYPE | SHIFT | HAZARD_CATEGORY | ENERGY_SOURCE | ROOT_CAUSE_CATEGORY
  type      String
  code      String
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  // type-specific extras (e.g. SHIFT.startHour / endHour)
  metadata  Json?
  createdAt DateTime @default(now())

  @@unique([type, code])
  @@index([type, active])
}

// ─────────────────────────────────────────────────────────────────────
//  MODULE 1 — Safety Observation
// ─────────────────────────────────────────────────────────────────────

enum ObservationType {
  SAFE_ACT
  UNSAFE_ACT
  SAFE_CONDITION
  UNSAFE_CONDITION
}

// Legacy hazard categories + the DuPont STOP categories (last block). At-risk
// observations dual-write their STOP categoryCode into this column so every
// existing group-by-category consumer keeps working — see ObservationTaxonomy.
// PPE and HOUSEKEEPING are shared between both lists.
enum ObservationCategory {
  PPE
  HOUSEKEEPING
  WORK_AT_HEIGHT
  HOT_WORK
  MOBILE_EQUIPMENT
  ELECTRICAL
  MATERIAL_HANDLING
  CONFINED_SPACE
  CHEMICAL_HANDLING
  EMERGENCY_PREP
  OTHERS
  REACTIONS_OF_PEOPLE
  POSITIONS_OF_PEOPLE
  TOOLS_EQUIPMENT
  PROCEDURES
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ObservationStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  CLOSED
}

model Observation {
  id                       String                         @id @default(cuid())
  number                   String                         @unique
  observerId               String
  observer                 User                           @relation(fields: [observerId], references: [id])
  date                     DateTime
  plantId                  String
  plant                    Plant                          @relation(fields: [plantId], references: [id])
  areaId                   String?
  area                     Area?                          @relation(fields: [areaId], references: [id])
  type                     ObservationType
  category                 ObservationCategory
  // ─── DuPont STOP taxonomy ─────────────────────────────────────────────
  // Required for at-risk types (UNSAFE_ACT / UNSAFE_CONDITION), null on safe
  // observations and on legacy rows the migration couldn't confidently map
  // (those are queued in UnmappedLegacyObservation). taxonomyAxis is
  // dual-written from `type` so the composite FK below can enforce
  // "sub-category belongs to this axis" at the DB level.
  categoryCode             String?
  subCategoryCode          String?
  taxonomyAxis             String?
  stopTaxonomy             ObservationTaxonomy?           @relation(fields: [categoryCode, subCategoryCode, taxonomyAxis], references: [categoryCode, subCategoryCode, observationType])
  description              String
  photoUrl                 String?
  severity                 Severity
  immediateAction          String?
  responsiblePersonId      String?
  responsiblePerson        User?                          @relation("ObservationResponsiblePerson", fields: [responsiblePersonId], references: [id])
  contractorCompanyId      String?
  contractorCompany        ContractorCompany?             @relation(fields: [contractorCompanyId], references: [id])
  // ─── Target closure date + SLA provenance ─────────────────────────────
  // Deliberately still a FLAT column. The SLA build spec nested it as
  // `targetClosureDate.date`; that would have been a breaking shape change for
  // every report, dashboard and mobile screen reading `targetDate` today, so
  // the provenance went into sidecar columns instead and nothing downstream
  // had to change. targetDateSource is auto_sla | manual_override |
  // section_head_reassigned | manual_no_policy; NULL means the row predates
  // the SLA layer. targetDateSlaConfig is a FROZEN copy of the policy applied,
  // so editing the matrix can never restate what an existing record was held
  // to. Full trail in ObservationTargetDateHistory.
  targetDate               DateTime?
  targetDateSource         String?
  targetDateSlaConfig      Json?
  targetDateOverrideReason String?
  status                   ObservationStatus              @default(OPEN)
  closedAt                 DateTime?
  closingRemark            String?
  attachments              ObservationAttachment[]
  workersInvolved          ObservationWorkerInvolved[]
  /// Append-only record of every time the observer's severity differed from the
  /// deterministic suggestion. Agreement is not logged — see SeverityOverrideLog.
  severityOverrides        SeverityOverrideLog[]
  derosters                ObservationDeroster[]
  targetDateHistory        ObservationTargetDateHistory[]

  // ─── Risk scoring (1-5 likelihood × consequence) ────────────────────
  // Computed at submit when matrix fields are provided; severity (LOW/MEDIUM/
  // HIGH/CRITICAL) is the legacy summary. riskScore drives Rule 7 — high-risk
  // closures suggest a systemic CAPA.
  riskLikelihood  Int?
  riskConsequence Int?
  riskScore       Int?
  riskLevel       String?

  // ─── Submit-time auto-detections ────────────────────────────────────
  // Set by the API on creation. isRepeat triggers Rule 1; activePermitId +
  // permitReviewFlagged trigger Rule 5 at closure time.
  isRepeat              Boolean  @default(false)
  similarObservationIds String[] @default([])
  activePermitId        String?
  activePermit          Permit?  @relation("ObservationActivePermit", fields: [activePermitId], references: [id])
  permitReviewFlagged   Boolean  @default(false)

  // ─── Cross-module trigger output (set by post-closure rules engine) ─
  // Each field is the ID of the record this observation spawned. Surfaced in
  // the "Related Items" section of the detail view; reverse-linked from each
  // target's "Triggered by Observation" field.
  triggeredInspectionId   String?
  triggeredInspection     Inspection?     @relation("ObservationTriggeredInspection", fields: [triggeredInspectionId], references: [id])
  triggeredTbtId          String?
  triggeredTbt            TrainingRecord? @relation("ObservationTriggeredTbt", fields: [triggeredTbtId], references: [id])
  triggeredCapaId         String?
  triggeredCapa           Incident?       @relation("ObservationTriggeredCapa", fields: [triggeredCapaId], references: [id])
  contributedToIncidentId String?
  contributedToIncident   Incident?       @relation("ObservationContributedToIncident", fields: [contributedToIncidentId], references: [id])

  // Audit log of every rule that fired at closure (and what it produced).
  // Free-form JSON to keep the schema simple while we iterate on rule shapes.
  closureTriggers Json?

  // Coaching tasks that this observation triggered (Rule 6)
  coachingTasks CoachingTask[] @relation("CoachingFromObservation")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // List/filter queries hit (status, plantId, date, observerId,
  // responsiblePersonId). Without these the table is full-scanned every
  // page load, which is the single biggest cause of the 5–10s page times.
  @@index([status])
  @@index([plantId, status])
  @@index([date])
  @@index([observerId])
  @@index([responsiblePersonId])
  @@index([contractorCompanyId])
  @@index([categoryCode, taxonomyAxis])
}

/// DuPont STOP category → sub-category master, split by act/condition axis.
///
/// Category eligibility per axis is DERIVED, never flagged: a category is
/// offered for an axis only when ≥1 active row exists for that
/// (categoryCode, observationType) pair. "Reactions of People" (STOP-1) and
/// "Positions of People" (STOP-2) drop out of the CONDITION list purely
/// because zero CONDITION rows are seeded for them — nothing to keep in sync.
model ObservationTaxonomy {
  id                String   @id @default(cuid())
  categoryCode      String
  categoryLabel     String
  /// "ACT" | "CONDITION" — the axis, NOT the four-value ObservationType.
  observationType   String
  subCategoryCode   String
  subCategoryLabel  String
  /// Traceability to the published standard, e.g. "STOP-3".
  stopReferenceCode String
  isActive          Boolean  @default(true)
  displayOrder      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  observations Observation[]

  /// Referenced by Observation's composite FK; also the idempotent seed key.
  @@unique([categoryCode, subCategoryCode, observationType])
  @@index([categoryCode, observationType, isActive])
  @@index([observationType])
  @@index([isActive])
}

/// Review queue for legacy observations the taxonomy migration would have had
/// to guess at. Written by prisma/migrate-observation-taxonomy.ts instead of
/// forcing a bad mapping onto the record.
model UnmappedLegacyObservation {
  id                    String    @id @default(cuid())
  observationId         String
  observationNumber     String
  observationType       String
  legacyCategory        String?
  /// NO_CONFIDENT_CATEGORY_MATCH | SUBCATEGORY_REQUIRES_REVIEW
  reason                String
  suggestedCategoryCode String?
  suggestedAxis         String?
  resolvedAt            DateTime?
  resolvedById          String?
  createdAt             DateTime  @default(now())

  @@unique([observationId])
  @@index([reason])
}

// Lightweight task surface for HR-style coaching / counselling actions
// spawned by Rule 6 (repeat behavioural observations). The brief said a full
// HR module is out of scope; this minimal table lets the inbox surface the
// task without inventing a new module. Closure of the coaching task is a
// simple status flip — no workflow attached today.
model CoachingTask {
  id                  String       @id @default(cuid())
  number              String       @unique
  // The person being coached
  personId            String
  person              User         @relation("CoachingPerson", fields: [personId], references: [id])
  // Whoever owns delivering the coaching (Supervisor for COACHING,
  // HR Manager for FORMAL_COUNSELING).
  assignedToId        String
  assignedTo          User         @relation("CoachingAssignee", fields: [assignedToId], references: [id])
  type                String // "COACHING" | "FORMAL_COUNSELING"
  reason              String       @db.Text
  sourceObservationId String?
  sourceObservation   Observation? @relation("CoachingFromObservation", fields: [sourceObservationId], references: [id])
  status              String       @default("PENDING") // PENDING | COMPLETED | CANCELLED
  completedAt         DateTime?
  completionRemark    String?      @db.Text
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([assignedToId, status])
  @@index([personId])
}

// ─────────────────────────────────────────────────────────────────────
//  ANOMALY DETECTION AGENT (Dimension 4 / Phase 2)
//  Detected anomalies in safety records. Populated by the detector
//  algorithms (frequency spike, severity drift, hot-spot, person-of-concern,
//  cross-correlation). Each row is a single signal — reviewers triage them
//  via the /anomalies page workflow (PENDING_REVIEW → CONFIRMED / DISMISSED).
// ─────────────────────────────────────────────────────────────────────

model Anomaly {
  id         String   @id @default(cuid())
  detectedAt DateTime @default(now())

  // Detector identity. Stable string keys so the dashboard can group / filter.
  // Known values: FREQUENCY_SPIKE | SEVERITY_DRIFT | HOTSPOT_CLUSTER |
  //               PERSON_OF_CONCERN | CROSS_CORRELATION
  detectorId String

  // Source module the anomaly was detected from (OBSERVATION first; later
  // NEAR_MISS, INCIDENT, etc. as detectors expand).
  module String

  // Subject — what the anomaly is about. All optional so different detectors
  // can populate only what's relevant.
  plantId  String?
  plant    Plant?  @relation(fields: [plantId], references: [id])
  category String? // observation category if applicable
  area     String? // free-text area name (Equipment.location surrogate)
  personId String? // for PERSON_OF_CONCERN
  person   User?   @relation("AnomalySubject", fields: [personId], references: [id])

  // Signal severity — drives how the dashboard ranks it and whether email fires.
  // INFO    = noteworthy but not actionable
  // WARNING = should be reviewed within 7 days
  // CRITICAL = email HSE Manager + PLANT_HEAD immediately
  severity String @default("WARNING")

  // The detection signal itself — algorithm-specific JSON. For frequency
  // spike: { window, observed, expected, zScore, ratio }. Other detectors
  // populate their own shape; the UI renders a generic chart from this.
  signalData Json

  // Human-readable summary the dashboard shows in the row.
  description String @db.Text

  // Records that contributed to triggering this anomaly. For OBSERVATION
  // module these are observation IDs; the UI renders them as click-through
  // chips so a reviewer can see "what made the algorithm fire."
  contributingRecordIds String[] @default([])

  // Review workflow.
  // PENDING_REVIEW → ACKNOWLEDGED (in-progress) → CONFIRMED | DISMISSED | EXPIRED
  status     String    @default("PENDING_REVIEW")
  reviewerId String?
  reviewer   User?     @relation("AnomalyReviewer", fields: [reviewerId], references: [id])
  reviewedAt DateTime?
  reviewNote String?   @db.Text

  // De-duplication: detectors should refuse to create a duplicate if an
  // active anomaly with the same subject + detector already exists. The
  // unique fingerprint is computed at detection time and stored here.
  fingerprint String? @unique

  emailNotifiedAt DateTime?

  @@index([status, detectedAt])
  @@index([plantId, status])
  @@index([detectorId, status])
}

// Same shape as IncidentAttachment — see that model's docstring for the
// upload lifecycle (signed URL → direct PUT → finalise metadata) and the
// soft-delete retention pattern.
model ObservationAttachment {
  id            String      @id @default(cuid())
  observationId String
  observation   Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  // Allowed: INITIAL_PHOTO | ACTION_EVIDENCE | VERIFICATION_PHOTO | DOCUMENT
  category      String
  fileName      String
  storagePath   String
  fileSize      Int
  mimeType      String
  caption       String?
  exifData      Json?
  uploadedById  String
  uploadedBy    User        @relation(fields: [uploadedById], references: [id])
  uploadedAt    DateTime    @default(now())
  deletedAt     DateTime?

  @@index([observationId, category])
  @@index([uploadedById])
}

// ─────────────────────────────────────────────────────────────────────
//  MODULE 2 — Near Miss
// ─────────────────────────────────────────────────────────────────────

enum NearMissStatus {
  REPORTED
  UNDER_REVIEW
  ACTION_ASSIGNED
  CLOSED
}

model NearMiss {
  id          String   @id @default(cuid())
  number      String   @unique
  reporterId  String
  reporter    User     @relation(fields: [reporterId], references: [id])
  date        DateTime
  plantId     String
  plant       Plant    @relation(fields: [plantId], references: [id])
  areaId      String?
  area        Area?    @relation(fields: [areaId], references: [id])
  description String

  // ─── Location / context ──────────────────────────────────────────
  location         String? // legacy free-text (kept for back-compat; new submissions use specificLocation + GPS)
  specificLocation String? // free-text specifics ("near south packer #3 outlet")
  gpsLatitude      Float?
  gpsLongitude     Float?

  // ─── Departmental & shift context ────────────────────────────────
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  shiftId      String? // FK by id to MasterItem(type=SHIFT) — not enforced as relation since MasterItem is generic

  // ─── Reporter context ────────────────────────────────────────────
  reporterType String? // EMPLOYEE | CONTRACTOR | EXTERNAL | ANONYMOUS
  isAnonymous  Boolean @default(false)

  // ─── Activity ────────────────────────────────────────────────────
  activityBeingPerformed String? // FK by id to MasterItem(type=ACTIVITY_TYPE), nullable so legacy free-text rows still work
  activityIsRoutine      Boolean?
  activity               String? // legacy free-text — kept for back-compat
  immediateAction        String? // steps taken at the scene before the formal review

  // ─── Equipment & contractor ─────────────────────────────────────
  equipmentId         String?
  equipment           Equipment?         @relation(fields: [equipmentId], references: [id])
  contractorCompanyId String?
  contractorCompany   ContractorCompany? @relation(fields: [contractorCompanyId], references: [id])

  // ─── Severity & consequence ─────────────────────────────────────
  potentialSeverity         Severity
  // Multi-select consequence list with sub-ratings, e.g.
  //   [{ "type": "INJURY", "subRating": "FATALITY_POTENTIAL" },
  //    { "type": "PROPERTY_DAMAGE", "costEstimate": 500000 }, ...]
  potentialConsequences     Json?
  // Legacy CSV column kept transitionally — null on new rows.
  potentialConsequence      String?
  multipleWorkersAggravator Boolean  @default(false)

  // ─── Hazard categorization ───────────────────────────────────────
  hazardCategory String? // FK by id to MasterItem(type=HAZARD_CATEGORY)
  energySource   String? // FK by id to MasterItem(type=ENERGY_SOURCE)

  // ─── Risk matrix scoring ────────────────────────────────────────
  riskLikelihood  Int?
  riskConsequence Int?
  riskScore       Int?
  riskLevel       String? // LOW | MEDIUM | HIGH | CRITICAL — derived from matrix

  // ─── Reporter's initial root-cause hint + barriers ─────────────
  initialRootCauseCategory String? // HUMAN_FACTOR | EQUIPMENT | PROCESS | ENVIRONMENT | MANAGEMENT_SYSTEM
  controlsThatFailed       String? // existing barriers that should have prevented this
  controlsThatWorked       String? // barriers that DID prevent the event

  // ─── Reporter recommendation ────────────────────────────────────
  recommendedActions     String?
  suggestedActionOwnerId String?
  suggestedActionOwner   User?   @relation("NearMissSuggestedOwner", fields: [suggestedActionOwnerId], references: [id])

  // Transitional: single-CAPA fields kept until the parallel-CAPA
  // workflow ships. Tools that still use these (workflow_engine
  // assignee resolution, the legacy CapaEditPanel) keep working
  // until Commit 3 swings them over to the new NearMissCapa[] table.
  rootCauseCategory String?
  rootCauseDetail   String?
  correctiveActions String?
  actionOwnerId     String?
  actionOwner       User?     @relation("NearMissActionOwner", fields: [actionOwnerId], references: [id])
  targetDate        DateTime?

  // ─── Auto-detection flags (set by API on submission) ───────────
  isRepeat            Boolean  @default(false)
  similarNearMissIds  String[] @default([])
  activePermitId      String?
  activePermit        Permit?  @relation("NearMissActivePermit", fields: [activePermitId], references: [id])
  permitReviewFlagged Boolean  @default(false)

  // ─── Auto-promotion to Incident (CRITICAL severity path) ──────
  autoPromoteToIncident Boolean   @default(false)
  promotedToIncident    Boolean   @default(false)
  promotedIncidentId    String?   @unique
  promotedIncident      Incident? @relation("NearMissPromoted", fields: [promotedIncidentId], references: [id])

  // Reverse for the new bidirectional FK on Incident.sourceNearMissId
  // (Commit 1, production-depth refactor). Either relation reaching the
  // same incident — both can be queried; the auto-promote service keeps
  // them in sync.
  autoPromotedIncident Incident? @relation("NearMissAutoPromoted")
  promotedAt           DateTime?

  // Cross-link to observations raised before in the same area
  relatedObservationIds String[] @default([])

  // ─── Joint Review (parallel CHECKER × 2) ──────────────────────
  reviewByHseManagerId     String?
  reviewByHseManagerAt     DateTime?
  reviewBySectionHeadId    String?
  reviewBySectionHeadAt    DateTime?
  reviewerNotes            String?
  refinedRootCauseCategory String?

  // ─── Verification & effectiveness ─────────────────────────────
  verificationMethod  String?
  verificationNotes   String?
  verifiedById        String?
  verifiedAt          DateTime?
  effectivenessRating Int?

  // ─── Closure ──────────────────────────────────────────────────
  closingRemark String?
  closedById    String?
  closedAt      DateTime?

  // ─── Lessons learned + cross-module trigger outputs ──────────
  lessonsLearned        String?
  lessonsDistributedTo  Json?
  triggeredInspectionId String?
  triggeredTbtId        String?
  triggeredCapaId       String?
  triggeredPermitFlagId String?
  // Audit log of post-closure cross-module triggers (Dimension 4)
  // produced by lib/nearmiss/post_closure_rules service. Shape: list
  // of `{ ruleId, ruleName, fired, reason?, error?, data?,
  // spawnedRecordType?, spawnedRecordId?, spawnedRecordNumber? }`.
  closureTriggers       Json?

  // ─── SLA tracking ─────────────────────────────────────────────
  slaTargetAt       DateTime?
  slaActualClosedAt DateTime?
  slaPerformance    String?

  // ─── Status (workflow-managed) ────────────────────────────────
  status NearMissStatus @default(REPORTED)

  // ─── Children ─────────────────────────────────────────────────
  personsInvolved            NearMissPersonInvolved[]
  personsPotentiallyAffected NearMissPersonAffected[]
  witnesses                  NearMissWitness[]
  capas                      NearMissCapa[]
  attachments                NearMissAttachment[]
  comments                   NearMissComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plantId, status])
  @@index([reporterId])
  @@index([potentialSeverity, status])
  // Date is used by every list query as orderBy. Without an index Postgres
  // sorts the filtered set in memory each request.
  @@index([date])
  @@index([status, date])
}

// ─── Near Miss child tables ─────────────────────────────────────────

model NearMissPersonInvolved {
  id         String   @id @default(cuid())
  nearMissId String
  nearMiss   NearMiss @relation(fields: [nearMissId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("NearMissPersonInvolved", fields: [userId], references: [id])
  role       String?

  @@unique([nearMissId, userId])
  @@index([nearMissId])
}

model NearMissPersonAffected {
  id                String   @id @default(cuid())
  nearMissId        String
  nearMiss          NearMiss @relation(fields: [nearMissId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation("NearMissPersonAffected", fields: [userId], references: [id])
  proximityToHazard String? // ADJACENT | NEARBY | DOWNSTREAM

  @@unique([nearMissId, userId])
  @@index([nearMissId])
}

model NearMissWitness {
  id                String   @id @default(cuid())
  nearMissId        String
  nearMiss          NearMiss @relation(fields: [nearMissId], references: [id], onDelete: Cascade)
  witnessId         String
  witness           User     @relation("NearMissWitness", fields: [witnessId], references: [id])
  statementCaptured Boolean  @default(false)

  @@unique([nearMissId, witnessId])
  @@index([nearMissId])
}

model NearMissCapa {
  id                  String    @id @default(cuid())
  nearMissId          String
  nearMiss            NearMiss  @relation(fields: [nearMissId], references: [id], onDelete: Cascade)
  description         String
  type                String // CORRECTIVE | PREVENTIVE
  ownerId             String
  owner               User      @relation("NearMissCapaOwner", fields: [ownerId], references: [id])
  targetDate          DateTime
  // PENDING | IN_PROGRESS | COMPLETED | OVERDUE | VERIFIED | REJECTED
  status              String    @default("PENDING")
  evidenceUrl         String?
  evidenceDescription String?
  completionNotes     String?
  completedAt         DateTime?
  verifiedById        String?
  verifiedBy          User?     @relation("NearMissCapaVerifier", fields: [verifiedById], references: [id])
  verifiedAt          DateTime?
  rejectionReason     String?
  reworkRound         Int       @default(0)
  // FK to the WorkflowTask once parallel-CAPA fan-out is wired in Commit 3
  workflowTaskId      String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([nearMissId])
  @@index([ownerId, status])
}

model NearMissAttachment {
  id           String    @id @default(cuid())
  nearMissId   String
  nearMiss     NearMiss  @relation(fields: [nearMissId], references: [id], onDelete: Cascade)
  // INITIAL_PHOTO | WITNESS_STATEMENT | EVIDENCE | CAPA_EVIDENCE | VERIFICATION_PHOTO
  category     String
  fileName     String
  storagePath  String
  fileSize     Int
  mimeType     String
  caption      String?
  exifData     Json?
  uploadedById String
  uploadedBy   User      @relation("NearMissAttachmentUploader", fields: [uploadedById], references: [id])
  uploadedAt   DateTime  @default(now())
  deletedAt    DateTime?

  @@index([nearMissId, deletedAt])
}

model NearMissComment {
  id         String   @id @default(cuid())
  nearMissId String
  nearMiss   NearMiss @relation(fields: [nearMissId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation("NearMissCommentAuthor", fields: [authorId], references: [id])
  content    String
  createdAt  DateTime @default(now())

  @@index([nearMissId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────
//  MODULE 3 — PTW (Permit to Work) & FLRA
// ─────────────────────────────────────────────────────────────────────

enum PermitType {
  HOT_WORK
  CONFINED_SPACE
  WORK_AT_HEIGHT
  EXCAVATION
  ELECTRICAL_LOTO
  LIFTING
  GENERAL_COLD
}

// Closed-loop PTW state machine:
//   DRAFT → SUBMITTED → APPROVED → ISSUED → [receiver accepts] → ACTIVE →
//   (SUSPENDED loop) → WORK_COMPLETED → HANDBACK_INSPECTION → CLOSED (+ isArchived)
// ISSUER_APPROVED / SAFETY_APPROVED / PLANT_HEAD_APPROVED are DEPRECATED —
// retained on the native enum for back-compat; the engine never writes them
// (per-step approvals live on PermitApproval + the *ApprovedAt columns).
// New values are applied to the live DB by prisma/apply-ptw-closed-loop-ddl.ts.
enum PermitStatus {
  DRAFT
  SUBMITTED
  ISSUER_APPROVED // deprecated — never written
  SAFETY_APPROVED // deprecated — never written
  PLANT_HEAD_APPROVED // deprecated — never written
  APPROVED // final approver signed off; release to receiver pending
  ISSUED // published/released to the receiver (auto-fired after APPROVED)
  ACTIVE
  SUSPENDED // HSE has paused active work; resumption requires re-approval
  WORK_COMPLETED // receiver declared work done + outcome
  HANDBACK_INSPECTION // handback inspection recorded; awaiting closure approval
  EXPIRED
  CLOSED
  REJECTED
  CANCELLED // issuer/admin pulled the permit (operational, not an approver refusal)
}

model Permit {
  id                  String             @id @default(cuid())
  number              String             @unique
  type                PermitType
  plantId             String
  plant               Plant              @relation(fields: [plantId], references: [id])
  areaId              String?
  area                Area?              @relation(fields: [areaId], references: [id])
  location            String
  scopeOfWork         String
  validFrom           DateTime
  validTo             DateTime
  originatorId        String
  originator          User               @relation("PermitOriginator", fields: [originatorId], references: [id])
  issuerId            String?
  issuer              User?              @relation("PermitIssuer", fields: [issuerId], references: [id])
  receiverId          String?
  receiver            User?              @relation("PermitReceiver", fields: [receiverId], references: [id])
  contractorName      String?
  contractorCompanyId String?
  contractorCompany   ContractorCompany? @relation(fields: [contractorCompanyId], references: [id])

  // Provenance — set when the permit was raised from a HIRA hazard row via the
  // Create-PTW prompt. Both null for permits raised independently, so a
  // non-null hiraEntryId is the "HIRA-driven permit" signal.
  hiraEntryId       String?
  hiraEntry         HiraEntry?       @relation("PermitFromHiraEntry", fields: [hiraEntryId], references: [id], onDelete: SetNull)
  hiraEntryHazardId String?
  hiraEntryHazard   HiraEntryHazard? @relation("PermitFromHiraHazard", fields: [hiraEntryHazardId], references: [id], onDelete: SetNull)

  isolationsRequired  String? // CSV / multi-line
  ppeChecklist        String? // JSON of checklist items
  gasTestRequired     Boolean      @default(false)
  gasTestResult       String?
  o2Level             String?
  lelLevel            String?
  h2sLevel            String?
  fireWatchRequired   Boolean      @default(false)
  rescuePlan          String?
  issuerApprovedAt    DateTime?
  safetyApprovedAt    DateTime?
  plantHeadApprovedAt DateTime?
  closedAt            DateTime?
  status              PermitStatus @default(DRAFT)
  rejectionReason     String?
  suspendedAt         DateTime?
  suspendedReason     String?
  expiredAt           DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  flras    FLRA[]
  workCrew PermitCrewMember[]

  // Observations that flagged this permit for review (Rule 5)
  observationsLinking Observation[] @relation("ObservationActivePermit")
  // Near misses raised in this permit's active area (Near Miss Rule 5)
  nearMissesLinking   NearMiss[]    @relation("NearMissActivePermit")
  // Incidents raised while this permit was active (Incident Phase 1)
  incidentsLinking    Incident[]    @relation("IncidentActivePermit")

  // ═══════════════════════════════════════════════════════════════════
  //  PTW + FLRA production-depth refactor — Commit 1 additions
  //  All new fields nullable / defaulted so existing rows remain valid.
  //  NB: model is named `Permit` per code-base consistency; the brief and
  //  UI copy interchangeably calls it PTW (Permit to Work). They are the
  //  same entity — comments use "PTW" colloquially.
  // ═══════════════════════════════════════════════════════════════════

  // ─── Step 1: validity context ───
  validityHours          Int? // computed validTo - validFrom in hours
  workflowDefinitionCode String? // PTW_HIGH_RISK | PTW_STANDARD | one of 5 type-specific codes; set on submit

  // ─── Step 2: location detail ───
  departmentId       String?
  department         Department? @relation("PermitDepartment", fields: [departmentId], references: [id])
  specificLocation   String? // more granular than `location` legacy free-text
  gpsLatitude        Float?
  gpsLongitude       Float?
  workOrderNumber    String? // optional link to maintenance work order
  attachedDrawingIds String[] // array of PermitAttachment ids holding drawings/sketches

  // ─── Step 3: roles beyond crew ───
  fireWatchPersonId String?
  fireWatchPerson   User?   @relation("PermitFireWatch", fields: [fireWatchPersonId], references: [id])
  standbyPersonId   String?
  standbyPerson     User?   @relation("PermitStandby", fields: [standbyPersonId], references: [id])

  // ─── Step 7: additional controls ───
  weatherConditionsAtIssue  String?
  windSpeedKmh              Float? // outdoor hot work — auto-block above threshold
  adjacentAreaNotifications Json? // array of user ids notified

  // ─── Issue phase (closed-loop rebuild): APPROVED → ISSUED, auto-fired
  //     after the final approval. Columns via apply-ptw-closed-loop-ddl.ts ───
  issuedAt   DateTime?
  issuedById String?

  // ─── FLRA policy: optional sub-flow; resolved at creation from instance
  //     config (PTW_FLRA_REQUIRED_*) and snapshotted here ───
  flraRequired Boolean @default(false)

  // ─── Active phase ───
  activatedAt          DateTime?
  activatedById        String? // receiver, stamped by POST /api/ptw/{id}/accept
  currentActiveFlraId  String? // pointer to current effective FLRA
  isCurrentlySuspended Boolean   @default(false)

  // ─── Work Completed declaration (receiver). returnedAt/returnedById are the
  //     legacy names for the same fact, kept in lockstep for old read-sites ───
  workCompletedAt   DateTime?
  workCompletedById String?
  outcome           String? // COMPLETED | PARTIALLY_COMPLETED | STOPPED_INCIDENT | CANCELLED
  returnedAt        DateTime?
  returnedById      String?
  returnNotes       String?   @db.Text
  returnPhotos      Json? // DEPRECATED — photos live on PermitAttachment (RETURN_PHOTO)

  // ─── Handback inspection (legacy name: site verification) ───
  siteVerifiedAt            DateTime?
  siteVerifiedById          String?
  siteVerificationChecklist Json?
  siteVerificationPhotos    Json? // DEPRECATED — photos live on PermitAttachment (VERIFICATION_PHOTO)

  // ─── Closure ───
  closedById    String?
  closingRemark String? @db.Text

  // ─── Cancellation (CANCELLED status; distinct from REJECTED) ───
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?   @db.Text

  // ─── Execution state: did work under this permit ever actually happen? ───
  //     Deliberately NOT folded into `status`, which carries the workflow
  //     position. An EXPIRED permit may have been worked past its window OR
  //     never have been acknowledged at all — same status, opposite operational
  //     truth. `closureType` records WHICH closure path a terminal permit took
  //     so downstream metrics never have to infer it from timestamps.
  //     Columns added by prisma/apply-ptw-execution-state-ddl.ts.
  executionState       String? // NOT_STARTED | IN_PROGRESS | COMPLETED | EXPIRED_UNEXECUTED | WITHDRAWN
  closureType          String? // WORK_COMPLETED | UNEXECUTED_CLOSURE | CANCELLED
  unexecutedReasonCode String? // NO_LONGER_REQUIRED | RESCHEDULED | RESOURCE_UNAVAILABLE | OTHER

  // ─── Archive (retention flag layered on CLOSED — not a lifecycle state) ───
  isArchived Boolean   @default(false)
  archivedAt DateTime?

  // ─── Auto-expiration audit ───
  autoExpiredAt    DateTime?
  expirationReason String? // VALIDITY_END | INCOMPLETE_RETURN | SUSPENDED_TIMEOUT

  // ─── Cross-module linkages (post-closure rule outputs) ───
  triggeredObservations String[]
  triggeredIncidentId   String?
  conflictingPermitIds  String[] // SIMOPS conflict detection results

  // ─── LOTO cross-reference (LOTO build spec §6) ───
  //     A REFERENCE, not a merge: the permit points at the lockout event that
  //     de-energised the equipment it authorises work on. The two data models
  //     stay separate — LOTO owns the isolation record, PTW owns the permit.
  //     Enforced at closure: a permit whose linked execution is still open
  //     cannot close (app/services/workflow_engine.py, CLOSURE step).
  //     FK-by-value to LotoExecution, per house convention — no Prisma
  //     relation, so the LOTO module stays additive and Permit's relation
  //     graph is untouched. Column added by prisma/apply-loto-ddl.ts.
  lotoExecutionId String?

  // ─── Phase-3+ child collections ───
  isolations       PermitIsolation[]
  toolsEquipment   PermitToolEquipment[]
  subjectEquipment PermitSubjectEquipment[]
  gasTestPlan      PermitGasTestPlan?
  gasTestReadings  PermitGasTestReading[]
  approvalsLog     PermitApproval[]
  suspensions      PermitSuspension[]
  extensions       PermitExtension[]
  attachments      PermitAttachment[]
  comments         PermitComment[]
  actionEvidence   PermitActionEvidence[]
  annexures        PermitHazardAnnexure[]

  // ─── Multi-hazard annexures (Page form PIL/EHSD/CL/038-R2) ───
  //     A permit carries ONE base `type` plus N hazard annexures.
  //     effectiveRiskType is the PermitType whose workflow chain actually ran
  //     — the UNION chain across all attached hazards. It equals `type` on a
  //     single-hazard permit, which is what the DDL backfills for legacy rows.
  //     precautionsCertified* is the ONE site-EHS-officer signature covering
  //     every attached checklist; there is no per-annexure sign-off.
  //     Columns live in the DB via prisma/apply-ptw-annexure-ddl.ts.
  effectiveRiskType        PermitType?
  precautionsCertifiedAt   DateTime?
  precautionsCertifiedById String?

  // ─── Soft-delete (governed entity — P1-3). Columns live in the DB via
  //     prisma/apply-softdelete-ddl.ts; declared here so Prisma reads can
  //     exclude soft-deleted rows. The backend enforces the delete path via
  //     the ORM guard in app.core.soft_delete (never a hard delete). ───
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?

  @@index([validTo, status])
  @@index([plantId, areaId, status])
  @@index([currentActiveFlraId])
  // PTW list orders by createdAt — without this Postgres sorts in memory.
  @@index([createdAt])
  @@index([type, status])
  @@index([contractorCompanyId])
  @@index([isDeleted])
  @@index([lotoExecutionId])
  @@index([executionState])
  @@index([closureType])
  @@index([effectiveRiskType])
}

// ═══════════════════════════════════════════════════════════════════════
//  Hazard annexures + precaution checklists
//
//  The paper form these mirror (PIL/EHSD/CL/038-R2) carries one precaution
//  checklist per hazard class on its back side. Those checklists ARE the
//  annexures: attaching a hazard to a permit and having to answer its
//  checklist are the same act.
//
//  ⚠ Tables live in the DB via prisma/apply-ptw-annexure-ddl.ts, NOT via
//    `prisma db push` — pushing would drop the other hand-DDL tables.
// ═══════════════════════════════════════════════════════════════════════

// The seeded checklist master. Deliberately NOT plant-scoped: these are
// standard/statutory-derived lines. A plant needing a local addition gets a
// row at a higher `sequence`, not a private copy of the set.
//
// Retire an item with isActive=false, never a delete — responses already
// recorded against it must stay renderable.
model PermitPrecautionItem {
  id          String   @id @default(cuid())
  hazardType  String
  sequence    Int
  text        String
  isMandatory Boolean  @default(true)
  allowsNA    Boolean  @default(true)
  sourceRef   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  responses PermitPrecautionResponse[]

  @@unique([hazardType, sequence])
  @@index([hazardType, isActive])
}

// One hazard class attached to one permit. The base permit type always
// contributes its own annexure (isPrimary), which cannot be detached.
model PermitHazardAnnexure {
  id            String    @id @default(cuid())
  permitId      String
  permit        Permit    @relation(fields: [permitId], references: [id], onDelete: Cascade)
  hazardType    String
  isPrimary     Boolean   @default(false)
  addedById     String?
  addedAt       DateTime  @default(now())
  completedAt   DateTime?
  completedById String?
  notes         String?

  responses PermitPrecautionResponse[]

  @@unique([permitId, hazardType])
  @@index([permitId])
}

// One Yes/No/NA answer to one precaution line on one annexure.
model PermitPrecautionResponse {
  id            String               @id @default(cuid())
  annexureId    String
  annexure      PermitHazardAnnexure @relation(fields: [annexureId], references: [id], onDelete: Cascade)
  itemId        String
  // No cascade: catalog rows are retired via isActive, never deleted, so a
  // closed permit's checklist always renders against the text actually asked.
  item          PermitPrecautionItem @relation(fields: [itemId], references: [id])
  response      String
  remark        String?
  respondedById String?
  respondedAt   DateTime             @default(now())

  @@unique([annexureId, itemId])
  @@index([annexureId])
  @@index([itemId])
}

// Crew named at PTW issuance time (high-risk permits expect this in Indian
// cement plants). Optional — if no crew is named on the permit, the FLRA
// captures crew freshly. Sign-off enforcement keys off whichever set is
// available: PTW crew if present, else FLRA team members.
model PermitCrewMember {
  id       String   @id @default(cuid())
  permitId String
  permit   Permit   @relation(fields: [permitId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  role     String   @default("WORKER") // WORKER / HELPER / SUPERVISOR / CONTRACTOR
  addedAt  DateTime @default(now())

  // ─── Validity snapshot at issuance (captured for audit) ───
  // The training/medical/contractor checks are run AT permit issuance time;
  // snapshot here so a later change (training expiry, contractor suspension)
  // doesn't retroactively invalidate the work that was done. The FLRA's
  // sign-off then re-validates training currency, with its own fresh snapshot.
  trainingValidAtIssuance    Boolean? @default(false)
  trainingValidationNotes    String?
  medicalValidAtIssuance     Boolean? @default(false)
  contractorActiveAtIssuance Boolean? @default(false)
  // PPE snapshot at crew add (PPE-01 Pass 2). Audit only — the activation
  // gate re-checks PPE live (app/services/ppe_gate.py) because issuance
  // state (returns, recalls, failed inspections) moves faster than training.
  ppeValidAtIssuance         Boolean?
  ppeValidationNotes         String?

  // ─── Mid-permit crew change audit ───
  removedAt     DateTime?
  removalReason String?

  @@unique([permitId, userId])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════
//  Permit (PTW) child models — production-depth refactor, Commit 1
// ═══════════════════════════════════════════════════════════════════════

// One row per isolation point — replaces the legacy CSV `isolationsRequired`.
// Each isolation is verified by the Issuer pre-activation and restored by the
// Receiver during permit return. Both events are timestamped + signed.
model PermitIsolation {
  id                    String    @id @default(cuid())
  permitId              String
  permit                Permit    @relation(fields: [permitId], references: [id], onDelete: Cascade)
  isolationType         String // FK by id to MasterItem(ISOLATION_TYPE) — Electrical / Mechanical / Fluid / Pneumatic / Hydraulic / Steam
  description           String
  isolationPointTag     String // physical tag/label
  lotoTagNumber         String? // Lockout-Tagout reference if applicable
  isolationVerifiedAt   DateTime?
  isolationVerifiedById String?
  restoredAt            DateTime?
  restoredById          String?

  @@index([permitId])
}

// Tools / equipment used during the permit. Each has its inspection currency
// snapshotted at issuance — adding a tool with an overdue inspection blocks
// the permit form (enforced application-side, this column is the audit row).
model PermitToolEquipment {
  id                          String     @id @default(cuid())
  permitId                    String
  permit                      Permit     @relation(fields: [permitId], references: [id], onDelete: Cascade)
  equipmentId                 String?
  equipment                   Equipment? @relation("PermitToolEquipment", fields: [equipmentId], references: [id])
  freeTextDescription         String? // for tools not in the equipment master
  inspectionCurrentAtIssuance Boolean    @default(false)

  @@index([permitId])
}

// Equipment being worked on (subject of the work). Distinct from
// `toolsEquipment` which is what the crew uses. Drives Equipment History
// updates in the post-closure rules engine (Commit 8).
model PermitSubjectEquipment {
  id          String    @id @default(cuid())
  permitId    String
  permit      Permit    @relation(fields: [permitId], references: [id], onDelete: Cascade)
  equipmentId String
  equipment   Equipment @relation("PermitSubjectEquipment", fields: [equipmentId], references: [id])
  workNature  String // INSPECTION | REPAIR | REPLACEMENT | MODIFICATION

  @@index([permitId])
  @@index([equipmentId])
}

// Gas test plan (1-to-1 with Permit). Captured at permit issuance for
// permit types that require it (Confined Space always, Hot Work in fuel
// areas). Refresh tasks for active permits read from this row's
// refreshFrequencyMinutes (Commit 5).
model PermitGasTestPlan {
  id                       String    @id @default(cuid())
  permitId                 String    @unique
  permit                   Permit    @relation(fields: [permitId], references: [id], onDelete: Cascade)
  refreshFrequencyMinutes  Int // default 120 confined / 240 hot work
  parametersToTest         Json // [{parameter:"O2",lowLimit:19.5,highLimit:23.5,unit:"%"}, ...]
  instrumentSerial         String?
  instrumentLastCalibrated DateTime?
}

// Per-reading log captured during active permit. `isPreEntry` flags the
// mandatory first reading taken before crew enters; `refreshDueBy` is
// computed and drives the next refresh-task creation. Exceedance triggers
// auto-suspend of the permit.
model PermitGasTestReading {
  id               String    @id @default(cuid())
  permitId         String
  permit           Permit    @relation(fields: [permitId], references: [id], onDelete: Cascade)
  recordedAt       DateTime  @default(now())
  recordedById     String
  recordedBy       User      @relation("PermitGasTestRecorder", fields: [recordedById], references: [id])
  readings         Json // [{parameter:"O2",value:20.5,unit:"%",isWithinLimit:true}, ...]
  isExceedance     Boolean   @default(false)
  exceedanceAction String? // typically "AUTO_SUSPEND" — text for audit
  instrumentSerial String?
  isPreEntry       Boolean   @default(false)
  refreshDueBy     DateTime? // computed = recordedAt + refreshFrequencyMinutes

  @@index([permitId, recordedAt])
}

// Per-approval audit log. The legacy `issuerApprovedAt` / `safetyApprovedAt`
// / `plantHeadApprovedAt` fields stay on the Permit row for back-compat
// reads, but every approval also creates one row here with comments,
// conditions, and the actual reviewer. This is the audit-grade record.
model PermitApproval {
  id         String   @id @default(cuid())
  permitId   String
  permit     Permit   @relation(fields: [permitId], references: [id], onDelete: Cascade)
  step       String // ISSUER | SAFETY_OFFICER | PLANT_HEAD | SITE_VERIFICATION | CLOSURE
  approverId String
  approver   User     @relation("PermitApprover", fields: [approverId], references: [id])
  decision   String // APPROVED | REJECTED
  comments   String?  @db.Text
  conditions String?  @db.Text // additional conditions added by the approver
  decidedAt  DateTime @default(now())

  @@index([permitId, step])
}

// Each suspension/resumption cycle gets its own row. Multiple suspensions
// per permit are supported (e.g., suspended for weather, resumed, suspended
// again for equipment failure). The legacy single-suspension fields on
// Permit (`suspendedAt`, `suspendedReason`) stay for back-compat reads but
// new code writes here.
model PermitSuspension {
  id                   String    @id @default(cuid())
  permitId             String
  permit               Permit    @relation(fields: [permitId], references: [id], onDelete: Cascade)
  suspendedAt          DateTime  @default(now())
  suspendedById        String
  suspendedBy          User      @relation("PermitSuspendedBy", fields: [suspendedById], references: [id])
  reason               String // GAS_TEST_EXCEEDANCE | WEATHER | EQUIPMENT_FAILURE | ADJACENT_OPERATION | INCIDENT_NEARBY | CREW_FATIGUE | OTHER
  reasonDetail         String?   @db.Text
  resumedAt            DateTime?
  resumedById          String?
  resumedBy            User?     @relation("PermitResumedBy", fields: [resumedById], references: [id])
  resumptionConditions String?   @db.Text
  reFlraRequired       Boolean   @default(true)

  @@index([permitId])
}

// Validity extensions. Original validTo stays on the Permit row; if
// extension is approved the Permit.validTo is updated AND a row here is
// kept as audit. Multiple extensions allowed.
model PermitExtension {
  id               String    @id @default(cuid())
  permitId         String
  permit           Permit    @relation(fields: [permitId], references: [id], onDelete: Cascade)
  requestedAt      DateTime  @default(now())
  requestedById    String
  requestedBy      User      @relation("PermitExtensionRequester", fields: [requestedById], references: [id])
  newValidTo       DateTime
  reason           String    @db.Text
  approvedAt       DateTime?
  approvedById     String?
  approvedBy       User?     @relation("PermitExtensionApprover", fields: [approvedById], references: [id])
  approverComments String?   @db.Text
  status           String // PENDING | APPROVED | REJECTED

  @@index([permitId, status])
}

// Generic file attachment — drawings, MSDS, return photos, verification
// photos, rescue plans, TPI certs. Storage path under Supabase bucket;
// `category` drives where the attachment shows up in the detail view.
model PermitAttachment {
  id               String                @id @default(cuid())
  permitId         String
  permit           Permit                @relation(fields: [permitId], references: [id], onDelete: Cascade)
  // Links an evidence photo to the lifecycle action it evidences (approve /
  // accept / handback …). NULL for general attachments (drawings, MSDS).
  // Column added by prisma/apply-ptw-closed-loop-ddl.ts.
  actionEvidenceId String?
  actionEvidence   PermitActionEvidence? @relation(fields: [actionEvidenceId], references: [id])
  category         String // SCOPE_DRAWING | SITE_PHOTO | MSDS | TPI_CERT | RESCUE_PLAN | RETURN_PHOTO | VERIFICATION_PHOTO | CLOSURE_DOC | ACTION_EVIDENCE_PHOTO
  fileName         String
  storagePath      String
  fileSize         Int
  mimeType         String
  caption          String?
  uploadedById     String
  uploadedBy       User                  @relation("PermitAttachmentUploader", fields: [uploadedById], references: [id])
  uploadedAt       DateTime              @default(now())
  deletedAt        DateTime?

  @@index([permitId, category])
  @@index([actionEvidenceId])
}

// Field evidence captured at each permit lifecycle action — the closed-loop
// audit record: WHO did WHAT, WHERE (GPS), WHEN, with onsite photo(s)
// (PermitAttachment.actionEvidenceId) and a drawn signature. One row per
// action per permit. Rendered as the evidence timeline in the close-out
// report. Table created by prisma/apply-ptw-closed-loop-ddl.ts.
model PermitActionEvidence {
  id                   String             @id @default(cuid())
  permitId             String
  permit               Permit             @relation(fields: [permitId], references: [id], onDelete: Cascade)
  action               String // APPROVE_ISSUER | APPROVE_SAFETY | APPROVE_PLANT_HEAD | ISSUE | ACCEPT | ISOLATION_VERIFY | SUSPEND | RESUME | EXTEND | WORK_COMPLETED_DECLARE | HANDBACK_INSPECT | CLOSE | CANCEL | REJECT
  actorId              String
  actor                User               @relation("PermitEvidenceActor", fields: [actorId], references: [id])
  gpsLatitude          Float?
  gpsLongitude         Float?
  gpsAccuracyMeters    Float?
  capturedAt           DateTime           @default(now())
  signatureImageBase64 String?            @db.Text
  declarationText      String?            @db.Text
  comments             String?            @db.Text
  photos               PermitAttachment[]

  @@index([permitId, action])
}

// Threaded comments visible across the permit lifecycle.
model PermitComment {
  id        String   @id @default(cuid())
  permitId  String
  permit    Permit   @relation(fields: [permitId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("PermitCommentAuthor", fields: [authorId], references: [id])
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([permitId])
}

enum FLRAStatus {
  IN_PROGRESS // crew sign-off pending
  COMPLETED // all crew signed; permit may activate
  SUPERSEDED // re-done because of condition change
  CANCELLED // permit was cancelled / FLRA invalidated
}

model FLRA {
  id                   String              @id @default(cuid())
  number               String              @unique
  permitId             String?
  permit               Permit?             @relation(fields: [permitId], references: [id])
  plantId              String
  plant                Plant               @relation(fields: [plantId], references: [id])
  date                 DateTime
  location             String
  jobDescription       String
  leaderId             String
  leader               User                @relation(fields: [leaderId], references: [id])
  teamMembers          FLRATeamMember[]
  crewSignatures       FLRACrewSignature[]
  hazards              String // legacy JSON array — kept for back-compat; new code reads jobSteps relation
  toolboxTalkById      String?
  toolboxTalkBy        User?               @relation("FLRAToolboxTalkBy", fields: [toolboxTalkById], references: [id])
  toolboxTalkConfirmed Boolean             @default(false)
  status               FLRAStatus          @default(IN_PROGRESS)
  completedAt          DateTime?
  // Re-do flow: when conditions change, the prior FLRA is set to SUPERSEDED
  // and supersededById points to the new FLRA. Self-relation lets us walk
  // history both ways from either record.
  supersededById       String?
  supersededBy         FLRA?               @relation("FLRASupersession", fields: [supersededById], references: [id])
  supersedes           FLRA[]              @relation("FLRASupersession")
  supersededReason     String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  // ═════════════════════════════════════════════════════════════════
  //  PTW + FLRA refactor — Commit 1 additions
  // ═════════════════════════════════════════════════════════════════

  isStandalone Boolean @default(false) // true when no linked permit (rare — most FLRAs are PTW-bound)

  // ─── Location detail (more granular than `location` legacy free-text) ───
  departmentId     String?
  areaCode         String? // FK by id to MasterItem(AREA) — same picklist as PTW.areaId concept
  specificLocation String?
  gpsLatitude      Float?
  gpsLongitude     Float?
  startTime        DateTime?
  jobIsRoutine     Boolean?

  // ─── Toolbox talk extended fields ───
  toolboxTalkConducted   Boolean   @default(false) // separate from `toolboxTalkConfirmed` legacy boolean
  toolboxTalkConductedAt DateTime?
  toolboxTalkTopics      Json? // array of topics covered
  toolboxTalkLanguage    String? // English | Hindi | Bengali | Khasi

  // ─── Controls confirmation (Commit 3 form fills these) ───
  ppeChecklistResponses      Json?
  toolsCheckedResponses      Json?
  exitRoutesIdentified       String? @db.Text
  emergencyContactsConfirmed Boolean @default(false)

  // ─── Phase 3 child collections ───
  jobSteps            FLRAJobStep[]
  fitnessDeclarations FLRAFitnessDeclaration[]
  attachments         FLRAAttachment[]

  @@index([permitId, status])
}

model FLRATeamMember {
  id     String @id @default(cuid())
  flraId String
  flra   FLRA   @relation(fields: [flraId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([flraId, userId])
  @@index([userId])
}

// Per-crew-member sign-off captured at the worksite. Each row represents one
// crew member's individual acknowledgement of the FLRA. The FLRA cannot move
// to COMPLETED until every required signature row has signed=true.
//
// trainingValidAtSignature is recorded at sign time so a later expiry doesn't
// retroactively invalidate the work. trainingExpiresAt is captured for audit.
model FLRACrewSignature {
  id                       String    @id @default(cuid())
  flraId                   String
  flra                     FLRA      @relation(fields: [flraId], references: [id], onDelete: Cascade)
  userId                   String
  user                     User      @relation(fields: [userId], references: [id])
  signed                   Boolean   @default(false)
  signedAt                 DateTime?
  ipAddress                String?
  deviceInfo               String?
  trainingValidAtSignature Boolean   @default(true)
  trainingExpiresAt        DateTime?

  // ─── Refusal handling (Commit 3 sign-off panel) ───
  refusedToSign        Boolean   @default(false)
  refusalReason        String?   @db.Text
  refusalEscalatedToId String?
  refusalEscalatedAt   DateTime?

  @@unique([flraId, userId])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════
//  FLRA child models — production-depth refactor, Commit 1
// ═══════════════════════════════════════════════════════════════════════

// Job broken into discrete steps for hazard analysis. Replaces the legacy
// JSON array on `FLRA.hazards` (which stays for back-compat reads).
model FLRAJobStep {
  id              String           @id @default(cuid())
  flraId          String
  flra            FLRA             @relation(fields: [flraId], references: [id], onDelete: Cascade)
  sequence        Int
  stepDescription String           @db.Text
  hazards         FLRAStepHazard[]

  @@index([flraId, sequence])
}

// One hazard per row, with the full 5×5 risk matrix data (initial likelihood
// × severity, controls applied, residual likelihood × severity). HIGH or
// CRITICAL residual blocks FLRA completion — handled application-side.
model FLRAStepHazard {
  id        String      @id @default(cuid())
  jobStepId String
  jobStep   FLRAJobStep @relation(fields: [jobStepId], references: [id], onDelete: Cascade)

  hazardDescription String  @db.Text
  hazardCategory    String // FK by id to MasterItem(HAZARD_CATEGORY)
  energySource      String? // FK by id to MasterItem(ENERGY_SOURCE)

  // Initial risk (before controls)
  initialLikelihood Int
  initialSeverity   Int
  initialRiskScore  Int
  initialRiskLevel  String // LOW | MEDIUM | HIGH | CRITICAL — derived

  // Controls applied
  controlMeasures String @db.Text

  // Residual risk (after controls). HIGH/CRITICAL blocks completion.
  residualLikelihood Int
  residualSeverity   Int
  residualRiskScore  Int
  residualRiskLevel  String

  @@index([jobStepId])
}

// Per-crew-member self-declaration of fitness for duty. Captured at the
// worksite before sign-off. If any crew member declines fitness, they
// cannot sign — supervisor must replace or stand them down (which then
// requires PTW re-approval).
model FLRAFitnessDeclaration {
  id     String @id @default(cuid())
  flraId String
  flra   FLRA   @relation(fields: [flraId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation("FlraFitnessDeclarant", fields: [userId], references: [id])

  isFit               Boolean
  declaredAt          DateTime @default(now())
  hasMedicalCondition Boolean  @default(false)
  conditionsDeclared  String? // optional self-declaration text
  hadAdequateRest     Boolean
  underInfluenceCheck Boolean // not under influence of substances
  notes               String?

  @@unique([flraId, userId])
  @@index([userId])
}

// File attachments — worksite photos, sketches, TBT photos. Storage
// path inside Supabase bucket; same shape as PermitAttachment.
model FLRAAttachment {
  id           String    @id @default(cuid())
  flraId       String
  flra         FLRA      @relation(fields: [flraId], references: [id], onDelete: Cascade)
  category     String // WORKSITE_PHOTO | SKETCH | TBT_PHOTO | OTHER
  fileName     String
  storagePath  String
  fileSize     Int
  mimeType     String
  caption      String?
  uploadedById String
  uploadedBy   User      @relation("FlraAttachmentUploader", fields: [uploadedById], references: [id])
  uploadedAt   DateTime  @default(now())
  deletedAt    DateTime?

  @@index([flraId, category])
}

// ─────────────────────────────────────────────────────────────────────
//  MODULE 4 — Incident Investigation
// ─────────────────────────────────────────────────────────────────────

enum IncidentType {
  FIRST_AID
  MTC
  RWC
  LTI
  FATALITY
  PROPERTY_DAMAGE
  ENVIRONMENTAL
  FIRE
  PROCESS_SAFETY
  HIPO_NEAR_MISS
}

enum IncidentStatus {
  REPORTED
  INVESTIGATION
  CAPA_ASSIGNED
  VERIFIED
  CLOSED
}

model Incident {
  id                       String                        @id @default(cuid())
  number                   String                        @unique
  // `date` is the legacy "incident date". Phase-1 refactor adds `occurredAt`
  // (precise occurrence timestamp) and `reportedAt` (when it was logged).
  // Keep `date` for back-compat reads; new writes also populate `occurredAt`.
  date                     DateTime
  type                     IncidentType
  plantId                  String
  plant                    Plant                         @relation(fields: [plantId], references: [id])
  areaId                   String?
  area                     Area?                         @relation(fields: [areaId], references: [id])
  location                 String
  reporterId               String
  reporter                 User                          @relation(fields: [reporterId], references: [id])
  injuredPersonName        String?
  injuredPersonAge         Int?
  injuredPersonDesignation String?
  bodyPart                 String?
  natureOfInjury           String?
  description              String
  immediateCause           String?
  rootCauseMethod          String? // "5-Why" or "Fishbone"
  rootCauseDetail          String? // JSON or formatted
  correctiveActions        String?
  preventiveActions        String?
  // ── Methodology-shaped JSON for the RCA. Each method stores a typed shape
  //    (5-Why / Fishbone / FTA / Bowtie / TapRoot / Cause Map). The legacy
  //    `rootCauseDetail` String column is retained for backward-compat reading
  //    of pre-refactor records; new writes go to rootCauseData.
  rootCauseData            Json?
  // Auto-generated plain-English summary used by dashboards / list views /
  // statutory reports — derived from rootCauseData on save.
  rootCauseSummary         String?
  investigationTeam        IncidentInvestigationMember[]
  attachments              IncidentAttachment[]
  lostDays                 Int                           @default(0)
  propertyDamageCost       Decimal?                      @db.Decimal(12, 2)
  status                   IncidentStatus                @default(REPORTED)
  closedAt                 DateTime?
  // Reverse 1-to-1 relation: when this incident was auto-promoted from a Near Miss
  // (potentialSeverity = CRITICAL), the originating NM is reachable here.
  fromNearMiss             NearMiss?                     @relation("NearMissPromoted")

  // Reverse trigger relations from Observation post-closure rules (Dimension 4)
  triggeringObservationsCapa Observation[] @relation("ObservationTriggeredCapa")
  contributingObservations   Observation[] @relation("ObservationContributedToIncident")

  // ═══════════════════════════════════════════════════════════════════
  //  Production-depth refactor — Commit 1 additions
  //  All new fields are nullable / defaulted so existing rows remain valid.
  // ═══════════════════════════════════════════════════════════════════

  // ─── PHASE 1: precise occurrence + reporter context ───
  occurredAt            DateTime? // when it actually happened (precise)
  reportedAt            DateTime? // when it was logged into the system
  reportingDelayMinutes Int? // computed = reportedAt - occurredAt
  reporterRole          String? // role code at time of reporting
  departmentId          String?
  department            Department? @relation("IncidentDepartment", fields: [departmentId], references: [id])
  specificLocation      String? // exact spot beyond `location` free text
  gpsLatitude           Float?
  gpsLongitude          Float?
  shiftId               String? // FK by id to MasterItem(type=SHIFT) — not enforced
  weatherConditions     String? // outdoor incidents

  initialDescription String? @db.Text // verbose description; `description` kept for back-compat
  immediateAction    String? @db.Text // first-aid / containment action

  // Activity / equipment / permit context
  activityBeingPerformed String? // FK by id to MasterItem(type=ACTIVITY_TYPE)
  activityIsRoutine      Boolean?
  activePermitId         String?
  activePermit           Permit?  @relation("IncidentActivePermit", fields: [activePermitId], references: [id])

  // Bidirectional link to source Near Miss (when auto-promoted).
  // FK lives on this side now; NearMiss.promotedIncidentId is the other side.
  // Keep both relations in sync via the auto-promote service.
  sourceNearMissId String?   @unique
  sourceNearMiss   NearMiss? @relation("NearMissAutoPromoted", fields: [sourceNearMissId], references: [id])

  // ─── PHASE 2: Classification ───
  classifiedAt            DateTime?
  classifiedById          String?
  classifiedBy            User?     @relation("IncidentClassifier", fields: [classifiedById], references: [id])
  severity                String? // LOW | MEDIUM | HIGH | CRITICAL — derived label mirror of severityDetail.band
  classificationRationale String?   @db.Text
  // ── Incident Intelligence (Slice 1) ──
  // Feature 5: numeric 5×5 severity scoring + escalation ledger.
  severityDetail          Json?
  // Feature 2: AI-assist provenance (summary draft + root-cause suggestion).
  aiAssist                Json?
  // ── Incident Intelligence (Slice 2) ──
  causeAnalysis           Json? // F1 shared cause canvas model (causes[])
  statutoryObligation     Json? // F4 { required, forms[], jurisdiction }
  costImpact              Json? // F8 derived cost-of-unsafety breakdown

  // ─── PHASE 2 / Statutory ───
  isReportable      Boolean   @default(false)
  reportableUnder   Json? // ["FACTORIES_ACT", "DGFASLI", "CPCB"]
  statutoryDeadline DateTime? // computed from incident type + regulation

  // ─── PHASE 3: Investigation team lead ───
  investigationTeamLead    String?
  investigationLead        User?     @relation("IncidentInvestigationLead", fields: [investigationTeamLead], references: [id])
  investigationCharterDate DateTime?

  // ─── PHASE 5: structured cause hierarchy (separate from rcaData) ───
  immediateCauses     String[] // what directly caused it
  underlyingCauses    String[] // contributing conditions
  rootCauses          String[] // identified by RCA — multiple allowed
  contributingFactors String[] // contextual factors

  // ─── PHASE 7: Cost of incident (granular) ───
  costMedical         Decimal? @db.Decimal(14, 2)
  costPropertyDamage  Decimal? @db.Decimal(14, 2) // mirrors propertyDamageCost; new code writes here
  costLostProduction  Decimal? @db.Decimal(14, 2)
  costInsurance       Decimal? @db.Decimal(14, 2)
  costLegalRegulatory Decimal? @db.Decimal(14, 2)
  costOther           Decimal? @db.Decimal(14, 2)
  costTotal           Decimal? @db.Decimal(14, 2) // computed sum

  // ─── PHASE 8: Statutory submissions ───
  form18PreparedAt          DateTime?
  form18PreparedById        String?
  form18Submitted           Boolean   @default(false)
  form18SubmissionDate      DateTime?
  form18SubmissionRef       String? // submission ref no. from inspector
  dgfasliSubmitted          Boolean   @default(false)
  dgfasliSubmissionDate     DateTime?
  cpcbSubmitted             Boolean   @default(false)
  cpcbSubmissionDate        DateTime?
  internalNotificationsSent Json? // who was notified, when

  // ─── PHASE 9: Review approvals ───
  investigationReportSubmittedAt DateTime?
  hseManagerApprovedAt           DateTime?
  hseManagerApprovedById         String?
  plantHeadApprovedAt            DateTime?
  plantHeadApprovedById          String?
  corporateHseApprovedAt         DateTime?
  corporateHseApprovedById       String?

  // ─── PHASE 10: Closure ───
  closingRemark        String? @db.Text
  lessonsLearned       String? @db.Text
  lessonsDistributedTo Json? // plant IDs where lessons distributed
  closedById           String?

  // ─── 90-day Effectiveness Review ───
  effectivenessReviewDueAt  DateTime?
  effectivenessReviewedAt   DateTime?
  effectivenessReviewedById String?
  effectivenessRating       Int? // 1-5
  effectivenessNotes        String?   @db.Text

  // ─── Cross-module linkages ───
  linkedObservationIds  String[] // observations linked as "missed warnings"
  linkedNearMissIds     String[] // related near misses (besides source)
  linkedIncidentIds     String[] // related incidents (recurring patterns)
  triggeredCapaIds      String[] // CAPAs spawned in other modules
  contractorScoreImpact Json? // record of score deductions made

  // ─── Training trigger (from incident_post_closure._rule_training_trigger) ───
  // Populated when the RCA text mentions training-related keywords. The
  // L&D dashboard reads these to surface "incidents needing a training
  // response" — actual schedule creation is a manual L&D action.
  triggeredTrainingFor      String[] // user IDs of affected persons
  triggeredTrainingKeywords String[] // detected keywords for L&D context

  // ─── SLA tracking (per-phase) ───
  initialReportSlaTargetAt  DateTime?
  classificationSlaTargetAt DateTime?
  investigationSlaTargetAt  DateTime?
  capaSlaTargetAt           DateTime?

  // ─── Child collections (new) ───
  personsInvolved   IncidentPerson[]
  reclassifications IncidentReclassification[]
  timelineEvents    IncidentTimelineEvent[]
  evidenceItems     IncidentEvidence[]
  documentsReviewed IncidentDocumentReview[]
  witnessStatements IncidentWitnessStatement[]
  equipmentInvolved IncidentEquipment[]
  capas             IncidentCapa[]
  comments          IncidentComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ─── Soft-delete (governed entity — P1-3). Columns live in the DB via
  //     prisma/apply-softdelete-ddl.ts; declared here so Prisma reads can
  //     exclude soft-deleted rows. The backend enforces the delete path via
  //     the ORM guard in app.core.soft_delete (never a hard delete). ───
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?

  @@index([occurredAt])
  @@index([severity])
  @@index([isReportable, statutoryDeadline])
  @@index([sourceNearMissId])
  @@index([isDeleted])
  // Incident list orders by `date` (the legacy column) and filters by status/type.
  // The existing index([occurredAt]) does not cover those queries.
  @@index([date])
  @@index([status, date])
  @@index([type, status])
  @@index([plantId, status])
}

model IncidentInvestigationMember {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  role       String? // "LEAD" | "MEMBER"

  @@unique([incidentId, userId])
  @@index([userId])
}

// Polymorphic-by-category attachment table for incidents. One row per file.
// Files live in Supabase Storage under `incidents/{incidentId}/{storagePath}`.
// We only persist the storage path + metadata; actual binaries are never in
// the DB. Downloads are served via short-lived signed URLs minted by the
// /attachments/[id]/download endpoint after auth check.
model IncidentAttachment {
  id           String    @id @default(cuid())
  incidentId   String
  incident     Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  // Lifecycle stage / evidence type. Drives where the attachment shows up in the UI.
  // Allowed: INITIAL_PHOTO | WITNESS_STATEMENT | CCTV | EQUIPMENT_DATA |
  //          DOCUMENT | SKETCH | EXTERNAL_REPORT | CAPA_EVIDENCE | CLOSURE_DOC
  category     String
  // Optional anchors when the attachment is tied to a specific sub-record.
  // Until per-CAPA / per-witness models exist, these store a stable client-side
  // string identifier (e.g. "capa-1", "witness-rajesh") so the UI can group.
  capaRef      String?
  witnessRef   String?
  fileName     String // user-facing original filename
  storagePath  String // path within the Supabase bucket; never a public URL
  fileSize     Int
  mimeType     String
  caption      String?
  // Optional EXIF payload extracted client-side at upload time. Schema is
  // free-form JSON: { gps?: {lat,lng}, takenAt?: string, make?, model? }
  exifData     Json?
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime  @default(now())
  // Soft-delete: file is logically removed but the storage object is kept
  // for the statutory retention window. A periodic job purges them later.
  deletedAt    DateTime?

  @@index([incidentId, category])
  @@index([uploadedById])
}

// ─────────────────────────────────────────────────────────────────────
//  MODULE 4 — Incident child models (Production-depth refactor, Commit 1)
// ─────────────────────────────────────────────────────────────────────

// Persons involved in the incident — replaces the single `injuredPerson*`
// columns when a multi-person incident is reported (e.g. several injured
// in one event, or victim + responder + witness all need separate records).
// Legacy `injuredPersonName/Age/Designation/bodyPart/natureOfInjury` are
// kept on the parent for back-compat reads.
model IncidentPerson {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  // Identity — internal user OR external (visitor / public / third party)
  userId          String?
  user            User?   @relation("IncidentPersonUser", fields: [userId], references: [id])
  externalName    String?
  externalContact String?

  // Relationship to incident
  role String // VICTIM | INJURED | WITNESS | RESPONDER | OPERATOR | SUPERVISOR

  // Employment context
  isContractor        Boolean            @default(false)
  contractorCompanyId String?
  contractorCompany   ContractorCompany? @relation("IncidentPersonContractor", fields: [contractorCompanyId], references: [id])

  // Injury details (when isInjured)
  isInjured        Boolean   @default(false)
  bodyPartAffected String? // FK by id to MasterItem(BODY_PART)
  natureOfInjury   String? // FK by id to MasterItem(INJURY_NATURE)
  injurySeverity   String? // MINOR | MAJOR | FATAL
  treatment        String?   @db.Text
  hospitalName     String?
  daysOff          Int?
  daysRestricted   Int?
  returnToWorkDate DateTime?
  isFitForDuty     Boolean?

  // PPE worn at time — JSON checklist of PPE items
  ppeWornAtTime Json?

  createdAt DateTime @default(now())

  @@index([incidentId])
  @@index([userId])
  @@index([contractorCompanyId])
}

// Audit log for severity / type reclassifications (e.g. MTC → LTI when
// worker doesn't return after expected days). Each row is immutable
// once written; the engine reads them to recompute statutory deadlines
// and re-trigger notification cascades.
model IncidentReclassification {
  id                      String   @id @default(cuid())
  incidentId              String
  incident                Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  fromType                String
  toType                  String
  fromSeverity            String?
  toSeverity              String?
  reason                  String   @db.Text
  reclassifiedAt          DateTime @default(now())
  reclassifiedById        String
  reclassifiedBy          User     @relation("IncidentReclassifier", fields: [reclassifiedById], references: [id])
  // True when escalation requires re-submission of statutory forms.
  triggersStatutoryUpdate Boolean  @default(false)

  @@index([incidentId])
}

// Chronological reconstruction of the event. Investigators add entries
// drawn from witnesses, CCTV, equipment data, and document reviews.
model IncidentTimelineEvent {
  id              String   @id @default(cuid())
  incidentId      String
  incident        Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  sequence        Int // chronological order (drag-reorderable)
  timestamp       DateTime
  description     String   @db.Text
  source          String // WITNESS | CCTV | EQUIPMENT_DATA | INTERVIEW | DOCUMENT
  sourceReference String? // e.g. specific witness id, camera id, log file ref

  @@index([incidentId, sequence])
}

// Evidence collection — distinct from generic IncidentAttachment because
// evidence has stricter chain-of-custody fields (collected by, when,
// preservation purpose) for legal defensibility.
model IncidentEvidence {
  id            String    @id @default(cuid())
  incidentId    String
  incident      Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  category      String // PHOTO | VIDEO | CCTV | EQUIPMENT_DATA | DOCUMENT | SKETCH | EXTERNAL_REPORT
  title         String
  description   String?   @db.Text
  // Storage path inside Supabase bucket (mirrors IncidentAttachment shape)
  fileUrl       String?
  fileName      String?
  fileSize      Int?
  mimeType      String?
  collectedById String?
  collectedBy   User?     @relation("EvidenceCollector", fields: [collectedById], references: [id])
  collectedAt   DateTime?
  preservedFor  String? // legal | regulatory | internal

  @@index([incidentId, category])
}

// Documents reviewed during investigation (SOPs, permits, training records,
// inspections, MOC, PSM). Each review carries a compliance verdict.
model IncidentDocumentReview {
  id                String   @id @default(cuid())
  incidentId        String
  incident          Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  documentType      String // SOP | PERMIT | TRAINING_RECORD | INSPECTION_RECORD | MOC | PSM
  documentReference String // free-text or external description
  documentLinkId    String? // optional FK by id to internal record (e.g. PTW.id)
  reviewNotes       String?  @db.Text
  complianceFinding String? // COMPLIANT | NON_COMPLIANT | NOT_APPLICABLE

  @@index([incidentId])
}

// Formal witness statements with attached signed PDF / scanned form / audio
// recording. Distinct from IncidentPerson(role=WITNESS) because a person
// can give multiple statements over time, and we need taken-by audit fields.
model IncidentWitnessStatement {
  id                String   @id @default(cuid())
  incidentId        String
  incident          Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  witnessUserId     String?
  witnessUser       User?    @relation("WitnessUser", fields: [witnessUserId], references: [id])
  witnessName       String // duplicated for external witnesses
  witnessRole       String?
  statementText     String?  @db.Text
  statementFileUrl  String? // signed PDF or scanned form
  audioRecordingUrl String? // optional audio statement
  takenById         String
  takenBy           User     @relation("StatementTaker", fields: [takenById], references: [id])
  takenAt           DateTime
  language          String? // English | Hindi | Bengali | Khasi

  @@index([incidentId])
}

// Equipment involved in the incident with damage assessment and repair
// status. Multiple equipment can be linked (e.g. crane + load + power source).
model IncidentEquipment {
  id             String    @id @default(cuid())
  incidentId     String
  incident       Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  equipmentId    String
  equipment      Equipment @relation("IncidentEquipmentLink", fields: [equipmentId], references: [id])
  involvement    String // DIRECTLY_INVOLVED | DAMAGED | INADEQUATE_GUARDING | etc.
  damageEstimate Decimal?  @db.Decimal(14, 2)
  repairStatus   String? // PENDING | IN_PROGRESS | REPAIRED | REPLACED | DECOMMISSIONED

  @@index([incidentId])
  @@index([equipmentId])
}

// Multiple CAPAs per incident — replaces the single `correctiveActions` /
// `preventiveActions` text fields on the parent. Each CAPA has its own
// owner, target date, evidence, and 90-day effectiveness rating.
model IncidentCapa {
  id                  String    @id @default(cuid())
  incidentId          String
  incident            Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  capaNumber          String    @unique
  description         String    @db.Text
  type                String // CORRECTIVE | PREVENTIVE
  rootCauseAddressed  String? // links to one of incident.rootCauses entries (free-text match)
  linkedCauseId       String? // Feature 1: RCA cause node this CAPA was raised from
  ownerId             String
  owner               User      @relation("IncidentCapaOwner", fields: [ownerId], references: [id])
  targetDate          DateTime
  status              String // PENDING | IN_PROGRESS | COMPLETED | OVERDUE | VERIFIED | NOT_EFFECTIVE
  evidenceUrls        String[]
  evidenceDescription String?   @db.Text
  beforePhotoUrl      String?
  afterPhotoUrl       String?
  completedAt         DateTime?
  verifiedById        String?
  verifiedBy          User?     @relation("IncidentCapaVerifier", fields: [verifiedById], references: [id])
  verifiedAt          DateTime?
  effectivenessRating Int? // 1-5 at 90-day review
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([incidentId])
  @@index([ownerId])
  @@index([status])
}

// Threaded comments. `isPrivilegedLegal` marks sensitive comments visible
// only to investigation team / HSE Manager / Plant Head / Corporate HSE
// / Legal — workers, supervisors, contractors cannot see them.
model IncidentComment {
  id                String   @id @default(cuid())
  incidentId        String
  incident          Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  authorId          String
  author            User     @relation("IncidentCommentAuthor", fields: [authorId], references: [id])
  content           String   @db.Text
  isPrivilegedLegal Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([incidentId])
}

// ─────────────────────────────────────────────────────────────────────
//  MODULE 5 — Training (production-depth)
// ─────────────────────────────────────────────────────────────────────
//
// Architecture (Commit 1 of the Training refactor):
//
//   TrainingProgram                — master curriculum + assessment +
//   ├─ TrainingProgramQuestion       certification config + SafeOps gates
//   └─ TrainingProgramMaterial
//
//   TrainingSchedule              — one delivery instance of a program
//   ├─ TrainingSession              (multi for multi-day programs)
//   └─ TrainingRegistration         (one per nominee)
//      ├─ TrainingAttendance        (one per session per registration)
//      └─ TrainingAssessment        (one per attempt)
//         └─ TrainingAssessmentResponse  (one per question)
//
//   TrainingCertificate           — issued on successful completion;
//                                   has its own state machine + renewal
//                                   + revocation + effectiveness review
//
//   TrainingRecord                — LEGACY flat row, retained so
//                                   existing PTW / FLRA crew validation
//                                   keeps working during cutover. New
//                                   code reads TrainingCertificate.

model TrainingProgram {
  id          String  @id @default(cuid())
  code        String  @unique // legacy alias for programCode
  programCode String? @unique // canonical e.g. "PTW_HOT_WORK_HOLDER"
  name        String
  programName String? // canonical name (use this in new UIs)
  description String? @db.Text

  // ───── Category & Type ─────
  category String? // INDUCTION | TECHNICAL | BEHAVIOURAL | STATUTORY |
  //   EMERGENCY | LEADERSHIP | COMPLIANCE | REFRESHER
  type     String? // CLASSROOM | E_LEARNING | ON_JOB | BLENDED |
  //   CERTIFICATION | WORKSHOP | DRILL

  // ───── Statutory & Regulatory ─────
  isStatutory               Boolean  @default(false)
  statutoryReference        String? // e.g. "Factories Act 1948 Section 7A"
  isMandatoryForRoles       String[] // role codes — these roles MUST hold this
  isMandatoryForActivities  String[] // activity master codes
  isMandatoryForPermitTypes String[] // permit type codes — drives PTW gate

  // ───── Delivery ─────
  durationHours           Float    @default(4) // legacy column was Int — widened
  durationSessions        Int      @default(1)
  maxParticipantsPerBatch Int      @default(20)
  language                String[] // English | Hindi | Bengali | Khasi | Tamil ...

  // ───── Prerequisites ─────
  prerequisitePrograms    String[] // programCode array
  prerequisiteRoles       String[] // role codes
  minimumExperienceMonths Int? // tenure requirement
  medicalFitnessRequired  Boolean  @default(false)

  // ───── Assessment ─────
  hasAssessment             Boolean @default(false)
  assessmentType            String? // WRITTEN | PRACTICAL | ORAL | PROJECT | OBSERVATION
  passingScore              Int     @default(60) // legacy — keep for back-compat
  passingScorePercent       Int?    @default(70) // canonical
  practicalAssessmentRubric String? @db.Text
  attemptsAllowed           Int     @default(3)

  // ───── Certification ─────
  issuesCertificate                Boolean @default(true)
  certificateTemplateUrl           String?
  validityMonths                   Int // legacy — keep for back-compat (Int required)
  certificateValidityMonths        Int? // canonical (null = lifetime)
  certificateExpiryGracePeriodDays Int     @default(30)
  refresherProgramCode             String? // points to refresher program if separate

  // ───── Content ─────
  contentOutline     Json? // {modules: [{topics: [{subTopics: [...]}]}]}
  learningObjectives String[]

  // ───── Trainer Qualifications ─────
  approvedTrainerIds     String[] // user IDs of qualified trainers
  externalTrainerAllowed Boolean  @default(false)
  trainerQualifications  String?  @db.Text

  // ───── Evaluation & Feedback ─────
  evaluatesEffectiveness    Boolean @default(true)
  effectivenessReviewMonths Int     @default(3)
  feedbackQuestionnaireId   String?

  // ───── SafeOps Gates ─────
  blocksPtwIfMissing                  Boolean @default(false)
  blocksRoleAssignmentIfMissing       Boolean @default(false)
  blocksContractorOnboardingIfMissing Boolean @default(false)

  // ───── Status & Approval ─────
  mandatory      Boolean   @default(false) // legacy boolean — keep until isStatutory + isMandatoryForRoles fully replace
  isActive       Boolean   @default(true)
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  approvalStatus String    @default("APPROVED") // DRAFT | APPROVED | UNDER_REVIEW | RETIRED
  approvedById   String?
  approvedBy     User?     @relation("TrainingProgramApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?

  // ───── Plant scoping (Pydantic referenced this — add for back-compat) ─────
  plantId String?
  plant   Plant?  @relation(fields: [plantId], references: [id])

  // ───── Metadata ─────
  ownerId               String? // typically LD_MANAGER
  owner                 User?     @relation("TrainingProgramOwner", fields: [ownerId], references: [id])
  reviewFrequencyMonths Int       @default(12)
  lastReviewedAt        DateTime?
  nextReviewAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Children
  questions    TrainingProgramQuestion[]
  materials    TrainingProgramMaterial[]
  schedules    TrainingSchedule[]
  records      TrainingRecord[] // legacy
  certificates TrainingCertificate[]

  @@index([category, isActive])
  @@index([isStatutory])
}

model TrainingProgramQuestion {
  id        String          @id @default(cuid())
  programId String
  program   TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  sequence      Int
  questionText  String  @db.Text
  questionType  String // MCQ_SINGLE | MCQ_MULTI | TRUE_FALSE | SHORT_ANSWER | NUMERIC
  options       Json? // for MCQ — array of {text, isCorrect}
  correctAnswer String? // for non-MCQ
  marks         Int     @default(1)
  isCritical    Boolean @default(false) // critical questions must be correct
  explanation   String? @db.Text // shown after assessment

  responses TrainingAssessmentResponse[]

  @@index([programId, sequence])
}

model TrainingProgramMaterial {
  id        String          @id @default(cuid())
  programId String
  program   TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  title       String
  type        String // PDF | VIDEO | SLIDES | IMAGE | DOCUMENT | LINK
  fileUrl     String?
  externalUrl String?
  fileSize    Int?
  duration    Int? // for videos, in seconds
  language    String?
  isMandatory Boolean @default(true)
  sequence    Int     @default(0)
}

// ─── Schedule + Sessions ─────────────────────────────────────────────

model TrainingSchedule {
  id             String          @id @default(cuid())
  scheduleNumber String          @unique // TS-YYYY-PLANT-NNNN
  programId      String
  program        TrainingProgram @relation(fields: [programId], references: [id])

  plantId String
  plant   Plant  @relation(fields: [plantId], references: [id])

  startDate DateTime
  endDate   DateTime
  venue     String
  language  String

  // Trainer
  trainerId           String?
  trainer             User?   @relation("ScheduleTrainer", fields: [trainerId], references: [id])
  isExternalTrainer   Boolean @default(false)
  externalTrainerName String?
  externalTrainerOrg  String?
  externalTrainerCert String?

  maxParticipants Int

  status String @default("DRAFT") // DRAFT | PUBLISHED | NOMINATIONS_OPEN | IN_PROGRESS |
  //   COMPLETED | CANCELLED | POSTPONED

  publishedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?

  // Effectiveness rollups (computed on completion)
  trainerEffectivenessScore   Float?
  participantSatisfaction     Float?
  immediateAssessmentPassRate Float?

  // Audit
  createdById  String
  createdBy    User      @relation("ScheduleCreator", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?     @relation("ScheduleApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  sessions      TrainingSession[]
  registrations TrainingRegistration[]

  @@index([plantId, status])
  @@index([programId, startDate])
}

model TrainingSession {
  id         String           @id @default(cuid())
  scheduleId String
  schedule   TrainingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  sequence              Int
  title                 String
  startTime             DateTime
  endTime               DateTime
  trainerId             String? // can override schedule trainer per session
  trainer               User?     @relation("SessionTrainer", fields: [trainerId], references: [id])
  topicsCovered         Json?
  conductedAt           DateTime?
  durationMinutesActual Int?

  attendances TrainingAttendance[]

  @@index([scheduleId, sequence])
}

// ─── Registration + Attendance + Assessment ──────────────────────────

model TrainingRegistration {
  id         String           @id @default(cuid())
  scheduleId String
  schedule   TrainingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("RegistrationUser", fields: [userId], references: [id])

  // Why registered
  registrationType String // SELF_NOMINATED | MANAGER_NOMINATED | MANDATORY_AUTO | TRIGGERED
  nominatedById    String?
  nominatedBy      User?   @relation("RegistrationNominator", fields: [nominatedById], references: [id])
  triggerReason    String? // ROLE_REQUIREMENT | EXPIRY_RENEWAL | INCIDENT_TRIGGERED |
  //   CONTRACTOR_ONBOARDING | NEW_HIRE | VOLUNTARY
  triggerSourceId  String? // ID of source event (incident ID, expiry alert, etc.)

  // Pre-validation snapshot
  prerequisitesMet        Boolean @default(false)
  prerequisiteCheckResult Json?

  // Approval (if manager approval required)
  approvalStatus String    @default("NOT_REQUIRED") // PENDING | APPROVED | REJECTED | NOT_REQUIRED
  approvedById   String?
  approvedBy     User?     @relation("RegistrationApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?

  status String @default("REGISTERED") // REGISTERED | CONFIRMED | ATTENDED | NO_SHOW |
  //   CANCELLED | COMPLETED | FAILED | WITHDREW

  // Final outcome (set on schedule completion)
  attendancePercent  Float?
  assessmentScore    Float?
  assessmentAttempts Int      @default(0)
  passed             Boolean?

  certificateId String?              @unique
  certificate   TrainingCertificate? @relation(fields: [certificateId], references: [id])

  registeredAt DateTime @default(now())

  attendances TrainingAttendance[]
  assessments TrainingAssessment[]

  @@unique([scheduleId, userId])
  @@index([userId, status])
}

model TrainingAttendance {
  id        String          @id @default(cuid())
  sessionId String
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  registrationId String
  registration   TrainingRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  status          String // PRESENT | ABSENT | LATE | LEFT_EARLY | MEDICAL_LEAVE
  arrivalTime     DateTime?
  departureTime   DateTime?
  durationMinutes Int?

  // Attendance proof
  signatureCaptured Boolean   @default(false)
  signatureUrl      String?
  qrScanned         Boolean   @default(false)
  qrScannedAt       DateTime?
  geoLocation       Json? // GPS at scan
  attendancePhotos  Json?

  notes String?

  capturedById String
  capturedBy   User     @relation("AttendanceCapturer", fields: [capturedById], references: [id])
  capturedAt   DateTime @default(now())

  @@unique([sessionId, registrationId])
}

model TrainingAssessment {
  id             String               @id @default(cuid())
  registrationId String
  registration   TrainingRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  attemptNumber Int @default(1)

  startedAt       DateTime
  submittedAt     DateTime?
  durationMinutes Int?

  // For practical: rubric scoring + narrative
  practicalScores   Json?
  practicalNotes    String?
  assessorNarrative String? @db.Text

  // Result
  totalScore     Float?
  totalMarks     Float
  scorePercent   Float?
  passed         Boolean
  failureReasons String[] // critical_question_wrong | below_threshold | etc.

  assessedById String
  assessedBy   User   @relation("AssessmentAssessor", fields: [assessedById], references: [id])

  remediationRequired Boolean   @default(false)
  remediationPlan     String?   @db.Text
  retakeAllowed       Boolean   @default(true)
  retakeAfterDate     DateTime?

  responses TrainingAssessmentResponse[]

  @@unique([registrationId, attemptNumber])
}

model TrainingAssessmentResponse {
  id           String             @id @default(cuid())
  assessmentId String
  assessment   TrainingAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  questionId String
  question   TrainingProgramQuestion @relation(fields: [questionId], references: [id])

  selectedOptions Json? // for MCQ
  textAnswer      String? // for short answer
  numericAnswer   Float? // for numeric

  isCorrect    Boolean
  marksAwarded Float
}

// ─── Certificate (state machine + renewal + revocation + effectiveness) ─

model TrainingCertificate {
  id                String          @id @default(cuid())
  certificateNumber String          @unique // CERT-YYYY-PLANT-NNNN
  programId         String
  program           TrainingProgram @relation(fields: [programId], references: [id])
  userId            String
  user              User            @relation("CertificateHolder", fields: [userId], references: [id])

  registrationId String? @unique // null when issued via legacy backfill

  issuedAt   DateTime @default(now())
  issuedById String?
  issuedBy   User?    @relation("CertificateIssuer", fields: [issuedById], references: [id])

  finalAssessmentScore Float?
  attendancePercent    Float?

  validFrom DateTime
  validTo   DateTime? // null = lifetime

  status String @default("ACTIVE") // ACTIVE | EXPIRING_SOON | EXPIRED | REVOKED | LAPSED

  // Renewal chain
  isRenewable              Boolean              @default(true)
  renewedFromCertificateId String?              @unique
  renewedFrom              TrainingCertificate? @relation("CertificateRenewal", fields: [renewedFromCertificateId], references: [id])
  renewedToCertificate     TrainingCertificate? @relation("CertificateRenewal")

  // Expiry reminder cascade
  firstExpiryReminderSent     DateTime? // 90 days before
  secondExpiryReminderSent    DateTime? // 60 days before
  thirdExpiryReminderSent     DateTime? // 30 days before
  finalExpiryReminderSent     DateTime? // 7 days before
  refresherScheduledForUserAt DateTime?

  // Revocation
  revokedAt         DateTime?
  revokedById       String?
  revokedBy         User?     @relation("CertificateRevoker", fields: [revokedById], references: [id])
  revocationReason  String? // INCIDENT_INVOLVEMENT | DISCIPLINARY | ROLE_CHANGE |
  //   HEALTH_REASONS | TRAINING_FRAUD | OTHER
  revocationDetails String?   @db.Text

  // Certificate file
  certificatePdfUrl String?
  certificateQrCode String?
  digitalSignature  String? // hash for tamper detection

  // Effectiveness review (3-month default post-issue)
  effectivenessReviewedAt   DateTime?
  effectivenessReviewedById String?
  effectivenessReviewedBy   User?     @relation("CertificateEffectivenessReviewer", fields: [effectivenessReviewedById], references: [id])
  effectivenessRating       Int? // 1-5
  effectivenessNotes        String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  registration TrainingRegistration?

  @@index([userId, status])
  @@index([programId, status])
  @@index([validTo, status])
}

// ─── Legacy ──────────────────────────────────────────────────────────
// Retained so existing PTW / FLRA crew validation keeps working during
// the cutover to TrainingCertificate. New code reads TrainingCertificate.

model TrainingRecord {
  id             String          @id @default(cuid())
  employeeId     String
  employee       User            @relation(fields: [employeeId], references: [id])
  programId      String
  program        TrainingProgram @relation(fields: [programId], references: [id])
  trainerId      String?
  trainer        User?           @relation("TrainerRecords", fields: [trainerId], references: [id])
  trainerName    String?
  date           DateTime
  durationHours  Int
  score          Int?
  passed         Boolean         @default(true)
  validUntil     DateTime
  certificateUrl String?
  remarks        String?

  triggeringObservations Observation[] @relation("ObservationTriggeredTbt")

  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────
//  MODULE 6 — Inspection (production-depth refactor)
//
//  Architecture:
//    InspectionType (master) → defines kind of inspection (Routine | Statutory
//      | Pre-Op | Post-Incident | Condition-Based | Third-Party) and sets
//      defaults for frequency, statutory awareness, certification gate.
//    ChecklistTemplate (master) → versioned, approved, attached to a type.
//      Holds typed ChecklistItem children (PASS_FAIL | NUMERIC | SELECT |
//      TEXT | PHOTO | SIGNATURE | MEASUREMENT | CHECKBOX) with thresholds
//      and critical flags.
//    Equipment ↔ InspectionType (EquipmentInspectionType join) → an item of
//      equipment can have multiple inspection regimens (daily walkaround +
//      monthly mechanical + annual statutory) each with own frequency &
//      checklist override.
//    Inspection → an instance generated from the schedule. Carries per-item
//      results (InspectionItemResult, replaces the old JSON blob) and
//      Findings (one per failed/observed item, with parallel CAPAs).
//    InspectionFinding → has its own lifecycle (OPEN → IN_PROGRESS →
//      CLOSED → VERIFIED), can spawn CAPAs (correction / corrective /
//      preventive), be deferred, marked duplicate, or sent for
//      effectiveness review.
// ─────────────────────────────────────────────────────────────────────

enum InspectionFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
}

enum InspectionStatus {
  SCHEDULED
  DUE
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
  DEFERRED
}

enum InspectionTypeCategory {
  ROUTINE
  STATUTORY
  PRE_OPERATIONAL
  POST_INCIDENT
  CONDITION_BASED
  THIRD_PARTY
  FOCUSED
}

enum ChecklistItemType {
  PASS_FAIL
  NUMERIC
  MEASUREMENT
  SELECT
  TEXT
  PHOTO
  SIGNATURE
  CHECKBOX
  SECTION_HEADER
}

enum ChecklistItemResultStatus {
  PASS
  FAIL
  MARGINAL
  NA
  OBSERVATION
  PENDING
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingStatus {
  OPEN
  UNDER_REVIEW
  IN_PROGRESS
  DEFERRED
  DUPLICATE
  CLOSED
  VERIFIED
}

enum FindingCapaType {
  CORRECTION
  CORRECTIVE_ACTION
  PREVENTIVE_ACTION
}

enum FindingCapaStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  VERIFIED
  OVERDUE
  REJECTED
}

model InspectionType {
  id          String                 @id @default(cuid())
  code        String                 @unique
  name        String
  description String?                @db.Text
  category    InspectionTypeCategory @default(ROUTINE)

  // Default scheduling — equipment can override per its own InspectionType row
  defaultFrequency InspectionFrequency @default(MONTHLY)

  // Equipment scoping — which categories can carry this type
  applicableEquipmentCategories String[]

  // ───── Statutory awareness ─────
  isStatutory         Boolean @default(false)
  statutoryReference  String? // e.g. "Factories Act 1948 / Form 11"
  regulatoryAuthority String? // e.g. "Chief Inspector of Factories"
  statutoryFormType   String? // e.g. "FORM_11_PRESSURE_VESSEL" | "FORM_13_LIFTING"
  retentionYears      Int     @default(7) // record retention requirement

  // ───── Inspector competency gate ─────
  requiresCertifiedInspector Boolean  @default(false)
  requiredCertificationCodes String[] // TrainingProgram codes — inspector must hold these

  // ───── Workflow & approval ─────
  workflowDefinitionCode String? // overrides default INSPECTION workflow

  // ───── Status ─────
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Relations
  defaultChecklistTemplateId String?
  defaultChecklistTemplate   ChecklistTemplate?        @relation("InspectionTypeDefaultTemplate", fields: [defaultChecklistTemplateId], references: [id])
  checklistTemplates         ChecklistTemplate[]       @relation("InspectionTypeTemplates")
  equipmentLinks             EquipmentInspectionType[]
  inspections                Inspection[]

  @@index([category, isActive])
  @@index([isStatutory])
}

model ChecklistTemplate {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String? @db.Text

  // Type binding — every template belongs to one InspectionType
  inspectionTypeId String
  inspectionType   InspectionType @relation("InspectionTypeTemplates", fields: [inspectionTypeId], references: [id])

  // Versioning — newer version supersedes prior; old inspections retain
  // snapshot via Inspection.checklistTemplateVersionLabel
  version          Int     @default(1)
  parentTemplateId String? // points to the previous version this superseded

  // Equipment scope
  applicableEquipmentCategories String[]

  // ───── Approval lifecycle ─────
  approvalStatus String    @default("DRAFT") // DRAFT | APPROVED | UNDER_REVIEW | RETIRED
  approvedById   String?
  approvedBy     User?     @relation("ChecklistTemplateApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  effectiveFrom  DateTime?
  effectiveTo    DateTime?

  // ───── Status ─────
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  createdBy   User?    @relation("ChecklistTemplateAuthor", fields: [createdById], references: [id])

  // Children
  items                ChecklistItem[]
  inspections          Inspection[]
  inspectionTypesUsing InspectionType[]          @relation("InspectionTypeDefaultTemplate")
  equipmentOverrides   EquipmentInspectionType[]

  @@index([inspectionTypeId, isActive])
  @@index([approvalStatus])
}

model ChecklistItem {
  id         String            @id @default(cuid())
  templateId String
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  sequence     Int
  sectionTitle String? // optional grouping
  itemText     String            @db.Text
  itemType     ChecklistItemType @default(PASS_FAIL)

  // ───── Type-specific configuration ─────
  options       Json? // for SELECT — array of {value, label}
  units         String? // e.g. "bar", "°C", "mm" — for NUMERIC/MEASUREMENT
  minValue      Float? // for NUMERIC/MEASUREMENT — below this = FAIL
  maxValue      Float? // for NUMERIC/MEASUREMENT — above this = FAIL
  expectedValue String? // free text — what "Pass" looks like (display hint)

  // ───── Behaviour ─────
  isCritical      Boolean @default(false) // failure → critical Finding
  requiresPhoto   Boolean @default(false)
  requiresComment Boolean @default(false)
  guidanceText    String? @db.Text

  itemResults InspectionItemResult[]

  @@index([templateId, sequence])
}

model EquipmentInspectionType {
  id               String         @id @default(cuid())
  equipmentId      String
  equipment        Equipment      @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  inspectionTypeId String
  inspectionType   InspectionType @relation(fields: [inspectionTypeId], references: [id])

  // Optional overrides — null means use the InspectionType defaults
  frequencyOverride   InspectionFrequency?
  checklistTemplateId String?
  checklistTemplate   ChecklistTemplate?   @relation(fields: [checklistTemplateId], references: [id])
  defaultInspectorId  String?
  defaultInspector    User?                @relation("EqInspectionTypeInspector", fields: [defaultInspectorId], references: [id])

  // Cached scheduling state — updated by schedule generator
  lastInspectionDate DateTime?
  nextInspectionDue  DateTime?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  inspections Inspection[]

  @@unique([equipmentId, inspectionTypeId])
  @@index([nextInspectionDue, isActive])
}

model Equipment {
  id           String  @id @default(cuid())
  code         String  @unique
  name         String
  category     String // "Kiln", "Mill", "Mobile Equipment", "Fire Safety", etc.
  subCategory  String?
  plantId      String
  plant        Plant   @relation(fields: [plantId], references: [id])
  departmentId String? // optional FK to MasterItem department
  location     String

  // ───── Identification ─────
  make                        String?
  modelNumber                 String?
  serialNumber                String?
  manufacturer                String?
  commissioningDate           DateTime?
  decommissionDate            DateTime?
  statutoryRegistrationNumber String?

  // ───── Criticality (drives PTW gate, finding severity weighting) ─────
  criticality String? // "A" | "B" | "C" | "D"

  // ───── Cached inspection state ─────
  lastInspectionDate DateTime?
  nextInspectionDue  DateTime?

  // ───── Legacy single-frequency fields (kept for back-compat with old
  // seed + simple inspection-form. New UIs use EquipmentInspectionType.) ─────
  frequency         InspectionFrequency
  checklistTemplate String? // legacy — JSON list of items

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  inspections       Inspection[]
  inspectionTypes   EquipmentInspectionType[]
  // Near misses involving this equipment — feeds Rule 4 (equipment review)
  nearMisses        NearMiss[]
  // Incidents involving this equipment (multi via IncidentEquipment join)
  incidentLinks     IncidentEquipment[]       @relation("IncidentEquipmentLink")
  // PTW: tools/equipment used during the permit
  permitToolUses    PermitToolEquipment[]     @relation("PermitToolEquipment")
  // PTW: equipment being worked on (subject of the permit)
  permitSubjectUses PermitSubjectEquipment[]  @relation("PermitSubjectEquipment")

  @@index([plantId, active])
  @@index([nextInspectionDue])
}

model Inspection {
  id               String           @id @default(cuid())
  number           String           @unique
  equipmentId      String
  equipment        Equipment        @relation(fields: [equipmentId], references: [id])
  plantId          String
  plant            Plant            @relation(fields: [plantId], references: [id])
  scheduledDate    DateTime
  completedDate    DateTime?
  inspectorId      String?
  inspector        User?            @relation(fields: [inspectorId], references: [id])
  status           InspectionStatus @default(SCHEDULED)
  result           String? // "Pass", "Fail", "Partial" — legacy text label
  checklistResult  String? // legacy JSON; new code reads itemResults[]
  observations     String?
  photoUrl         String?
  followUpRequired Boolean          @default(false)

  // ───── Type & template binding ─────
  inspectionTypeId          String?
  inspectionType            InspectionType?          @relation(fields: [inspectionTypeId], references: [id])
  equipmentInspectionTypeId String?
  equipmentInspectionType   EquipmentInspectionType? @relation(fields: [equipmentInspectionTypeId], references: [id])
  checklistTemplateId       String?
  checklistTemplate         ChecklistTemplate?       @relation(fields: [checklistTemplateId], references: [id])
  checklistTemplateVersion  Int? // snapshot — survives template upgrades

  // ───── Statutory awareness ─────
  isStatutory                       Boolean   @default(false)
  statutoryFormType                 String?
  statutoryFormSubmittedAt          DateTime?
  statutoryFormAcknowledgmentNumber String?

  // ───── Reschedule trail ─────
  rescheduledFromInspectionId String?
  rescheduledFromInspection   Inspection?  @relation("InspectionReschedule", fields: [rescheduledFromInspectionId], references: [id])
  rescheduledTo               Inspection[] @relation("InspectionReschedule")
  rescheduleReason            String?
  rescheduleCount             Int          @default(0)

  // ───── Deferral ─────
  deferredUntil  DateTime?
  deferredReason String?
  deferredById   String?
  deferredBy     User?     @relation("InspectionDeferredBy", fields: [deferredById], references: [id])
  deferredAt     DateTime?

  // ───── Sign-off ─────
  inspectorSignature String?   @db.Text // base64 PNG
  inspectorSignedAt  DateTime?
  reviewerId         String?
  reviewer           User?     @relation("InspectionReviewer", fields: [reviewerId], references: [id])
  reviewerSignature  String?   @db.Text
  reviewerSignedAt   DateTime?
  closedAt           DateTime?
  closedById         String?
  closedBy           User?     @relation("InspectionCloser", fields: [closedById], references: [id])

  // ───── Cross-module trace ─────
  triggeredByIncidentId   String?
  triggeredByIncidentType String? // FOCUSED | POST_INCIDENT
  pdfUrl                  String? // generated closed-record PDF

  // Reverse: observations that spawned this inspection (Rule 1 / Rule 4)
  triggeringObservations Observation[]          @relation("ObservationTriggeredInspection")
  itemResults            InspectionItemResult[]
  findings               InspectionFinding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([plantId, status])
  @@index([scheduledDate, status])
  @@index([inspectorId, status])
  @@index([inspectionTypeId])
}

model InspectionItemResult {
  id                 String            @id @default(cuid())
  inspectionId       String
  inspection         Inspection        @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  // Item ref + snapshot — snapshots survive template upgrades
  checklistItemId    String?
  checklistItem      ChecklistItem?    @relation(fields: [checklistItemId], references: [id])
  sequence           Int
  sectionTitle       String?
  itemTextSnapshot   String            @db.Text
  itemTypeSnapshot   ChecklistItemType
  isCriticalSnapshot Boolean           @default(false)

  // Result
  resultStatus  ChecklistItemResultStatus @default(PENDING)
  valueText     String?                   @db.Text
  valueNumeric  Float?
  valueDate     DateTime?
  photoUrls     String[]
  signatureData String?                   @db.Text
  comment       String?                   @db.Text

  // Capture metadata
  capturedById String?
  capturedBy   User?     @relation("ItemResultCapturer", fields: [capturedById], references: [id])
  capturedAt   DateTime?

  // Optional 1:1 to a Finding spawned from this failed item
  finding InspectionFinding?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([inspectionId, sequence])
  @@index([resultStatus])
}

model InspectionFinding {
  id            String     @id @default(cuid())
  findingNumber String     @unique // e.g. FND-2026-0001
  inspectionId  String
  inspection    Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  // Optional 1:1 to the failed item that spawned it
  itemResultId String?               @unique
  itemResult   InspectionItemResult? @relation(fields: [itemResultId], references: [id])

  title       String
  description String          @db.Text
  severity    FindingSeverity @default(MEDIUM)
  isCritical  Boolean         @default(false)

  // ───── Lifecycle ─────
  status  FindingStatus @default(OPEN)
  ownerId String?
  owner   User?         @relation("FindingOwner", fields: [ownerId], references: [id])
  dueDate DateTime?

  closedAt    DateTime?
  closedById  String?
  closedBy    User?     @relation("FindingCloser", fields: [closedById], references: [id])
  closureNote String?   @db.Text

  verifiedAt   DateTime?
  verifiedById String?
  verifiedBy   User?     @relation("FindingVerifier", fields: [verifiedById], references: [id])

  // ───── Effectiveness review (90-day post-close) ─────
  effectivenessReviewedAt   DateTime?
  effectivenessReviewedById String?
  effectivenessReviewedBy   User?     @relation("FindingEffectivenessReviewer", fields: [effectivenessReviewedById], references: [id])
  effectivenessRating       String? // EFFECTIVE | PARTIAL | NOT_EFFECTIVE | RECURRENCE
  effectivenessNote         String?   @db.Text

  // ───── Deferral ─────
  deferredUntil  DateTime?
  deferredReason String?

  // ───── Duplicate handling ─────
  duplicateOfFindingId String?
  duplicateOfFinding   InspectionFinding?  @relation("FindingDuplicate", fields: [duplicateOfFindingId], references: [id])
  duplicates           InspectionFinding[] @relation("FindingDuplicate")

  // ───── Diagnostic context ─────
  rootCauseCategory String? // 5M: MAN | MACHINE | METHOD | MATERIAL | MEASUREMENT | ENVIRONMENT
  rootCauseNote     String?  @db.Text
  photoUrls         String[]
  escalationLevel   Int      @default(0)

  // ───── Cross-module ─────
  spawnedObservationId String? // if escalation → observation
  spawnedNearMissId    String?
  spawnedIncidentId    String?

  capas InspectionFindingCapa[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([status, dueDate])
  @@index([severity, isCritical])
  @@index([ownerId, status])
}

model InspectionFindingCapa {
  id        String            @id @default(cuid())
  findingId String
  finding   InspectionFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  capaType    FindingCapaType   @default(CORRECTIVE_ACTION)
  description String            @db.Text
  ownerId     String?
  owner       User?             @relation("FindingCapaOwner", fields: [ownerId], references: [id])
  dueDate     DateTime?
  status      FindingCapaStatus @default(OPEN)

  completedAt   DateTime?
  completedById String?
  completedBy   User?     @relation("FindingCapaCompleter", fields: [completedById], references: [id])

  verifiedAt   DateTime?
  verifiedById String?
  verifiedBy   User?     @relation("FindingCapaVerifier", fields: [verifiedById], references: [id])

  evidenceUrls String[]
  evidenceNote String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([findingId, status])
  @@index([ownerId, status])
}

// ─────────────────────────────────────────────────────────────────────
//  MODULE 7 — Manhours
// ─────────────────────────────────────────────────────────────────────

model Manhours {
  id              String   @id @default(cuid())
  plantId         String
  plant           Plant    @relation(fields: [plantId], references: [id])
  year            Int
  month           Int // 1-12
  employeeHours   Int
  contractorHours Int
  fatalityCount   Int      @default(0)
  ltiCount        Int      @default(0)
  rwcCount        Int      @default(0)
  mtcCount        Int      @default(0)
  facCount        Int      @default(0)
  lostDays        Int      @default(0)
  ltifr           Decimal  @default(0) @db.Decimal(10, 4) // computed
  trir            Decimal  @default(0) @db.Decimal(10, 4)
  severityRate    Decimal  @default(0) @db.Decimal(10, 4)
  locked          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([plantId, year, month])
}

// ─────────────────────────────────────────────────────────────────────
//  MODULE 7 — Manhours (Production-Depth refactor — Commit 1)
//
//  Replaces the flat `Manhours` row above with a full submission model:
//    • multi-category headcount + hours (permanent / contract / trainee)
//    • visitor exposure tracked separately
//    • statutory deductions (annual leave, sick leave, off-job training,
//      maternity, other) → net exposure hours per IS 3786
//    • full workflow audit (submitter → reviewer → locker) with reasons
//    • unlock event chain — every unlock is logged with a diff + re-lock
//    • KPI snapshot captured at LOCKED so historical numbers stay
//      immutable even when source incidents get reclassified later
//
//  Legacy `Manhours` rows are preserved; the dashboard read path keeps
//  working until C2's wizard and C6's seed retire them.
// ─────────────────────────────────────────────────────────────────────

model ManhoursSubmission {
  id               String  @id @default(cuid())
  // MH-YYYY-PLANT-MM. Assigned at SUBMITTED transition (Commit 2);
  // remains null while in DRAFT so collisions don't block save-resume.
  submissionNumber String? @unique

  plantId              String
  plant                Plant    @relation(fields: [plantId], references: [id])
  reportingYear        Int
  reportingMonth       Int // 1-12
  reportingPeriodStart DateTime
  reportingPeriodEnd   DateTime

  // ── Headcount + hours by category ──
  // Single relation; rows are discriminated by `categoryType`. Simpler
  // than three FK columns and matches how the wizard + engine group on
  // read. Visitors are 1:1 because they're a single aggregate, not a
  // per-department breakdown.
  categories ManhoursEmployeeCategory[]
  visitors   ManhoursVisitorRecord?

  // ── Aggregates (computed on save / submit) ──
  totalManhoursPermanent  Float @default(0)
  totalManhoursContract   Float @default(0)
  totalManhoursTrainee    Float @default(0)
  totalManhoursAll        Float @default(0)
  totalEmployeeStrength   Int   @default(0)
  totalContractorStrength Int   @default(0)
  totalDaysWorked         Int   @default(0)
  totalShiftsWorked       Int   @default(0)

  // ── Deductions (IS 3786 — hours NOT counted toward exposure) ──
  hoursAnnualLeave     Float @default(0)
  hoursSickLeave       Float @default(0)
  hoursTraining        Float @default(0)
  hoursMaternityLeave  Float @default(0)
  hoursOther           Float @default(0)
  hoursDeductionsTotal Float @default(0)

  // ── Net exposure hours = totalManhoursAll − hoursDeductionsTotal ──
  // This is the LTIFR/TRIR/Severity denominator per IS 3786. The
  // existing flat `Manhours.employeeHours + contractorHours` is GROSS,
  // which silently produces optimistic KPIs — see the audit's "wrong
  // denominator" finding.
  netExposureHours Float @default(0)

  // ── KPI snapshot — captured at LOCKED transition ──
  // Stores numerator records + denominator value + formula at the
  // moment of lock, so re-computation later doesn't mutate historical
  // KPIs even if source incidents get reclassified.
  kpiSnapshot Json?

  // ── Workflow status ──
  // DRAFT | SUBMITTED | UNDER_REVIEW | APPROVED | LOCKED | UNLOCKED_FOR_REVISION
  status String @default("DRAFT")

  // Submission (HSE Manager)
  submittedById   String?
  submittedBy     User?     @relation("ManhoursSubmitter", fields: [submittedById], references: [id])
  submittedAt     DateTime?
  submissionNotes String?   @db.Text

  // Review (Plant Head)
  reviewedById   String?
  reviewedBy     User?     @relation("ManhoursReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewerNotes  String?   @db.Text
  reviewDecision String? // APPROVED | REJECTED | RETURNED_FOR_REVISION

  // Lock (Corporate HSE)
  lockedById String?
  lockedBy   User?     @relation("ManhoursLocker", fields: [lockedById], references: [id])
  lockedAt   DateTime?
  lockNotes  String?   @db.Text

  // Unlock audit chain — every unlock is a row, paired with its re-lock.
  unlockHistory ManhoursUnlockEvent[]

  attachments ManhoursAttachment[]
  comments    ManhoursComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([plantId, reportingYear, reportingMonth])
  @@index([status])
  @@index([plantId, reportingYear, reportingMonth])
}

model ManhoursEmployeeCategory {
  id           String             @id @default(cuid())
  submissionId String
  submission   ManhoursSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // PERMANENT | CONTRACT | TRAINEE
  categoryType String

  // Optional grouping dimensions
  departmentId String?
  department   Department? @relation("ManhoursCategoryDepartment", fields: [departmentId], references: [id])

  // FK by id to MasterItem(type=SHIFT) — not enforced (matches Incident
  // pattern at line 1499; MasterItem's PK is `id` but shifts are
  // semantically keyed by `code`, so we leave the column loose).
  shiftId String?

  contractorCompanyId String?
  contractorCompany   ContractorCompany? @relation("ManhoursCategoryContractor", fields: [contractorCompanyId], references: [id])

  averageHeadcount     Int @default(0)
  peakHeadcount        Int @default(0)
  endOfPeriodHeadcount Int @default(0)

  regularHours  Float @default(0)
  overtimeHours Float @default(0)
  totalHours    Float @default(0)

  notes String?

  @@index([submissionId, categoryType])
  @@index([contractorCompanyId])
  @@index([departmentId])
}

model ManhoursVisitorRecord {
  id           String             @id @default(cuid())
  submissionId String             @unique
  submission   ManhoursSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  totalVisitorCount Int     @default(0)
  totalVisitorHours Float   @default(0)
  // VIP visits, audit visits, regulator visits, etc.
  notableVisits     String? @db.Text
}

model ManhoursUnlockEvent {
  id           String             @id @default(cuid())
  submissionId String
  submission   ManhoursSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  unlockedAt   DateTime @default(now())
  unlockedById String
  unlockedBy   User     @relation("ManhoursUnlocker", fields: [unlockedById], references: [id])
  reason       String   @db.Text

  // Diff captured when re-locked. Shape: { before: {...}, after: {...} }.
  changeLog Json?

  reLockedAt   DateTime?
  reLockedById String?
  reLockedBy   User?     @relation("ManhoursReLocker", fields: [reLockedById], references: [id])

  @@index([submissionId])
}

model ManhoursAttachment {
  id           String             @id @default(cuid())
  submissionId String
  submission   ManhoursSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // ATTENDANCE_REPORT | PAYROLL_EXPORT | HR_SYSTEM_EXPORT |
  // CONTRACTOR_BILL | STATUTORY_FORM | OTHER
  category String

  fileName String
  fileUrl  String
  fileSize Int
  mimeType String
  caption  String?

  uploadedById String
  uploadedBy   User     @relation("ManhoursAttachmentUploader", fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  @@index([submissionId])
}

model ManhoursComment {
  id           String             @id @default(cuid())
  submissionId String
  submission   ManhoursSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  authorId     String
  author       User               @relation("ManhoursCommentAuthor", fields: [authorId], references: [id])
  content      String             @db.Text
  createdAt    DateTime           @default(now())

  @@index([submissionId])
}

// ─────────────────────────────────────────────────────────────────────
//  WORKFLOW ENGINE — Generic Maker → Checker → Assignee → Verifier → Closure
//  Reused by every module: Observation, NearMiss, PTW, Incident, Training, Inspection, Manhours
// ─────────────────────────────────────────────────────────────────────

model WorkflowDefinition {
  id          String                      @id @default(cuid())
  module      String // "OBSERVATION" | "NEAR_MISS" | "PTW" | "INCIDENT" | "TRAINING" | "INSPECTION" | "MANHOURS"
  recordType  String? // e.g. for PTW: "HOT_WORK" / "CONFINED_SPACE" — null = applies to all subtypes
  name        String
  description String?
  isActive    Boolean                     @default(true)
  steps       WorkflowStep[]
  instances   WorkflowInstance[]
  versions    WorkflowDefinitionVersion[]
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  @@index([module, recordType, isActive])
}

model WorkflowStep {
  id                 String             @id @default(cuid())
  definitionId       String
  definition         WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  sequence           Int // 1, 2, 3...
  stepType           String // "MAKER" | "CHECKER" | "ASSIGNEE_TASK" | "VERIFIER" | "CLOSURE"
  name               String // display: "Safety Officer Review"
  approverRole       String? // role: "HSE_MANAGER", "PLANT_HEAD", "WORKER"
  approverField      String? // field-based: "AREA_OWNER", "ACTION_OWNER", "ORIGINATOR" (resolved at runtime)
  approverUserId     String? // assignment mode 3: a specific named user
  approverUser       User?              @relation("WorkflowStepSpecificApprover", fields: [approverUserId], references: [id])
  approverGroupRoles String? // assignment mode 4: JSON array of role names — task offered to anyone in the union
  slaHours           Int?
  slaUnit            String? // "HOURS" | "DAYS" — display preference; slaHours is canonical
  escalationRole     String?
  isOptional         Boolean            @default(false)
  conditionExpr      String? // JSON. v1: {"severity": ["HIGH","CRITICAL"]}. v2: {"version":2,"combinator":"AND|OR","rules":[{field,operator,value}]}
  notes              String? // instructions / context shown to the approver when they receive the task
  // Parallel-task strategy used by the engine when entering this step.
  //   null              — single task (default behaviour)
  //   "JOINT_APPROVAL"  — one task per role in approverGroupRoles, all
  //                       must complete before the workflow advances
  //   "CAPA_FAN_OUT"    — for NEAR_MISS, one EXECUTION task per
  //                       NearMissCapa row tied to the parent record
  parallelStrategy   String?
  // Severity-driven SLA override. Optional JSON: {"LOW":336,"MEDIUM":168,"HIGH":48,"CRITICAL":24}
  // — engine picks the matching key based on the parent record's severity
  // and falls back to slaHours when absent.
  slaBySeverity      Json?
  createdAt          DateTime           @default(now())

  @@index([definitionId, sequence])
}

model WorkflowDefinitionVersion {
  id           String             @id @default(cuid())
  definitionId String
  definition   WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  version      Int
  snapshot     String // JSON snapshot of definition + all steps at the time of save
  editedById   String
  editedBy     User               @relation("WorkflowVersionEditor", fields: [editedById], references: [id])
  editedAt     DateTime           @default(now())
  changeNote   String?

  @@unique([definitionId, version])
  @@index([definitionId])
}

model WorkflowInstance {
  id              String             @id @default(cuid())
  definitionId    String
  definition      WorkflowDefinition @relation(fields: [definitionId], references: [id])
  module          String
  recordId        String // FK to the actual observation/permit/incident record
  recordNumber    String? // for display
  currentStepId   String?
  currentStepName String?
  status          String // "DRAFT" | "IN_PROGRESS" | "APPROVED" | "REJECTED" | "COMPLETED" | "CANCELLED"
  initiatedById   String
  initiatedBy     User               @relation("WorkflowInitiator", fields: [initiatedById], references: [id])
  initiatedAt     DateTime           @default(now())
  completedAt     DateTime?
  history         WorkflowHistory[]
  pendingTasks    WorkflowTask[]

  @@unique([module, recordId])
  @@index([status])
}

model WorkflowHistory {
  id            String           @id @default(cuid())
  instanceId    String
  instance      WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepId        String?
  stepName      String
  action        String // "INITIATED" | "SUBMITTED" | "APPROVED" | "REJECTED" | "REASSIGNED" | "COMPLETED" | "ESCALATED" | "COMMENTED" | "EXECUTED" | "VERIFIED"
  performedById String
  performedBy   User             @relation("WorkflowActor", fields: [performedById], references: [id])
  performedAt   DateTime         @default(now())
  comments      String?
  attachments   String? // JSON array
  fromStatus    String?
  toStatus      String?

  @@index([instanceId, performedAt])
}

model WorkflowTask {
  id           String           @id @default(cuid())
  instanceId   String
  instance     WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepId       String
  stepName     String
  taskType     String // "APPROVAL" | "EXECUTION" | "VERIFICATION"
  module       String // duplicated from instance for fast inbox queries
  recordId     String // duplicated from instance
  recordNumber String?
  recordTitle  String? // short summary for inbox display
  assignedToId String
  assignedTo   User             @relation("WorkflowAssignee", fields: [assignedToId], references: [id])
  assignedAt   DateTime         @default(now())
  dueAt        DateTime?
  status       String // "PENDING" | "COMPLETED" | "OVERDUE" | "ESCALATED" | "REASSIGNED"
  completedAt  DateTime?
  priority     String           @default("NORMAL") // "LOW" | "NORMAL" | "HIGH" | "URGENT"
  // Inbox read state, same contract as Notification.readAt: null = the assignee
  // has never opened this task's record. Set the first time they land on the
  // record (from the Inbox, a deep link, or a modal). A task has exactly one
  // assignee, so a single column on the task IS per-user read state — no join
  // table needed.
  readAt       DateTime?

  @@index([assignedToId, status])
  @@index([module, recordId])
  @@index([assignedToId, readAt])
}

// ─────────────────────────────────────────────────────────────────────
//  MODULE — User-initiated AI Agent infrastructure (Commit 1)
// ─────────────────────────────────────────────────────────────────────
//
// This is the foundation for agents that the user triggers from a record
// page (first user: RcaAssistantAgent). It is intentionally SEPARATE from
// the workflow-rule-triggered fire-and-forget agents (TriageAgent /
// LessonsDistributionAgent) which write to *.closureTriggers JSON and do
// not write to these tables. Two patterns coexist:
//
//   Pattern A — workflow-rule agents
//     • triggered by workflow rules (e.g. observation submit / close)
//     • simple JSON-only Anthropic call (no tools)
//     • output stored on the source record's closureTriggers JSON
//     • no human accept/reject decision; agents are advisory only
//     • see safeops_360_bakend/app/services/ai/agents/*.py
//
//   Pattern B — user-initiated agents (THESE TABLES)
//     • triggered by a user clicking "Start AI Analysis" on a record
//     • tool-use loop against typed read-only tools
//     • full invocation tracking + human accept/modify/reject capture
//     • prompt versioning + calibration metrics
//     • used by RcaAssistantAgent and future agents-with-tools
//
// Authority levels (Agent.currentAuthorityLevel):
//   L0 — suggest only. Default. Human accepts/modifies/rejects every output.
//   L1 — suggest with auto-fill drafts (still requires human submission).
//   L2 — limited auto-action (small bounded writes, never RCA conclusions).
//
// Pilot scoping uses the existing RBAC permission system (AGENT.RCA_INVOKE
// with scope OWN_PLANT seeded only for demo-plant users) rather than a
// duplicate pilotPlantIds column on Agent.

model Agent {
  id          String @id @default(cuid())
  code        String @unique // "RCA_ASSISTANT" | "TRIAGE" | "CAPA_SUGGESTION" | ...
  name        String
  description String @db.Text

  // Which functional module this agent serves (INCIDENT, OBSERVATION,
  // NEAR_MISS, PTW, FLRA, INSPECTION, TRAINING, MANHOURS, CONFIGURATION).
  module String

  // Structured capability map. Shape evolves per agent; treated as opaque
  // JSON by the runtime. Used by the Configuration UI to render what the
  // agent claims to do.
  capabilities Json

  // ── Model ──────────────────────────────────────────────────────────
  // Default to Haiku for cost; escalate to Opus when low-confidence
  // responses or when the user explicitly requests a "deep" analysis.
  // Both fields hold full model IDs (e.g. "claude-haiku-4-5-20251001",
  // "claude-opus-4-7"). escalationModelId may be null when no escalation
  // policy applies.
  primaryModelId    String
  escalationModelId String?

  // ── Active prompt ──────────────────────────────────────────────────
  // Pointer to the currently active AgentPrompt. Null only during agent
  // bootstrapping (before any prompt is seeded). Prompt history lives on
  // the AgentPrompt rows themselves.
  activePromptId String?      @unique
  activePrompt   AgentPrompt? @relation("AgentActivePrompt", fields: [activePromptId], references: [id])

  // ── Authority ──────────────────────────────────────────────────────
  currentAuthorityLevel String  @default("L0") // "L0" | "L1" | "L2"
  maxAuthorityLevel     String  @default("L0") // ceiling, can be promoted up to this
  authorityRationale    String? @db.Text

  // ── Tools (names only; definitions are code in Python) ─────────────
  availableTools String[]

  // ── Economics (estimates for the UI cost preview) ──────────────────
  estimatedTokensPerInvocation Int   @default(8000)
  estimatedCostPerInvocation   Float @default(0.012) // Haiku-default estimate (USD)

  // ── Operational state ──────────────────────────────────────────────
  isActive  Boolean @default(true)
  isInPilot Boolean @default(true) // pilot = elevated logging + tighter rate limit
  // Invocations per hour, per plant. Enforced in agent_service.invoke().
  rateLimit Int     @default(50)

  // ── Rolling metrics (updated by the calibration job; surfaced in
  //     the Configuration → Agent Operations dashboard) ──
  totalInvocations   Int    @default(0)
  totalAcceptances   Int    @default(0)
  totalModifications Int    @default(0)
  totalRejections    Int    @default(0)
  averageLatencyMs   Int?
  averageCostUsd     Float?

  // 0..1 score derived from accept/modify/reject mix. Used to gate
  // promotion to L1 once the agent proves itself.
  calibrationScore  Float?
  lastCalibrationAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prompts     AgentPrompt[]     @relation("AgentPromptOwner")
  invocations AgentInvocation[]

  @@index([module])
  @@index([isActive])
}

// One row per prompt version of an Agent. The active version is pointed
// to by Agent.activePromptId. Prompt edits create a new row; nothing is
// mutated in place (audit trail of every prompt the agent has run with).
model AgentPrompt {
  id      String @id @default(cuid())
  agentId String
  agent   Agent  @relation("AgentPromptOwner", fields: [agentId], references: [id], onDelete: Cascade)

  version           Int
  systemPrompt      String @db.Text
  promptDescription String @db.Text

  // Optional label for A/B experiments. Null = mainline prompt.
  variantLabel String?

  // ── Rolling metrics scoped to this prompt version ──
  invocationCount  Int    @default(0)
  acceptanceRate   Float?
  modificationRate Float?
  rejectionRate    Float?

  // ── Approval (changes to active prompt require approver per workflow) ──
  createdById  String
  createdBy    User      @relation("AgentPromptCreator", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?     @relation("AgentPromptApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  createdAt DateTime @default(now())

  // Reverse pointer for Agent.activePromptId (one-to-one). Optional
  // because most prompts are not the active one.
  activeForAgent Agent? @relation("AgentActivePrompt")

  invocations AgentInvocation[]

  @@unique([agentId, version])
  @@index([agentId])
}

// One row per agent invocation. This table doubles as the agent audit
// log — there is no separate AuditLog model. AUDIT.VIEW permission
// grants read access to these rows + the AgentToolCall children.
model AgentInvocation {
  id               String @id @default(cuid())
  invocationNumber String @unique // "AINV-YYYY-NNNNNN" — human-readable audit ref

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id])

  // ── Trigger context ────────────────────────────────────────────────
  invokedAt         DateTime @default(now())
  invokedById       String? // null for AUTO_ON_EVENT / SCHEDULED triggers
  invokedBy         User?    @relation("AgentInvocationUser", fields: [invokedById], references: [id])
  invocationTrigger String   @default("USER_INITIATED") // "USER_INITIATED" | "AUTO_ON_EVENT" | "SCHEDULED"

  // What record this invocation analyses. sourceRecordId is loosely
  // typed (FK by value) because it can point to any module's record.
  sourceModule     String // "INCIDENT" | "OBSERVATION" | ...
  sourceRecordId   String
  sourceRecordType String // duplicates module for legibility; e.g. "INCIDENT"
  sourcePlantId    String? // duplicated for rate-limiting + dashboard filters

  authorityLevelUsed String // "L0" | "L1" | "L2" at the moment of invocation
  promptVersionId    String
  promptVersion      AgentPrompt @relation(fields: [promptVersionId], references: [id])

  // ── Execution metadata ─────────────────────────────────────────────
  modelUsed    String // full model ID used (may be primaryModelId or escalationModelId)
  inputTokens  Int?
  outputTokens Int?
  totalCostUsd Float?
  latencyMs    Int?

  // ── Input / output ─────────────────────────────────────────────────
  inputContext    Json // structured incident/observation/etc. context fed to the agent
  rawApiResponse  Json? // last Anthropic response block (debugging / replay)
  agentReasoning  String? @db.Text // extracted <reasoning>...</reasoning>
  agentSuggestion Json? // extracted <suggestion>{...}</suggestion>
  agentConfidence Float? // extracted <confidence>...</confidence>, 0..1

  // ── Status / human decision ────────────────────────────────────────
  // RUNNING        — BackgroundTask still executing the tool-use loop
  // PENDING_REVIEW — invocation completed, awaiting human decision
  // ACCEPTED       — human took the suggestion as-is
  // MODIFIED       — human edited and accepted
  // REJECTED       — human discarded the suggestion
  // EXPIRED        — no human decision after the agent's TTL (set by cron)
  // ERRORED        — invocation failed before completion (hadError=true)
  status String @default("RUNNING")

  humanDecisionAt    DateTime?
  humanDecisionById  String?
  humanDecisionBy    User?     @relation("AgentInvocationDecider", fields: [humanDecisionById], references: [id])
  humanDecision      String? // "ACCEPT_AS_IS" | "ACCEPT_WITH_MODIFICATION" | "REJECT"
  humanModifications Json? // diff or final state, agent-specific shape
  rejectionReason    String?   @db.Text

  // ── Calibration feedback ───────────────────────────────────────────
  ratingByHuman    Int? // 1-5
  detailedFeedback String? @db.Text

  // ── Errors ─────────────────────────────────────────────────────────
  hadError     Boolean @default(false)
  errorType    String? // "API_ERROR" | "TIMEOUT" | "RATE_LIMIT" | "PARSE_ERROR" | "INTERNAL"
  errorDetails String? @db.Text

  // ── Hallucination detection ────────────────────────────────────────
  // The agent service inspects the response for record references that
  // look like real IDs (e.g. "INC-2025-LUM-0042") and verifies each
  // against the DB. Mismatches set this flag; full details in JSON.
  hallucinationFlagged Boolean @default(false)
  hallucinationDetails Json? // [{ type, value, context }]

  createdAt DateTime @default(now())

  toolCallsUsed AgentToolCall[]

  @@index([agentId, invokedAt])
  @@index([sourceModule, sourceRecordId])
  @@index([sourcePlantId, invokedAt])
  @@index([status])
}

// One row per tool call inside an invocation. Sequence preserves order
// across the tool-use loop. Useful for the transparency drawer the UI
// renders for HSE Manager / Corporate HSE reviewers.
model AgentToolCall {
  id           String          @id @default(cuid())
  invocationId String
  invocation   AgentInvocation @relation(fields: [invocationId], references: [id], onDelete: Cascade)

  toolName    String
  toolInput   Json
  toolOutput  Json?
  executionMs Int?

  hadError     Boolean @default(false)
  errorDetails String? @db.Text

  sequence  Int // order within invocation, starts at 1
  invokedAt DateTime @default(now())

  @@index([invocationId, sequence])
}

// ═════════════════════════════════════════════════════════════════════
// HIRA — Hazard Identification and Risk Assessment (Phase 1 of IMS expansion)
// ═════════════════════════════════════════════════════════════════════
// The live risk register of the platform. A HiraStudy scopes a set of
// activities/areas; each HiraEntry analyses one activity for hazards →
// initial risk → existing controls → residual risk → (if not acceptable)
// recommended controls. Studies move through team review and approval
// via the generic WorkflowDefinition engine — see seed-workflows.ts for
// HIRA_STUDY_STANDARD and HIRA_STUDY_HIGH_RISK definitions.
//
// Key design choices (see HIRA_IMPLEMENTATION_PLAN.md §11 for full rationale):
// - RiskMatrix is a configurable master; the legacy 5×5 in Observation/
//   NearMiss/FLRA stays hardcoded for now (D1 Option A).
// - HiraHazard is the structured library; MasterItem(type='HAZARD_CATEGORY')
//   keeps its simpler role for the older modules.
// - HiraVersion holds a JSON snapshot of every change to an approved
//   entry. Versions are immutable — enforced at service layer.
// - HiraCapa is HIRA's own CAPA child table; if a standalone CAPA module
//   ships later, a one-shot migration absorbs these rows (D2).
// ═════════════════════════════════════════════════════════════════════

// Risk matrix master — N×M grid configurable per tenant. Standard 5×5
// is seeded by seed-hira-masters.ts; tenants can clone and edit.
model RiskMatrix {
  id          String  @id @default(cuid())
  code        String  @unique // "STD_5X5", "STD_6X6", "SIMPLE_3X3"
  name        String
  description String?

  likelihoodLevels Int // 5, 6, etc.
  severityLevels   Int

  // Acceptable residual thresholds, per activity routine type. JSON:
  // { "routine": "MODERATE", "non_routine": "MODERATE", "emergency": "LOW" }
  acceptableResidual Json

  // ALARP tolerability bands — maps each riskLevel to an ALARP region. JSON:
  // { "LOW": "BROADLY_ACCEPTABLE", "MODERATE": "TOLERABLE",
  //   "HIGH": "TOLERABLE", "CRITICAL": "UNACCEPTABLE" }
  // Nullable for backward-compat; backend falls back to DEFAULT_ALARP_BANDS.
  alarpBands Json?

  // If true, the entry editor forces the team to record their consideration
  // of higher-tier controls (elimination, substitution) before lower-tier
  // ones (engineering, administrative, PPE) are accepted.
  controlHierarchyEnforced Boolean @default(true)

  isActive  Boolean @default(true)
  isDefault Boolean @default(false)
  isGlobal  Boolean @default(false) // pre-seeded vs tenant-added

  likelihoods RiskMatrixLikelihood[]
  severities  RiskMatrixSeverity[]
  cells       RiskMatrixCell[]
  studies     HiraStudy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, isDefault])
}

model RiskMatrixLikelihood {
  id                String     @id @default(cuid())
  matrixId          String
  matrix            RiskMatrix @relation(fields: [matrixId], references: [id], onDelete: Cascade)
  score             Int // 1..N
  label             String // "Rare", "Unlikely", ...
  description       String
  frequencyGuidance String? // "Once in 10+ years"
  sortOrder         Int        @default(0)

  initialRiskEntries  HiraEntry[] @relation("HiraEntryInitialLikelihood")
  residualRiskEntries HiraEntry[] @relation("HiraEntryResidualLikelihood")

  @@unique([matrixId, score])
  @@index([matrixId, sortOrder])
}

model RiskMatrixSeverity {
  id                     String     @id @default(cuid())
  matrixId               String
  matrix                 RiskMatrix @relation(fields: [matrixId], references: [id], onDelete: Cascade)
  score                  Int // 1..N
  label                  String // "Insignificant", "Minor", ...
  description            String
  healthSafetyGuidance   String?
  propertyDamageGuidance String?
  environmentalGuidance  String?
  reputationGuidance     String?
  sortOrder              Int        @default(0)

  initialRiskEntries  HiraEntry[] @relation("HiraEntryInitialSeverity")
  residualRiskEntries HiraEntry[] @relation("HiraEntryResidualSeverity")

  @@unique([matrixId, score])
  @@index([matrixId, sortOrder])
}

// Explicit cell mapping. Cell colours, risk level, action statements, and
// response-time SLAs are all configurable per matrix.
model RiskMatrixCell {
  id               String     @id @default(cuid())
  matrixId         String
  matrix           RiskMatrix @relation(fields: [matrixId], references: [id], onDelete: Cascade)
  likelihoodScore  Int
  severityScore    Int
  riskScore        Int // typically likelihood × severity, but configurable
  riskLevel        String // "LOW" | "MODERATE" | "HIGH" | "CRITICAL"
  colorHex         String
  actionRequired   String
  responseTimeDays Int

  @@unique([matrixId, likelihoodScore, severityScore])
  @@index([matrixId, riskLevel])
}

// Structured hazard library. The 17 categories from the spec are
// validated at the service layer, not enforced as an enum, so tenants
// can extend the list. isGlobal rows are pre-seeded; tenants add rows
// with isGlobal=false.
model HiraHazard {
  id          String  @id @default(cuid())
  code        String  @unique // "MECH_UNGUARDED_ROTATING", etc.
  category    String // "mechanical" | "electrical" | "chemical" | "biological" | "physical" | "ergonomic" | "psychosocial" | "fire_explosion" | "environmental" | "radiation" | "noise" | "thermal" | "pressure" | "height" | "confined_space" | "transportation" | "behavioral"
  subcategory String?
  name        String
  description String

  // Arrays modelled as JSON because the rows are short and read-mostly;
  // a join table would add complexity for negligible benefit.
  typicalHarmPotential   Json // string[]
  typicalAffectedPersons Json // string[]
  energyForm             String?

  // Regulatory references at the hazard level (e.g., this hazard is
  // covered by Factories Act §28). Per-entry refs live on HiraEntryRegulationRef.
  oshaStandard        String?
  factoriesActSection String?
  isStandard          String?
  isoReference        String?

  // Pre-canned control suggestions, shown to the team when this hazard
  // is added to an entry. JSON: [{ hierarchy, description }]
  typicalControlsSuggested Json?

  // Permit gate. When true, an entry hazard row built from this library hazard
  // surfaces a "Create PTW" prompt. permitTypes narrows the drafted permit's
  // default type (null/empty => the originator picks).
  requiresPermit Boolean @default(false)
  permitTypes    Json?

  isActive Boolean @default(true)
  isGlobal Boolean @default(false) // pre-seeded vs tenant-added

  entryHazards HiraEntryHazard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, isActive])
  @@index([isGlobal, isActive])
}

// Reusable control library — organisations standardise on consistent
// control descriptions so the HIRA register reads coherently.
model HiraControl {
  id          String @id @default(cuid())
  code        String @unique
  hierarchy   String // "ELIMINATION" | "SUBSTITUTION" | "ENGINEERING" | "ADMINISTRATIVE" | "PPE"
  description String

  verificationMethod    String?
  verificationFrequency String?

  isActive Boolean @default(true)
  isGlobal Boolean @default(false)

  entryControls HiraEntryControl[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hierarchy, isActive])
}

// A HIRA study — the scoping container. One study per (scope) is
// "active" at any time; previous versions move to "superseded".
model HiraStudy {
  id     String @id @default(cuid())
  number String @unique // "HIRA-YYYY-PLT-NNN" assigned at creation

  // Plant + optional narrower scope. activityIds/equipmentIds are
  // JSON arrays of FK values; the values reference MasterItem(type=
  // 'ACTIVITY_TYPE') and Equipment respectively.
  plantId      String
  plant        Plant       @relation(fields: [plantId], references: [id])
  departmentId String?
  department   Department? @relation("HiraStudyDepartment", fields: [departmentId], references: [id])
  areaId       String?
  area         Area?       @relation("HiraStudyArea", fields: [areaId], references: [id])
  scopeType    String // "PLANT" | "AREA" | "DEPARTMENT" | "ACTIVITY" | "EQUIPMENT" | "PROCESS"
  activityIds  Json? // string[] — FK-by-value to MasterItem
  equipmentIds Json? // string[] — FK-by-value to Equipment
  processCode  String?

  title       String
  description String?

  // Methodology — locked at creation, can only change via supersession
  riskMatrixId String
  riskMatrix   RiskMatrix @relation(fields: [riskMatrixId], references: [id])

  // Team
  teamLeaderId String
  teamLeader   User                  @relation("HiraStudyTeamLeader", fields: [teamLeaderId], references: [id])
  team         HiraStudyTeamMember[]

  // Lifecycle
  status                  String    @default("DRAFT") // DRAFT | IN_PROGRESS | TEAM_REVIEW | APPROVAL_PENDING | APPROVED | ACTIVE | SUPERSEDED | ARCHIVED
  initiatedAt             DateTime  @default(now())
  targetCompletionDate    DateTime?
  completedAt             DateTime?
  approvedAt              DateTime?
  approvedById            String?
  approvedBy              User?     @relation("HiraStudyApprover", fields: [approvedById], references: [id])
  effectiveFrom           DateTime?
  nextScheduledReviewDate DateTime?

  // Periodicity
  reviewFrequency    String @default("ANNUAL") // ANNUAL | BIENNIAL | TRIGGERED_ONLY | QUARTERLY | CUSTOM
  customReviewMonths Int?

  // Supersession (self-relation)
  supersedesStudyId  String?    @unique // each study supersedes at most one
  supersedesStudy    HiraStudy? @relation("HiraStudySupersession", fields: [supersedesStudyId], references: [id])
  supersededByStudy  HiraStudy? @relation("HiraStudySupersession")
  supersessionReason String?

  // Compliance — string[] of regulation codes
  applicableRegulations    Json?
  regulatoryReviewRequired Boolean @default(false)

  // Cached aggregates — recomputed by service layer on entry change
  // { total_entries, total_hazards, risk_distribution_initial, risk_distribution_residual, ... }
  aggregateMetrics Json?

  // Children
  entries     HiraEntry[]
  attachments HiraStudyAttachment[]

  // Audit
  createdAt   DateTime @default(now())
  createdById String
  createdBy   User     @relation("HiraStudyCreator", fields: [createdById], references: [id])
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("HiraStudyUpdater", fields: [updatedById], references: [id])

  @@index([plantId, status])
  @@index([status, nextScheduledReviewDate])
  @@index([plantId, departmentId])
}

model HiraStudyTeamMember {
  id      String    @id @default(cuid())
  studyId String
  study   HiraStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)
  userId  String
  user    User      @relation("HiraStudyTeamMemberUser", fields: [userId], references: [id])

  // FACILITATOR | SUBJECT_MATTER_EXPERT | OPERATOR_REP | SAFETY_OFFICER | DEPARTMENT_HEAD | EXTERNAL_CONSULTANT
  teamRole   String
  department String?

  // Team review sign-off — captured when the workflow's team-review step
  // routes a task to this member and they approve.
  signedAt   DateTime?
  signedNote String?

  createdAt DateTime @default(now())

  @@unique([studyId, userId])
  @@index([studyId])
}

model HiraStudyAttachment {
  id           String    @id @default(cuid())
  studyId      String
  study        HiraStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  category     String? // "SCOPING_NOTES" | "PHOTO" | "REFERENCE_DOC" | "PDF_EXPORT"
  description  String?
  uploadedAt   DateTime  @default(now())
  uploadedById String
  uploadedBy   User      @relation("HiraStudyAttachmentUploader", fields: [uploadedById], references: [id])

  @@index([studyId])
}

// Single row in the HIRA register — the atomic unit of analysis.
model HiraEntry {
  id      String    @id @default(cuid())
  studyId String
  study   HiraStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)

  sequenceNumber Int
  groupLabel     String?

  // Activity — flat fields for query performance; original spec nests these
  activityDescription String
  areaId              String?
  area                Area?   @relation("HiraEntryArea", fields: [areaId], references: [id])
  subLocation         String?
  gpsLatitude         Float?
  gpsLongitude        Float?
  routine             String // "ROUTINE" | "NON_ROUTINE" | "EMERGENCY"
  frequency           String // "CONTINUOUS" | "DAILY" | "WEEKLY" | "MONTHLY" | "OCCASIONAL" | "RARE"
  typicalDurationMin  Int?

  // Persons exposed — numerical buckets per spec §2.3
  personsEmployees     Int     @default(0)
  personsContractors   Int     @default(0)
  personsVisitors      Int     @default(0)
  personsPublic        Int     @default(0)
  affectedPersonGroups String? @db.Text // G13: free-text description of affected groups

  // Loose-FK JSON arrays
  equipmentUsed        Json? // string[] — Equipment.id values
  materialsUsed        Json? // string[] — material master values
  energySourcesPresent Json? // string[] — MasterItem(type=ENERGY_SOURCE) codes

  // Initial risk — flat columns with FKs to scale rows for queryability
  initialLikelihoodId        String
  initialLikelihood          RiskMatrixLikelihood @relation("HiraEntryInitialLikelihood", fields: [initialLikelihoodId], references: [id])
  initialLikelihoodScore     Int
  initialLikelihoodRationale String?              @db.Text
  initialSeverityId          String
  initialSeverity            RiskMatrixSeverity   @relation("HiraEntryInitialSeverity", fields: [initialSeverityId], references: [id])
  initialSeverityScore       Int
  initialSeverityRationale   String?              @db.Text
  initialRiskScore           Int
  initialRiskLevel           String // LOW | MODERATE | HIGH | CRITICAL
  initialRiskColor           String?

  // Residual risk — null until controls assessed; same shape as initial
  residualLikelihoodId        String?
  residualLikelihood          RiskMatrixLikelihood? @relation("HiraEntryResidualLikelihood", fields: [residualLikelihoodId], references: [id])
  residualLikelihoodScore     Int?
  residualLikelihoodRationale String?               @db.Text
  residualSeverityId          String?
  residualSeverity            RiskMatrixSeverity?   @relation("HiraEntryResidualSeverity", fields: [residualSeverityId], references: [id])
  residualSeverityScore       Int?
  residualSeverityRationale   String?               @db.Text
  residualRiskScore           Int?
  residualRiskLevel           String?
  residualRiskColor           String?
  residualAcceptable          Boolean? // computed against ALARP region + legacy matrix.acceptableResidual threshold
  residualAcceptanceRationale String?               @db.Text
  // True => residual L/S are derived from the existing controls (hierarchy +
  // effectiveness); False => manual matrix pick; Null (legacy) => treated as
  // manual so hand-set residuals are never silently recomputed.
  residualAutoCalculated      Boolean?

  // ALARP tolerability banding — region derived from risk level via matrix.alarpBands.
  // UNACCEPTABLE | TOLERABLE | BROADLY_ACCEPTABLE. Computed server-side.
  initialAlarpRegion  String? // ALARP region of the initial (pre-control) risk
  residualAlarpRegion String? // ALARP region of the residual (post-control) risk

  // ALARP demonstration — the reasonably-practicable test required to accept a
  // residual sitting in the TOLERABLE region. NOT_REQUIRED | REQUIRED | DEMONSTRATED
  alarpStatus                     String?
  alarpFurtherControlsConsidered  Boolean?
  alarpFurtherControlsDescription String?   @db.Text
  alarpRiskReductionBenefit       String?   @db.Text
  alarpCostBand                   String? // LOW | MEDIUM | HIGH | VERY_HIGH
  alarpGrosslyDisproportionate    Boolean? // true => further reduction not reasonably practicable => ALARP
  alarpJustification              String?   @db.Text
  alarpDemonstratedById           String?
  alarpDemonstratedAt             DateTime?

  // Target (forecast) risk — projected residual after the recommended controls
  // land. Hand-picked on the matrix; region computed server-side. Powers the
  // Initial→Residual→Target ALARP risk-reduction pathway view.
  targetLikelihoodId    String?
  targetLikelihoodScore Int?
  targetSeverityId      String?
  targetSeverityScore   Int?
  targetRiskScore       Int?
  targetRiskLevel       String?
  targetRiskColor       String?
  targetAlarpRegion     String?
  targetRationale       String? @db.Text

  // Unacceptable-risk override (ALARP governance). The only way an Unacceptable
  // residual can reach APPROVED: an elevated, time-bounded authorisation by a
  // holder of HIRA.OVERRIDE_UNACCEPTABLE. Cleared on a material change; expired
  // by the review scheduler. Replaces the old free-text acceptance rationale.
  unacceptableOverrideById          String?
  unacceptableOverrideAt            DateTime?
  unacceptableOverrideJustification String?   @db.Text
  unacceptableOverrideExpiresAt     DateTime?

  // Cross-module linkages — see post-closure rule services for the writers
  triggersTrainingProgramIds Json? // string[] — TrainingProgram.id
  triggersInspectionTypeIds  Json? // string[]
  influencesPtwRiskLevel     Boolean @default(false)
  influencesPtwPermitTypes   Json? // string[] — "HOT_WORK", "CONFINED_SPACE", ...
  linkedEmergencyProcIds     Json?
  linkedEnvironmentalAspects Json? // EAI cross-ref placeholder (D2)

  // Review metadata
  lastReviewedAt      DateTime?
  lastReviewedById    String?
  nextReviewDue       DateTime?
  reviewCount         Int       @default(0)
  lastReviewType      String? // "SCHEDULED" | "INCIDENT_TRIGGERED" | "MOC_TRIGGERED" | "AUDIT_TRIGGERED" | "AD_HOC"
  triggeredByRecordId String? // incident/MOC/etc. that triggered the most recent review

  // Lifecycle
  status String @default("DRAFT") // DRAFT | IN_REVIEW | APPROVED | ACTIVE | FLAGGED_FOR_REVIEW | SUPERSEDED | ARCHIVED

  // Versioning — current version always reflected in this row; HiraVersion
  // holds the immutable history snapshots.
  versionNumber    Int     @default(1)
  isCurrentVersion Boolean @default(true)
  parentVersionId  String? // points to the previous HiraEntry row before a major-revision branch (rare)

  // Children
  hazards             HiraEntryHazard[]
  existingControls    HiraEntryControl[]
  recommendedControls HiraEntryRecommendedControl[]
  regulationRefs      HiraEntryRegulationRef[]
  reviewCycles        HiraReviewCycle[]
  versions            HiraVersion[]
  capas               HiraCapa[]
  // Permits raised from this entry's hazard rows.
  permits             Permit[]                      @relation("PermitFromHiraEntry")

  // Audit
  createdAt   DateTime @default(now())
  createdById String
  createdBy   User     @relation("HiraEntryCreator", fields: [createdById], references: [id])
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("HiraEntryUpdater", fields: [updatedById], references: [id])

  @@unique([studyId, sequenceNumber])
  @@index([studyId, status])
  @@index([status, nextReviewDue])
  @@index([initialRiskLevel])
  @@index([residualRiskLevel])
  @@index([initialAlarpRegion])
  @@index([residualAlarpRegion])
  @@index([alarpStatus])
  @@index([targetAlarpRegion])
  @@index([unacceptableOverrideExpiresAt])
}

// Hazard occurrence — links a library Hazard to an entry, with context
// (one hazard library row may appear on many entries with different
// contextualised descriptions).
model HiraEntryHazard {
  id       String     @id @default(cuid())
  entryId  String
  entry    HiraEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  hazardId String
  hazard   HiraHazard @relation(fields: [hazardId], references: [id])

  // Contextualised — what THIS activity makes of the generic hazard
  contextualDescription String? @db.Text
  potentialHarm         Json? // string[] — overrides library defaults
  affectedPersons       Json? // string[]
  consequence           String? @db.Text // G16: worst-case consequence if hazard is realised (ISO 45001 cl.6.1.2.1)

  // Hazard-row-grain regulatory citation. Separate from the entry-level
  // HiraEntryRegulationRef list — that cites the activity, this cites the
  // hazard. Seeded from HiraHazard's library columns when the row is created.
  regulationRef     String? @db.VarChar(200)
  regulationSection String? @db.VarChar(120)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  permits Permit[] @relation("PermitFromHiraHazard")

  @@unique([entryId, hazardId])
  @@index([entryId])
}

model HiraEntryControl {
  id        String       @id @default(cuid())
  entryId   String
  entry     HiraEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  // Optional FK to the control library — null for ad-hoc controls
  controlId String?
  control   HiraControl? @relation(fields: [controlId], references: [id])

  hierarchy          String // ELIMINATION | SUBSTITUTION | ENGINEERING | ADMINISTRATIVE | PPE
  description        String  @db.Text
  effectiveness      String? // EFFECTIVE | PARTIALLY_EFFECTIVE | INEFFECTIVE | NOT_VERIFIED
  verificationMethod String?
  verificationFreq   String?
  responsibleRole    String?
  evidenceAttached   Boolean @default(false)
  documentReference  String? // G19: doc/record reference when evidence is on file

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([entryId])
}

// Recommended controls — proposals to push residual into acceptability.
// When status moves to APPROVED, a HiraCapa row is created to track delivery.
model HiraEntryRecommendedControl {
  id      String    @id @default(cuid())
  entryId String
  entry   HiraEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  hierarchy   String
  description String  @db.Text
  rationale   String? @db.Text

  targetLikelihoodReduction Int?
  targetSeverityReduction   Int?
  estimatedCostBand         String? // LOW | MEDIUM | HIGH | VERY_HIGH

  proposedImplementationDate DateTime?
  responsibleId              String?
  responsible                User?     @relation("HiraRecommendedControlOwner", fields: [responsibleId], references: [id])

  status String @default("PROPOSED") // PROPOSED | APPROVED | IN_PROGRESS | IMPLEMENTED | DEFERRED | REJECTED

  // When the recommendation becomes a CAPA, link it for traceability
  capaId String?
  capa   HiraCapa? @relation(fields: [capaId], references: [id])

  // Proof that the proposal actually landed. Mirrors HiraEntryControl.
  evidenceAttached  Boolean @default(false)
  documentReference String? @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entryId, status])
}

model HiraEntryRegulationRef {
  id      String    @id @default(cuid())
  entryId String
  entry   HiraEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  regulation         String // e.g. "Factories Act 1948"
  section            String? // e.g. "Section 41B"
  requirementSummary String? @db.Text

  createdAt DateTime @default(now())

  @@index([entryId])
}

// HIRA's CAPA child table — mirrors IncidentCapa / NearMissCapa shape.
// Spawned automatically when a HiraEntryRecommendedControl is APPROVED.
model HiraCapa {
  id      String    @id @default(cuid())
  entryId String
  entry   HiraEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  number  String    @unique // "HCAPA-YYYY-NNNN"

  description      String  @db.Text
  controlHierarchy String? // mirrors recommended-control hierarchy

  ownerId String
  owner   User   @relation("HiraCapaOwner", fields: [ownerId], references: [id])

  targetDate     DateTime?
  status         String    @default("OPEN") // OPEN | IN_PROGRESS | COMPLETED | VERIFIED | CLOSED | CANCELLED
  completedAt    DateTime?
  completionNote String?

  verifierId   String?
  verifier     User?     @relation("HiraCapaVerifier", fields: [verifierId], references: [id])
  verifiedAt   DateTime?
  verifyMethod String?

  effectiveness String? // EFFECTIVE | PARTIALLY_EFFECTIVE | INEFFECTIVE

  recommendedControls HiraEntryRecommendedControl[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entryId, status])
  @@index([ownerId, status])
}

// A scheduled or triggered re-review of one HiraEntry. Created by:
// - the scheduled review job (T-30 days before nextReviewDue)
// - incident post-closure rule (incident in covered area)
// - MOC post-approval rule (D2 — receiver exists, MOC not yet built)
// - manual trigger by HSE Manager
model HiraReviewCycle {
  id      String    @id @default(cuid())
  entryId String
  entry   HiraEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  scheduledFor       DateTime
  triggeredBy        String // SCHEDULE | INCIDENT | MOC | AUDIT_FINDING | MANUAL | REGULATORY_CHANGE | NEAR_MISS | OBSERVATION
  triggerReferenceId String? // FK-by-value to the source record

  status String @default("SCHEDULED") // SCHEDULED | IN_PROGRESS | COMPLETED | SKIPPED

  assignedToId String
  assignedTo   User    @relation("HiraReviewAssignee", fields: [assignedToId], references: [id])
  assignedRole String?

  startedAt     DateTime?
  completedAt   DateTime?
  completedById String?
  completedBy   User?     @relation("HiraReviewCompleter", fields: [completedById], references: [id])

  // NO_CHANGE_REQUIRED | MINOR_REVISION | MAJOR_REVISION | NEW_ENTRY_CREATED | ENTRY_ARCHIVED
  outcome      String?
  outcomeNotes String? @db.Text

  // JSON: [{ field, oldValue, newValue, rationale }]
  changesMade Json?

  createdAt DateTime @default(now())

  @@index([entryId, status])
  @@index([assignedToId, status])
  @@index([status, scheduledFor])
}

// Immutable version history. Every change to an approved HiraEntry
// creates a row here with a full snapshot. Service-layer enforces:
// no UPDATE, no DELETE.
model HiraVersion {
  id      String    @id @default(cuid())
  entryId String
  entry   HiraEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  versionNumber Int

  // Full snapshot of the HiraEntry (and its child rows) at this version.
  // Schema: { entry: {...}, hazards: [...], controls: [...], etc. }
  snapshot Json

  // JSON: [{ fieldPath, oldValue, newValue }]
  changes Json

  changeReason  String @db.Text
  // SCHEDULED_REVIEW | INCIDENT_REVIEW | MOC | CORRECTION | AUDIT_FINDING | INITIAL_APPROVAL
  changeTrigger String

  createdAt   DateTime @default(now())
  createdById String
  createdBy   User     @relation("HiraVersionCreator", fields: [createdById], references: [id])

  @@unique([entryId, versionNumber])
  @@index([entryId])
}

// ═════════════════════════════════════════════════════════════════════
// CAPA — Corrective Action and Preventive Action (Phase 1 of IMS — QMS wedge)
// ═════════════════════════════════════════════════════════════════════
// Generalises the existing safety-only CAPA workflow into a universal
// system handling 17+ source types (safety, audit, customer complaint,
// quality NCR, calibration, environmental, management review, MOC,
// kaizen, regulatory, manual). The 4 existing CAPA tables
// (IncidentCapa, NearMissCapa, InspectionFindingCapa, HiraCapa) remain
// intact through Phase B; backfilled into Capa. Their virtual relations
// are preserved at the Prisma layer so existing call sites
// (`incident.capas`, etc.) keep working — see [CAPA_IMPLEMENTATION_PLAN.md](../../CAPA_IMPLEMENTATION_PLAN.md)
// decisions D1–D8.
//
// `sourceMetadata` JSON is polymorphic by `sourceType`:
//   SAFETY_INCIDENT, NEAR_MISS, etc. → SafetyIncidentMetadata
//   AUDIT_INTERNAL / EXTERNAL / REGULATORY → AuditMetadata
//   CUSTOMER_COMPLAINT → CustomerComplaintMetadata
//   QUALITY_NCR → QualityNcrMetadata
//   CALIBRATION_FAILURE → CalibrationMetadata
//   ENVIRONMENTAL_FINDING → EnvironmentalMetadata
//   MANAGEMENT_REVIEW_ACTION → ManagementReviewMetadata
//   TRAINING_GAP → TrainingGapMetadata
//   MANUAL → ManualMetadata
// Shapes defined in app/schemas/capa.py and src/lib/capa/source-metadata-types.ts.
// ═════════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────────────
// Master data
// ─────────────────────────────────────────────────────────────────────

model CapaSourceCategory {
  id          String  @id @default(cuid())
  code        String  @unique // SAFETY | QUALITY | ENVIRONMENTAL | ORGANIZATIONAL | REGULATORY | OTHER
  name        String
  description String?
  prefix      String  @unique // S | Q | E | O | R | X — used in Capa.capaNumber
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  sourceTypes CapaSourceType[]
  capas       Capa[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CapaSourceType {
  id          String             @id @default(cuid())
  code        String             @unique // SAFETY_INCIDENT | NEAR_MISS | HIRA_CONTROL | AUDIT_INTERNAL | CUSTOMER_COMPLAINT | ...
  name        String
  description String?
  categoryId  String
  category    CapaSourceCategory @relation(fields: [categoryId], references: [id])

  // Whether this source has a corresponding parent module live in this build.
  // false → manual intake only; receiver stubs exist but no caller.
  parentModuleLive Boolean @default(false)
  parentModuleName String? // e.g. "INCIDENT" | "NEAR_MISS" | "INSPECTION_FINDING" | "HIRA"

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  capas Capa[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, isActive])
}

model CapaSubCategory {
  id                      String  @id @default(cuid())
  code                    String  @unique
  name                    String
  description             String?
  // Applicable source-type filter; null = applies to all sources
  applicableSourceTypeIds Json? // string[] of CapaSourceType ids

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  capas Capa[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CapaSlaProfile {
  id             String  @id @default(cuid())
  code           String  @unique // matches CapaSourceType.code + severity suffix where needed
  // Source-type this profile applies to. null = default fallback.
  sourceTypeCode String?
  // Severity this profile applies to. null = applies to all severities of that source.
  severity       String? // LOW | MODERATE | HIGH | CRITICAL

  initialResponseHours  Int
  rcaDueDays            Int
  actionsPlannedDueDays Int
  closureTargetDays     Int
  recurrenceCheckDays   Int @default(90)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceTypeCode, severity])
}

model CapaVerificationMethod {
  id          String  @id @default(cuid())
  code        String  @unique // REVIEW_METRICS | AUDIT_CHECK | INSPECTION | TEST | OBSERVATION | TREND_ANALYSIS | CUSTOMER_FEEDBACK | MULTIPLE
  name        String
  description String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  capas Capa[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────
// Capa — the unified record
// ─────────────────────────────────────────────────────────────────────

model Capa {
  id           String  @id @default(cuid())
  capaNumber   String  @unique // CAPA-{prefix}-YYYY-PLT-NNN
  // Backward-compat alias: legacy capaNumber from IncidentCapa, NearMissCapa,
  // HiraCapa. Resolves existing URLs / audit references indefinitely.
  aliasNumber  String? @unique
  // Legacy table + id this row was backfilled from (null for new CAPAs).
  legacySource String? // "INCIDENT_CAPA" | "NEAR_MISS_CAPA" | "INSPECTION_FINDING_CAPA" | "HIRA_CAPA"
  legacyId     String? @unique

  title String

  // Plant scoping — derived from source where possible
  plantId String
  plant   Plant  @relation("CapaPlant", fields: [plantId], references: [id])

  // ── Source ──────────────────────────────────────────────────────────
  sourceCategoryId String
  sourceCategory   CapaSourceCategory @relation(fields: [sourceCategoryId], references: [id])
  sourceTypeId     String
  sourceType       CapaSourceType     @relation(fields: [sourceTypeId], references: [id])
  // sourceType.code denormalised for fast filtering without joining
  sourceTypeCode   String

  // FK to the source record (loosely typed — could be Incident, NearMiss, HiraEntry, etc.)
  sourceReferenceId      String?
  sourceReferenceUrl     String?
  sourceReferenceSummary String? @db.Text

  // Polymorphic metadata — shape depends on sourceTypeCode. See spec §3.2.
  sourceMetadata Json?

  // ── Problem ────────────────────────────────────────────────────────
  problemDescription  String   @db.Text
  problemImpact       String?  @db.Text
  detectionMethod     String?
  detectedAt          DateTime
  detectedByUserId    String?
  affectedAreas       Json? // string[] of Area.id
  affectedDepartments Json? // string[] of Department.id
  affectedProducts    Json? // free-form product identifiers
  affectedProcesses   Json?
  affectedCustomers   Json?

  // ── Classification ─────────────────────────────────────────────────
  primaryCategory String // e.g. "Equipment-related" | "Process-related"
  subCategoryId   String?
  subCategory     CapaSubCategory? @relation(fields: [subCategoryId], references: [id])
  // CORRECTIVE_ONLY | PREVENTIVE_ONLY | CORRECTIVE_AND_PREVENTIVE
  actionType      String           @default("CORRECTIVE_AND_PREVENTIVE")
  severity        String           @default("MODERATE") // LOW | MODERATE | HIGH | CRITICAL
  priority        String           @default("MODERATE") // LOW | MODERATE | HIGH | URGENT
  isRecurring     Boolean          @default(false)
  // Links to related CAPAs — recurrences, parents, same-root-cause patterns.
  // Authoritative links are in CapaLinkage; this is a denormalised array.
  relatedCapaIds  Json?

  // ── Root cause analysis ────────────────────────────────────────────
  rcaMethodology          String? // 5_WHY | FISHBONE | FAULT_TREE | BOWTIE | TAP_ROOT | CAUSE_MAP | EIGHT_D | IS_IS_NOT | NONE_REQUIRED
  rcaMethodologyRationale String?   @db.Text
  rcaCompleted            Boolean   @default(false)
  rcaRecordId             String? // FK to RCA workspace if used
  rcaSummary              String?   @db.Text
  // Methodology-specific analysis in the same shape the incident RCA editors
  // read and write (src/lib/rca/types.ts), keyed by rcaMethodology. Null when
  // the CAPA was closed on a free-text summary alone, and when a
  // RootCauseAnalysis row (rcaRecordId) owns the analysis instead.
  rcaAnalysisPayload      Json?
  contributingFactors     Json? // string[]
  rcaCompletedAt          DateTime?
  rcaCompletedByUserId    String?

  // ── Verification ───────────────────────────────────────────────────
  verificationMethodId          String?
  verificationMethod            CapaVerificationMethod? @relation(fields: [verificationMethodId], references: [id])
  verificationSuccessCriteria   String?                 @db.Text
  measurementPeriodDays         Int                     @default(30)
  verificationDueDate           DateTime?
  verificationCompletedAt       DateTime?
  verificationCompletedByUserId String?
  // EFFECTIVE | PARTIALLY_EFFECTIVE | INEFFECTIVE | INCONCLUSIVE
  verificationResult            String?
  verificationEvidence          String?                 @db.Text

  recurrenceCheckDueDate     DateTime?
  recurrenceCheckCompletedAt DateTime?
  recurrenceDetected         Boolean?

  // ── Workflow state ─────────────────────────────────────────────────
  // Superset enum per D1: DRAFT | SUBMITTED | UNDER_RCA | ACTIONS_PLANNED |
  // ACTIONS_IN_PROGRESS | PENDING_VERIFICATION | VERIFIED | CLOSED |
  // CLOSED_RECURRED | REJECTED | CANCELLED
  state                String   @default("DRAFT")
  stateChangedAt       DateTime @default(now())
  stateChangedByUserId String?

  rcaDueDate              DateTime?
  correctiveActionDueDate DateTime?
  preventiveActionDueDate DateTime?
  closureTargetDate       DateTime?

  // Free-form audit log of SLA breaches; populated by the scheduler.
  slaBreaches Json?

  // ── Ownership ──────────────────────────────────────────────────────
  raisedByUserId     String
  raisedBy           User    @relation("CapaRaisedBy", fields: [raisedByUserId], references: [id])
  raisedByRole       String?
  primaryOwnerUserId String
  primaryOwner       User    @relation("CapaPrimaryOwner", fields: [primaryOwnerUserId], references: [id])
  primaryOwnerRole   String?
  departmentOwnerId  String? // Department.id

  // ── Cost (optional) ─────────────────────────────────────────────────
  estimatedProblemCost     Float?
  estimatedProblemCurrency String? @default("INR")
  estimatedActionsCost     Float?
  estimatedActionsCurrency String? @default("INR")
  actualCost               Float?
  actualCostCurrency       String? @default("INR")
  costCategories           Json? // ["labor","materials","downtime","rework","customer_concessions"]

  // ── Children ────────────────────────────────────────────────────────
  actions      CapaAction[]
  rootCauses   CapaRootCause[]
  contributors CapaContributor[]
  linkages     CapaLinkage[]     @relation("CapaLinkageFrom")
  linkagesTo   CapaLinkage[]     @relation("CapaLinkageTo")
  attachments  CapaAttachment[]
  comments     CapaComment[]

  // ── Audit ───────────────────────────────────────────────────────────
  createdAt       DateTime  @default(now())
  createdByUserId String
  updatedAt       DateTime  @updatedAt
  updatedByUserId String?
  updatedBy       User?     @relation("CapaUpdatedBy", fields: [updatedByUserId], references: [id])
  versionNumber   Int       @default(1)
  rcaCompletedBy  User?     @relation("CapaRcaCompletedBy", fields: [rcaCompletedByUserId], references: [id])
  verifiedBy      User?     @relation("CapaVerifiedBy", fields: [verificationCompletedByUserId], references: [id])
  closedByUserId  String?
  closedAt        DateTime?
  closedBy        User?     @relation("CapaClosedBy", fields: [closedByUserId], references: [id])

  @@index([plantId, state])
  @@index([plantId, sourceTypeCode, state])
  @@index([plantId, primaryOwnerUserId, state])
  @@index([plantId, closureTargetDate, state])
  @@index([plantId, severity, state])
  @@index([sourceReferenceId, sourceTypeCode])
  @@index([aliasNumber])
}

// ─────────────────────────────────────────────────────────────────────
// Capa children
// ─────────────────────────────────────────────────────────────────────

model CapaAction {
  id     String @id @default(cuid())
  capaId String
  capa   Capa   @relation(fields: [capaId], references: [id], onDelete: Cascade)

  // IMMEDIATE_CONTAINMENT | CORRECTIVE | PREVENTIVE
  actionType  String
  description String  @db.Text
  rationale   String? @db.Text

  ownerUserId String
  owner       User    @relation("CapaActionOwner", fields: [ownerUserId], references: [id])
  ownerRole   String?

  dueDate     DateTime
  startedAt   DateTime?
  completedAt DateTime?

  // PROPOSED | APPROVED | IN_PROGRESS | COMPLETED | DEFERRED | CANCELLED
  status String @default("PROPOSED")

  evidenceOfCompletion String? @db.Text
  attachmentIds        Json? // string[] of CapaAttachment.id

  costEstimate         Float?
  costEstimateCurrency String? @default("INR")

  approverUserId String?
  approver       User?     @relation("CapaActionApprover", fields: [approverUserId], references: [id])
  approvedAt     DateTime?

  // Optional link to the WorkflowTask spawned by CAPA_FAN_OUT for this action
  workflowTaskId String?

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([capaId, actionType, status])
  @@index([ownerUserId, status])
}

model CapaRootCause {
  id     String @id @default(cuid())
  capaId String
  capa   Capa   @relation(fields: [capaId], references: [id], onDelete: Cascade)

  description String @db.Text
  // HUMAN | PROCESS | EQUIPMENT | MATERIAL | ENVIRONMENT | MEASUREMENT | METHOD | MANAGEMENT
  category    String
  // LOW | MEDIUM | HIGH
  confidence  String @default("MEDIUM")

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model CapaContributor {
  id     String @id @default(cuid())
  capaId String
  capa   Capa   @relation(fields: [capaId], references: [id], onDelete: Cascade)

  userId           String
  user             User    @relation("CapaContributorUser", fields: [userId], references: [id])
  role             String?
  // INVESTIGATOR | EXECUTOR | REVIEWER | APPROVER | CONSULTED
  contributionType String

  createdAt DateTime @default(now())

  @@unique([capaId, userId, contributionType])
  @@index([userId])
}

model CapaLinkage {
  id         String @id @default(cuid())
  fromCapaId String
  fromCapa   Capa   @relation("CapaLinkageFrom", fields: [fromCapaId], references: [id], onDelete: Cascade)
  toCapaId   String
  toCapa     Capa   @relation("CapaLinkageTo", fields: [toCapaId], references: [id], onDelete: Cascade)

  // PARENT | CHILD | RELATED | RECURRENCE | PATTERN_MEMBER
  linkageType String

  rationale       String?  @db.Text
  createdAt       DateTime @default(now())
  createdByUserId String?

  @@unique([fromCapaId, toCapaId, linkageType])
  @@index([toCapaId, linkageType])
}

model CapaPatternGroup {
  id        String @id @default(cuid())
  plantId   String
  // Auto-detected (deterministic) → CONFIRMED by reviewer or DISMISSED
  status    String @default("PROPOSED") // PROPOSED | CONFIRMED | DISMISSED
  rationale String @db.Text
  capaIds   Json // string[] of Capa.id forming the pattern

  reviewedByUserId String?
  reviewedAt       DateTime?

  createdAt DateTime @default(now())

  @@index([plantId, status])
}

model CapaAttachment {
  id     String @id @default(cuid())
  capaId String
  capa   Capa   @relation(fields: [capaId], references: [id], onDelete: Cascade)

  // EVIDENCE | RCA_DOCUMENT | ACTION_PLAN | VERIFICATION_EVIDENCE | CLOSURE_DOCUMENT | EXTERNAL_COMMUNICATION | OTHER
  category    String
  fileName    String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  description String?

  uploadedAt       DateTime @default(now())
  uploadedByUserId String
  uploadedBy       User     @relation("CapaAttachmentUploader", fields: [uploadedByUserId], references: [id])

  @@index([capaId])
}

model CapaComment {
  id     String @id @default(cuid())
  capaId String
  capa   Capa   @relation(fields: [capaId], references: [id], onDelete: Cascade)

  body         String  @db.Text
  authorUserId String
  author       User    @relation("CapaCommentAuthor", fields: [authorUserId], references: [id])
  // ACTIVITY | UPDATE | DECISION | EXTERNAL_RESPONSE
  commentType  String  @default("ACTIVITY")
  isInternal   Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([capaId])
}

// ═════════════════════════════════════════════════════════════════════
// EAI — Environmental Aspect & Impact Register (HIRA Phase 2)
// ═════════════════════════════════════════════════════════════════════
// ISO 14001:2015 §6.1.2 — identify environmental aspects of activities
// and assess associated environmental impacts. Mirrors HIRA's structural
// pattern (study container + per-row register entries + masters + review
// cycles + immutable versioning + cross-module hooks) so 60-70% of the
// HIRA infrastructure is reused.
//
// Domain mapping (HIRA → EAI):
//   Hazard                  → EaiAspect
//   Harm to persons         → EaiEntryImpact
//   RiskMatrix              → EnvironmentalImpactMatrix (likelihood × magnitude)
//   Risk level              → Impact significance
//   Affected persons        → Affected receptors (air/water/soil/community)
//   Health & safety controls → Environmental controls
//
// Feature is opt-in per-plant via Plant.featuresEnabled JSON (added below).
// ═════════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────────────
// Master data — 9 ISO 14001 aspect categories, 80+ aspect library,
// receptors, regulations, impact matrices.
// ─────────────────────────────────────────────────────────────────────

model EaiAspectCategory {
  id          String  @id @default(cuid())
  code        String  @unique // "AIR_EMISSIONS", "WATER_DISCHARGE", ...
  name        String
  description String?
  sortOrder   Int     @default(0)
  iconKey     String? // UI hint
  isActive    Boolean @default(true)

  aspects EaiAspect[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EaiAspect {
  id          String            @id @default(cuid())
  code        String            @unique // "AIR_STACK_PM", "WATER_PROCESS_EFFLUENT", ...
  categoryId  String
  category    EaiAspectCategory @relation(fields: [categoryId], references: [id])
  name        String
  description String            @db.Text

  // Typical receptors affected (string codes — EaiReceptor.code)
  typicalReceptors Json // string[]

  // Typical impact descriptions for this aspect — pre-seeded so the
  // team has a starting point when the aspect is added to an entry.
  // JSON: [{ description, impactType, reversibility, geographicExtent }]
  typicalImpacts Json?

  // Statutory references — string[] of regulation codes
  typicalRegulations Json?

  // Typical controls — pre-canned suggestions when this aspect is added.
  // JSON: [{ hierarchy, description }]
  typicalControls Json?

  // Significance hints — does this aspect typically meet the significance
  // threshold (legal exposure, irreversibility, etc.)?
  typicallySignificant Boolean @default(false)

  isActive Boolean @default(true)
  isGlobal Boolean @default(false)

  entryAspects EaiEntryAspect[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, isActive])
  @@index([isGlobal, isActive])
}

model EaiReceptor {
  id          String  @id @default(cuid())
  code        String  @unique // "AIR", "SURFACE_WATER", "COMMUNITY", ...
  name        String
  description String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
}

model EaiRegulation {
  id           String  @id @default(cuid())
  code         String  @unique // "EPA_1986", "WATER_ACT_1974", ...
  name         String
  jurisdiction String  @default("INDIA") // INDIA | STATE | INTERNATIONAL
  section      String?
  description  String? @db.Text
  authority    String? // CPCB | SPCB | MoEFCC | state board
  sortOrder    Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
}

// Environmental impact matrix — likelihood × magnitude, mirrors RiskMatrix
// but uses environmental magnitude scales (reversibility, geographic extent,
// duration) instead of severity-to-persons scales.
model EnvironmentalImpactMatrix {
  id          String  @id @default(cuid())
  code        String  @unique // "ENV_5X5_STD", "ENV_4X4_SIMPLE", "ENV_5X5_CHEMICALS"
  name        String
  description String?

  likelihoodLevels Int
  magnitudeLevels  Int

  // Significance thresholds per impact level — { "low": false, "moderate": false, "significant": true, "major": true }
  significanceThresholds Json

  // Acceptable residual thresholds, per activity occurrence type. JSON:
  // { "normal": "MODERATE", "abnormal": "MODERATE", "emergency": "LOW" }
  acceptableResidual Json

  controlHierarchyEnforced Boolean @default(true)

  isActive  Boolean @default(true)
  isDefault Boolean @default(false)
  isGlobal  Boolean @default(false)

  likelihoods EnvironmentalImpactMatrixLikelihood[]
  magnitudes  EnvironmentalImpactMatrixMagnitude[]
  cells       EnvironmentalImpactMatrixCell[]
  studies     EaiStudy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, isDefault])
}

model EnvironmentalImpactMatrixLikelihood {
  id                 String                    @id @default(cuid())
  matrixId           String
  matrix             EnvironmentalImpactMatrix @relation(fields: [matrixId], references: [id], onDelete: Cascade)
  score              Int // 1..N
  label              String // "Rare", "Unlikely", ...
  description        String
  occurrenceGuidance String? // "Once in 10+ years" / "Continuous"
  sortOrder          Int                       @default(0)

  initialEntries  EaiEntry[] @relation("EaiEntryInitialLikelihood")
  residualEntries EaiEntry[] @relation("EaiEntryResidualLikelihood")

  @@unique([matrixId, score])
  @@index([matrixId, sortOrder])
}

model EnvironmentalImpactMatrixMagnitude {
  id                    String                    @id @default(cuid())
  matrixId              String
  matrix                EnvironmentalImpactMatrix @relation(fields: [matrixId], references: [id], onDelete: Cascade)
  score                 Int
  label                 String // "Insignificant", "Minor", "Moderate", "Major", "Catastrophic"
  description           String
  // Environmental-specific guidance fields
  geographicGuidance    String? // "Site only" .. "Regional spread"
  reversibilityGuidance String? // "Fully reversible" .. "Irreversible"
  durationGuidance      String? // "Short-term <1 month" .. "Permanent"
  legalGuidance         String? // "No reportable threshold" .. "Statutory breach"
  sortOrder             Int                       @default(0)

  initialEntries  EaiEntry[] @relation("EaiEntryInitialMagnitude")
  residualEntries EaiEntry[] @relation("EaiEntryResidualMagnitude")

  @@unique([matrixId, score])
  @@index([matrixId, sortOrder])
}

model EnvironmentalImpactMatrixCell {
  id               String                    @id @default(cuid())
  matrixId         String
  matrix           EnvironmentalImpactMatrix @relation(fields: [matrixId], references: [id], onDelete: Cascade)
  likelihoodScore  Int
  magnitudeScore   Int
  impactScore      Int
  impactLevel      String // "LOW" | "MODERATE" | "SIGNIFICANT" | "MAJOR"
  colorHex         String
  actionRequired   String
  responseTimeDays Int

  @@unique([matrixId, likelihoodScore, magnitudeScore])
  @@index([matrixId, impactLevel])
}

// ─────────────────────────────────────────────────────────────────────
// EaiStudy — the per-plant container for environmental entries.
// ─────────────────────────────────────────────────────────────────────

model EaiStudy {
  id     String @id @default(cuid())
  number String @unique // "EAI-YYYY-PLT-NNN" assigned at creation

  plantId      String
  plant        Plant       @relation(fields: [plantId], references: [id])
  departmentId String?
  department   Department? @relation("EaiStudyDepartment", fields: [departmentId], references: [id])
  areaId       String?
  area         Area?       @relation("EaiStudyArea", fields: [areaId], references: [id])
  scopeType    String // "PLANT" | "AREA" | "DEPARTMENT" | "PROCESS" | "ACTIVITY"
  activityIds  Json?
  processCode  String?

  title       String
  description String?

  impactMatrixId String
  impactMatrix   EnvironmentalImpactMatrix @relation(fields: [impactMatrixId], references: [id])

  teamLeaderId String
  teamLeader   User                 @relation("EaiStudyTeamLeader", fields: [teamLeaderId], references: [id])
  team         EaiStudyTeamMember[]

  status                  String    @default("DRAFT") // DRAFT | IN_PROGRESS | TEAM_REVIEW | APPROVAL_PENDING | APPROVED | ACTIVE | SUPERSEDED | ARCHIVED
  initiatedAt             DateTime  @default(now())
  targetCompletionDate    DateTime?
  completedAt             DateTime?
  approvedAt              DateTime?
  approvedById            String?
  approvedBy              User?     @relation("EaiStudyApprover", fields: [approvedById], references: [id])
  effectiveFrom           DateTime?
  nextScheduledReviewDate DateTime?

  reviewFrequency    String @default("ANNUAL") // ANNUAL | BIENNIAL | TRIGGERED_ONLY | QUARTERLY | CUSTOM
  customReviewMonths Int?

  // Compliance — string[] of EaiRegulation codes
  applicableRegulations    Json?
  regulatoryReviewRequired Boolean @default(false)

  aggregateMetrics Json? // recomputed by service layer

  entries EaiEntry[]

  createdAt   DateTime @default(now())
  createdById String
  createdBy   User     @relation("EaiStudyCreator", fields: [createdById], references: [id])
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("EaiStudyUpdater", fields: [updatedById], references: [id])

  @@index([plantId, status])
  @@index([status, nextScheduledReviewDate])
  @@index([plantId, departmentId])
}

model EaiStudyTeamMember {
  id      String   @id @default(cuid())
  studyId String
  study   EaiStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)
  userId  String
  user    User     @relation("EaiStudyTeamMemberUser", fields: [userId], references: [id])

  // FACILITATOR | ENVIRONMENT_MANAGER | PROCESS_EXPERT | OPERATIONS | SUSTAINABILITY | EXTERNAL_CONSULTANT
  teamRole   String
  department String?

  signedAt   DateTime?
  signedNote String?

  createdAt DateTime @default(now())

  @@unique([studyId, userId])
  @@index([studyId])
}

// ─────────────────────────────────────────────────────────────────────
// EaiEntry — single row in the environmental register.
// ─────────────────────────────────────────────────────────────────────

model EaiEntry {
  id      String   @id @default(cuid())
  studyId String
  study   EaiStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)

  sequenceNumber Int
  groupLabel     String?

  // Activity context
  activityDescription String  @db.Text
  areaId              String?
  area                Area?   @relation("EaiEntryArea", fields: [areaId], references: [id])
  subLocation         String?
  occurrence          String // "NORMAL" | "ABNORMAL" | "EMERGENCY"
  frequency           String // "CONTINUOUS" | "DAILY" | "WEEKLY" | "MONTHLY" | "OCCASIONAL" | "RARE"
  typicalDurationMin  Int?

  // Loose-FK JSON arrays
  equipmentUsed Json? // string[] — Equipment.id values
  materialsUsed Json? // string[] — material master values
  processInputs Json? // string[] — energy/water/raw inputs

  // Initial impact assessment — flat columns with FKs for queryability
  initialLikelihoodId        String
  initialLikelihood          EnvironmentalImpactMatrixLikelihood @relation("EaiEntryInitialLikelihood", fields: [initialLikelihoodId], references: [id])
  initialLikelihoodScore     Int
  initialLikelihoodRationale String?                             @db.Text
  initialMagnitudeId         String
  initialMagnitude           EnvironmentalImpactMatrixMagnitude  @relation("EaiEntryInitialMagnitude", fields: [initialMagnitudeId], references: [id])
  initialMagnitudeScore      Int
  initialMagnitudeRationale  String?                             @db.Text
  initialImpactScore         Int
  initialImpactLevel         String // LOW | MODERATE | SIGNIFICANT | MAJOR
  initialImpactColor         String?
  initialSignificant         Boolean                             @default(false)

  // Residual impact assessment
  residualLikelihoodId        String?
  residualLikelihood          EnvironmentalImpactMatrixLikelihood? @relation("EaiEntryResidualLikelihood", fields: [residualLikelihoodId], references: [id])
  residualLikelihoodScore     Int?
  residualLikelihoodRationale String?                              @db.Text
  residualMagnitudeId         String?
  residualMagnitude           EnvironmentalImpactMatrixMagnitude?  @relation("EaiEntryResidualMagnitude", fields: [residualMagnitudeId], references: [id])
  residualMagnitudeScore      Int?
  residualMagnitudeRationale  String?                              @db.Text
  residualImpactScore         Int?
  residualImpactLevel         String?
  residualImpactColor         String?
  residualAcceptable          Boolean?
  residualAcceptanceRationale String?                              @db.Text
  residualSignificant         Boolean                              @default(false)

  // Legal compliance status — COMPLIANT | MARGINAL | NON_COMPLIANT | NOT_APPLICABLE
  legalComplianceStatus String?

  // Cross-module linkages
  linkedHiraEntryIds         Json? // string[] — HIRA cross-ref
  triggersTrainingProgramIds Json?
  triggersInspectionTypeIds  Json?
  triggersComplianceTaskIds  Json?

  // Review metadata
  lastReviewedAt      DateTime?
  lastReviewedById    String?
  nextReviewDue       DateTime?
  reviewCount         Int       @default(0)
  lastReviewType      String?
  triggeredByRecordId String?

  status String @default("DRAFT") // DRAFT | IN_REVIEW | APPROVED | ACTIVE | FLAGGED_FOR_REVIEW | SUPERSEDED | ARCHIVED

  versionNumber    Int     @default(1)
  isCurrentVersion Boolean @default(true)
  parentVersionId  String?

  aspects               EaiEntryAspect[]
  impacts               EaiEntryImpact[]
  existingControls      EaiEntryControl[]
  recommendedControls   EaiEntryRecommendedControl[]
  complianceObligations EaiComplianceObligation[]
  regulationRefs        EaiEntryRegulationRef[]
  reviewCycles          EaiReviewCycle[]
  versions              EaiVersion[]

  createdAt   DateTime @default(now())
  createdById String
  createdBy   User     @relation("EaiEntryCreator", fields: [createdById], references: [id])
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("EaiEntryUpdater", fields: [updatedById], references: [id])

  @@unique([studyId, sequenceNumber])
  @@index([studyId, status])
  @@index([status, nextReviewDue])
  @@index([initialImpactLevel])
  @@index([residualImpactLevel])
  @@index([residualSignificant])
}

model EaiEntryAspect {
  id       String    @id @default(cuid())
  entryId  String
  entry    EaiEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  aspectId String
  aspect   EaiAspect @relation(fields: [aspectId], references: [id])

  contextualDescription String? @db.Text
  // JSON: { parameter, typicalValue, unit, monitoringPoint }
  quantification        Json?
  occurrence            String? // overrides entry-level if different ("NORMAL" | "ABNORMAL" | "EMERGENCY")

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([entryId, aspectId])
  @@index([entryId])
}

model EaiEntryImpact {
  id      String   @id @default(cuid())
  entryId String
  entry   EaiEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  description      String @db.Text
  affectedReceptor String // EaiReceptor.code
  impactType       String // "DIRECT" | "INDIRECT" | "CUMULATIVE"
  reversibility    String // "REVERSIBLE" | "PARTIALLY_REVERSIBLE" | "IRREVERSIBLE"
  geographicExtent String // "SITE" | "LOCAL" | "REGIONAL" | "NATIONAL" | "GLOBAL"
  temporalExtent   String // "SHORT_TERM" | "MEDIUM_TERM" | "LONG_TERM" | "PERMANENT"

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([entryId])
}

model EaiEntryControl {
  id      String   @id @default(cuid())
  entryId String
  entry   EaiEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  hierarchy           String // ELIMINATION | SUBSTITUTION | ENGINEERING | ADMINISTRATIVE | PPE | MONITORING
  description         String  @db.Text
  effectiveness       String?
  verificationMethod  String?
  verificationFreq    String?
  responsibleRole     String?
  evidenceAttached    Boolean @default(false)
  // Environmental controls often include monitoring — point/parameter/frequency
  monitoringPoint     String?
  monitoringParameter String?
  monitoringFrequency String?

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([entryId])
}

model EaiEntryRecommendedControl {
  id      String   @id @default(cuid())
  entryId String
  entry   EaiEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  hierarchy   String
  description String  @db.Text
  rationale   String? @db.Text

  targetLikelihoodReduction Int?
  targetMagnitudeReduction  Int?
  estimatedCostBand         String?

  proposedImplementationDate DateTime?
  responsibleUserId          String?

  status String @default("PROPOSED") // PROPOSED | APPROVED | IN_PROGRESS | IMPLEMENTED | DEFERRED | REJECTED

  // When the recommendation becomes a CAPA, link to unified Capa via ID
  capaId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entryId, status])
}

model EaiComplianceObligation {
  id      String   @id @default(cuid())
  entryId String
  entry   EaiEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  regulationCode       String // EaiRegulation.code
  section              String?
  parameter            String // "PM concentration", "BOD", "Noise dB(A)"
  permittedLimit       String // free-text, e.g. "150 mg/Nm³" or "60 dB(A) daytime"
  monitoringFrequency  String
  reportingAuthority   String?
  reportingFrequency   String?
  nextMonitoringDue    DateTime?
  lastMonitoringDate   DateTime?
  lastMonitoringResult String?
  status               String    @default("ACTIVE") // ACTIVE | MET | BREACHED | INACTIVE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entryId, status])
  @@index([nextMonitoringDue])
}

model EaiEntryRegulationRef {
  id      String   @id @default(cuid())
  entryId String
  entry   EaiEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  regulationCode     String
  section            String?
  requirementSummary String? @db.Text

  createdAt DateTime @default(now())

  @@index([entryId])
}

model EaiReviewCycle {
  id      String   @id @default(cuid())
  entryId String
  entry   EaiEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  scheduledFor       DateTime
  triggeredBy        String // SCHEDULE | ENV_INCIDENT | MOC | AUDIT_FINDING | MANUAL | REGULATORY_CHANGE | COMPLIANCE_BREACH
  triggerReferenceId String?

  status String @default("SCHEDULED") // SCHEDULED | IN_PROGRESS | COMPLETED | SKIPPED

  assignedToId String
  assignedTo   User    @relation("EaiReviewAssignee", fields: [assignedToId], references: [id])
  assignedRole String?

  startedAt     DateTime?
  completedAt   DateTime?
  completedById String?
  completedBy   User?     @relation("EaiReviewCompleter", fields: [completedById], references: [id])

  outcome      String? // NO_CHANGE_REQUIRED | MINOR_REVISION | MAJOR_REVISION | NEW_ENTRY_CREATED | ENTRY_ARCHIVED
  outcomeNotes String? @db.Text

  changesMade Json?

  createdAt DateTime @default(now())

  @@index([entryId, status])
  @@index([assignedToId, status])
  @@index([status, scheduledFor])
}

model EaiVersion {
  id      String   @id @default(cuid())
  entryId String
  entry   EaiEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  versionNumber Int

  snapshot Json
  changes  Json

  changeReason  String @db.Text
  changeTrigger String // SCHEDULED_REVIEW | ENV_INCIDENT_REVIEW | MOC | CORRECTION | AUDIT_FINDING | INITIAL_APPROVAL | COMPLIANCE_BREACH

  createdAt   DateTime @default(now())
  createdById String
  createdBy   User     @relation("EaiVersionCreator", fields: [createdById], references: [id])

  @@unique([entryId, versionNumber])
  @@index([entryId])
}

// ─────────────────────────────────────────────────────────────────────
// EaiFeatureFlag — per-plant tenant-style feature flag for Phase 2
// rollout. EAI is opt-in: a plant must have an active flag to see EAI
// pages, masters, and endpoints. Combined Register and Risk Aggregation
// Dashboard each have their own flag too.
// ─────────────────────────────────────────────────────────────────────

model EaiFeatureFlag {
  id      String @id @default(cuid())
  plantId String @unique

  eaiRegisterEnabled      Boolean @default(false)
  combinedRegisterEnabled Boolean @default(false)
  riskDashboardEnabled    Boolean @default(false)
  hiraAssistantV2Enabled  Boolean @default(false)

  enabledAt   DateTime?
  enabledById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ═════════════════════════════════════════════════════════════════════
// SKILL MATRIX — Competency state layer (Phase 1 of IMS — HR-adjacent wedge)
// ═════════════════════════════════════════════════════════════════════
// The authoritative record of who can do what. Sits ON TOP of the existing
// Training/Certificate machinery: a CompetencyRecord is the validated state,
// TrainingCertificate is ONE input to it (training completion ≠ competency).
// See SKILL_MATRIX_IMPLEMENTATION_PLAN.md (D1) + SKILL_MATRIX_PHASE0.md (§2 ER).
//
// Additive-only stance: relations are declared ONLY among these new tables.
// Every reference to a pre-existing table (User, Plant, TrainingProgram,
// TrainingCertificate, TrainingAssessment, HiraEntry, Permit, Role,
// Department) is an FK-by-value String scalar — exactly the precedent set by
// Capa.detectedByUserId / departmentOwnerId / sourceReferenceId. Appending
// these models therefore edits NO existing model. `state` is String (not an
// enum) per D2, matching Capa.state.
// ═════════════════════════════════════════════════════════════════════

// ── Competency master (spec §3.1) ────────────────────────────────────
model Competency {
  id          String  @id @default(cuid())
  // null plantId = global library row; else plant-specific. code is globally
  // unique (the library uses globally-stable codes like "CS-ENTRANT-L1").
  plantId     String?
  code        String  @unique
  name        String
  description String? @db.Text

  // safety_critical | operational | technical | leadership | behavioral |
  // regulatory | quality | environmental
  category    String
  subcategory String?

  // [{ method, isMandatory, weight, minimumScore, minimumDurationMonths,
  //    minimumSupervisedInstances }] — see spec §3.1 validation_methods.
  validationMethods Json

  // FK-by-value to TrainingProgram (programCode/id) — training feeds competency.
  relatedTrainingProgramIds String[]

  defaultValidityMonths Int
  preExpiryWarningDays  Int @default(90)
  gracePeriodDays       Int @default(30)

  prerequisiteCompetencyIds String[]
  supersededByCompetencyIds String[]
  supersededAt              DateTime?

  // [{ regulation, section, requirement }]
  regulatoryReferences Json?

  // Cross-module enablement (FK-by-value): which roles/permits/HIRA activities
  // this competency unlocks. enablesPermitTypes is read by the PTW gate (D6).
  enablesRoleIds       String[]
  enablesPermitTypes   String[]
  enablesActivityTypes String[]

  // training_only | assessment_required | external_only | supervisor_endorsement
  reValidationWorkflow String @default("assessment_required")

  isActive Boolean @default(true)
  isGlobal Boolean @default(false)

  createdAt       DateTime @default(now())
  createdByUserId String
  updatedAt       DateTime @updatedAt

  records          CompetencyRecord[]
  roleRequirements RoleCompetencyRequirement[]

  // Training & Competency Engine back-relations (additive)
  hazardMappings      HazardToSkillMapping[]
  trainingAssignments TrainingAssignment[]
  trainingContent     TrainingContent[]

  @@index([plantId, category, isActive])
}

// ── Skill — sub-component of a competency (spec §3.1) ─────────────────
model Skill {
  id          String  @id @default(cuid())
  plantId     String?
  code        String  @unique
  name        String
  description String? @db.Text
  category    String?

  contributesToCompetencyIds String[]

  isActive Boolean @default(true)
  isGlobal Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── RoleDefinition — job/position master (spec §3.1, D3) ──────────────
// A job role ("Senior Welder"), distinct from the RBAC Role master.
// roleMasterId optionally links to Role.id when the job role also grants
// system permissions (FK-by-value; nullable).
model RoleDefinition {
  id      String  @id @default(cuid())
  // null = global template role definition (applies to all plants); else
  // plant-specific. Seed library role defs are global.
  plantId String?

  roleMasterId String? // FK-by-value to Role.id (optional)
  roleName     String // denormalised for display

  appliesToDepartments String[] // Department.id
  appliesToPlants      String[] // Plant.id

  // { overallIndustryMonths, similarRoleMonths, specificEquipmentMonths }
  minimumExperience          Json?
  // [{ requirement, frequencyMonths }]
  medicalFitnessRequirements Json?
  // { maxPermitSeverityCanApprove, maxCapaSeverityCanClose, canTrainOthers,
  //   canAssessCompetency, canSuperviseCompetencyDevelopment }
  authorityLimits            Json?

  isActive                 Boolean  @default(true)
  effectiveFrom            DateTime @default(now())
  supersededByDefinitionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requiredCompetencies RoleCompetencyRequirement[]
  assignments          PersonRoleAssignment[]

  @@index([plantId, isActive])
}

// ── RoleCompetencyRequirement (child of RoleDefinition, spec §3.1) ────
model RoleCompetencyRequirement {
  id               String         @id @default(cuid())
  roleDefinitionId String
  roleDefinition   RoleDefinition @relation(fields: [roleDefinitionId], references: [id], onDelete: Cascade)
  competencyId     String
  competency       Competency     @relation(fields: [competencyId], references: [id])

  requirementType            String // mandatory | preferred | conditional
  conditionalLogic           String?
  gracePeriodForNewHiresDays Int     @default(0)
  rationale                  String? @db.Text
  // Training & Competency Engine (additive): target proficiency for this
  // role×competency. Awareness | Working | Proficient | Expert. Nullable so
  // existing rows are unaffected; the 11-state machine stays authoritative
  // for compliance — proficiency is a display/analytics overlay.
  requiredProficiency        String?

  // Recert interval override for this role×competency (months). Null = use
  // Competency.defaultValidityMonths. Consumed by the recertification rule.
  recertIntervalMonthsOverride Int?

  @@index([roleDefinitionId])
  @@index([competencyId])
}

// ── CompetencyRecord — the validated state for a person (spec §3.2) ───
model CompetencyRecord {
  id      String @id @default(cuid())
  plantId String

  personUserId String // FK-by-value to User.id
  competencyId String
  competency   Competency @relation(fields: [competencyId], references: [id])

  // 11-state machine (spec §3.2). String, not enum (D2). Transition rules live
  // in app/services/competency_state.py (Phase B).
  state String @default("not_yet_attempted")

  // ── current validation (flattened from spec's current_validation object) ──
  currentValidatedAt           DateTime?
  currentValidatedByUserId     String?
  currentValidationMethod      String?
  currentScore                 Float?
  // Training & Competency Engine (additive): attained proficiency label
  // (Awareness | Working | Proficient | Expert). Display/analytics overlay;
  // nullable so existing rows are unaffected.
  currentProficiency           String?
  externalCertificateReference String?
  externalCertificateAuthority String?
  externalCertificateUrl       String?
  currentEvidenceAttachments   Json?
  validFrom                    DateTime?
  validUntil                   DateTime?
  conditions                   String?   @db.Text
  restrictions                 String?   @db.Text

  // ── progress (in-development competencies) ──
  requiredValidationsTotal     Int       @default(0)
  requiredValidationsCompleted Int       @default(0)
  lastProgressEventAt          DateTime?
  estimatedCompletionDate      DateTime?

  // ── re-validation ──
  nextRevalidationDue DateTime?
  // [{ revalidatedAt, previousValidUntil, newValidUntil, methodUsed, score }]
  revalidationHistory Json?
  // [{ suspendedAt, suspendedByUserId, reason, reinstatedAt, ... }]
  suspensionHistory   Json?

  // ── cross-references (FK-by-value arrays) ──
  relatedTrainingRecords String[] // TrainingCertificate.id
  relatedAssessments     String[] // CompetencyAssessment.id
  relatedSupervisions    String[] // SupervisedPerformanceRecord.id

  createdAt       DateTime @default(now())
  createdByUserId String
  updatedAt       DateTime @updatedAt
  updatedByUserId String?
  versionNumber   Int      @default(1)

  attempts     CompetencyValidationAttempt[]
  versions     CompetencyRecordVersion[]
  assessments  CompetencyAssessment[]
  supervisions SupervisedPerformanceRecord[]

  @@unique([personUserId, competencyId])
  @@index([plantId, personUserId, state])
  @@index([plantId, competencyId, state])
  @@index([plantId, validUntil])
  @@index([nextRevalidationDue])
}

// ── CompetencyValidationAttempt (child, spec §3.2) ────────────────────
model CompetencyValidationAttempt {
  id       String           @id @default(cuid())
  recordId String
  record   CompetencyRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  method              String
  startedAt           DateTime
  completedAt         DateTime?
  result              String // passed | failed | in_progress | abandoned
  score               Float?
  assessorUserId      String?
  evidenceAttachments Json?
  notes               String?   @db.Text

  @@index([recordId])
}

// ── CompetencyRecordVersion — immutable audit/version (D8, HiraVersion shape) ─
model CompetencyRecordVersion {
  id       String           @id @default(cuid())
  recordId String
  record   CompetencyRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  versionNumber Int

  snapshot Json // full CompetencyRecord (+ children) at this version
  changes  Json // [{ fieldPath, oldValue, newValue }]

  changeReason  String @db.Text
  // VALIDATION | REVALIDATION | EXPIRY | SUSPENSION | REINSTATEMENT |
  // REVOCATION | CORRECTION | INITIAL
  changeTrigger String

  createdAt   DateTime @default(now())
  createdById String

  @@unique([recordId, versionNumber])
  @@index([recordId])
}

// ── PersonRoleAssignment — companion to UserRole (spec §3.2, D4) ──────
// UserRole stays the RBAC truth; this holds the competency-gap metadata.
model PersonRoleAssignment {
  id      String @id @default(cuid())
  plantId String

  personUserId     String // FK-by-value to User.id
  roleDefinitionId String
  roleDefinition   RoleDefinition @relation(fields: [roleDefinitionId], references: [id])

  isPrimary Boolean @default(false)

  assignedAt          DateTime @default(now())
  assignedByUserId    String
  assignmentRationale String?  @db.Text

  effectiveFrom  DateTime  @default(now())
  effectiveUntil DateTime?

  // { fullyCompetent, gaps:[{competencyId, gapType}], operatingUnderGracePeriod,
  //   gracePeriodExpires }
  competencyAssessmentAtAssignment Json?
  operatingUnderGracePeriod        Boolean   @default(false)
  gracePeriodExpires               DateTime?

  status        String @default("active") // active | on_leave | suspended | transitioning | ended
  statusHistory Json? // [{ status, changedAt, changedByUserId, reason }]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plantId, personUserId, status])
  @@index([roleDefinitionId, status])
}

// ── CompetencyAssessment — standalone competency assessment (spec §3.2, D5) ──
// Modelled on TrainingAssessment but not registration-bound. Links back to a
// TrainingAssessment via sourceTrainingAssessmentId when it happened inside a
// training (FK-by-value).
model CompetencyAssessment {
  id      String @id @default(cuid())
  plantId String

  recordId     String
  record       CompetencyRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  // denormalised for direct query without joining the record
  personUserId String
  competencyId String

  assessmentType String // written | practical | oral | scenario_based | psychomotor | combined
  scheduledAt    DateTime
  conductedAt    DateTime?
  location       String?

  assessorUserId String
  assessorRole   String?

  assessmentTemplateId String? // FK-by-value
  questionsCount       Int     @default(0)
  durationMinutes      Int     @default(0)

  status           String  @default("scheduled") // scheduled | in_progress | completed | passed | failed | cancelled | rescheduled
  rawScore         Float?
  maximumScore     Float?
  percentageScore  Float?
  minimumPassScore Float   @default(0)
  result           String? // pass | fail

  scoringBreakdown Json? // [{ area, score, maximum, notes }]

  assessorObservations String? @db.Text
  assesseeFeedback     String? @db.Text
  evidenceAttachments  Json? // [{ type, fileUrl, description }]

  competencyValidated      Boolean   @default(false)
  remedialActionsRequired  String?   @db.Text
  reAssessmentEligibleFrom DateTime?

  sourceTrainingAssessmentId String? // FK-by-value to TrainingAssessment.id (D5)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([recordId])
  @@index([plantId, personUserId])
  @@index([assessorUserId, status])
}

// ── SupervisedPerformanceRecord — OJT (spec §3.2) ─────────────────────
model SupervisedPerformanceRecord {
  id      String @id @default(cuid())
  plantId String

  recordId     String
  record       CompetencyRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  personUserId String
  competencyId String

  activityDescription String   @db.Text
  activityDate        DateTime
  activityLocation    String?
  hiraEntryId         String? // FK-by-value
  permitId            String? // FK-by-value

  supervisorUserId                String
  supervisorCompetencyToSupervise String?

  // needs_significant_support | needs_some_support | competent_with_supervision |
  // competent_independent | exemplary
  performanceRating String

  // { technicalExecution, safetyAwareness, decisionMaking, communication,
  //   procedureAdherence }
  observations Json?

  contributesToValidation Boolean @default(true)
  attemptNumber           Int     @default(1)

  evidenceAttachments        Json?
  supervisorSignatureAt      DateTime?
  superviseeAcknowledgmentAt DateTime?

  createdAt DateTime @default(now())

  @@index([recordId])
  @@index([plantId, personUserId])
}

// ── RecertificationCycle (spec §4.4) ──────────────────────────────────
model RecertificationCycle {
  id      String @id @default(cuid())
  plantId String

  cycleNumber String @unique
  name        String
  status      String @default("DRAFT") // DRAFT | SCHEDULED | IN_PROGRESS | COMPLETED | CLOSED

  scopeCompetencyIds String[]
  scopeRoleIds       String[]
  scopeDepartmentIds String[]
  scopePlantIds      String[]

  windowStart DateTime?
  windowEnd   DateTime?

  ownerUserId          String
  affectedPersonsCount Int    @default(0)
  completedCount       Int    @default(0)

  summary Json?

  createdAt       DateTime  @default(now())
  createdByUserId String
  updatedAt       DateTime  @updatedAt
  closedAt        DateTime?
  closedByUserId  String?

  tasks RecertificationTask[]

  @@index([plantId, status])
}

// ── RecertificationTask (child) ───────────────────────────────────────
model RecertificationTask {
  id      String               @id @default(cuid())
  cycleId String
  cycle   RecertificationCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  personUserId String
  competencyId String
  recordId     String? // FK-by-value to CompetencyRecord.id

  revalidationMethod String
  status             String @default("not_started") // not_started | scheduled | in_progress | completed | overdue

  scheduledAt DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())

  @@index([cycleId, status])
  @@index([personUserId, status])
}

// ═════════════════════════════════════════════════════════════════════
//  TRAINING & COMPETENCY ENGINE  (Trigger + Assignment + Content Adapter)
//  ─────────────────────────────────────────────────────────────────────
//  Additive layer over the Skill-Matrix models above. Every table below is
//  keyed on competencyId (the "skill node") — the rule engine NEVER reads
//  contentType/vendorId, which is what decouples content vendors from the
//  logic (spec §C). Tables are created by prisma/apply-training-engine-ddl.ts
//  (hand-DDL, idempotent) — NEVER prisma db push. String+comment, not enum
//  (house convention). SQLAlchemy mirror: app/models/training_engine.py.
// ═════════════════════════════════════════════════════════════════════

// ── HazardToSkillMapping — the admin-configurable "moat" mapping ──────
// Links a classification value on an Incident / Near Miss / Observation to a
// competency (skill node). Configurable per plant (plantId null = global) so
// each client tunes trigger sensitivity WITHOUT a code change (spec §B).
model HazardToSkillMapping {
  id      String  @id @default(cuid())
  plantId String? // null = global mapping (applies to every plant)

  // INCIDENT | NEAR_MISS | OBSERVATION | ANY — which source module this maps
  sourceModule String @default("ANY")

  // Which classification field on the source record to match against:
  //   category (Observation) | hazardCategory (NearMiss, MasterItem id) |
  //   initialRootCauseCategory | rootCauseCategory | severity | type | keyword
  classificationField String
  // The value to match (e.g. "CONFINED_SPACE", "WORK_AT_HEIGHT", "CRITICAL"),
  // or — when classificationField = "keyword" — a substring matched against the
  // record's root-cause/description text blob (case-insensitive).
  classificationValue String
  matchMode           String @default("exact") // exact | keyword

  competencyId String
  competency   Competency @relation(fields: [competencyId], references: [id])

  priority Int     @default(100)
  notes    String? @db.Text
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([plantId, sourceModule, isActive])
  @@index([competencyId])
  @@index([classificationField, classificationValue])
}

// ── TrainingRuleConfig — tenant/plant-configurable thresholds & windows ─
// One row per plant (plantId null = global default). The rule engine resolves
// the most-specific active config. All sensitivity knobs live here, never
// hardcoded (spec business rule "all threshold/window values tenant-configurable").
model TrainingRuleConfig {
  id      String  @id @default(cuid())
  plantId String? // null = global default; a plant row overrides it

  // Threshold rule: N mapped records at a site/department within the window.
  thresholdCount      Int @default(3)
  thresholdWindowDays Int @default(90)

  // Severity rule: SIF-potential (or >= severityThreshold) → immediate
  // individual assignment, bypassing the threshold count.
  severitySifImmediate Boolean @default(true)
  severityThreshold    String  @default("HIGH") // HIGH | CRITICAL

  // Recertification rule: refresher auto-assigned this many days before expiry.
  recertWindowDays Int @default(30)

  // Default due-date offset (days) for any created assignment.
  assignmentDueDays Int @default(30)

  // Correlation report window (days before/after completion).
  correlationWindowDays Int @default(90)

  // Person-risk analytics — a worker accumulating events "against their name"
  // is auto-flagged into training. Threshold + window + risk-score band cutoffs,
  // all tenant-configurable (never hardcoded).
  personFlagThreshold  Int @default(2) // distinct events in the window to flag
  personFlagWindowDays Int @default(365)
  personRiskElevated   Int @default(3) // weighted riskScore → band cutoffs
  personRiskHigh       Int @default(6)
  personRiskCritical   Int @default(10)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@index([plantId, isActive])
}

// ── TrainingAssignment — first-class assignment with full provenance ──
// Created by the rule engine (threshold/severity/recert) or manually. Carries
// provenance back to the triggering record(s) for the correlation report and
// audit defensibility (spec §B "every assignment must carry full provenance").
model TrainingAssignment {
  id      String @id @default(cuid())
  plantId String

  personUserId String // the worker — resolved via RoleCompetencyRequirement, never blanket
  competencyId String
  competency   Competency @relation(fields: [competencyId], references: [id])

  // threshold_rule | severity_rule | recert_rule | manual
  source   String
  ruleType String? // mirror of source for reporting convenience

  sourceModule     String? // INCIDENT | NEAR_MISS | OBSERVATION | null (manual/recert)
  sourceRecordId   String?
  sourceRecordRef  String?
  triggerMappingId String? // HazardToSkillMapping.id that fired (FK-by-value)

  // { triggerRecords:[{module,id,ref,date}], ruleType, windowDays,
  //   thresholdCount, matchedValue, keywords, siteCompliancePct }
  provenance Json?

  contentId String? // assigned TrainingContent.id — opaque to the engine

  assignedAt       DateTime  @default(now())
  assignedByUserId String?
  dueDate          DateTime?

  // assigned | in_progress | completed | overdue | escalated | cancelled
  status String @default("assigned")

  // Severity-rule assignments cannot be dismissed by the worker (spec business
  // rule) — only marked complete or escalated.
  isMandatory Boolean @default(false)
  dismissible Boolean @default(true)

  escalationFlag    Boolean @default(false) // severity rule → HSE Manager escalation
  escalatedToUserId String?

  completedAt            DateTime?
  completionEvidenceType String? // training_completion | assessment | manual_signoff
  completionEvidenceId   String?
  completionNote         String?   @db.Text
  competencyRecordId     String? // CompetencyRecord updated on completion (FK-by-value)

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([plantId, status])
  @@index([personUserId, status])
  @@index([competencyId])
  @@index([sourceModule, sourceRecordId])
}

// ── TrainingContent — vendor-decoupled content adapter (spec §C) ──────
// The engine + skill matrix NEVER reference contentType / vendorId — they
// operate purely on competencyId. Swapping demo content for an external
// AR/VR vendor is a data-layer change only.
model TrainingContent {
  id           String     @id @default(cuid())
  competencyId String // the skill node — the ONLY field the engine keys on
  competency   Competency @relation(fields: [competencyId], references: [id])

  title       String
  description String? @db.Text

  // video | document | quiz | vr_package | ar_package | external_link
  contentType  String
  // hosted | external_redirect | local_package (local_package = airgapped
  // VR-headset content; plays with NO runtime network dependency, spec NFR)
  deliveryMode String
  contentRef   String // URL, file path, or vendor package id — opaque

  vendorId   String? // null = demo/placeholder content
  vendorName String?

  durationMinutes Int?
  passingScore    Int? // for quiz content
  language        String @default("en")

  isActive  Boolean @default(true)
  isPrimary Boolean @default(false) // the default content auto-assigned for this competency
  plantId   String? // null = global catalog

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([competencyId, isActive])
  @@index([vendorId])
}

// ── TrainingTriggerEvent — dedicated outbox for the rule engine ───────
// A DEDICATED outbox (not the shared DomainEvent table — the alerts resolver
// stamps every DomainEvent processed, so training can't share it). Written in
// the same transaction as an Incident classify / Near Miss / Observation
// create; drained asynchronously by the training_engine_resolver scheduler job
// (spec NFR: "rule engine must run as a background job … not synchronously").
model TrainingTriggerEvent {
  id      String  @id @default(cuid())
  plantId String?

  sourceModule    String // INCIDENT | NEAR_MISS | OBSERVATION
  sourceRecordId  String
  sourceRecordRef String?
  eventType       String  @default("classification_saved") // classification_saved | incident_closed

  // { category?, hazardCategory?, initialRootCauseCategory?, rootCauseCategory?,
  //   severity?, type?, sifPotential(bool), involvedUserIds[], departmentId?,
  //   textBlob?, keywords[] } — everything the resolver needs, denormalised
  classification Json

  occurredAt      DateTime  @default(now())
  processedAt     DateTime?
  processingError String?

  createdAt DateTime @default(now())

  @@index([processedAt])
  @@index([sourceModule, sourceRecordId])
}

// ── TrainingCorrelationPoint — the defensible data asset (spec §D) ────
// One row logged whenever a triggered training is completed, capturing the
// re-incident rate in the window BEFORE completion. The correlation scan fills
// the post-completion count once the window elapses, so the report can compare
// before-vs-after re-incident rate per skill node per site.
model TrainingCorrelationPoint {
  id      String @id @default(cuid())
  plantId String

  competencyId String
  personUserId String
  assignmentId String?

  sourceModule    String?
  sourceRecordId  String?
  sourceRecordRef String?

  trainingCompletedAt DateTime
  windowDays          Int      @default(90)

  preWindowCount  Int       @default(0) // mapped records in the N days before completion
  postWindowCount Int? // filled by the correlation scan once the window elapses
  computedAt      DateTime?

  createdAt DateTime @default(now())

  @@index([plantId, competencyId])
  @@index([personUserId])
}

// ── WorkerTrainingFlag — the person-risk analytic (auto-flag repeat-involved) ─
// A worker who accumulates incidents / near misses / observations "against their
// name" within the window is auto-flagged into the training module, with the
// contributing records + inferred competencies + auto-created assignments. This
// is the person-centric flow (distinct from the site/hazard threshold rule):
// events → PERSON risk → training. Upserted (one active flag per person) by the
// person_risk_scan job.
model WorkerTrainingFlag {
  id           String @id @default(cuid())
  plantId      String
  personUserId String @unique

  riskScore  Float  @default(0)
  riskBand   String @default("elevated") // elevated | high | critical
  windowDays Int    @default(365)

  incidentCount    Int @default(0)
  nearMissCount    Int @default(0)
  observationCount Int @default(0)
  sifCount         Int @default(0) // events with SIF / serious potential
  totalEvents      Int @default(0)

  // [{ module, id, ref, date, role, severity }] — the events behind the flag
  contributingRecords     Json?
  // [{ competencyId, name, fromEvents }] — training the events point to
  recommendedCompetencies Json?
  mappedCompetencyIds     String[]
  assignmentIds           String[] // TrainingAssignments created for this flag

  // flagged | acknowledged | training_assigned | cleared
  status String @default("flagged")

  flaggedAt       DateTime  @default(now())
  lastEvaluatedAt DateTime?
  acknowledgedBy  String?
  acknowledgedAt  DateTime?
  clearedBy       String?
  clearedAt       DateTime?
  clearReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plantId, status])
  @@index([riskBand])
}

// ─────────────────────────────────────────────────────────────────────
//  MOC — Management of Change (IMS Phase 1, 4th module)
//  The workflow that governs every planned change to the plant's operating
//  reality and triggers re-review of dependent registers (HIRA, EAI, Training,
//  Skill Matrix, …). States/categories are Strings (newest-module convention,
//  like Capa.state) — transition rules live in the service layer, not the DB.
// ─────────────────────────────────────────────────────────────────────
model ChangeRequest {
  id      String @id @default(cuid())
  plantId String

  number      String @unique // MOC-2026-LMS-0142
  title       String
  description String @db.Text

  // equipment | process | material | organizational | procedural |
  // software_control | scope | temporary | other
  category       String
  subcategory    String?
  // minor | moderate | major | critical
  classification String  @default("minor")

  isTemporary         Boolean   @default(false)
  temporaryExpiryDate DateTime?

  // operational_request | maintenance_initiative | incident_corrective_action |
  // audit_finding_action | regulatory_mandate | … | other
  origin           String
  originSourceType String?
  originSourceId   String?

  // Scope
  departmentId         String?
  affectedDepartments  String[]
  affectedLocations    String[]
  affectedEquipmentIds String[]
  affectedProcesses    String[]
  affectedRoles        String[]

  // Initiation
  initiatedByUserId     String
  initiatedAt           DateTime @default(now())
  businessJustification String?  @db.Text
  expectedBenefits      String?  @db.Text
  costEstimate          Float?
  costCurrency          String   @default("INR")

  // Timeline
  proposedImplementationDate DateTime?
  targetCompletionDate       DateTime?
  actualImplementationDate   DateTime?
  actualCompletionDate       DateTime?

  // 18-state lifecycle (spec §3.1). String, not enum.
  status String @default("draft")

  // Risk summary (flattened from the spec's risk_assessment_summary object)
  safetyRiskLevel        String?
  environmentalRiskLevel String?
  qualityRiskLevel       String?
  operationalRiskLevel   String?
  overallResidualRisk    String?

  // PSSR (major/critical) — summary fields; full checklist lives in JSON later
  pssrRequired    Boolean   @default(false)
  pssrOutcome     String? // go | no_go | conditional_go | deferred
  pssrConductedAt DateTime?

  // Return-to-normal (temporary changes)
  returnToNormalCompletedAt DateTime?

  // Cross-references (FK-by-value)
  spawnedFromCapaId String?
  supersededByMocId String?

  // ── Gensuite-parity extension (5-step wizard) — all additive/nullable so
  //    pre-existing rows load unchanged; only enforced going forward. ──────
  // standard | emergency (emergency = fast-track: implement before full approval)
  urgency                     String    @default("standard")
  emergencyRetroApprovalDueAt DateTime? // now+72h when emergency impl starts pre-approval

  linkedMocIds String[] // related / follow-on MOC references

  // Step 2 — risk & hazard assessment
  psmApplicable      Boolean  @default(false)
  psmDetails         Json? // { coveredProcess, affectedSafeguards }
  riskMatrixPre      Json? // { likelihood, impactScores:[{dimension,level}], score, band }
  riskMatrixResidual Json? // same shape, post-mitigation
  hazardCategories   String[] // fire_explosion | chemical_exposure | mechanical | …
  mitigations        String?  @db.Text

  // Step 3 — impact & stakeholder
  departmentImpact      Json? // { safety:{affected,reviewerUserId?}, engineering:{…}, … }
  trainingRequired      Boolean @default(false)
  trainingCertificateId String? // FK-by-value → TrainingCertificate.id

  // Step 5 — implementation & closure
  pssrChecklist       Json? // { items:[{label,verdict,note}], completedAt, completedBy }
  effectivenessReview Json? // { dueAt, cadenceDays, effective, newRisks, notes, reviewedAt, reviewedBy }

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  versionNumber Int      @default(1)

  approvalSteps    MocApprovalStep[]
  dependentRecords MocDependentRecord[]
  stateHistory     MocStateHistory[]
  impactAssessment MocImpactAssessment?
  attachments      MocAttachment[]

  @@index([plantId, status])
  @@index([plantId, category])
  @@index([initiatedByUserId, status])
  @@index([targetCompletionDate, status])
  @@index([isTemporary, temporaryExpiryDate])
}

// ── Approval chain step (classification-driven, sequential) ──────────
model MocApprovalStep {
  id              String        @id @default(cuid())
  changeRequestId String
  changeRequest   ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)

  sequence       Int
  role           String
  specificUserId String?
  isRequired     Boolean @default(true)

  // pending | approved | rejected | conditional | delegated | abstained
  decision        String    @default("pending")
  decidedAt       DateTime?
  decidedByUserId String?
  rationale       String?   @db.Text
  conditions      String?   @db.Text

  @@index([changeRequestId])
}

// ── Dependent record — what other registers this change affects ──────
model MocDependentRecord {
  id              String        @id @default(cuid())
  changeRequestId String
  changeRequest   ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)

  // hira_entry | eai_entry | competency_requirement | training_program | sop |
  // control_plan | permit_type | inspection_schedule | equipment_master |
  // role_definition | calibration_schedule | other
  recordType        String
  recordId          String?
  recordReference   String
  // must_update | must_review | must_create | must_archive
  impactType        String
  impactDescription String? @db.Text

  // not_started | in_progress | completed | not_applicable_confirmed
  updateStatus    String    @default("not_started")
  updatedAt       DateTime?
  updatedByUserId String?
  updateEvidence  String?

  @@index([changeRequestId, updateStatus])
}

// ── Immutable state-transition log (D8 audit pattern) ────────────────
model MocStateHistory {
  id              String        @id @default(cuid())
  changeRequestId String
  changeRequest   ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)

  fromState            String?
  toState              String
  transitionedAt       DateTime @default(now())
  transitionedByUserId String?
  rationale            String?  @db.Text

  @@index([changeRequestId])
}

// ── Impact assessment (1:1 with the change request) ──────────────────
model MocImpactAssessment {
  id              String        @id @default(cuid())
  changeRequestId String        @unique
  changeRequest   ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)

  assessorUserId String?
  assessorRole   String?
  // checklist_based | hazop_lite | what_if_analysis | structured_walkthrough | expert_judgment
  methodology    String?
  // full per-dimension structure (safety/environmental/quality/operations/…)
  dimensions     Json?

  recommendedClassification String?
  pssrRequired              Boolean @default(false)
  rollbackPlanRequired      Boolean @default(false)

  assessmentDate   DateTime?
  reviewedByUserId String?
  reviewedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Attachment — drawings, P&IDs, vendor specs, risk docs (Supabase) ──
// Cloned from RiskAttachment; two-phase signed-URL upload, soft-deletable.
model MocAttachment {
  id              String        @id @default(cuid())
  changeRequestId String
  changeRequest   ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)

  category     String // drawing | pid | vendor_spec | risk_assessment | other
  fileName     String
  storagePath  String
  fileSize     Int
  mimeType     String
  caption      String?   @db.Text
  uploadedById String
  uploadedAt   DateTime  @default(now())
  deletedAt    DateTime?

  @@index([changeRequestId, deletedAt])
}

// ── Change freeze — administrative block on new submissions ──────────
model MocFreeze {
  id                    String   @id @default(cuid())
  plantIds              String[] // empty = all plants
  departmentIds         String[]
  categoryFilters       String[]
  classificationFilters String[]

  // regulatory_inspection | external_audit | customer_audit | peak_production |
  // year_end | incident_investigation | other
  reason       String
  reasonDetail String? @db.Text

  startsAt DateTime
  endsAt   DateTime?

  exceptionsAllowed          Boolean @default(false)
  exceptionApprovalAuthority String?

  imposedByUserId String
  imposedAt       DateTime  @default(now())
  liftedAt        DateTime?
  liftedByUserId  String?

  isActive Boolean @default(true)

  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────────────
// Statutory Compliance Register (SCR-01)
// Auto-populated, inspection-ready statutory registers. Each register is
// fed FROM a source module (no manual entry). Entries are immutable —
// void, never delete. See SCR_Module_Build_Prompt §4. plantId is FK-by-
// value (no relation) to match the module convention.
// ─────────────────────────────────────────────────────────────────────
model RegisterMaster {
  id                      String    @id @default(cuid())
  registerCode            String // FORM18, FORM11, CLRA-FORMXIII …
  registerName            String
  legalAct                String
  sectionRule             String?
  plantId                 String
  sourceModule            String // IncidentManagement, PTW, Inspection …
  sourceEventType         String // INCIDENT_RECORDED, PTW_ISSUED …
  entryFrequency          String // ON_EVENT | DAILY | MONTHLY …
  submissionFrequency     String // ANNUAL | HALF_YEARLY | ON_OCCURRENCE …
  nextSubmissionDue       DateTime?
  lastSubmittedDate       DateTime?
  submissionAuthority     String?
  authorisedSignatoryRole String?
  retentionPeriodYears    Int       @default(5)
  isActive                Boolean   @default(true)
  complianceStatus        String    @default("COMPLIANT") // COMPLIANT | AT_RISK | NON_COMPLIANT
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  entries RegisterEntry[]

  @@unique([registerCode, plantId])
  @@index([plantId, isActive])
}

model RegisterEntry {
  id                   String         @id @default(cuid())
  registerId           String
  register             RegisterMaster @relation(fields: [registerId], references: [id], onDelete: Cascade)
  sourceTransactionId  String // originating record id (incident id …)
  sourceModule         String
  sourceRef            String? // human ref, e.g. INC-2026-LMS-014
  entryDate            DateTime
  entryCreatedBy       String         @default("SYSTEM")
  entryFieldsJson      Json // all register-specific columns for this row
  isManualCorrection   Boolean        @default(false)
  correctionReason     String?
  correctionApprovedBy String?
  isVoided             Boolean        @default(false) // soft-delete only
  voidReason           String?
  auditTrail           Json // immutable change log
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([registerId, sourceTransactionId])
  @@index([registerId, entryDate])
}

// ─────────────────────────────────────────────────────────────────────
// Safety Culture Index (SCI-01) — verified-event point ledger.
// Points are earned ONLY from verified operational events (no self-report,
// no manual award). Entries are immutable; a voided source transaction is
// reversed by a compensating negative entry, never deleted. SSO-only — the
// module consumes SafeOps360 identity, it never creates accounts.
// ─────────────────────────────────────────────────────────────────────
model SciLedgerEntry {
  id                      String   @id @default(cuid())
  userId                  String
  plantId                 String
  sourceModule            String // SAFETY_OBS | NEAR_MISS | FLRA | PTW | INCIDENT | TRAINING | INSPECTION | CAPA | HIRA | KAIZEN_WALL | KAIZEN_COMMITTEE | STREAK
  sourceTransactionId     String
  eventType               String
  basePoints              Int
  multiplier              Float    @default(1)
  finalPoints             Int
  isAnonymous             Boolean  @default(false)
  isVoided                Boolean  @default(false)
  voidCompensatingEntryId String?
  scoringPeriod           String // YYYY-MM
  createdAt               DateTime @default(now())
  auditTrail              Json

  @@unique([userId, sourceModule, sourceTransactionId])
  @@index([plantId, userId])
  @@index([plantId, scoringPeriod])
}

// ─────────────────────────────────────────────────────────────────────
// Safety Kaizen Wall (SCI-01 §7) — governed, verified community wall.
// Every post is peer-committee reviewed before going live (no supervisor,
// identity withheld from committee). Declined posts are retained, never
// deleted. Approved posts award SCI points via the SciLedgerEntry.
// ─────────────────────────────────────────────────────────────────────
model KaizenPost {
  id                     String    @id @default(cuid())
  submitterUserId        String // always stored, withheld from committee/public if anonymous
  isAnonymous            Boolean   @default(false)
  plantId                String
  category               String // UNSAFE_ACT | UNSAFE_CONDITION | NEAR_MISS | GOOD_PRACTICE | IMPROVEMENT_SUGGESTION
  hazardSeveritySelf     String // LOW | MEDIUM | HIGH
  photoUrl               String?
  description            String
  locationTag            String?
  status                 String    @default("PENDING_COMMITTEE") // PENDING_COMMITTEE | APPROVED | DECLINED
  committeeScoresJson    Json? // [{reviewerId, hazardSig, learningVal, actionQual, decision}]
  finalCommitteeScore    Float?
  pointsAwardedSubmitter Int?
  declineFeedback        String?
  parentPostId           String?
  crossPlantDistributed  Boolean   @default(false)
  reactionsCount         Int       @default(0)
  reviewedByUserId       String?
  reviewedAt             DateTime?
  createdAt              DateTime  @default(now())
  approvedAt             DateTime?

  @@index([plantId, status])
  @@index([submitterUserId])
}

// ─────────────────────────────────────────────────────────────────────
// Safety Culture Management — a live culture engine whose per-site score
// feeds the ERM Risk Register as a KRI (the structural differentiator vs a
// disconnected snapshot/survey app). Schema applied by
// prisma/apply-safetyculture-ddl.ts; mirrored in app/models/safety_culture.py.
// plantId is FK-by-value (== Plant.id, the site/isolation boundary).
// ─────────────────────────────────────────────────────────────────────
model CultureMaturityProfile {
  id                   String    @id @default(cuid())
  plantId              String    @unique
  currentStage         String    @default("Reactive") // Reactive | Dependent | Independent | Interdependent
  stageScore           Float     @default(0)
  leadershipEngagement Float     @default(0)
  workerParticipation  Float     @default(0)
  leadingLaggingRatio  Float     @default(0)
  bbsQualityIndex      Float     @default(0)
  perceptionIndex      Float     @default(0)
  industryVertical     String?
  lastCalculatedAt     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([currentStage])
}

model CultureMaturitySnapshot {
  id              String   @id @default(cuid())
  plantId         String
  period          String // YYYY-MM
  stageScore      Float    @default(0)
  currentStage    String   @default("Reactive")
  componentScores Json
  snapshotAt      DateTime @default(now())

  @@unique([plantId, period])
  @@index([plantId, period])
}

model CultureObservationClosure {
  id                    String    @id @default(cuid())
  observationId         String    @unique
  plantId               String
  linkedCapaId          String?
  linkedActionId        String?
  reobservationVerified Boolean   @default(false)
  reobservationDate     DateTime?
  verifiedById          String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([plantId])
}

// Shared integrity gate — the single source of truth both BBS Quality and
// Recognition read, so the two screens can never contradict each other (§Fix 1).
model CultureObserverIntegrity {
  id           String    @id @default(cuid())
  plantId      String
  observerId   String
  period       String // YYYY-MM
  status       String    @default("flagged_pending_review") // clear | flagged_pending_review | flagged_reviewed_dismissed | flagged_reviewed_upheld
  reasons      Json      @default("[]") // pattern snapshot at flag time
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  flaggedAt    DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([plantId, observerId, period])
  @@index([plantId, period])
}

model LeadershipWalk {
  id                 String    @id @default(cuid())
  plantId            String
  leaderId           String
  scheduledDate      DateTime
  completedDate      DateTime?
  status             String    @default("Scheduled") // Scheduled | Completed | Missed | Rescheduled
  cadence            String? // WEEKLY | MONTHLY
  areaVisited        String?
  workersInteracted  Int       @default(0)
  observationsRaised Int       @default(0)
  hazardsIdentified  Int       @default(0)
  notes              String?
  checklist          Json? // { hazardCategories, workerInteractions, ppeCompliance, housekeepingRating }
  followUpActionIds  Json
  escalatedAt        DateTime? // set when a scheduled walk is auto-flipped to Missed
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([plantId, status])
  @@index([leaderId, scheduledDate])
}

model PerceptionSurveyTemplate {
  id               String   @id @default(cuid())
  name             String
  description      String?
  industryVertical String?
  questions        Json // [{ id, text, dimension, scaleType }]
  isActive         Boolean  @default(true)
  cadence          String   @default("QUARTERLY")
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PerceptionSurveyResponse {
  id                       String   @id @default(cuid())
  surveyTemplateId         String
  plantId                  String
  period                   String // e.g. 2026-Q3
  respondentAnonymousToken String // one-way hash — NO PII, prevents double-submit only
  responses                Json // [{ questionId, score }]
  submittedAt              DateTime @default(now())

  @@unique([surveyTemplateId, plantId, period, respondentAnonymousToken])
  @@index([plantId, period])
}

model PerceptionIndexSnapshot {
  id                  String   @id @default(cuid())
  plantId             String
  period              String
  dimensionScores     Json
  compositeScore      Float    @default(0)
  responseCount       Int      @default(0)
  responseRatePercent Float    @default(0)
  thresholdMet        Boolean  @default(false)
  publishedAt         DateTime @default(now())

  @@unique([plantId, period])
  @@index([plantId, period])
}

model RecognitionEntry {
  id           String   @id @default(cuid())
  plantId      String
  userId       String
  category     String // ObservationStreak | QualityContribution | LeadershipWalkCompliance | TeamMilestone | MostImproved
  points       Float    @default(0)
  periodEarned String // YYYY-MM
  badgeAwarded String?
  streakWeeks  Int      @default(0)
  detail       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([plantId, userId, category, periodEarned])
  @@index([plantId, periodEarned])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────
// PPE Management (PPE-01) — the authoritative record of personal protective
// equipment: what exists, who holds it, whether it is serviceable, and
// whether every person in a hazardous area has the right PPE for the hazard.
// PPE is the last tier of the control hierarchy (Factories Act s.35, OSH Code
// 2020 s.23, ISO 45001 8.1.2). Three core record types: PpeType (catalog),
// PpeItem (individual unit), PpeIssuance (transaction). PpeInspection drives
// the serviceability lifecycle; PpeRequirementProfile + PpeBatch support
// compliance checking and recall tracking. plantId is FK-by-value. Arrays /
// nested structures are Json (jsonb) to keep the mirror simple.
// ─────────────────────────────────────────────────────────────────────
model PpeType {
  id                         String   @id @default(cuid())
  tenantId                   String? // null = global library entry
  code                       String   @unique // HARNESS-FULLBODY-EN361 …
  name                       String
  description                String   @default("")
  category                   String // respiratory_protection | fall_protection | gas_detection …
  subcategory                String   @default("")
  applicableStandards        Json // [{standard, clause, requirement}]
  minimumSpecification       String   @default("")
  acceptableBrandsOrModels   String   @default("")
  controlsHazards            Json // hazard codes this PPE addresses
  enablesPermitTypes         Json // permit types requiring this PPE
  requiredForAreas           Json // area codes where always required
  serviceLifeYears           Int      @default(5)
  serviceLifeHours           Int? // for hour-based life (SCBA cylinders)
  inspectionSchedule         Json // [{inspection_type, interval_days, requires_competent_person, requires_third_party, regulatory_reference}]
  requiresCompetencyToUse    String? // Skill Matrix competency code (SCBA → CS-ENTRANT-L1)
  requiresFitTest            Boolean  @default(false)
  fitTestValidityMonths      Int?
  requiredTrainingPrograms   Json // training program codes
  tracksIndividualItems      Boolean  @default(true)
  reorderPointPer100Workers  Int      @default(0)
  isPersonalIssue            Boolean  @default(false)
  statutoryProvisionRequired Boolean  @default(true)
  regulatoryReferences       Json // [{regulation, section, requirement}]
  isActive                   Boolean  @default(true)
  isGlobal                   Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  items PpeItem[]

  @@index([category])
  @@index([tenantId, isActive])
}

model PpeItem {
  id                          String    @id @default(cuid())
  tenantId                    String?
  itemNumber                  String    @unique // PPE-LMS-HARNESS-0042
  serialNumber                String // manufacturer serial
  ppeTypeId                   String
  ppeType                     PpeType   @relation(fields: [ppeTypeId], references: [id])
  ppeTypeCode                 String // denormalized
  ppeTypeName                 String // denormalized
  manufacturer                String    @default("")
  model                       String    @default("")
  batchLotNumber              String    @default("")
  manufactureDate             DateTime // CRITICAL for service-life calc
  purchaseDate                DateTime?
  purchaseOrderReference      String?
  cost                        Float?
  costCurrency                String    @default("INR")
  plantId                     String
  departmentId                String?
  storageLocation             String?
  status                      String    @default("in_stock") // in_stock | issued | under_inspection | under_repair | quarantined | retired | lost | stolen | recalled
  currentIssuanceId           String?
  currentHolderUserId         String?
  issuedSince                 DateTime?
  condition                   String    @default("new") // new | good | fair | needs_inspection | unserviceable
  lastConditionUpdateAt       DateTime?
  lastConditionUpdateByUserId String?
  commissionedAt              DateTime
  serviceLifeEndDate          DateTime // manufactureDate + serviceLifeYears
  serviceHoursUsed            Int?
  lastInspectedAt             DateTime?
  lastInspectedByUserId       String?
  nextInspectionDueDate       DateTime?
  lastFitTestedAt             DateTime?
  fitTestValidUntil           DateTime?
  fitTestHolderUserId         String?
  batchUnderRecall            Boolean   @default(false)
  recallReference             String?
  recallIssuedAt              DateTime?
  stateHistory                Json // [{from_status, to_status, changed_at, changed_by_user_id, reason}]
  versionNumber               Int       @default(1)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([tenantId, status, plantId])
  @@index([plantId, ppeTypeId, status])
  @@index([plantId, currentHolderUserId])
  @@index([plantId, nextInspectionDueDate, status])
  @@index([plantId, serviceLifeEndDate])
}

model PpeIssuance {
  id                           String    @id @default(cuid())
  tenantId                     String?
  issuanceNumber               String    @unique // ISS-LMS-2026-0284
  ppeItemId                    String
  ppeTypeCode                  String
  ppeTypeName                  String
  serialNumber                 String
  issuedToUserId               String
  issuedToName                 String
  issuedToDepartment           String    @default("")
  issuedToRole                 String    @default("")
  issuedByUserId               String
  issuedByName                 String
  issuedAt                     DateTime  @default(now())
  expectedReturnDate           DateTime?
  issuancePurpose              String    @default("personal_assignment") // personal_assignment | task_based | temporary_loan | replacement | new_joiner_kit
  linkedPermitId               String?
  linkedWorkOrder              String?
  conditionAtIssuance          String    @default("good") // new | good | fair
  conditionNotesAtIssuance     String    @default("")
  preIssuanceInspectionDone    Boolean   @default(false)
  preIssuanceInspectorUserId   String?
  recipientAcknowledged        Boolean   @default(false)
  recipientAcknowledgedAt      DateTime?
  recipientSignatureUrl        String?
  briefingProvided             Boolean   @default(false)
  briefingByUserId             String?
  status                       String    @default("active") // active | returned | lost | stolen | damaged_return
  returnedAt                   DateTime?
  returnedByUserId             String?
  conditionAtReturn            String? // good | fair | damaged | destroyed
  conditionNotesAtReturn       String    @default("")
  postReturnInspectionRequired Boolean   @default(false)
  plantId                      String
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  @@index([tenantId, issuedToUserId, status])
  @@index([ppeItemId, status])
  @@index([plantId, status])
}

model PpeInspection {
  id                             String    @id @default(cuid())
  tenantId                       String?
  ppeItemId                      String
  ppeTypeCode                    String
  serialNumber                   String
  inspectionType                 String // pre_use | periodic | post_incident | annual | five_yearly | return_check | ad_hoc
  trigger                        String // scheduled | pre_permit | post_incident | post_return | recall_response | manual
  linkedPermitId                 String?
  linkedIncidentId               String?
  scheduledDate                  DateTime?
  conductedAt                    DateTime  @default(now())
  inspectorUserId                String
  inspectorName                  String
  inspectorQualification         String    @default("")
  isThirdPartyInspection         Boolean   @default(false)
  thirdPartyCompany              String    @default("")
  thirdPartyCertificateReference String    @default("")
  checklistTemplateId            String?
  checklistItems                 Json // [{sequence, check_item, result, notes, photo_evidence_url}]
  overallResult                  String // pass | fail | conditional_pass
  defectsFound                   Json // [{defect_description, severity, action_required}]
  conditions                     String    @default("")
  reInspectionRequired           Boolean   @default(false)
  reInspectionDueDate            DateTime?
  itemStatusAfterInspection      String // returned_to_service | quarantined_pending_repair | retired | recalled_to_store | condemned
  serviceLifeRemainingDays       Int?
  inspectionCertificateUrl       String?
  certificateValidUntil          DateTime?
  capaSpawned                    Boolean   @default(false)
  capaId                         String?
  plantId                        String
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt

  @@index([ppeItemId, conductedAt])
  @@index([plantId, inspectionType])
}

model PpeRequirementProfile {
  id               String    @id @default(cuid())
  tenantId         String?
  plantId          String
  scopeType        String // role | area | activity | permit_type | hira_control
  scopeId          String
  scopeName        String
  requiredPpe      Json // [{ppe_type_id, ppe_type_code, ppe_type_name, requirement_level, condition, minimum_specification, substitution_allowed, rationale, regulatory_reference}]
  effectiveFrom    DateTime  @default(now())
  supersededAt     DateTime?
  approvedByUserId String?
  approvedAt       DateTime?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([plantId, scopeType, scopeId])
  @@index([plantId, scopeType, isActive])
}

model PpeBatch {
  id                   String    @id @default(cuid())
  tenantId             String?
  plantId              String
  ppeTypeId            String
  batchLotNumber       String
  manufacturer         String    @default("")
  manufactureDate      DateTime
  purchaseDate         DateTime?
  itemsInBatch         Int       @default(0)
  underRecall          Boolean   @default(false)
  recallReason         String    @default("")
  recallIssuedBy       String    @default("")
  recallIssuedAt       DateTime?
  recallActionRequired String    @default("")
  recallResolvedAt     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([tenantId, underRecall])
  @@index([plantId, ppeTypeId])
}

// ─────────────────────────────────────────────────────────────────────
// Audit & Compliance Management
//
// Industry-specific checklist audits: schedule → conduct on-site (100+
// checkpoints, auto partial-save) → auditee response → plant-manager review
// → close, with graphical dashboards and auto-CAPA. Built for Page Industries
// (Garments / Textile) and expandable to every manufacturing vertical via the
// per-industry checkpoint library.
//
//   AuditCheckpointLibrary  — master checklist per industry (categories +
//                             checkpoints stored as Json).
//   AuditTemplate           — tenant preset: which checkpoints an audit type
//                             pulls in + scoring / workflow config.
//   ComplianceAudit         — one audit instance carrying the full lifecycle
//                             via `status` (schedule + execution merged, like
//                             Capa's single row + state).
//   AuditCheckpointResponse — one row per checkpoint per audit; enables per-row
//                             partial-save, auditee routing, and clean SQL for
//                             the dashboards. Nested detail (photos, notes) is
//                             Json inside each row.
//
// FKs to Plant / User are plain scalars (matching the other vertical modules);
// the only Prisma relation is ComplianceAudit → its response rows.
//
// `status` is a plain String (like Capa.state and the other lifecycle records)
// to keep the SQLAlchemy mirror simple. Allowed values: scheduled | in_progress
// | submitted_pending_response | response_in_progress | under_review | closed |
// cancelled.
// ─────────────────────────────────────────────────────────────────────
model AuditCheckpointLibrary {
  id              String   @id @default(cuid())
  industryCode    String   @unique // GARMENTS_TEXTILE | MANUFACTURING_GENERIC | PHARMA_LIFE_SCIENCES | …
  industryName    String
  version         String   @default("2026.1")
  categories      Json // [{category_code,name,color,icon,sequence,checkpoints:[{code,question,…}]}]
  checkpointCount Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AuditTemplate {
  id                      String   @id @default(cuid())
  tenantId                String?
  name                    String
  description             String   @default("")
  auditType               String // sa8000_iso45001_integrated | fire_safety_audit | worker_welfare | …
  baseIndustry            String // industryCode of the source library
  checkpointConfiguration Json // { mode: "all" | "subset", codes?: string[], categories?: string[] }
  // Custom checkpoints added to this template (audit-lifecycle v2). Each is a
  // library-shaped def carrying its discipline (category_code). Adding one
  // FORKS a new template version (parentTemplateId set, version bumped, parent
  // retired). Materialized into every audit that uses this template/version,
  // flagged "custom".
  // [{ code, discipline_code, discipline_name, question, criticality, guidance,
  //    requirement_reference, standard, evidence_required_on_fail, is_custom,
  //    added_by_id, added_at }]
  customCheckpoints       Json     @default("[]")
  parentTemplateId        String?
  scoring                 Json? // { method, critical_fail_auto_fails_audit, minimum_pass_score }
  workflow                Json? // { auditee_response_sla_days, plant_manager_approval_required, … }
  isActive                Boolean  @default(true)
  version                 String   @default("1.0")
  createdByUserId         String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([baseIndustry])
}

model ComplianceAudit {
  id          String  @id @default(cuid())
  tenantId    String?
  auditNumber String  @unique // AUD-GT-2026-NW-0042
  title       String
  plantId     String

  templateId   String?
  industryCode String
  auditType    String

  scopeDepartments Json // string[]
  scopeAreas       Json // string[]
  scopeDescription String @default("")

  // Discipline scope chosen at scheduling (audit-lifecycle v2). A discipline is
  // a library category_code. Empty list = full library (back-compat with audits
  // scheduled before scoped materialization existed).
  selectedDisciplineIds       Json    @default("[]") // string[] of category_code
  scopePresetUsed             String? // FULL | FIRE_FOCUSED | SA8000_ISO45001 | WORKER_WELFARE | CUSTOM
  materializedCheckpointCount Int     @default(0) // sum of materialized checkpoints incl. ad-hoc
  adHocCount                  Int     @default(0) // ad-hoc checkpoints added to this audit

  scheduledDate          DateTime
  scheduledStartTime     String   @default("09:00")
  estimatedDurationHours Float    @default(2)

  leadAuditorUserId  String
  coAuditors         Json // string[]
  auditees           Json // [{ userId, responsibleCategories: string[] }]
  plantManagerUserId String?

  status        String    @default("scheduled")
  actualStartAt DateTime?
  actualEndAt   DateTime?
  submittedAt   DateTime?

  // Computed score snapshot — recomputed only at submit / review / close.
  score Json?

  // Denormalized rollups so the programme list never opens the Json columns.
  totalCheckpoints     Int?
  answeredCheckpoints  Int      @default(0)
  overallCompliancePct Float?
  auditPassed          Boolean?
  openCapaCount        Int      @default(0)
  criticalFailureCount Int      @default(0)

  openingRemarks String @default("")
  closingRemarks String @default("")

  isRecurring Boolean @default(false)

  // Governed reopen (docs/cams/09 §2.5). close_audit used to be terminal, so the
  // only way to correct a closed record was a direct DB write — which leaves no
  // trace in the product. A counted, approved, logged reopen is strictly safer.
  reopenCount      Int       @default(0)
  lastReopenedAt   DateTime?
  lastReopenReason String?

  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  closedAt        DateTime?

  responses AuditCheckpointResponse[]
  reports   AuditReport[]

  @@index([plantId, status])
  @@index([leadAuditorUserId])
  @@index([plantManagerUserId])
}

model AuditCheckpointResponse {
  id      String          @id @default(cuid())
  auditId String
  audit   ComplianceAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  plantId String

  // Denormalized checkpoint definition (snapshot from the library at materialization).
  checkpointCode       String
  checkpointQuestion   String
  guidance             String @default("")
  requirementReference String @default("")
  standard             String @default("")
  categoryId           String
  categoryName         String
  categoryColor        String @default("")
  criticality          String @default("major") // critical | major | minor | informational
  responseType         String @default("pass_partial_fail")
  sequence             Int    @default(0)

  // Denormalized per-checkpoint rules (so submit/save never re-parse the library).
  requiresPhotoOnFail   Boolean @default(false)
  autoTriggerCapaOnFail Boolean @default(false)
  capaSeverity          String? // critical | major | minor
  linkedSafeopsModule   String? // training | skill_matrix | capa | inspection | ppe | …

  // Auditee this checkpoint is routed to on submit (from the audit's auditees map).
  routedToUserId String?

  // Per-checkpoint owner allocation (audit-lifecycle v2). Plant Head / Lead
  // Auditor assigns owners per-checkpoint / per-discipline / in bulk. A
  // failed/partial checkpoint routes to assignedOwnerId (falls back to
  // routedToUserId, then audit-level default).
  assignedOwnerId   String?
  // assignedAuditorId = the AUDITOR who conducts this checkpoint (per-discipline
  // auditor assignment). assignedOwnerId is the auditee who responds to findings.
  assignedAuditorId String?
  assignedById      String?
  assignedAt        DateTime?

  // Ad-hoc checkpoint added to THIS audit on the fly by an auditor (vs a
  // library/template checkpoint). Visually flagged "custom" everywhere.
  isAdHoc   Boolean @default(false)
  addedById String?

  // Two-axis state (audit-lifecycle v2), additive to the legacy overallStatus.
  // assessmentStatus = the auditor's verdict; workflowState = iteration state.
  assessmentStatus String @default("NOT_ASSESSED") // NOT_ASSESSED | PASS | PARTIAL | FAIL | NA
  workflowState    String @default("OPEN") // OPEN | PASSED | AWAITING_AUDITEE | AUDITEE_RESPONDED | MORE_INFO_REQUESTED | RESOLVED | ACCEPTED_WITH_CAPA | ESCALATED_PM | FINALIZED
  currentRound     Int    @default(0)

  // Carousel capture fields (first-class, mirrored into auditorResponse Json
  // for back-compat with the existing conduct screen).
  observation String? // auditor's observation note
  auditorNote String?
  orderIndex  Int     @default(0) // position within discipline for carousel sequencing

  auditorEvidenceIds Json @default("[]") // attachment ids captured by the auditor
  auditeeEvidenceIds Json @default("[]") // attachment ids supplied by the auditee

  capaId      String? // scalar mirror of capa.capa_id for direct query
  finalizedAt DateTime?

  // Lifecycle sub-documents (Json).
  auditorResponse    Json? // { value, numeric_value, selected_options, text_observation, auditor_notes, photos[], evidence_links[], responded_at, is_saved }
  auditeeResponse    Json? // { respondent_user_id, response_text, action_taken, action_date, photos[], estimated_closure_date, responded_at, status }
  plantManagerReview Json? // { reviewer_user_id, decision, comments, reviewed_at }
  capa               Json? // { auto_triggered, capa_id, capa_number, capa_status, capa_due_date }

  overallStatus String    @default("not_answered")
  answeredAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interactions CheckpointInteraction[]

  @@unique([auditId, checkpointCode])
  @@index([auditId])
  @@index([auditId, categoryId])
  @@index([auditId, routedToUserId])
  @@index([auditId, assignedOwnerId])
  @@index([auditId, assignedAuditorId])
  @@index([auditId, workflowState])
  @@index([auditId, sequence])
}

// ─────────────────────────────────────────────────────────────────────
// Audit lifecycle v2 — multi-round iteration thread (append-only) + reports.
// ─────────────────────────────────────────────────────────────────────

// Append-only thread row. One per state transition on a checkpoint. Never
// updated or deleted; `timestamp` is server-set and immutable. Reads as
// "Round 1, 2, 3 …" via the `round` counter.
model CheckpointInteraction {
  id                   String                  @id @default(cuid())
  checkpointInstanceId String
  checkpointInstance   AuditCheckpointResponse @relation(fields: [checkpointInstanceId], references: [id], onDelete: Cascade)
  auditId              String
  round                Int                     @default(0)
  actorId              String
  actorRole            String // AUDITOR | AUDITEE | PLANT_MANAGER | LEAD_AUDITOR
  action               String // ASSESSED | ROUTED_TO_OWNER | AUDITEE_RESPONSE | REQUEST_MORE_INFO | AUDITOR_ACCEPT | RAISE_CAPA | ESCALATE_PM | PM_DECISION | REOPEN | ADHOC_ADDED
  comment              String?
  evidenceIds          Json                    @default("[]") // string[]
  resultingState       String // resulting CheckpointWorkflowState
  timestamp            DateTime                @default(now()) // server-set, immutable

  createdAt DateTime @default(now())

  @@index([checkpointInstanceId])
  @@index([auditId])
}

// Immutable Interim / Final report snapshot. Interim reports accumulate; the
// latest supersedes for display (isSuperseded) but all are retained.
model AuditReport {
  id               String          @id @default(cuid())
  auditId          String
  audit            ComplianceAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  siteId           String
  reportType       String // INTERIM | FINAL
  reportCode       String          @unique
  generatedById    String
  generatedAt      DateTime        @default(now())
  snapshot         Json // frozen metrics + per-discipline scores + open iterations + capa summary
  signOffs         Json? // [{ role, userId, signedAt }]
  pdfAttachmentId  String?
  isSuperseded     Boolean         @default(false)
  // Full-length SHA-256 of the canonical snapshot (docs/cams/09 §2.5). The
  // snapshot itself carries a 16-char prefix at snapshot["snapshotHash"] for
  // display; 64 bits is thin against intent, so the verifiable digest lives
  // here. Null on reports generated before this column → those verify as
  // LEGACY_TRUNCATED, not as tampered.
  snapshotHashFull String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([auditId, reportType])
}

