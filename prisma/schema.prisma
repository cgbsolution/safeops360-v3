// ─── Observation SLA / Worker Involved / Deroster ─────────────────────────
// Mirrors app/models/observation_sla.py. Applied by
// prisma/apply-observation-sla-ddl.ts (hand DDL, idempotent) — NEVER db push.

/// Target-closure-date policy. plantId NULL = the global default; a plant row
/// overrides it. There is no Tenant table in this schema, so the spec's
/// "tenant-scoped" resolves to plant-scoped-with-global-fallback, the same
/// precedence TrainingRuleConfig uses.
model ObservationSlaConfig {
  id            String   @id @default(cuid())
  plantId       String?
  severity      String
  categoryGroup String
  slaDays       Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  updatedById   String?

  @@index([severity, categoryGroup, isActive])
  @@index([plantId])
}

/// DuPont STOP category → Behavioural | Physical, the key into the SLA matrix.
/// Configuration rather than code: the first build derived this from the
/// act/condition axis, which could not express "not decided yet" and gave the
/// policy owner no override. `PENDING_DECISION` resolves NO SLA, so the form
/// falls back to manual entry — nothing guesses a band.
/// axis 'ANY' covers both axes; an exact ACT/CONDITION row overrides it.
model ObservationCategoryGroup {
  id            String   @id @default(cuid())
  categoryCode  String
  axis          String   @default("ANY")
  categoryGroup String
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  updatedById   String?

  @@unique([categoryCode, axis])
  @@index([categoryCode, isActive])
}

/// Deroster review SLA + escalation contact. One row per scope.
/// escalationContactUserId wins when set; otherwise holders of
/// escalationRoleCode are notified on timeout.
model ObservationDerosterConfig {
  id                      String   @id @default(cuid())
  plantId                 String?
  reviewSlaHours          Int      @default(4)
  escalationContactUserId String?
  escalationRoleCode      String   @default("HSE_MANAGER")
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  updatedById             String?

  @@index([plantId])
}

/// The named worker(s) on an observation. Polymorphic by necessity: `User` is
/// the employee directory and the only thing TrainingAssignment can point at;
/// `ContractorWorker` is the EPC workforce and has no user account by design.
/// Exactly one of userId / contractorWorkerId is set (DB CHECK constraint).
model ObservationWorkerInvolved {
  id            String      @id @default(cuid())
  observationId String
  observation   Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  partyType          String
  userId             String?
  user               User?             @relation("ObservationWorkerInvolvedUser", fields: [userId], references: [id])
  contractorWorkerId String?
  contractorWorker   ContractorWorker? @relation("ObservationWorkerInvolvedContractor", fields: [contractorWorkerId], references: [id])

  // Snapshotted at observation time so the record still reads correctly after
  // a transfer, rename or demobilisation.
  nameSnapshot     String
  roleSnapshot     String?
  employerSnapshot String?

  addedById String?
  createdAt DateTime @default(now())

  deroster ObservationDeroster?

  @@index([observationId])
  @@index([userId])
  @@index([contractorWorkerId])
  @@index([partyType])
}

/// One review per involved worker on a qualifying observation (UNSAFE_ACT at
/// HIGH/CRITICAL). `pending_review` is a SOFT-LOCK, not a punitive record —
/// nothing here is surfaced as "derostered" until a human confirms it.
model ObservationDeroster {
  id            String      @id @default(cuid())
  observationId String
  observation   Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  workerInvolvedId String                    @unique
  workerInvolved   ObservationWorkerInvolved @relation(fields: [workerInvolvedId], references: [id], onDelete: Cascade)

  partyType          String
  userId             String?
  contractorWorkerId String?
  plantId            String

  status         String   @default("pending_review")
  flaggedAt      DateTime @default(now())
  flaggedReason  String
  reviewSlaHours Int      @default(4)
  reviewDueAt    DateTime

  reviewedById         String?
  reviewedAt           DateTime?
  reviewDecisionReason String?

  // Employees: the TrainingAssignment minted by the Training & Competency
  // engine. Contractor workers cannot hold one (personUserId is a User FK), so
  // their gate is an EPC competencyRecords / trainingCertificates entry for
  // the same mapped competency.
  correctiveActionTrainingId   String?
  correctiveActionCompetencyId String?
  correctiveActionNote         String?

  // Non-null escalatedAt is the latch that makes the timeout scan fire exactly
  // once. It never changes `status` — silence escalates, it does not decide.
  escalatedAt   DateTime?
  escalatedToId String?

  reinstatedById    String?
  reinstatedAt      DateTime?
  reinstatementNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events ObservationDerosterEvent[]

  @@index([observationId])
  @@index([status])
  @@index([userId])
  @@index([contractorWorkerId])
  @@index([plantId])
  @@index([status, escalatedAt, reviewDueAt])
}

/// Append-only deroster audit trail. A table rather than a JSON array because
/// in-place JSON mutation silently no-ops a SQLAlchemy commit — this codebase
/// has been bitten by that before. Never updated, never deleted.
model ObservationDerosterEvent {
  id         String              @id @default(cuid())
  derosterId String
  deroster   ObservationDeroster @relation(fields: [derosterId], references: [id], onDelete: Cascade)

  observationId String
  action        String
  fromStatus    String?
  toStatus      String?
  actorId       String?
  notes         String?
  context       Json?
  createdAt     DateTime @default(now())

  @@index([derosterId])
  @@index([observationId])
  @@index([createdAt])
}

/// Append-only trail of every value Observation.targetDate has held,
/// including the initial auto-calculated one.
model ObservationTargetDateHistory {
  id            String      @id @default(cuid())
  observationId String
  observation   Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  targetDate       DateTime?
  source           String
  reason           String?
  // What the policy said at the time, so a later config edit can't rewrite
  // history: {severity, categoryGroup, slaDays, configId, scope}.
  slaConfigApplied Json?

  changedById String?
  changedAt   DateTime @default(now())

  @@index([observationId])
  @@index([changedAt])
}

// ─────────────────────────────────────────────────────────────────────
//  OBSERVATION SEVERITY SUGGESTION ENGINE
//  prisma/apply-observation-severity-ddl.ts (hand DDL, idempotent) — NEVER db push.
//  Deterministic: a seeded lookup plus an area modifier, no model in the loop.
// ─────────────────────────────────────────────────────────────────────

/// Base severity for one DuPont STOP (axis, category, sub-category) triple.
/// `observationType` holds the ACT / CONDITION axis — the same key
/// ObservationTaxonomy is partitioned on, NOT the four-value ObservationType.
/// The unique index is PARTIAL (`WHERE isActive`) so a retired rule and its
/// replacement coexist: SeverityOverrideLog.matrixRuleId points at the rule
/// that was in force and must still resolve after the rule is superseded.
model SeverityMatrixRule {
  id              String   @id @default(cuid())
  observationType String
  category        String
  subCategory     String
  baseSeverity    String
  /// Observer-facing justification, shown next to the suggestion in the form.
  rationale       String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedById     String?

  @@index([observationType, category, subCategory, isActive])
}

/// How much worse the same deviation is in this area. `areaId` NULL is the
/// plant-wide default; an area row overrides it; absent both, Standard applies
/// and the base severity passes through untouched.
///
/// Created rather than reused: `Area` carries no risk classification, and HIRA's
/// risk levels sit on HiraEntry — one row per assessed hazard scenario, not a
/// standing property of the place. The seed DERIVES the first value per area
/// from those HIRA entries, then leaves it editable here.
///
/// Uniqueness is TWO partial indexes in the DDL, not one composite: Postgres
/// treats NULLs as distinct, so UNIQUE(plantId, areaId) would accept several
/// plant-wide defaults for the same plant.
model AreaHazardTier {
  id          String   @id @default(cuid())
  plantId     String
  plant       Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  areaId      String?
  area        Area?    @relation(fields: [areaId], references: [id], onDelete: Cascade)
  hazardTier  String
  notes       String?
  /// hira_derived | manual. A manual row is never overwritten by a re-derive.
  source      String   @default("manual")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@index([plantId, isActive])
  @@index([areaId])
}

/// Append-only record of every submission where the observer's severity differed
/// from the suggestion. This is the calibration signal: a sub-category overridden
/// consistently in one direction means the matrix rule is wrong, not the observers.
///
/// Agreement writes NO row. The denominator for an override rate is the count of
/// observations carrying the same taxonomy pair, which Observation already holds
/// exactly, so a confirmation row would be volume without information.
///
/// The taxonomy pair and resolver inputs are denormalised onto the row because
/// Observation.categoryCode and .severity are both editable afterwards — a report
/// joining through them would quietly restate history.
model SeverityOverrideLog {
  id            String      @id @default(cuid())
  observationId String
  observation   Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  suggestedSeverity String
  finalSeverity     String
  overrideReason    String?

  /// Frozen copy of what the engine was asked and what it answered with.
  observationType String?
  categoryCode    String?
  subCategoryCode String?
  /// The rule's own severity, before the area tier was applied. With hazardTier
  /// this separates "the rule is wrong" from "the tier is wrong".
  baseSeverity    String?
  hazardTier      String?
  matrixRuleId    String?
  plantId         String?
  areaId          String?

  /// OBSERVER_FORM | CAPTURE_CONVERSION | EDIT. The calibration report counts
  /// OBSERVER_FORM only by default — a triager's or an editor's severity call
  /// is not observer disagreement.
  source String @default("OBSERVER_FORM")

  overriddenById String?
  overriddenBy   User?    @relation(fields: [overriddenById], references: [id])
  createdAt      DateTime @default(now())

  @@index([observationId])
  @@index([source, createdAt, observationType, categoryCode, subCategoryCode])
  @@index([plantId, createdAt])
  @@index([matrixRuleId])
}

