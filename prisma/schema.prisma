// ════════════════════════════════════════════════════════════════════════
// ENTERPRISE RISK MANAGEMENT (ERM) — Phase 1
//
// Board-grade ERM layer (ISO 31000:2018 / COSO ERM 2017) that sits ABOVE the
// existing Combined Risk Register (HIRA + EAI). The platform is plant-scoped,
// so "tenant" == the set of plants a user can reach via RBAC. An EnterpriseRisk
// may be ENTERPRISE-level (plantId null) or SITE-level (plantId = a Plant).
//
// References to existing models (User, Plant, Capa, HiraEntry, EaiEntry) are
// plain String id columns WITHOUT Prisma relations, so this block adds ZERO
// fields to existing models — honouring the hard constraint "do not modify the
// Combined Risk Register / HIRA / EAI schemas." Relations are used only WITHIN
// the ERM cluster. Audit fields (createdBy/updatedBy = userId) + soft-delete
// (isDeleted) are consistent with the platform's audit conventions.
// ════════════════════════════════════════════════════════════════════════

model RiskCategory {
  id               String  @id @default(cuid())
  code             String  @unique // STR, FIN, OPS, CMP, REP, TEC, ESG, SCM, PPL, GEO
  name             String
  description      String  @db.Text
  colorHex         String
  displayOrder     Int     @default(0)
  isSystemCategory Boolean @default(false) // the 10 seeded categories — deactivate only
  isActive         Boolean @default(true)

  subCategories RiskSubCategory[]
  risks         EnterpriseRisk[]

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([isActive, displayOrder])
}

model RiskSubCategory {
  id          String       @id @default(cuid())
  categoryId  String
  category    RiskCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  code        String       @unique // FIN-FX, OPS-HSE, ...
  name        String
  description String       @default("") @db.Text
  isActive    Boolean      @default(true)

  risks EnterpriseRisk[]

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([categoryId, isActive])
}

model ScoringMatrixConfig {
  id               String  @id @default(cuid())
  name             String // "Meridian Standard 5x5"
  version          Int     @default(1) // bumped on threshold edits; assessments store the version used
  isDefault        Boolean @default(false)
  isActive         Boolean @default(true)
  likelihoodLevels Json    @default("[]") // LikelihoodLevel[] (exactly 5)
  impactLevels     Json    @default("[]") // ImpactLevelDefinition[] (5 levels × 5 dimensions)
  ratingBands      Json    @default("[]") // RatingBand[] (score → band mapping)
  notes            String? @db.Text

  assessments RiskAssessment[]

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([isActive, isDefault])
}

model EnterpriseRisk {
  id            String           @id @default(cuid())
  riskCode      String           @unique // "ERM-2026-0001" — tenant(=plant-set)-scoped sequence
  title         String // max 160 chars (enforced in API)
  description   String           @db.Text // cause→event→consequence risk statement (rich text)
  categoryId    String
  category      RiskCategory     @relation(fields: [categoryId], references: [id])
  subCategoryId String?
  subCategory   RiskSubCategory? @relation(fields: [subCategoryId], references: [id])

  orgLevel       String  @default("ENTERPRISE") // ENTERPRISE | BUSINESS_UNIT | FUNCTION | SITE
  businessUnit   String? // free-text BU label (platform has no OrgUnit model)
  plantId        String? // Plant.id for SITE-level risks; null = enterprise
  riskOwnerId    String // User.id — single accountable owner (mandatory)
  riskChampionId String // User.id — facilitates assessment & review

  lifecycleState String  @default("DRAFT") // DRAFT|SUBMITTED|ASSESSED|TREATMENT_ACTIVE|MONITORING|ACCEPTED|ESCALATED|CLOSED
  velocity       String  @default("MODERATE") // SLOW | MODERATE | FAST | VERY_FAST
  sourceType     String  @default("MANUAL") // MANUAL | HSE_ROLLUP | INCIDENT_TRIGGERED
  rollupRuleId   String? // set when sourceType = HSE_ROLLUP

  identifiedDate    DateTime
  nextReviewDate    DateTime
  appetiteThreshold Int? // residual score above which auto-escalate (Phase 2 expands)

  tags             Json @default("[]") // string[]
  causes           Json @default("[]") // string[] — bow-tie left
  consequences     Json @default("[]") // string[] — bow-tie right
  existingControls Json @default("[]") // string[] — controls considered in residual

  // Denormalised current scores for fast register/heat-map rendering. Kept in
  // sync by the assessment engine on every (re)assessment / rollup run.
  inherentLikelihood Int?
  inherentImpact     Int?
  inherentScore      Int?
  inherentBand       String?
  residualLikelihood Int?
  residualImpact     Int?
  residualScore      Int?
  residualBand       String?
  // Prior-quarter residual (set by the snapshot job) — powers trend arrows /
  // movement panel / quarter-compare without re-querying snapshot rows.
  priorResidualScore Int?
  priorResidualBand  String?

  // ── ADVANCED (CRO-grade) extension ──────────────────────────────────────
  // Monetary exposure (₹), denormalised from the current INHERENT/RESIDUAL
  // assessments by the scoring engine. expected = likelihood% × ₹expected impact;
  // worst = tail (₹worst impact) for value-at-risk.
  inherentExpectedLossInr Float?
  inherentWorstLossInr    Float?
  residualExpectedLossInr Float?
  residualWorstLossInr    Float?
  targetExpectedLossInr   Float?

  // Target risk level — where the org intends to steer the risk (ISO 31000 §6.5).
  targetLikelihood Int?
  targetImpact     Int?
  targetScore      Int?
  targetBand       String?
  targetDate       DateTime?
  targetRationale  String?   @db.Text

  // Control-derived residual. derivedResidual* is residual implied PURELY by mapped
  // control effectiveness (inherent attenuated by barriers-in-series). When an
  // expert asserts a different residual it is an OVERRIDE with rationale; the
  // variance is surfaced. controlAlert fires when a mapped control goes deficient.
  controlEffectivenessPct  Float? // 0..100 combined effectiveness of mapped controls
  derivedResidualScore     Int?
  derivedResidualBand      String?
  residualIsOverride       Boolean   @default(false)
  residualOverrideVariance Int? // assertedResidualScore − derivedResidualScore
  controlAlert             Boolean   @default(false)
  controlAlertAt           DateTime?

  // Structured bow-tie: { topEvent, threats[{preventiveBarriers[{controlId?,status}]}],
  // consequences[{mitigatingBarriers[{controlId?,status}]}] } — causal model, not free text.
  bowtie             Json?
  // Three-lines-of-defence accountability (COSO / IIA): owners of each line.
  firstLineOwnerId   String?
  secondLineOwnerId  String?
  thirdLineAssurance String? // e.g. "Internal Audit", "External Audit"
  // Raised when a linked KRI breaches RED — the early-warning → reassessment hook.
  kriAlert           Boolean   @default(false)
  kriAlertAt         DateTime?

  closureJustification    String?   @db.Text
  acceptanceJustification String?   @db.Text
  acceptedBy              String? // CRO userId when state = ACCEPTED
  acceptedAt              DateTime?
  escalatedAt             DateTime?

  version Int @default(1) // optimistic lock

  assessments    RiskAssessment[]
  reviews        RiskReview[]
  linkagesFrom   RiskLinkage[]    @relation("LinkageSource")
  linkagesTo     RiskLinkage[]    @relation("LinkageTarget")
  rollupLinkages RollupLinkage[]

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([categoryId, lifecycleState])
  @@index([plantId, lifecycleState])
  @@index([riskOwnerId])
  @@index([residualBand])
  @@index([sourceType])
  @@index([nextReviewDate])
  @@index([isDeleted, lifecycleState])
}

model RiskAssessment {
  id             String               @id @default(cuid())
  riskId         String
  risk           EnterpriseRisk       @relation(fields: [riskId], references: [id], onDelete: Cascade)
  matrixConfigId String?
  matrixConfig   ScoringMatrixConfig? @relation(fields: [matrixConfigId], references: [id])
  matrixVersion  Int? // version of the matrix in force at assessment time

  assessmentType          String // INHERENT | RESIDUAL
  likelihood              Int // 1..5
  impactScores            Json   @default("[]") // { dimension, level }[]
  dominantImpactDimension String
  overallImpact           Int // = max(impactScores.level)
  totalScore              Int // likelihood × overallImpact (1..25)
  ratingBand              String // LOW | MEDIUM | HIGH | CRITICAL

  // ── ADVANCED quantification ──────────────────────────────────────────────
  likelihoodPct           Float? // annualised probability 0..100 (defaults from ordinal likelihood)
  financialBestInr        Float? // single-event ₹ loss — best case
  financialExpectedInr    Float? // single-event ₹ loss — expected
  financialWorstInr       Float? // single-event ₹ loss — worst (tail)
  expectedLossInr         Float? // = likelihoodPct/100 × financialExpectedInr
  unexpectedLossInr       Float? // = likelihoodPct/100 × (worst − expected) — tail proxy
  timeHorizon             String? // ONE_YEAR | THREE_YEAR | FIVE_YEAR
  derivedFromControls     Boolean @default(false) // RESIDUAL computed from control effectiveness
  controlEffectivenessPct Float? // snapshot of mapped-control effectiveness at assessment time

  assessmentDate DateTime
  assessedBy     String
  rationale      String   @db.Text
  isCurrent      Boolean  @default(true) // latest of its type; history preserved

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt

  @@index([riskId, assessmentType, isCurrent])
}

model RiskLinkage {
  id           String         @id @default(cuid())
  sourceRiskId String
  sourceRisk   EnterpriseRisk @relation("LinkageSource", fields: [sourceRiskId], references: [id], onDelete: Cascade)
  targetRiskId String
  targetRisk   EnterpriseRisk @relation("LinkageTarget", fields: [targetRiskId], references: [id], onDelete: Cascade)
  linkageType  String // TRIGGERS | AMPLIFIES | CORRELATED
  notes        String         @default("") @db.Text

  // ── ADVANCED correlation modelling ───────────────────────────────────────
  // correlationStrength: how tightly the two risks co-move (0..1). impactFactor:
  // fraction of the SOURCE risk's expected loss that propagates onto the TARGET
  // when the source materialises — drives correlated-exposure aggregation.
  correlationStrength Float @default(0.5)
  impactFactor        Float @default(0.0)

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt

  @@unique([sourceRiskId, targetRiskId])
  @@index([sourceRiskId])
  @@index([targetRiskId])
}

model RollupRule {
  id                    String    @id @default(cuid())
  name                  String
  sourceRegister        String    @default("COMBINED_RISK_REGISTER")
  filterCriteria        Json      @default("{}") // { siteIds?, minRiskBand?, sourceModules? }
  aggregationMode       String    @default("GROUPED") // GROUPED | ONE_TO_ONE
  targetCategoryCode    String    @default("OPS") // locked to Operational in Phase 1
  targetSubCategoryCode String // OPS-HSE | OPS-ENV | OPS-QUA
  scoringMode           String    @default("MAX") // MAX | WEIGHTED_AVERAGE
  isActive              Boolean   @default(true)
  lastRunAt             DateTime?
  lastRunSummary        Json? // { created, updated, unlinked, matched }

  linkages RollupLinkage[]

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([isActive])
}

model RollupLinkage {
  id                    String         @id @default(cuid())
  enterpriseRiskId      String
  enterpriseRisk        EnterpriseRisk @relation(fields: [enterpriseRiskId], references: [id], onDelete: Cascade)
  rollupRuleId          String?
  rollupRule            RollupRule?    @relation(fields: [rollupRuleId], references: [id])
  sourceRegisterEntryId String // HiraEntry.id or EaiEntry.id
  sourceModule          String // HIRA | EAI | QUALITY_NCR
  sourceRef             String? // snapshot of activity description / human ref
  contributingScore     Int
  contributingBand      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enterpriseRiskId, sourceRegisterEntryId])
  @@index([enterpriseRiskId])
  @@index([rollupRuleId])
}

model ReviewCycleConfig {
  id                  String @id @default(cuid())
  ratingBand          String @unique // LOW | MEDIUM | HIGH | CRITICAL
  reviewFrequencyDays Int // LOW 365, MEDIUM 180, HIGH 90, CRITICAL 30

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RiskReview {
  id              String         @id @default(cuid())
  riskId          String
  risk            EnterpriseRisk @relation(fields: [riskId], references: [id], onDelete: Cascade)
  reviewDate      DateTime
  reviewedBy      String
  outcome         String // NO_CHANGE | RESCORED | ESCALATED | RECOMMEND_CLOSURE
  notes           String         @db.Text
  newAssessmentId String? // when outcome = RESCORED

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt

  @@index([riskId, reviewDate])
}

model ErmBoardPack {
  id           String    @id @default(cuid())
  title        String
  quarterLabel String // "Q1 FY27"
  periodStart  DateTime
  periodEnd    DateTime
  status       String    @default("DRAFT") // DRAFT | PUBLISHED
  sections     Json      @default("{}") // selected sections + per-section config
  commentary   Json      @default("{}") // { [riskId]: richTextHtml }
  snapshotHash String?
  generatedAt  DateTime?
  publishedAt  DateTime?
  publishedBy  String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([status, quarterLabel])
}

model ErmRiskSnapshot {
  id             String   @id @default(cuid())
  quarterLabel   String // "Q4 FY26"
  snapshotDate   DateTime
  riskId         String
  riskCode       String
  categoryCode   String
  inherentScore  Int?
  inherentBand   String?
  residualScore  Int?
  residualBand   String?
  likelihood     Int?
  overallImpact  Int?
  lifecycleState String?

  createdAt DateTime @default(now())

  @@unique([quarterLabel, riskId])
  @@index([quarterLabel])
  @@index([riskId])
}

// ════════════════════════════════════════════════════════════════════════
// ENTERPRISE RISK MANAGEMENT (ERM) — Phase 2
//
// Adds the monitoring (KRI), governance (Appetite), evidence (Loss Events) and
// compliance (Legal Obligations) layers on top of the Phase 1 register. Same
// conventions as Phase 1: plant-scoped, cuid ids, camelCase, Json arrays for
// id-lists, audit fields + isDeleted soft delete. References to existing models
// (User/Plant/RiskCategory/EnterpriseRisk/Incident/Capa) are plain String
// columns — zero edits to existing models. Phase 1's EnterpriseRisk.appetiteThreshold
// is now DEPRECATED (superseded by the Appetite module) but kept for back-compat.
// ════════════════════════════════════════════════════════════════════════

// ── KRI Monitoring & Early Warning ──────────────────────────────────────────
model KriDefinition {
  id                String  @id @default(cuid())
  kriCode           String  @unique // "KRI-0001"
  name              String
  description       String  @default("") @db.Text
  categoryId        String // FK RiskCategory (primary classification)
  linkedRiskIds     Json    @default("[]") // EnterpriseRisk.id[]
  unit              String // "%", "count", "days", "₹ Lakh", "per mn manhours"
  direction         String  @default("HIGHER_IS_WORSE") // HIGHER_IS_WORSE | LOWER_IS_WORSE
  indicatorType     String  @default("LAGGING") // LEADING | LAGGING | COINCIDENT — does it warn BEFORE the event?
  frequency         String  @default("MONTHLY") // WEEKLY | MONTHLY | QUARTERLY
  feedType          String  @default("MANUAL") // MANUAL | MODULE_FED | API
  metricProviderKey String? // MODULE_FED — key from the metric catalogue
  apiEndpointConfig String? // API — inbound token reference
  apiToken          String? // API — rotatable bearer token for inbound feed
  thresholdGreen    Float // HIGHER_IS_WORSE: value <= green → GREEN; LOWER_IS_WORSE: value >= green → GREEN
  thresholdAmber    Float // boundary between AMBER and RED (direction-aware)
  ownerId           String // accountable user
  isActive          Boolean @default(true)
  graceDays         Int     @default(7) // days after periodEnd before NO_DATA breach
  currentStatus     String  @default("NO_DATA") // denormalised latest reading status
  currentValue      Float? // denormalised latest reading value

  readings KriReading[]
  breaches KriBreachEvent[]

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([categoryId, isActive])
  @@index([feedType])
  @@index([ownerId])
  @@index([currentStatus])
}

model KriReading {
  id          String        @id @default(cuid())
  kriId       String
  kri         KriDefinition @relation(fields: [kriId], references: [id], onDelete: Cascade)
  periodLabel String // "2026-05", "2026-W21", "FY27-Q1"
  periodEnd   DateTime
  value       Float
  status      String // GREEN | AMBER | RED (computed at write)
  source      String // MANUAL | MODULE_FED | API
  enteredBy   String?
  notes       String?       @db.Text
  isCurrent   Boolean       @default(true)

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt

  @@unique([kriId, periodLabel])
  @@index([kriId, isCurrent])
  @@index([kriId, periodEnd])
}

model KriBreachEvent {
  id              String        @id @default(cuid())
  kriId           String
  kri             KriDefinition @relation(fields: [kriId], references: [id], onDelete: Cascade)
  readingId       String?
  breachType      String // AMBER | RED | NO_DATA
  acknowledgedBy  String?
  acknowledgedAt  DateTime?
  resolutionNotes String?       @db.Text
  status          String        @default("OPEN") // OPEN | ACKNOWLEDGED | RESOLVED

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt

  @@index([kriId, status])
  @@index([status])
}

// ── Risk Appetite & Tolerance ───────────────────────────────────────────────
model AppetiteStatement {
  id                String    @id @default(cuid())
  categoryId        String // FK RiskCategory — one ACTIVE statement per category
  statementText     String    @db.Text
  appetiteLevel     String // AVERSE | MINIMAL | CAUTIOUS | OPEN | SEEKING
  version           Int       @default(1)
  status            String    @default("DRAFT") // DRAFT | PENDING_APPROVAL | ACTIVE | SUPERSEDED
  approvedBy        String?
  approvalReference String? // "RMC Meeting 14-May-2026, Item 4.2"
  approvedAt        DateTime?
  effectiveFrom     DateTime?
  toleranceBands    Json      @default("[]") // { bandType, thresholdValue }[]

  breaches AppetiteBreach[]

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([categoryId, status])
  @@index([status])
}

model AppetiteBreach {
  id                  String            @id @default(cuid())
  appetiteStatementId String
  appetiteStatement   AppetiteStatement @relation(fields: [appetiteStatementId], references: [id], onDelete: Cascade)
  categoryId          String // denormalised for fast dashboard grouping
  bandType            String // MAX_RESIDUAL_SCORE | MAX_CRITICAL_COUNT | MAX_HIGH_PLUS_COUNT | MAX_RED_KRI_COUNT
  observedValue       Float
  thresholdValue      Float
  triggeringEntityIds Json              @default("[]") // risk / KRI ids
  detectedAt          DateTime
  status              String            @default("OPEN") // OPEN | UNDER_REVIEW | TREATMENT_MANDATED | TEMPORARILY_ACCEPTED | RESOLVED
  committeeDecision   String?           @db.Text
  decisionBy          String? // CRO only
  reviewByDate        DateTime? // mandatory for TEMPORARILY_ACCEPTED (max 90 days)
  resolvedAt          DateTime?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt

  @@index([categoryId, status])
  @@index([status])
}

// ── Compliance & Legal Obligations Register ─────────────────────────────────
model LegalObligation {
  id               String    @id @default(cuid())
  obligationCode   String    @unique // "OBL-0001"
  title            String
  obligationType   String // LICENCE | CONSENT | RETURN_FILING | STATUTORY_DUTY | REGISTRATION
  statuteReference String    @db.Text
  regulatorName    String
  siteId           String? // Plant.id; null = corporate-level
  ownerId          String
  frequency        String // ONE_TIME | MONTHLY | QUARTERLY | HALF_YEARLY | ANNUAL | PERIODIC_RENEWAL
  validFrom        DateTime?
  validUntil       DateTime?
  renewalLeadDays  Int       @default(60)
  conditions       Json      @default("[]") // string[]
  linkedRiskIds    Json      @default("[]") // EnterpriseRisk.id[] (usually CMP)
  status           String    @default("COMPLIANT") // COMPLIANT | DUE_SOON | OVERDUE | UNDER_RENEWAL | NOT_APPLICABLE
  isActive         Boolean   @default(true)

  tasks ComplianceTask[]

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([siteId, status])
  @@index([obligationType])
  @@index([ownerId])
  @@index([status])
}

model ComplianceTask {
  id                  String          @id @default(cuid())
  obligationId        String
  obligation          LegalObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  taskType            String // RENEWAL | FILING | ATTESTATION
  periodLabel         String // "FY27-Q1", "2026-06", "Renewal-2027"
  dueDate             DateTime
  status              String          @default("PENDING") // PENDING | SUBMITTED | VERIFIED | OVERDUE | WAIVED
  attestedBy          String?
  attestedAt          DateTime?
  verifiedBy          String?
  verifiedAt          DateTime?
  capaId              String? // raised CAPA on overdue
  waiverJustification String?         @db.Text
  remarks             String?         @db.Text

  attachments ComplianceAttachment[]

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt

  @@unique([obligationId, periodLabel])
  @@index([obligationId, status])
  @@index([status, dueDate])
}

model ComplianceAttachment {
  id           String         @id @default(cuid())
  taskId       String
  task         ComplianceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName     String
  storagePath  String
  fileSize     Int?
  mimeType     String?
  caption      String?
  uploadedById String
  uploadedAt   DateTime       @default(now())
  deletedAt    DateTime?
  deleteReason String?

  @@index([taskId])
}

// ── Loss Event / Risk Event Database ────────────────────────────────────────
model LossEvent {
  id                String   @id @default(cuid())
  eventCode         String   @unique // "LE-2026-0001"
  title             String
  description       String   @default("") @db.Text
  eventDate         DateTime
  siteId            String?
  categoryId        String // FK RiskCategory
  subCategoryId     String?
  linkedRiskIds     Json     @default("[]") // EnterpriseRisk.id[]
  source            String   @default("MANUAL") // INCIDENT_AUTO | MANUAL
  sourceIncidentId  String? // INCIDENT_AUTO drill-down
  isNearMiss        Boolean  @default(false)
  grossLossInr      Float    @default(0)
  recoveredInr      Float    @default(0)
  netLossInr        Float    @default(0) // computed = gross - recovered
  potentialLossInr  Float? // near-miss credible worst case
  lossTypes         Json     @default("[]") // string[]
  status            String   @default("DRAFT") // DRAFT | QUANTIFIED | CLOSED
  closureNotes      String?  @db.Text
  sourceUpdatedFlag Boolean  @default(false) // info badge: source incident changed post-quantification

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([categoryId, status])
  @@index([siteId])
  @@index([source])
  @@index([eventDate])
  @@index([sourceIncidentId])
}

// ════════════════════════════════════════════════════════════════════════
// ENTERPRISE RISK MANAGEMENT (ERM) — Phase 3: Business Continuity (ISO 22301)
//   + Scenario Analysis + Horizon Scanning.
//
// Additive only. Same conventions as P1/P2: cuid ids, camelCase, plain-String
// refs to existing models (User/Plant/EnterpriseRisk/Capa/Incident), Json for
// nested arrays, audit fields + isDeleted. CrisisLogEntry is append-only (no
// updatedAt) — the legal record. FSER data is read via a provider, not modelled.
// ════════════════════════════════════════════════════════════════════════

// ── Business Impact Analysis ────────────────────────────────────────────────
model BusinessProcess {
  id                               String    @id @default(cuid())
  processCode                      String    @unique // "BP-0001"
  name                             String
  description                      String    @default("") @db.Text
  siteId                           String? // Plant.id; null = corporate process
  ownerId                          String
  departmentName                   String    @default("")
  rtoHours                         Int // Recovery Time Objective
  rpoHours                         Int? // Recovery Point Objective
  mtpdHours                        Int // Maximum Tolerable Period of Disruption (>= rto)
  criticality                      String    @default("IMPORTANT") // VITAL | ESSENTIAL | IMPORTANT | DEFERRABLE
  criticalityOverrideJustification String?   @db.Text
  peakPeriods                      String?
  impactProfile                    Json      @default("[]") // [{dimension, at4h, at24h, at7d, at30d}]
  linkedRiskIds                    Json      @default("[]")
  biaStatus                        String    @default("DRAFT") // DRAFT | ASSESSED | APPROVED | REVIEW_DUE
  approvedBy                       String?
  lastBiaDate                      DateTime?
  nextBiaReviewDate                DateTime?

  dependencies ProcessDependency[]

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([siteId, criticality])
  @@index([biaStatus])
  @@index([ownerId])
}

model ProcessDependency {
  id                      String          @id @default(cuid())
  processId               String
  process                 BusinessProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  dependencyType          String // UPSTREAM_PROCESS | IT_SYSTEM | EQUIPMENT | VENDOR | PEOPLE_SKILL | UTILITY | FACILITY
  name                    String
  description             String?         @db.Text
  isSinglePointOfFailure  Boolean         @default(false)
  workaround              String?         @db.Text
  workaroundDurationHours Int?
  linkedEntityRef         String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt

  @@index([processId])
  @@index([isSinglePointOfFailure])
}

// ── Continuity Plans ─────────────────────────────────────────────────────────
model ContinuityPlan {
  id                 String    @id @default(cuid())
  planCode           String    @unique // "BCP-0001"
  title              String
  planType           String // BUSINESS_CONTINUITY | DISASTER_RECOVERY_IT | CRISIS_MANAGEMENT | EMERGENCY_RESPONSE_LINK
  siteId             String?
  ownerId            String
  coveredProcessIds  Json      @default("[]")
  scopeStatement     String    @default("") @db.Text
  activationCriteria Json      @default("[]") // string[]
  status             String    @default("DRAFT") // DRAFT | IN_REVIEW | APPROVED | REVIEW_DUE | RETIRED
  version            Int       @default(1)
  approvedBy         String?
  approvedAt         DateTime?
  nextReviewDate     DateTime?
  sections           Json      @default("[]") // PlanSection[] {orderIndex, heading, contentRichText, attachments}
  strategySummary    String    @default("") @db.Text
  fserPlanRef        String? // EMERGENCY_RESPONSE_LINK pointer (provider key / site code)
  versionSnapshots   Json      @default("[]") // immutable prior approved versions
  lastExercisedAt    DateTime? // denormalised from exercises (plan health)

  recoveryTasks RecoveryTask[]

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([siteId, status])
  @@index([planType])
  @@index([status])
}

model RecoveryTask {
  id                        String         @id @default(cuid())
  planId                    String
  plan                      ContinuityPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  orderIndex                Int            @default(0)
  title                     String
  detail                    String?        @db.Text
  responsibleRoleName       String
  targetHoursFromActivation Int            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId, orderIndex])
}

// ── Crisis Management ─────────────────────────────────────────────────────────
model CrisisTeamRole {
  id               String  @id @default(cuid())
  roleName         String
  siteId           String? // null = corporate crisis team
  primaryUserId    String
  alternateUserId  String // mandatory — no single-person crisis roles
  responsibilities String  @default("") @db.Text
  escalationOrder  Int     @default(0)

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([siteId, escalationOrder])
}

model CallTree {
  id          String    @id @default(cuid())
  name        String
  siteId      String?
  nodes       Json      @default("[]") // CallTreeNode[] {id, parentNodeId, userId|groupName, contactPhone, contactEmail}
  publishedAt DateTime?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([siteId])
}

model CrisisEvent {
  id                   String    @id @default(cuid())
  crisisCode           String    @unique // "CRX-2026-0001"
  title                String
  siteId               String?
  activatedPlanIds     Json      @default("[]")
  linkedRiskIds        Json      @default("[]")
  linkedIncidentId     String?
  status               String    @default("ACTIVATED") // ACTIVATED | MANAGED | STAND_DOWN | CLOSED
  activatedBy          String
  activatedAt          DateTime
  severityLevel        Int       @default(1) // 1 site · 2 corporate · 3 enterprise
  standDownAt          DateTime?
  postCrisisReviewDone Boolean   @default(false)
  reviewNote           String?   @db.Text
  reviewCapaId         String?
  cachedPlanContent    Json      @default("[]") // snapshot of activated plans (offline read)
  callTreeAck          Json      @default("{}") // { nodeId: { notifiedAt, acknowledgedAt } }

  logEntries CrisisLogEntry[]

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([siteId, status])
  @@index([status])
}

model CrisisLogEntry {
  // Append-only legal record: server-set timestamp, NO updatedAt, no edit/delete API.
  id             String      @id @default(cuid())
  crisisId       String
  crisis         CrisisEvent @relation(fields: [crisisId], references: [id], onDelete: Cascade)
  timestamp      DateTime    @default(now())
  enteredBy      String
  entryType      String // DECISION | ACTION | COMMUNICATION | STATUS_UPDATE | TASK_CHECK
  content        String      @db.Text
  recoveryTaskId String?

  @@index([crisisId, timestamp])
}

// ── BC Exercises / Drills ─────────────────────────────────────────────────────
model BcExercise {
  id               String    @id @default(cuid())
  exerciseCode     String    @unique // "BCX-2026-0001"
  title            String
  exerciseType     String // DESK_CHECK | TABLETOP | SIMULATION | FULL_INTERRUPTION_TEST | CALL_TREE_TEST
  scheduledDate    DateTime
  siteId           String?
  testedPlanIds    Json      @default("[]")
  testedScenarioId String?
  facilitatorId    String
  participants     Json      @default("[]")
  objectives       Json      @default("[]")
  status           String    @default("PLANNED") // PLANNED | IN_PROGRESS | COMPLETED | CANCELLED
  conductedDate    DateTime?
  outcome          String? // MET_OBJECTIVES | PARTIALLY_MET | NOT_MET
  rtoAchievedHours Int?
  callTreeStats    Json? // { notified, acknowledged, medianAckMinutes }
  reportRichText   String?   @db.Text

  findings ExerciseFinding[]

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([siteId, status])
  @@index([scheduledDate])
  @@index([status])
}

model ExerciseFinding {
  id          String     @id @default(cuid())
  exerciseId  String
  exercise    BcExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  description String     @db.Text
  severity    String // OBSERVATION | MINOR_GAP | MAJOR_GAP
  capaId      String? // MAJOR_GAP requires a CAPA (sourceType BC_EXERCISE)

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt

  @@index([exerciseId])
}

// ── Scenario Analysis & Horizon Scanning ──────────────────────────────────────
model Scenario {
  id                     String    @id @default(cuid())
  scenarioCode           String    @unique // "SCN-0001"
  title                  String
  category               String // NATURAL_DISASTER | CYBER_ATTACK | ...
  narrative              String    @default("") @db.Text
  probabilityQualitative String    @default("POSSIBLE") // REMOTE | POSSIBLE | PLAUSIBLE | LIKELY
  timeHorizon            String    @default("1_3_YEARS") // 0_12_MONTHS | 1_3_YEARS | 3_PLUS_YEARS
  affectedRiskIds        Json      @default("[]")
  affectedProcessIds     Json      @default("[]")
  impactEstimates        Json      @default("[]") // [{dimension, estimatedLevel, estimateBasisNotes, estimatedGrossInr?, distributionParams:null}]
  whatIfAdjustments      Json      @default("[]") // [{riskId, stressedLikelihood, stressedImpact}]
  mitigationReadiness    String    @default("NO_PLAN") // NO_PLAN | PLAN_EXISTS | PLAN_TESTED (cached; recomputed live)
  status                 String    @default("DRAFT") // DRAFT | ACTIVE | RETIRED
  lastReviewedAt         DateTime?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([category, status])
  @@index([status])
}

model HorizonItem {
  id                   String   @id @default(cuid())
  title                String
  description          String   @default("") @db.Text
  category             String
  signalStrength       String   @default("WEAK") // WEAK | EMERGING | STRONG
  potentialCategoryIds Json     @default("[]")
  watchedBy            String
  reviewDate           DateTime
  disposition          String? // PROMOTED_TO_SCENARIO | PROMOTED_TO_RISK | DISMISSED
  promotedEntityId     String?
  dispositionNote      String?  @db.Text

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([signalStrength])
  @@index([watchedBy])
}

// ═══════════════════════════════════════════════════════════════════════════════
// ERM TIER 3 — Internal Controls · Vendor/Third-Party Risk · Insurance & Transfer
// Additive only. References to existing models (EnterpriseRisk, BusinessProcess,
// LegalObligation, LossEvent, User, Plant, Capa) are plain String columns.
// ═══════════════════════════════════════════════════════════════════════════════

// ── Internal Controls Register ─────────────────────────────────────────────────
model Control {
  id                     String    @id @default(cuid())
  controlCode            String    @unique // "CTL-0001"
  name                   String
  description            String    @default("") @db.Text
  controlType            String // PREVENTIVE | DETECTIVE | CORRECTIVE | DIRECTIVE
  nature                 String // MANUAL | AUTOMATED | IT_DEPENDENT_MANUAL
  frequency              String // CONTINUOUS | DAILY | WEEKLY | MONTHLY | QUARTERLY | ANNUAL | EVENT_DRIVEN
  category               String // FINANCIAL_REPORTING | OPERATIONAL | COMPLIANCE | IT_GENERAL | ENTITY_LEVEL
  controlOwnerId         String
  processName            String?
  siteId                 String? // null = entity-level / corporate
  isKeyControl           Boolean   @default(false)
  assertions             Json      @default("[]") // string[] for financial controls
  controlDesignNotes     String    @default("") @db.Text
  currentDesignRating    String? // EFFECTIVE | DEFICIENT | NOT_ASSESSED
  currentOperatingRating String? // EFFECTIVE | DEFICIENT | NOT_ASSESSED
  lastTestDate           DateTime?
  nextTestDueDate        DateTime?
  isActive               Boolean   @default(true)

  mappings     RiskControlMapping[]
  testPlans    ControlTestPlan[]
  tests        ControlTest[]
  deficiencies ControlDeficiency[]

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([category, isKeyControl])
  @@index([siteId])
  @@index([controlOwnerId])
}

model RiskControlMapping {
  id                 String  @id @default(cuid())
  controlId          String
  control            Control @relation(fields: [controlId], references: [id], onDelete: Cascade)
  riskId             String? // FK EnterpriseRisk
  processId          String? // FK BusinessProcess
  obligationId       String? // FK LegalObligation
  mitigationStrength String // PRIMARY | SECONDARY | COMPENSATING
  coverageNotes      String  @default("") @db.Text

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt

  @@index([controlId])
  @@index([riskId])
  @@index([processId])
  @@index([obligationId])
}

model ControlTestPlan {
  id                   String   @id @default(cuid())
  controlId            String
  control              Control  @relation(fields: [controlId], references: [id], onDelete: Cascade)
  testCycleLabel       String // "FY27"
  testMethod           String // INQUIRY | OBSERVATION | INSPECTION | REPERFORMANCE
  sampleSizePlanned    Int      @default(1)
  testFrequencyPerYear Int      @default(1)
  assignedTesterId     String // must differ from control.controlOwnerId
  scheduledDate        DateTime

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt

  @@index([controlId])
}

model ControlTest {
  id                    String   @id @default(cuid())
  controlId             String
  control               Control  @relation(fields: [controlId], references: [id], onDelete: Cascade)
  testPlanId            String?
  testType              String // DESIGN | OPERATING
  testDate              DateTime
  testerId              String
  method                String // INQUIRY | OBSERVATION | INSPECTION | REPERFORMANCE
  sampleSize            Int      @default(1)
  exceptionsFound       Int      @default(0)
  conclusion            String // EFFECTIVE | DEFICIENT | SIGNIFICANT_DEFICIENCY | MATERIAL_WEAKNESS
  workpaperNotes        String   @db.Text
  evidenceAttachmentIds Json     @default("[]")
  deficiencyId          String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt

  @@index([controlId, testType])
  @@index([testDate])
}

model ControlDeficiency {
  id                       String  @id @default(cuid())
  deficiencyCode           String  @unique // "DEF-2026-0001"
  controlId                String
  control                  Control @relation(fields: [controlId], references: [id], onDelete: Cascade)
  sourceTestId             String
  severity                 String // DEFICIENCY | SIGNIFICANT_DEFICIENCY | MATERIAL_WEAKNESS
  description              String  @db.Text
  rootCause                String? @db.Text
  remediationCapaId        String?
  status                   String  @default("OPEN") // OPEN | REMEDIATION_ACTIVE | RETESTING | CLOSED
  identifiedRiskImpact     String? @db.Text
  reportedToAuditCommittee Boolean @default(false)
  auditCommitteeReference  String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([controlId])
  @@index([severity, status])
}

// ── Third-Party / Vendor Risk Management (dual-lens) ────────────────────────────
model VendorProfile {
  id                  String    @id @default(cuid())
  vendorCode          String    @unique // "VEN-0001"
  masterDataRef       String? // FK to platform vendor master via provider; null = module-owned
  legalName           String
  category            String
  criticality         String // STRATEGIC | CRITICAL | IMPORTANT | ROUTINE
  tier                String // TIER_1 | TIER_2 | TIER_3
  siteScope           Json      @default("[]")
  relationshipOwnerId String
  annualSpendInr      Float?
  isSingleSource      Boolean   @default(false)
  linkedProcessIds    Json      @default("[]")
  linkedRiskIds       Json      @default("[]")
  onboardingStatus    String    @default("PROSPECT") // PROSPECT | DUE_DILIGENCE | APPROVED | CONDITIONAL | SUSPENDED | OFFBOARDED
  currentRiskScore    Float?
  currentRiskBand     String? // LOW | MEDIUM | HIGH | CRITICAL
  currentEsgScore     Float?
  currentEsgBand      String? // LEADING | ADEQUATE | DEVELOPING | LAGGING
  nextReviewDate      DateTime?
  isActive            Boolean   @default(true)

  assessments VendorAssessment[]

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([criticality, currentRiskBand])
  @@index([currentEsgBand])
  @@index([onboardingStatus])
}

model VendorAssessment {
  id             String        @id @default(cuid())
  vendorId       String
  vendor         VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  lens           String // RISK | ESG
  assessmentDate DateTime
  assessorId     String
  method         String // SELF_ASSESSMENT | DESK_REVIEW | ONSITE_AUDIT | THIRD_PARTY_RATING
  domainScores   Json          @default("[]") // [{domainKey, rawScore, weightPct, evidenceNotes}]
  weightedScore  Float         @default(0)
  band           String
  summaryNotes   String        @default("") @db.Text
  validUntil     DateTime
  isCurrent      Boolean       @default(true)
  findings       Json          @default("[]") // [{id, lens, severity, description, capaId?, targetCloseDate?}]

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  @@index([vendorId, lens])
}

model VendorScoringConfig {
  id             String @id @default(cuid())
  lens           String @unique // RISK | ESG (one active config per lens)
  domains        Json   @default("[]") // [{domainKey, label, weightPct, guidance}]
  bandThresholds Json   @default("[]") // [{band, minScore, maxScore, colorHex}]

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
}

// ── Insurance & Risk Transfer Register ──────────────────────────────────────────
model InsurancePolicy {
  id                String   @id @default(cuid())
  policyCode        String   @unique // "POL-0001"
  policyName        String
  policyType        String // PROPERTY_FIRE | BUSINESS_INTERRUPTION | ... | OTHER
  insurerName       String
  brokerName        String?
  policyNumber      String
  siteScope         Json     @default("[]")
  sumInsuredInr     Float    @default(0)
  premiumAnnualInr  Float    @default(0)
  deductibleInr     Float?
  coverageStartDate DateTime
  coverageEndDate   DateTime
  renewalLeadDays   Int      @default(45)
  status            String   @default("ACTIVE") // ACTIVE | EXPIRING_SOON | EXPIRED | UNDER_RENEWAL | LAPSED
  keyExclusions     Json     @default("[]")
  coveredRiskIds    Json     @default("[]")
  coveredProcessIds Json     @default("[]")
  ownerId           String
  isActive          Boolean  @default(true)

  claims InsuranceClaim[]

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([policyType, status])
  @@index([status])
}

model InsuranceClaim {
  id               String          @id @default(cuid())
  claimCode        String          @unique // "CLM-2026-0001"
  policyId         String
  policy           InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  lossEventId      String? // FK Phase 2 LossEvent
  claimDate        DateTime
  description      String          @db.Text
  claimedAmountInr Float           @default(0)
  status           String          @default("INTIMATED") // INTIMATED | SURVEYOR_APPOINTED | UNDER_ASSESSMENT | APPROVED | PARTIALLY_SETTLED | SETTLED | REPUDIATED
  settledAmountInr Float?
  settlementDate   DateTime?
  remarks          String?         @db.Text

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  @@index([policyId])
  @@index([lossEventId])
  @@index([status])
}

model CoverageGapAssessment {
  id                   String   @id @default(cuid())
  assessmentCycleLabel String // "FY27 Insurance Review"
  reviewDate           DateTime
  reviewedBy           String
  lines                Json     @default("[]") // [{riskId, isInsurable, coveredByPolicyIds, gapType, gapNotes, recommendedAction?}]
  summaryNotes         String   @default("") @db.Text

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  @@index([reviewDate])
}

// ═══════════════════════════════════════════════════════════════════════════
// CAMS — Compliance & Audit Management System
// Centralised audit/inspection engine. An inspection is an audit at the engine
// level — these tables are the single shared services consumed platform-wide
// (Fire / PPE / Pharma / EPC call them via sourceModule). Re-homes the legacy
// Inspection cluster (InspectionType / ChecklistTemplate / Inspection /
// InspectionFinding) via the Section-9 migration; legacy tables coexist until
// migrated, hence the distinct `Cams*` names. String columns + inline value
// comments (not Prisma enums) match the ERM Phase-2 convention and avoid a
// collision with the existing `FindingSeverity` enum.
// ═══════════════════════════════════════════════════════════════════════════

// ── Shared Service ③ (types) — Audit Type config (was "Inspection Types") ──
model CamsAuditType {
  id                        String  @id @default(cuid())
  typeCode                  String  @unique // "AT-0001"
  name                      String // "Fire Equipment Inspection", "Internal HSE System Audit"
  engagementType            String // INTERNAL_AUDIT | COMPLIANCE_AUDIT | INSPECTION | SUPPLIER_AUDIT | LAYERED_PROCESS_AUDIT | MANAGEMENT_REVIEW
  defaultTemplateId         String? // CamsTemplate.id (loose ref — versioned)
  defaultRecurrence         String? // scheduling hint: MONTHLY | QUARTERLY | ANNUAL | ...
  requiresAssetRef          Boolean @default(false)
  requiresAuditorCompetency Json    @default("[]") // competency codes (Skill Matrix provider) — enrichment, degrades if absent
  standardRefs              Json    @default("[]") // ["ISO_45001", "ISO_14001"]
  isActive                  Boolean @default(true)

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([engagementType])
  @@index([isActive])
}

// ── Shared Service ① — Audit/Inspection Engine ──
model CamsEngagement {
  id                  String    @id @default(cuid())
  engagementCode      String    @unique // "AUD-2026-0001" (type-prefixed, tenant-scoped)
  title               String
  engagementType      String // INTERNAL_AUDIT | COMPLIANCE_AUDIT | INSPECTION | SUPPLIER_AUDIT | LAYERED_PROCESS_AUDIT | MANAGEMENT_REVIEW
  auditTypeId         String? // CamsAuditType.id (loose ref)
  standardRefs        Json      @default("[]") // ["ISO_45001"]
  siteId              String? // Plant.id
  areaOrAssetRef      String? // Equipment Master ref (provider) for asset/area inspections
  scopeStatement      String    @default("") @db.Text
  leadAuditorId       String
  auditTeamIds        Json      @default("[]") // User.id[]
  auditeeOwnerId      String? // accountable area/process owner
  plannedDate         DateTime
  scheduledStart      DateTime?
  scheduledEnd        DateTime?
  conductedDate       DateTime?
  templateId          String? // CamsTemplate.id — versioned snapshot taken at execution start
  templateVersionUsed Int?
  status              String    @default("PLANNED") // PLANNED | SCHEDULED | IN_PROGRESS | FIELDWORK_COMPLETE | FINDINGS_REVIEW | REPORT_ISSUED | CLOSED | CANCELLED
  riskBasis           String? // ROUTINE | RISK_TRIGGERED | REGULATORY_REQUIRED | CUSTOMER_REQUIRED
  triggeringRiskId    String? // integrated mode: EnterpriseRisk that drove a risk-based audit
  overallResult       String? // CONFORMING | MINOR_NC | MAJOR_NC | CRITICAL_NC
  scorePercent        Float?
  reportAttachmentIds Json      @default("[]")
  nextScheduledDate   DateTime? // recurrence engine sets this
  sourceModule        String? // null = CAMS-native; else Fire / PPE / Pharma / EPC — provenance for analytics
  recurrenceId        String? // CamsRecurrence.id that generated this engagement

  responses CamsResponse[]
  findings  CamsFinding[]

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([siteId, status])
  @@index([status])
  @@index([engagementType])
  @@index([leadAuditorId])
  @@index([plannedDate])
  @@index([sourceModule])
  @@index([auditTypeId])
}

model CamsRecurrence {
  id                   String    @id @default(cuid())
  auditTypeId          String?
  templateId           String?
  siteScope            Json      @default("[]") // Plant.id[]
  frequency            String // WEEKLY | MONTHLY | QUARTERLY | HALF_YEARLY | ANNUAL | CUSTOM_DAYS
  customIntervalDays   Int?
  leadTimeDays         Int       @default(14) // auto-create the engagement N days before due
  defaultLeadAuditorId String?
  isActive             Boolean   @default(true)
  lastGeneratedAt      DateTime?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([isActive])
  @@index([auditTypeId])
}

// ── Shared Service ② — Template / Checklist Engine ──
model CamsTemplate {
  id                        String    @id @default(cuid())
  templateCode              String    @unique // "TPL-0001"
  name                      String
  description               String    @default("") @db.Text
  applicableEngagementTypes Json      @default("[]") // EngagementType[]
  standardRefs              Json      @default("[]") // standards this template assesses
  version                   Int       @default(1)
  status                    String    @default("DRAFT") // DRAFT | IN_REVIEW | APPROVED | RETIRED
  approvedBy                String?
  approvedAt                DateTime?
  parentTemplateId          String? // prior version this was forked from (immutability)
  scoringConfig             Json      @default("{}") // { mode, passThresholdPercent?, ncWeighting? }
  ownerId                   String
  isGlobal                  Boolean   @default(true) // global = all sites; else site-scoped
  siteId                    String?

  sections CamsTemplateSection[]

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([status])
  @@index([isGlobal])
  @@index([parentTemplateId])
}

model CamsTemplateSection {
  id         String       @id @default(cuid())
  templateId String
  template   CamsTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  orderIndex Int
  title      String
  weightPct  Float? // WEIGHTED_SCORE mode

  questions CamsTemplateQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId, orderIndex])
}

model CamsTemplateQuestion {
  id                   String              @id @default(cuid())
  sectionId            String
  section              CamsTemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  orderIndex           Int
  text                 String              @db.Text
  questionType         String // YES_NO_NA | CONFORM_NC_NA | RATING_SCALE | NUMERIC | SINGLE_SELECT | MULTI_SELECT | TEXT | PHOTO_REQUIRED | SIGNATURE
  isMandatory          Boolean             @default(true)
  standardClauseRef    String? // "ISO 45001:8.1.2" — drives compliance-coverage analytics
  guidance             String?             @db.Text
  weight               Float?
  ncTriggersFinding    Boolean             @default(true)
  evidenceRequiredOnNc Boolean             @default(false)
  options              Json? // for select/scale types

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId, orderIndex])
  @@index([standardClauseRef])
}

model CamsResponse {
  id                  String         @id @default(cuid())
  engagementId        String         @unique // one executed checklist per engagement (resume-in-place)
  engagement          CamsEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  templateVersionUsed Int
  // [{ questionId, value, conformance?, evidenceAttachmentIds[], note?, findingId? }]
  answers             Json           @default("[]")
  sectionScores       Json           @default("[]") // [{ sectionId, scorePercent }]
  completedBy         String?
  completedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([engagementId])
}

// ── Shared Service ③ — Findings ──
model CamsFinding {
  id                    String         @id @default(cuid())
  findingCode           String         @unique // "FND-2026-0001"
  engagementId          String
  engagement            CamsEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  sourceQuestionId      String? // CamsTemplateQuestion.id that triggered it
  title                 String
  description           String         @db.Text
  severity              String         @default("MINOR_NC") // OBSERVATION | MINOR_NC | MAJOR_NC | CRITICAL_NC | OPPORTUNITY_FOR_IMPROVEMENT
  standardClauseRef     String? // inherited from the question — feeds clause-conformance analytics
  siteId                String?
  areaOrAssetRef        String?
  ownerId               String?
  rootCauseMethod       String? // RCA method ref (Incident provider in integrated mode; shipped library standalone)
  rootCauseSummary      String?        @db.Text
  capaId                String? // Capa.id (AUDIT source) — MAJOR/CRITICAL require one
  status                String         @default("OPEN") // OPEN | CAPA_RAISED | IN_REMEDIATION | VERIFICATION | CLOSED | ACCEPTED_RISK
  isRepeatFinding       Boolean        @default(false) // computed by Analytics recurrence detection
  repeatOfFindingId     String?
  dueDate               DateTime?
  closedBy              String?
  closedAt              DateTime?
  verificationNote      String?        @db.Text
  evidenceAttachmentIds Json           @default("[]")

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([engagementId])
  @@index([status, dueDate])
  @@index([severity])
  @@index([standardClauseRef])
  @@index([siteId])
  @@index([isRepeatFinding])
}

// ── Shared Service ⑤ — Compliance link (audit ↔ obligation) ──
// Thin linking entity so audits and compliance reinforce each other (§5.1).
// obligationId references the ERM Phase-2 LegalObligation (loose ref; degrades
// to empty when ERM/obligations absent — standalone-safe).
model CamsComplianceLink {
  id           String  @id @default(cuid())
  engagementId String? // a compliance audit that verifies obligations
  findingId    String? // a finding that evidences non-compliance
  obligationId String // FK LegalObligation.id (loose ref)
  linkType     String // VERIFIES | BREACHES | EVIDENCES
  notes        String  @default("") @db.Text

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  @@index([obligationId])
  @@index([engagementId])
  @@index([findingId])
}

// ════════════════════════════════════════════════════════════════════════════
// FACILITIES — Factory Profile Master & Consolidated Dashboard
// A descriptive/compliance layer 1:1 with the existing Plant (= "Site"). The
// consolidated dashboard reads live audit/CAPA/compliance data per siteId from
// the existing engines; this family owns only profile attributes. siteId is a
// plain (unique) reference to Plant.id — no FK, matching the Cams* convention.
// ════════════════════════════════════════════════════════════════════════════
model FactoryProfile {
  id            String @id @default(cuid())
  siteId        String @unique // Plant.id — 1:1, mandatory, unique (enforces TF-01)
  factoryCode   String @unique // "MAG-TN-01" style
  factoryName   String
  status        String @default("OPERATIONAL") // OPERATIONAL | UNDER_CONSTRUCTION | PARTIAL_OPERATION | SHUTDOWN | DECOMMISSIONED
  ownershipType String @default("OWNED") // OWNED | LEASED | CONTRACT_MANUFACTURING | JOINT_VENTURE

  // location
  addressLine String @default("")
  city        String @default("")
  state       String @default("") // Indian state — drives jurisdiction & map
  pincode     String @default("")
  latitude    Float? // for the India map view
  longitude   Float?

  // identity & statutory
  establishedYear          Int?
  factoryLicenseNo         String? // Factories Act registration
  factoryLicenseValidUntil DateTime?
  registrationNos          Json      @default("[]") // { type, number }[] — GST/ESI/EPF/PCB consent
  applicableActs           Json      @default("[]") // string[] — ["Factories Act 1948", ...]
  pollutionControlBoard    String? // jurisdictional SPCB

  // descriptive
  totalLandAreaSqm Float?
  builtUpAreaSqm   Float?
  buildingCount    Int    @default(0) // kept in sync with active Building rows; manual when none

  // workforce summary (denormalised from WorkforceComposition — Phase B)
  totalEmployees Int @default(0)

  // operational summary
  primaryIndustry String    @default("Garments / Textile") // drives default audit library
  profileStatus   String    @default("DRAFT") // DRAFT | ACTIVE | REVIEW_DUE
  lastReviewedAt  DateTime?
  nextReviewDate  DateTime?

  // lifecycle workflow (governance approval state, separate from profileStatus)
  lifecycleStage          String    @default("INITIATED") // INITIATED | EXECUTION | VALIDATION | ACTIVE | ARCHIVED
  lifecycleStageOwnerRole String?
  lifecycleUpdatedAt      DateTime?

  buildings               Building[]
  workforceCompositions   WorkforceComposition[]
  productionProcesses     ProductionProcess[]
  certifications          FactoryCertification[]
  contacts                FactoryContact[]
  complianceSnapshots     FactoryComplianceSnapshot[]
  envPeriods              FactoryEnvPeriod[]
  socialCompliance        SocialComplianceProfile?
  equipment               FactoryEquipment[]
  hazardousMaterials      HazardousMaterial[]
  regulatoryRegistrations RegulatoryRegistration[]
  lifecycleEvents         FactoryLifecycleEvent[]

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([state])
  @@index([status])
  @@index([profileStatus])
}

model Building {
  id                     String         @id @default(cuid())
  factoryProfileId       String
  factoryProfile         FactoryProfile @relation(fields: [factoryProfileId], references: [id], onDelete: Cascade)
  siteId                 String // denormalised Plant.id for site-scoped queries
  buildingName           String // "Block A — Stitching"
  buildingType           String         @default("PRODUCTION") // PRODUCTION | WAREHOUSE | ADMIN_OFFICE | UTILITY | CANTEEN | DORMITORY | ETP_PLANT | BOILER_HOUSE | STORE | OTHER
  floors                 Int            @default(1)
  areaSqm                Float?
  maxOccupancy           Int?
  currentOccupancy       Int?
  yearBuilt              Int?
  // fire/safety-relevant (feeds Fire Safety module if present)
  assemblyPoint          String?
  emergencyExits         Int?
  occupancyCertificateNo String?
  isActive               Boolean        @default(true)

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([factoryProfileId])
  @@index([siteId])
  @@index([buildingType])
}

// ── Workforce Composition (SA8000-aware; history retained via isCurrent) ──
model WorkforceComposition {
  id                     String         @id @default(cuid())
  factoryProfileId       String
  factoryProfile         FactoryProfile @relation(fields: [factoryProfileId], references: [id], onDelete: Cascade)
  siteId                 String
  asOfDate               DateTime
  isCurrent              Boolean        @default(true) // latest composition; history kept for trends
  // headcount by employment type
  permanentCount         Int            @default(0)
  contractCount          Int            @default(0)
  apprenticeTraineeCount Int            @default(0)
  // gender split (SA8000 / welfare reporting)
  maleCount              Int            @default(0)
  femaleCount            Int            @default(0)
  otherGenderCount       Int            @default(0)
  // optional welfare-relevant detail
  migrantWorkerCount     Int?
  differentlyAbledCount  Int?
  totalCount             Int            @default(0) // = permanent + contract + apprentice
  // child-labour evidence (SA8000 Element 1)
  youngestWorkerAge      Int? // evidences no child labour
  workersUnder18Count    Int            @default(0) // legally-employed young workers (apprentices); 0 expected for child labour
  minHiringAgePolicy     Int? // e.g. 18
  // derived (persisted for fast export) — contract/female/migrant share of total
  contractPct            Float          @default(0)
  femalePct              Float          @default(0)
  migrantPct             Float?
  notes                  String?        @db.Text

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([factoryProfileId, isCurrent])
  @@index([siteId])
}

// ── Production Process (informs audit scope; HIRA link is a Phase-X hook) ──
model ProductionProcess {
  id                String         @id @default(cuid())
  factoryProfileId  String
  factoryProfile    FactoryProfile @relation(fields: [factoryProfileId], references: [id], onDelete: Cascade)
  siteId            String
  processName       String // "Cutting", "Stitching", "Washing & Dyeing", "Finishing", "Packing"
  processCategory   String?
  description       String?        @db.Text
  sequenceOrder     Int? // process-flow order
  shiftPattern      String? // "2 shifts", "24x7"
  installedCapacity String? // "12,000 pcs/day"
  keyHazards        Json           @default("[]") // string[] — links conceptually to HIRA scope
  isActive          Boolean        @default(true)

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([factoryProfileId])
  @@index([siteId])
}

// ── Factory Certification (buyer/social-compliance certs; status engine) ──
model FactoryCertification {
  id                String         @id @default(cuid())
  factoryProfileId  String
  factoryProfile    FactoryProfile @relation(fields: [factoryProfileId], references: [id], onDelete: Cascade)
  siteId            String
  certificationType String // SA8000 | ISO_9001 | ISO_14001 | ISO_45001 | WRAP | BSCI | OEKO_TEX | GOTS | SEDEX_SMETA | OTHER
  certificateNo     String?
  issuingBody       String?
  issueDate         DateTime?
  expiryDate        DateTime?
  renewalLeadDays   Int            @default(60) // drives EXPIRING_SOON + dashboard alert
  status            String         @default("VALID") // VALID | EXPIRING_SOON | EXPIRED | UNDER_RENEWAL | SUSPENDED (date-derived recomputed on read)
  scopeNotes        String?        @db.Text
  attachmentIds     Json           @default("[]")

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([factoryProfileId])
  @@index([siteId])
  @@index([certificationType])
}

// ── Factory Contact ──
model FactoryContact {
  id               String         @id @default(cuid())
  factoryProfileId String
  factoryProfile   FactoryProfile @relation(fields: [factoryProfileId], references: [id], onDelete: Cascade)
  siteId           String
  role             String         @default("OTHER") // FACTORY_MANAGER | SAFETY_OFFICER | COMPLIANCE_OFFICER | HR_HEAD | ENVIRONMENT_OFFICER | OTHER
  name             String
  phone            String?
  email            String?
  isPrimary        Boolean        @default(false)

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([factoryProfileId])
  @@index([siteId])
}

// ── Factory Compliance Snapshot (dashboard precompute; read from existing engines) ──
// Cache of live operational metrics per factory so the consolidated dashboard
// renders fast at any factory count. Recomputed on demand/schedule; the F-02
// drill-downs hit the real engines live. "LIVE" = current; "FYxx-Qy" = trend.
model FactoryComplianceSnapshot {
  id                      String         @id @default(cuid())
  factoryProfileId        String
  factoryProfile          FactoryProfile @relation(fields: [factoryProfileId], references: [id], onDelete: Cascade)
  siteId                  String
  periodLabel             String         @default("LIVE")
  auditComplianceScorePct Float?
  openFindings            Int            @default(0)
  criticalFindings        Int            @default(0)
  openCapas               Int            @default(0)
  overdueCapas            Int            @default(0)
  openObligations         Int            @default(0)
  overdueObligations      Int            @default(0)
  certsExpiringCount      Int            @default(0)
  lastAuditDate           DateTime?
  incidentCount12m        Int            @default(0)
  computedAt              DateTime       @default(now())

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@unique([factoryProfileId, periodLabel])
  @@index([siteId])
}

// ── Factory Environmental Period (ESG operational data source) ──
// Minimal environmental-data source-of-truth for the facility ESG rollup — one
// row per (site, period) holding energy / water / effluent / waste / emissions
// totals + targets. NOT a rollup cache: this is the "ESG module" the per-facility
// Compliance & Audit tab reads live. A site with no rows ⇒ the tab shows the
// neutral "Environmental data — module not enabled" tile (graceful absence).
model FactoryEnvPeriod {
  id               String         @id @default(cuid())
  factoryProfileId String
  factoryProfile   FactoryProfile @relation(fields: [factoryProfileId], references: [id], onDelete: Cascade)
  siteId           String
  periodLabel      String // e.g. "2026-Q2"

  // Energy
  energyKwh              Float?
  energyIntensity        Float? // kWh / unit output
  energyTargetKwh        Float?
  // Water + effluent (garment-critical)
  waterWithdrawnKl       Float?
  effluentDischargedKl   Float?
  etpStatus              String? // COMPLIANT | NON_COMPLIANT | NOT_MONITORED
  consentStatus          String? // free-text mirror of SPCB consent standing
  // Waste
  wasteGeneratedT        Float?
  wasteDivertedPct       Float?
  wasteDivertedTargetPct Float?
  // Emissions
  scope1TCo2e            Float?
  scope2TCo2e            Float?
  notes                  String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@unique([factoryProfileId, periodLabel])
  @@index([siteId])
}

// ── Social-Compliance Profile (SA8000 policy/standing; 1:1 with factory) ──
// The less-volatile attributes a buyer social-compliance audit (SA8000 / WRAP /
// BSCI / SMETA) checks — wages, working hours, freedom of association, forced
// labour, grievance, training — separate from the dated headcount. ComplianceFlag
// fields hold COMPLIANT | ATTENTION | NON_COMPLIANT | NOT_ASSESSED;
// overallSocialComplianceFlag is the persisted worst-of (computed on write).
model SocialComplianceProfile {
  id               String         @id @default(cuid())
  factoryProfileId String         @unique // 1:1 with the factory
  factoryProfile   FactoryProfile @relation(fields: [factoryProfileId], references: [id], onDelete: Cascade)
  siteId           String
  asOfDate         DateTime

  // Remuneration (SA8000 Element 8)
  minimumWageCompliant    String @default("NOT_ASSESSED")
  lowestMonthlyWageInr    Int?
  statutoryMinimumWageInr Int? // for comparison
  wagesPaidOnTime         String @default("NOT_ASSESSED")

  // Working Hours (Element 7) — SA8000 caps OT at 12/week
  standardWeeklyHours    Int?
  maxWeeklyOvertimeHours Int?
  overtimeVoluntary      String @default("NOT_ASSESSED")
  weeklyRestDayProvided  String @default("NOT_ASSESSED")

  // Freedom of Association (Element 4)
  unionOrWorkerCommitteePresent String  @default("NOT_ASSESSED")
  collectiveBargainingAgreement Boolean @default(false)

  // Forced Labour (Element 2) — no deposits / ID retention
  noDepositOrDocumentRetention String @default("NOT_ASSESSED")

  // Disciplinary & Grievance (Elements 5, 6, 9)
  grievanceMechanismPresent String @default("NOT_ASSESSED")
  antiDiscriminationPolicy  String @default("NOT_ASSESSED")

  // Management System / Training (Element 9)
  sa8000AwarenessTrainingPct Float? // % workforce trained
  socialComplianceOwnerId    String? // accountable person
  lastSocialAuditDate        DateTime?
  nextReviewDate             DateTime?

  overallSocialComplianceFlag String @default("NOT_ASSESSED") // computed worst-of the element flags + OT cap

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([siteId])
}

// ════════════════════════════════════════════════════════════════════════════
// FACILITIES — Extension layer (Equipment, Hazmat, Regulatory, Lifecycle)
// Applied via prisma/apply-factory-ext-ddl.ts (NOT `db push` — drift-safe).
// ════════════════════════════════════════════════════════════════════════════

// ── Factory Equipment (facility-grade asset register; PUWER/LOLER/noise) ──
model FactoryEquipment {
  id               String         @id @default(cuid())
  factoryProfileId String
  factoryProfile   FactoryProfile @relation(fields: [factoryProfileId], references: [id], onDelete: Cascade)
  siteId           String
  buildingId       String? // loose link to Building.id (no FK)

  equipmentName      String
  assetCode          String?
  category           String?
  manufacturer       String?
  modelNumber        String?
  serialNumber       String?
  installationDate   DateTime?
  warrantyExpiryDate DateTime?

  capacity             Float?
  capacityUnit         String?
  status               String  @default("ACTIVE") // ACTIVE | IDLE | DOWN | RETIRED
  operatingHoursPerDay Float?
  hazardLevel          String  @default("LOW") // LOW | MEDIUM | HIGH

  puwerRequired            Boolean   @default(false)
  puwerLastInspection      DateTime?
  puwerNextDue             DateTime?
  lolerRequired            Boolean   @default(false)
  lolerLastInspection      DateTime?
  lolerNextDue             DateTime?
  electricalSafetyRequired Boolean   @default(false)
  electricalLastCheck      DateTime?
  electricalNextDue        DateTime?
  noiseAssessmentRequired  Boolean   @default(false)
  noiseLastTest            DateTime?
  noiseMeasurementDb       Float?

  lastMaintenanceDate DateTime?
  lastMaintenanceType String?
  nextScheduledDate   DateTime?
  downtimeHoursYtd    Float     @default(0)

  lastInspectionDate   DateTime?
  lastInspectionResult String? // PASS | FAIL | CONDITIONAL_PASS

  certifiedOperators Json @default("[]") // [{ name, certifiedOn, expiresOn }]
  spareParts         Json @default("[]") // [{ partName, quantityInStock, reorderLevel, vendor }]

  notes String?

  inspections FactoryEquipmentInspection[]

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([factoryProfileId])
  @@index([siteId])
  @@index([status])
}

// ── Factory Equipment Inspection (statutory inspection log per asset) ──
model FactoryEquipmentInspection {
  id               String           @id @default(cuid())
  factoryProfileId String // denormalised; real FK applied via DDL (not modelled as a Prisma relation)
  equipmentId      String
  equipment        FactoryEquipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  siteId           String

  inspectionDate DateTime
  inspectorName  String
  result         String // PASS | FAIL | CONDITIONAL_PASS
  findings       String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([equipmentId])
  @@index([factoryProfileId])
  @@index([siteId])
}

// ── Hazardous Material (chemical inventory; GHS / SDS / storage / shelf-life) ──
model HazardousMaterial {
  id               String         @id @default(cuid())
  factoryProfileId String
  factoryProfile   FactoryProfile @relation(fields: [factoryProfileId], references: [id], onDelete: Cascade)
  siteId           String

  chemicalName             String
  casNumber                String?
  regulatoryClassification String? // SCHEDULED_SUBSTANCE | HIGH_HAZARD | NOTIFIED | OTHER
  hazmatClassification     String  @default("LOW") // HIGH | MEDIUM | LOW

  ghsSignalWord    String? // DANGER | WARNING | NONE
  ghsHazardClasses Json    @default("[]")
  ghsPictograms    Json    @default("[]")

  quantityStored  Float   @default(0)
  unit            String?
  maxAllowableQty Float?
  reorderLevel    Float?

  storageBuilding             String?
  storageRoom                 String?
  containerType               String?
  containerCount              Int?
  secondaryContainmentPresent Boolean @default(false)
  secondaryContainmentVolume  Float?
  ventilationAvailable        Boolean @default(false)
  signagePresent              Boolean @default(false)

  issueDate      DateTime?
  expiryDate     DateTime?
  batchLotNumber String?

  sdsDocId        String?
  sdsVersion      String?
  sdsGhsCompliant Boolean @default(false)

  ppeRequired            Json    @default("[]")
  incompatibleSubstances Json    @default("[]")
  spillKitLocation       String?
  emergencyContact       String?

  handlersTrainedCount Int @default(0)
  handlersTotalCount   Int @default(0)

  pcbNotificationRequired Boolean @default(false)
  pcbRegistrationStatus   String  @default("NOT_REGISTERED") // REGISTERED | PENDING | NOT_REGISTERED

  notes String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([factoryProfileId])
  @@index([siteId])
  @@index([hazmatClassification])
}

// ── Regulatory Registration (Factory Act / ESI / Fire / PCB / Boiler …) ──
model RegulatoryRegistration {
  id               String         @id @default(cuid())
  factoryProfileId String
  factoryProfile   FactoryProfile @relation(fields: [factoryProfileId], references: [id], onDelete: Cascade)
  siteId           String

  registrationType   String // FACTORY_ACT | ESI | PF | GST | FIRE_LICENSE | PCB | BOILER | BUILDING_CERT | OTHER
  registrationName   String
  registrationNumber String?
  issuingAuthority   String?
  issueDate          DateTime?
  expiryDate         DateTime?
  renewalFrequency   String    @default("ANNUAL") // ANNUAL | BIENNIAL | TRIENNIAL | ONEOFF | ONGOING
  lastRenewedDate    DateTime?
  nextRenewalDue     DateTime?

  status               String  @default("VALID") // computed on read
  renewalInProgress    Boolean @default(false)
  renewalAgencyContact String?
  renewalEstimatedCost Float?
  renewalNotes         String?

  alertThresholdDays        Int    @default(90)
  complianceImpactIfExpired String @default("MEDIUM") // CRITICAL | HIGH | MEDIUM | LOW
  documentationIds          Json   @default("[]")

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([factoryProfileId])
  @@index([siteId])
  @@index([registrationType])
  @@index([expiryDate])
}

// ── Factory Lifecycle Event (append-only approval-workflow timeline) ──
model FactoryLifecycleEvent {
  id               String         @id @default(cuid())
  factoryProfileId String
  factoryProfile   FactoryProfile @relation(fields: [factoryProfileId], references: [id], onDelete: Cascade)
  siteId           String

  fromStage       String?
  toStage         String
  action          String // INITIATE | ADVANCE | REQUEST_REVISIONS | REJECT | NOTIFY
  performedBy     String?
  performedByRole String?
  comment         String?
  validations     Json    @default("{}") // { fieldName: bool }
  issues          Json    @default("[]") // [{ section, issue }]

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@index([factoryProfileId])
  @@index([siteId])
}

// ─────────────────────────────────────────────────────────────────────────────
// GUIDED FIELD CAPTURE + DAILY ALERT BRIEF
// Schema mirrored from the backend SQLAlchemy models (app/models/capture.py,
// app/models/alerts.py). Tables are created by prisma/apply-capture-ddl.ts —
// hand-DDL only; NEVER `prisma db push` (it would drop drifted tables).
// Relations are deliberately loose (plain String ids) so the existing User /
// Plant model blocks stay untouched.
// ─────────────────────────────────────────────────────────────────────────────

model CaptureSubmission {
  id                   String    @id @default(cuid())
  tenantId             String    @default("default")
  number               String    @unique
  clientSubmissionId   String
  type                 String    @default("observation") // observation | near_miss | unsafe_condition | incident
  reporterId           String?
  isAnonymous          Boolean   @default(false)
  anonHash             String?
  plantId              String
  areaId               String?
  mapPinX              Float?
  mapPinY              Float?
  equipmentId          String?
  qrScanned            Boolean   @default(false)
  categoryL1Id         String?
  categoryL2Id         String?
  categorySnapshot     Json?
  aiSuggested          Boolean   @default(false)
  aiConfidence         Float?
  aiSuggestion         Json?
  severitySelfReported String    @default("medium") // low | medium | high
  description          String?
  voiceLangCode        String?
  transcriptOriginal   String?
  transcriptEnglish    String?
  transcriptionStatus  String    @default("none") // none | device | pending | done | failed
  status               String    @default("submitted") // submitted | triaged | converted | closed | rejected
  triagedById          String?
  triagedAt            DateTime?
  hiraLikelihood       Int?
  hiraSeverity         Int?
  riskScore            Int?
  riskLevel            String?
  triageNote           String?
  convertedEntityType  String?
  convertedEntityId    String?
  convertedById        String?
  convertedAt          DateTime?
  linkedRcaIds         Json      @default("[]")
  linkedCapaIds        Json      @default("[]")
  linkedPtwIds         Json      @default("[]")
  tapCount             Int?
  durationMs           Int?
  wasOffline           Boolean   @default(false)
  appVersion           String?
  deviceLang           String?
  taxonomyVersion      Int?
  createdAtClient      DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  isDeleted            Boolean   @default(false)
  deletedAt            DateTime?
  deletedBy            String?
  deletionReason       String?

  attachments CaptureAttachment[]

  @@unique([tenantId, clientSubmissionId], map: "uq_CaptureSubmission_tenant_client")
  @@index([tenantId, plantId, status, createdAt], map: "ix_CaptureSubmission_plant_status_created")
  @@index([plantId, areaId, categoryL1Id], map: "ix_CaptureSubmission_cluster")
  @@index([reporterId], map: "ix_CaptureSubmission_reporterId")
  @@index([anonHash], map: "ix_CaptureSubmission_anonHash")
  @@index([status], map: "ix_CaptureSubmission_status")
