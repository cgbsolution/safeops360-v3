# ─────────────────────────────────────────────────────────────────────────
# Frontend env. The Next.js app should only need the variables in this
# file. Everything that talks to Postgres / Supabase Storage / JWTs lives
# in `safeops_360_bakend/.env` and is consumed by the Python backend.
#
# During the strangler migration, some Node code paths still read
# DATABASE_URL etc. directly via Prisma — those are flagged below as
# "during migration only" and can be removed once every server component
# has been switched over to backendFetch().
# ─────────────────────────────────────────────────────────────────────────
#
# ════════════════════════════════════════════════════════════════════════
#  VERCEL DEPLOYMENT — REQUIRED ENV VARS
# ════════════════════════════════════════════════════════════════════════
# When deploying to Vercel you MUST set these on the Vercel dashboard
# (Settings → Environment Variables → for Production, Preview, Dev):
#
#   1. BACKEND_URL          — public HTTPS URL of your Python backend.
#                             NO trailing slash. e.g. https://api.example.com
#                             NOT http://localhost:8000 (Vercel can't reach
#                             localhost) and NOT a private IP.
#   2. DATABASE_URL         — Supabase pooler URL (port 6543, pgbouncer=true).
#   3. JWT_SECRET           — IDENTICAL to safeops_360_bakend/.env JWT_SECRET.
#                             A mismatch makes every API call return 401.
#   4. NEXTAUTH_SECRET      — random 32+ chars. Generate: openssl rand -base64 32
#   5. NEXTAUTH_URL         — your full Vercel URL, e.g. https://yourapp.vercel.app
#
# After you change any env var, Vercel does NOT auto-redeploy. Trigger a
# fresh deploy: Deployments → ⋯ → Redeploy (uncheck "use existing build").
#
# To verify your Vercel deployment is correctly configured, hit:
#
#     https://your-vercel-url.vercel.app/api/diagnostics
#
# It returns JSON listing every required env var, whether it's set, and
# whether your backend is reachable from Vercel's serverless functions.
# ════════════════════════════════════════════════════════════════════════

# ─── Auth (NextAuth) ─────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-32-char-string

# ─── Python backend ──────────────────────────────────────────────────────
# When set, NextAuth's credentials provider authenticates against the
# Python backend instead of querying Prisma, and `backendFetch()` works
# in server components. Unset to fall back to the legacy Node + Prisma
# code path during gradual cutover.
BACKEND_URL=http://localhost:8000

# Shared with safeops_360_bakend/.env. Next.js uses this to mint a JWT
# the Python backend will accept whenever login takes the Prisma fallback
# path (otherwise the proxy can't authenticate to Python). Must match the
# JWT_SECRET in the backend env exactly.
JWT_SECRET=replace-with-the-same-32-byte-string-as-backend

# ─── During migration only ───────────────────────────────────────────────
# Once every server component uses backendFetch(), these can be deleted.
# Until then, un-migrated server components still call Prisma directly.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL_SYNC=postgresql://USER:PASSWORD@HOST:PORT/DB

# ─── During migration only — Supabase Storage ────────────────────────────
# These were used by the Node API routes that minted signed upload URLs.
# The Python backend now owns this; remove from the frontend once the
# incident-attachments / observations attachments routes are gone from
# `src/app/api/`.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ey...your-service-role-jwt...
# SUPABASE_INCIDENT_BUCKET=incident-attachments
# SUPABASE_OBSERVATION_BUCKET=observation-attachments

# ─── During migration only — SMTP for AnomalyDetectionAgent ──────────────
# Will move to the Python backend in a follow-up session.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alerts@yourorg.com
SMTP_PASS=your-app-password
SMTP_FROM="SafeOps360 Alerts <alerts@yourorg.com>"
