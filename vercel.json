{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/hira-review-scheduler",
      "schedule": "30 20 * * *"
    },
    {
      "path": "/api/cron/hira-training-expiry",
      "schedule": "30 21 * * *"
    }
  ]
}
