# npm resolution mode — applies to local installs, CI, and Vercel.
#
# We're on React 19, but a few of our deps still declare React 18 as the
# upper bound in their peer-deps metadata even though they work fine on
# React 19 in practice:
#   - lucide-react@0.344.x  (peer: react@^16.5.1 || ^17.0.0 || ^18.0.0)
#   - next-auth@4.24.x      (peer: react@^17.0.2 || ^18)
#
# Strict peer-dep resolution (npm 7+ default) refuses to install in this
# situation. legacy-peer-deps reverts to the npm 6 behaviour: peer-dep
# metadata becomes a warning rather than a hard error. The actual modules
# work — we verified with `npm run build` on React 19 (all 41 routes
# compiled cleanly).
#
# Long-term fix is to bump these deps to versions that explicitly list
# React 19 in their peer range (lucide-react ≥ 0.460, next-auth → v5),
# but those are migration projects of their own. This flag bridges the gap.
legacy-peer-deps=true
