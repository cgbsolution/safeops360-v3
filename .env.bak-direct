# ─── Frontend-only ───────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=safeops360-vizionforge-star-cement-demo-secret-key-replace-in-prod

# ─── Python backend pointer ─────────────────────────────────────────────
# When set, NextAuth + backendFetch route through it.
BACKEND_URL=http://localhost:8000

# Shared with safeops_360_bakend/.env — used by Next.js to mint a Python-
# compatible JWT when login goes through the Prisma fallback path. Without
# this set, the proxy calls Python with no bearer token and gets 401 on
# every protected endpoint (UserPicker, permissions, etc.).
JWT_SECRET=dev-only-jwt-secret-z4H9pK2nQ7rL5wB8tF3vM6sY1aEcRoUiX-rotate-in-prod

# ─── During migration only — used by un-migrated Prisma server components
# Delete once every server component is on backendFetch().
# Supabase Mumbai (ap-south-1) — project ref xwyzujrdlsdhezfikbku. Password
# `Safeops321@123` is URL-encoded (`@` → `%40`) so Prisma can parse it.
DATABASE_URL=postgresql://postgres:reliancesafeops360123321@db.kojhjwivrssygutjqpvc.supabase.co:5432/postgres
DATABASE_URL_SYNC=postgresql://postgres:reliancesafeops360123321@db.kojhjwivrssygutjqpvc.supabase.co:5432/postgres

